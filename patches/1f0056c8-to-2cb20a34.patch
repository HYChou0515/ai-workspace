index 000000000..128db435c
--- /dev/null
+++ b/tests/tooling/test_builder_env_names.py
@@ -0,0 +1,64 @@
+"""A name the host would drop cannot be declared (review round 2, M2).
+
+The sandbox host scrubs, from a third-party tool's environment, every user-set
+name that decides where code loads from, where traffic goes or whom it trusts
+(`tool_env.py`). A tool that DECLARED such a name in `env.json` would have its
+users asked to fill it in — and then never receive it, with nobody told. So the
+builder refuses it in the author's own CI, naming it.
+
+`tool_env.py` is the same file on both sides, so the rule the builder checks is
+the rule the host applies.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+
+from tests.tooling.test_builder import _BUILDER, _fake_bundle, _source
+from tests.tooling.test_builder_secrets import _with_env_json
+from workspace_app.tooling.builder import BuildError, build_artifact
+
+
+def _build(tmp_path: Path, entries: list[dict]) -> None:
+    build_artifact(
+        source=_with_env_json(_source(tmp_path), entries),
+        out=tmp_path / "dist",
+        builder_id=_BUILDER,
+        build_bundle=_fake_bundle({"trend": "t"}),
+        smoke_check=lambda _dist: None,
+    )
+
+
+@pytest.mark.parametrize("name", ["HTTPS_PROXY", "GIT_TOKEN", "PYTHONPATH", "ssl_cert_file"])
+def test_a_name_the_host_drops_cannot_be_declared(tmp_path, name):
+    with pytest.raises(BuildError, match=name):
+        _build(tmp_path, [{"name": name}])
+
+
+def test_an_ordinary_name_still_builds(tmp_path):
+    _build(tmp_path, [{"name": "ERP_TOKEN"}, {"name": "GITLAB_TOKEN"}])
+
+
+def test_a_secret_is_not_a_user_name_and_is_not_checked_as_one(tmp_path, monkeypatch):
+    """The tool's own credentials are added by the host after the scrub; only
+    the names a USER fills in can be dropped."""
+    from cryptography.hazmat.primitives.asymmetric.x25519 import X25519PrivateKey
+
+    from workspace_app.tooling.tool_secrets import public_key_text
+
+    key = X25519PrivateKey.generate()
+    monkeypatch.setenv("GIT_DEPLOY_KEY", "x")
+    monkeypatch.setenv("TOOL_SECRET_RECIPIENTS", public_key_text(key.public_key()))
+    _build(tmp_path, [{"name": "GIT_DEPLOY_KEY", "secret": True}])
+
+
+def test_both_copies_of_the_rule_are_the_same_file():
+    repo = Path(__file__).resolve().parents[2]
+    app = repo / "src" / "workspace_app" / "tooling" / "tool_env.py"
+    host = repo / "sandbox-host" / "src" / "sandbox_host" / "tool_env.py"
+    assert host.read_bytes() == app.read_bytes(), (
+        "sandbox-host/src/sandbox_host/tool_env.py has drifted from the app's copy — "
+        "copy it across; the builder checks the rule the host applies"
+    )
diff --git a/tests/tooling/test_builder_secrets.py b/tests/tooling/test_builder_secrets.py
new file mode 100644
index 000000000..5b2ec4798
--- /dev/null
+++ b/tests/tooling/test_builder_secrets.py
@@ -0,0 +1,158 @@
+"""The builder seals the author's credentials into the bundle
+(docs/plan-tool-identity-secrets.md P4).
+
+The author's CI already runs the builder; GitLab hands the job the project's
+CI/CD Variables as environment variables. For every name `env.json` marks
+`"secret": true`, the builder reads the value from there, seals it to the
+platform's public keys (`TOOL_SECRET_RECIPIENTS`, set on the GitLab group), and
+puts only the sealed file in the bundle. The value never reaches the manifest,
+the bundle in the clear, or the build log.
+"""
+
+from __future__ import annotations
+
+import io
+import json
+import tarfile
+from pathlib import Path
+
+import pytest
+from cryptography.hazmat.primitives.asymmetric.x25519 import X25519PrivateKey
+
+from tests.tooling.test_builder import _BUILDER, _fake_bundle, _source
+from workspace_app.tooling.builder import BUNDLE_NAME, MANIFEST_NAME, BuildError, build_artifact
+from workspace_app.tooling.tool_secrets import SECRETS_FILE, open_sealed, public_key_text
+
+
+def _with_env_json(src: Path, entries: list[dict]) -> Path:
+    (src / "env.json").write_text(json.dumps(entries))
+    return src
+
+
+def _members(bundle: bytes) -> dict[str, bytes]:
+    out: dict[str, bytes] = {}
+    with tarfile.open(fileobj=io.BytesIO(bundle)) as tar:
+        for member in tar.getmembers():
+            if member.isfile():
+                fh = tar.extractfile(member)
+                assert fh is not None
+                out[member.name] = fh.read()
+    return out
+
+
+def _build(tmp_path: Path, monkeypatch, env: dict[str, str], entries: list[dict]) -> Path:
+    for name, value in env.items():
+        monkeypatch.setenv(name, value)
+    out = tmp_path / "dist"
+    build_artifact(
+        source=_with_env_json(_source(tmp_path), entries),
+        out=out,
+        builder_id=_BUILDER,
+        build_bundle=_fake_bundle({"trend": "t"}),
+        smoke_check=lambda _dist: None,
+    )
+    return out
+
+
+def test_a_secret_is_sealed_into_the_bundle_and_opens_on_the_host(tmp_path, monkeypatch):
+    key = X25519PrivateKey.generate()
+    out = _build(
+        tmp_path,
+        monkeypatch,
+        {
+            "MACHINE_PASSWORD": "hunter2",
+            "TOOL_SECRET_RECIPIENTS": public_key_text(key.public_key()),
+        },
+        [{"name": "MACHINE_PASSWORD", "secret": True}, {"name": "ERP_BASE"}],
+    )
+    members = _members((out / BUNDLE_NAME).read_bytes())
+    assert open_sealed(members[SECRETS_FILE], key) == {"MACHINE_PASSWORD": "hunter2"}
+
+
+def test_the_value_appears_nowhere_in_the_clear(tmp_path, monkeypatch):
+    key = X25519PrivateKey.generate()
+    out = _build(
+        tmp_path,
+        monkeypatch,
+        {
+            "MACHINE_PASSWORD": "hunter2",
+            "TOOL_SECRET_RECIPIENTS": public_key_text(key.public_key()),
+        },
+        [{"name": "MACHINE_PASSWORD", "secret": True}],
+    )
+    assert b"hunter2" not in (out / MANIFEST_NAME).read_bytes()
+    assert all(
+        b"hunter2" not in body for body in _members((out / BUNDLE_NAME).read_bytes()).values()
+    )
+
+
+def test_a_secret_missing_from_ci_fails_the_build_naming_where_to_set_it(tmp_path, monkeypatch):
+    key = X25519PrivateKey.generate()
+    monkeypatch.delenv("MACHINE_PASSWORD", raising=False)
+    with pytest.raises(BuildError, match=r"MACHINE_PASSWORD.*CI/CD.*Variables"):
+        _build(
+            tmp_path,
+            monkeypatch,
+            {"TOOL_SECRET_RECIPIENTS": public_key_text(key.public_key())},
+            [{"name": "MACHINE_PASSWORD", "secret": True}],
+        )
+    assert not (tmp_path / "dist" / BUNDLE_NAME).exists(), "a refused build publishes nothing"
+
+
+def test_no_recipient_fails_the_build(tmp_path, monkeypatch):
+    monkeypatch.delenv("TOOL_SECRET_RECIPIENTS", raising=False)
+    with pytest.raises(BuildError, match="TOOL_SECRET_RECIPIENTS"):
+        _build(
+            tmp_path,
+            monkeypatch,
+            {"MACHINE_PASSWORD": "hunter2"},
+            [{"name": "MACHINE_PASSWORD", "secret": True}],
+        )
+
+
+def test_a_tool_with_no_secret_builds_exactly_as_before(tmp_path, monkeypatch):
+    """No sealed file, and no need for a recipient: every existing tool's build
+    is untouched."""
+    monkeypatch.delenv("TOOL_SECRET_RECIPIENTS", raising=False)
+    out = _build(tmp_path, monkeypatch, {}, [{"name": "ERP_BASE"}])
+    assert SECRETS_FILE not in _members((out / BUNDLE_NAME).read_bytes())
+
+
+def test_the_manifest_says_which_names_are_secret(tmp_path, monkeypatch):
+    key = X25519PrivateKey.generate()
+    out = _build(
+        tmp_path,
+        monkeypatch,
+        {
+            "MACHINE_PASSWORD": "hunter2",
+            "TOOL_SECRET_RECIPIENTS": public_key_text(key.public_key()),
+        },
+        [{"name": "MACHINE_PASSWORD", "secret": True}],
+    )
+    env = json.loads((out / MANIFEST_NAME).read_text())["env"]
+    assert env == [
+        {"name": "MACHINE_PASSWORD", "description": "", "required": None, "secret": True}
+    ]
+
+
+def test_a_missing_secret_fails_before_the_bundle_is_built(tmp_path, monkeypatch):
+    """The author should not wait for a venv to learn they forgot a variable."""
+    key = X25519PrivateKey.generate()
+    monkeypatch.delenv("MACHINE_PASSWORD", raising=False)
+    monkeypatch.setenv("TOOL_SECRET_RECIPIENTS", public_key_text(key.public_key()))
+    built: list[str] = []
+
+    def bundle(*, name, source, dst):  # noqa: ARG001
+        built.append(name)
+
+    with pytest.raises(BuildError):
+        build_artifact(
+            source=_with_env_json(
+                _source(tmp_path), [{"name": "MACHINE_PASSWORD", "secret": True}]
+            ),
+            out=tmp_path / "dist",
+            builder_id=_BUILDER,
+            build_bundle=bundle,
+            smoke_check=lambda _dist: None,
+        )
+    assert built == []
