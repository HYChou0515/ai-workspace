index 000000000..127a1f840
--- /dev/null
+++ b/sandbox-host/tests/test_secret_flag_reaches_the_app.py
@@ -0,0 +1,61 @@
+"""Which names are secret travels every hop to the app
+(docs/plan-tool-identity-secrets.md P4).
+
+The app never reads a manifest: it learns a tool's `env` from `/tools/resolve`,
+which is built from a `ResolvedTool`, which an outage rebuilds from the host's
+remembered note. A hop that dropped `secret` would hand the app the machine
+password's NAME as an ordinary variable — and the environment panel would offer
+the user a field to type it into.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+from sandbox_host.artifact import CommandSpec, EnvSpec
+from sandbox_host.tool_resolve import ResolvedTool
+
+from .test_tool_resolve import _MANIFEST_URL, _bundle, _manifest, _resolver, _Wire
+from .test_tools_endpoint import _client, _Resolver
+
+_ENV = [
+    {"name": "MACHINE_PASSWORD", "description": "", "required": None, "secret": True},
+    {"name": "ERP_BASE", "description": "site", "required": False},
+]
+
+
+async def test_the_resolve_reply_says_which_names_are_secret() -> None:
+    resolver = _Resolver(
+        erp=ResolvedTool(
+            name="erp",
+            sha="a" * 64,
+            version="1.0",
+            commands=(CommandSpec("q", "q", {"type": "object"}),),
+            stale=False,
+            env=(EnvSpec("MACHINE_PASSWORD", secret=True), EnvSpec("ERP_BASE", "site", False)),
+        )
+    )
+    async with _client(resolver) as c:
+        r = await c.post("/tools/resolve", json={"tools": {"erp": "https://g/m"}})
+    assert r.json()["tools"]["erp"]["env"] == _ENV
+
+
+def test_a_resolve_carries_the_flag_from_the_manifest(tmp_path: Path) -> None:
+    data = _bundle()
+    wire = _Wire(manifest=_manifest(data, env=_ENV), bundle=data)
+    resolved = _resolver(tmp_path, wire).resolve("wafer-history", _MANIFEST_URL)
+    assert resolved.env is not None
+    assert [e.secret for e in resolved.env] == [True, False]
+
+
+def test_the_remembered_copy_keeps_the_flag(tmp_path: Path) -> None:
+    """An outage serves the remembered note; losing the flag there would show
+    the field exactly when nothing else can be checked."""
+    data = _bundle()
+    _resolver(tmp_path, _Wire(manifest=_manifest(data, env=_ENV), bundle=data)).resolve(
+        "wafer-history", _MANIFEST_URL
+    )
+    fallen_back = _resolver(tmp_path, _Wire()).resolve("wafer-history", _MANIFEST_URL)
+    assert fallen_back.stale is True
+    assert fallen_back.env is not None
+    assert [e.secret for e in fallen_back.env] == [True, False]
diff --git a/sandbox-host/tests/test_tool_group.py b/sandbox-host/tests/test_tool_group.py
new file mode 100644
index 000000000..978ff0d2f
--- /dev/null
+++ b/sandbox-host/tests/test_tool_group.py
@@ -0,0 +1,137 @@
+"""Third-party bundles are readable by the tool group only
+(docs/plan-tool-identity-secrets.md P2).
+
+Before: `root:root`, group/other may read — so the agent, running as the
+sandbox uid, could `cat` a tool's source and any credential written into it.
+After: `root:<tool group>`, and the group gets exactly the read/traverse bits
+"other" used to have — so the tool's uid reaches precisely what a sandbox could
+reach before, and "other" (the agent) reaches nothing.
+
+First-party tools (`builtin/`) and the engineer's MCP runner are untouched.
+"""
+
+from __future__ import annotations
+
+import io
+import os
+import tarfile
+from pathlib import Path
+
+from sandbox_host.config import SandboxHostSettings
+from sandbox_host.service import build_sandbox, build_tool_resolver
+from sandbox_host.tool_cache import EXT_DIR, ToolCache, _GroupHardener
+
+GROUP = 4242
+
+
+def _tar(files: dict[str, bytes]) -> bytes:
+    buf = io.BytesIO()
+    with tarfile.open(fileobj=buf, mode="w:gz") as tar:
+        for name, body in files.items():
+            info = tarfile.TarInfo(name)
+            info.size = len(body)
+            info.mode = 0o755 if name == "launch" else 0o644
+            tar.addfile(info, io.BytesIO(body))
+    return buf.getvalue()
+
+
+def _record(monkeypatch) -> tuple[list[tuple[Path, int, int]], dict[Path, int]]:
+    owned: list[tuple[Path, int, int]] = []
+    modes: dict[Path, int] = {}
+    monkeypatch.setattr(os, "lchown", lambda p, u, g: owned.append((Path(p), u, g)))
+    monkeypatch.setattr(os, "chmod", lambda p, m: modes.__setitem__(Path(p), m))
+    return owned, modes
+
+
+def test_the_group_gets_what_other_had_and_other_gets_nothing(tmp_path, monkeypatch):
+    tree = tmp_path / "staging"
+    (tree / "lib").mkdir(parents=True)
+    (tree / "launch").write_text("#!/bin/sh\n")
+    (tree / "launch").chmod(0o755)
+    (tree / "lib" / "creds.py").write_text("PASSWORD = 'x'\n")
+    (tree / "lib" / "creds.py").chmod(0o644)
+    (tree / "lib" / "private").write_text("")
+    (tree / "lib" / "private").chmod(0o600)
+    tree.chmod(0o755)
+    (tree / "lib").chmod(0o755)
+    owned, modes = _record(monkeypatch)
+
+    _GroupHardener(GROUP)(tree)
+
+    assert {p for p, _, _ in owned} == {
+        tree,
+        tree / "lib",
+        tree / "launch",
+        tree / "lib" / "creds.py",
+        tree / "lib" / "private",
+    }
+    assert all(uid == 0 and gid == GROUP for _, uid, gid in owned)
+    assert modes[tree] == 0o750
+    assert modes[tree / "lib"] == 0o750
+    assert modes[tree / "launch"] == 0o750
+    assert modes[tree / "lib" / "creds.py"] == 0o640
+    # Nobody but root could read it before; the group gains nothing either.
+    assert modes[tree / "lib" / "private"] == 0o600
+
+
+def test_group_hardening_never_follows_a_link(tmp_path, monkeypatch):
+    """Same rule as `_harden`: `lchown`, and no `chmod` through a symlink — a
+    dangling relative one is something the safe tar filter lets through."""
+    tree = tmp_path / "staging"
+    tree.mkdir()
+    (tree / "dangling").symlink_to("nowhere")
+    owned, modes = _record(monkeypatch)
+
+    _GroupHardener(GROUP)(tree)
+
+    assert (tree / "dangling", 0, GROUP) in owned
+    assert tree / "dangling" not in modes
+
+
+def test_bundles_already_on_the_host_are_hardened_again(tmp_path):
+    """A host that unpacked bundles before this change keeps them on disk, and
+    `ensure` returns early for a sha it already has — so without this, every
+    tool installed before the upgrade would stay readable by the agent."""
+    sha_a, sha_b = "a" * 64, "b" * 64
+    plain = ToolCache(tmp_path, harden=lambda _p: None)
+    plain.ensure(sha_a, _tar({"launch": b"#!/bin/sh\n"}))
+    plain.ensure(sha_b, _tar({"launch": b"#!/bin/sh\n"}))
+    (tmp_path / f".{sha_a}.half").mkdir()  # an interrupted unpack: not a bundle
+
+    hardened: list[Path] = []
+    ToolCache(tmp_path, harden=hardened.append).reharden_installed()
+
+    assert sorted(hardened) == [tmp_path / sha_a, tmp_path / sha_b]
+
+
+def test_the_production_cache_hardens_for_the_group_the_tools_run_with(tmp_path, monkeypatch):
+    """One number, two consumers: the bundles' group and the group a tool
+    command holds. Derived in one place, or a host could unpack bundles for a
+    group no tool ever joins — and then no third-party tool runs at all."""
+    monkeypatch.setenv("TOOL_BUILDER_ID", "tool-builder:2026.07")
+    settings = SandboxHostSettings(
+        uid_min=300000,
+        uid_max=300009,
+        tools_dir=str(tmp_path / "tools"),
+        cgroup_root=str(tmp_path / "cg"),
+        root=str(tmp_path / "sb"),
+    )
+    resolver = build_tool_resolver(settings)
+    assert resolver is not None
+    hardener = resolver._cache._harden
+    assert isinstance(hardener, _GroupHardener)
+    assert hardener.group == build_sandbox(settings)._tool_gid == 300000
+
+
+def test_the_production_cache_rehardens_what_it_finds_at_startup(tmp_path, monkeypatch):
+    monkeypatch.setenv("TOOL_BUILDER_ID", "tool-builder:2026.07")
+    ext = tmp_path / "tools" / EXT_DIR
+    ToolCache(ext, harden=lambda _p: None).ensure("c" * 64, _tar({"launch": b"x"}))
+    settings = SandboxHostSettings(
+        uid_min=300000, uid_max=300009, tools_dir=str(tmp_path / "tools")
+    )
+    owned, _modes = _record(monkeypatch)
+
+    build_tool_resolver(settings)
+
+    assert (ext / ("c" * 64), 0, 300000) in owned
diff --git a/sandbox-host/tests/test_tool_identity.py b/sandbox-host/tests/test_tool_identity.py
new file mode 100644
index 000000000..4cdb1cbd6
--- /dev/null
+++ b/sandbox-host/tests/test_tool_identity.py
@@ -0,0 +1,387 @@
+"""A third-party tool runs as the item's TOOL identity, not the sandbox's
+(docs/plan-tool-identity-secrets.md P1).
+
+The agent's own commands run as the sandbox uid; a third-party tool's command
+runs as a second pooled uid that shares the sandbox's cgroup and workspace (by
+ACL) but nothing else — its own HOME, and a group the sandbox uid never holds.
+Being a different uid is what keeps the agent from reading the running tool's
+environment (`/proc/<pid>/environ` is readable by the same uid only).
+
+L2 unit tests: the uid pool is pure and the privileged steps are seamed, so
+nothing here needs root. Real enforcement is in the root-gated integration file.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import logging
+import os
+from pathlib import Path
+
+import pytest
+
+from sandbox_host.isolated_process import IsolatedProcessSandbox, _acl_argv
+from sandbox_host.protocol import SandboxSpec
+
+TOOL_GID = 4242
+
+
+@pytest.fixture
+def tooled(tmp_path):
+    """Room in the pool for exactly one sandbox's TWO uids: the sandbox takes the
+    caller's own uid (the pool hands out from the top) so `_provision`'s raw
+    `chown` of the workspace works non-root; the tool takes the one below, whose
+    ownership handovers are recorded through `_own_privately` instead."""
+    acl: list[list[str]] = []
+    owned: list[tuple[Path, int]] = []
+    sb = IsolatedProcessSandbox(
+        root_dir=tmp_path / "sb",
+        cgroup_root=tmp_path / "cg",
+        uid_min=os.getuid() - 1,
+        uid_max=os.getuid(),
+        tool_gid=TOOL_GID,
+        acl_runner=acl.append,
+        chown_runner=lambda p, u: None,
+    )
+    sb._own_privately = lambda path, uid: owned.append((path, uid))  # ty: ignore[invalid-assignment]
+    return sb, acl, owned
+
+
+async def test_a_sandbox_gets_a_second_pooled_uid_for_its_tools(tooled):
+    sb, _acl, _owned = tooled
+    h = await sb.create(SandboxSpec())
+    ident = sb._identities[h.id]
+    assert ident.uid == os.getuid()
+    assert ident.tool_uid == os.getuid() - 1
+
+
+async def test_the_workspace_acl_grants_both_identities(tooled):
+    sb, acl, _owned = tooled
+    h = await sb.create(SandboxSpec())
+    ident = sb._identities[h.id]
+    assert ident.tool_uid is not None
+    ws = sb._workspace(h)
+    assert acl == [_acl_argv(ws, ident.uid, ident.tool_uid)]
+
+
+def test_one_acl_call_names_every_identity_and_its_default():
+    spec = "u:7:rwx,u:8:rwx"
+    assert _acl_argv(Path("/w"), 7, 8) == ["setfacl", "-R", "-m", spec, "-d", "-m", spec, "/w"]
+
+
+async def test_the_tool_identity_has_its_own_home(tooled):
+    sb, _acl, owned = tooled
+    h = await sb.create(SandboxSpec())
+    ident = sb._identities[h.id]
+    tool_home = sb._require(h) / ".tool-home"
+    assert tool_home.is_dir()
+    assert (tool_home, ident.tool_uid) in owned
+    # Never the sandbox's own HOME: that one the agent writes.
+    assert (sb._require(h) / ".home", ident.tool_uid) not in owned
+
+
+async def test_a_tool_command_runs_as_the_tool_identity_in_the_same_cgroup(tooled):
+    sb, _acl, _owned = tooled
+    h = await sb.create(SandboxSpec())
+    ident = sb._identities[h.id]
+    plain, _, _ = sb._exec_argv(h, ["true"])
+    argv, cwd, env = sb._exec_argv(h, ["../.tools/erp/launch", "q", "{}"], as_tool="erp")
+
+    assert argv[:3] == plain[:3], "joins the SAME cgroup — limits and billing unchanged"
+    assert f"--reuid={ident.tool_uid}" in argv
+    assert f"--regid={ident.tool_uid}" in argv
+    assert f"--groups={TOOL_GID}" in argv
+    assert "--clear-groups" not in argv
+    assert argv[-3:] == ["../.tools/erp/launch", "q", "{}"]
+    assert cwd == sb._workspace(h)
+    tool_home = str(sb._require(h) / ".tool-home")
+    assert env["HOME"] == tool_home
+    assert env["SANDBOX_HOME"] == tool_home
+    assert env["PYTHONNOUSERSITE"] == "1"
+    assert env["PYTHONSAFEPATH"] == "1"
+
+
+async def test_a_tool_commands_temp_files_are_its_own(tooled):
+    """Review round 3 (reproduced as root): with TMPDIR = the workspace, a tool's
+    private temp file — a credential written out for a subprocess, say — sat in
+    a directory the agent writes, so the agent could move it aside mid-run and
+    read it once the call was over. A tool's TMPDIR is under its own HOME, which
+    the agent cannot enter."""
+    sb, _acl, owned = tooled
+    h = await sb.create(SandboxSpec())
+    ident = sb._identities[h.id]
+    _argv, _cwd, env = sb._exec_argv(h, ["true"], as_tool="erp")
+    tmp = sb._require(h) / ".tool-home" / "tmp"
+    assert env["TMPDIR"] == str(tmp)
+    assert tmp.is_dir()
+    assert (tmp, ident.tool_uid) in owned
+    # The agent's own commands keep the workspace, as before.
+    _argv, cwd, env = sb._exec_argv(h, ["true"])
+    assert env["TMPDIR"] == str(cwd)
+
+
+async def test_an_ordinary_command_keeps_the_sandbox_identity(tooled):
+    sb, _acl, _owned = tooled
+    h = await sb.create(SandboxSpec())
+    ident = sb._identities[h.id]
+    argv, _cwd, env = sb._exec_argv(h, ["true"])
+    assert f"--reuid={ident.uid}" in argv
+    assert "--clear-groups" in argv
+    assert not any(a.startswith("--groups") for a in argv)
+    assert env["HOME"] == str(sb._require(h) / ".home")
+    assert "PYTHONNOUSERSITE" not in env
+
+
+async def test_the_tool_identity_owns_its_home_on_every_tool_exec(tooled):
+    """Same shape as `.home`: re-established per exec, so a home the exec path
+    had to recreate is never handed to the tool owned by this service."""
+    sb, _acl, owned = tooled
+    h = await sb.create(SandboxSpec())
+    ident = sb._identities[h.id]
+    owned.clear()
+    sb._exec_argv(h, ["true"], as_tool="erp")
+    assert (sb._require(h) / ".tool-home", ident.tool_uid) in owned
+
+
+async def test_kill_returns_both_uids_to_the_pool(tooled, monkeypatch):
+    sb, _acl, _owned = tooled
+    # Freed uids come back in a different order, so the second sandbox may get
+    # the uid that is not the caller's — `_provision`'s raw chown would then need
+    # root. Ownership is not what this test is about.
+    monkeypatch.setattr(os, "chown", lambda *a, **k: None)
+    h = await sb.create(SandboxSpec())
+    await sb.kill(h)
+    # A pool of exactly two: a leaked tool uid makes this create raise.
+    h2 = await sb.create(SandboxSpec())
+    ident = sb._identities[h2.id]
+    assert {ident.uid, ident.tool_uid} == {os.getuid(), os.getuid() - 1}
+
+
+async def test_the_callers_env_cannot_move_a_tools_home(tooled, monkeypatch):
+    """The caller's variables win over the exec path's own — except the names
+    that define the tool identity's environment. A `HOME` the agent can write is
+    a user site the tool would import from."""
+    sb, _acl, _owned = tooled
+    h = await sb.create(SandboxSpec())
+    seen: dict[str, str] = {}
+
+    async def fake_spawn(*_argv, env, **_kw):
+        seen.update(env)
+        raise FileNotFoundError
+
+    monkeypatch.setattr(asyncio, "create_subprocess_exec", fake_spawn)
+    # No tool is mounted in this fixture; what a tool exec may be is pinned
+    # in test_as_tool_is_enforced_here.py. This test is about HOME only.
+    monkeypatch.setattr(sb, "_refuse_tool_exec", lambda *_a: None)
+    await sb.exec(
+        h,
+        ["../.tools/erp/launch", "q", "{}"],
+        env={"HOME": "/root/evil", "SANDBOX_HOME": "/root/evil", "PYTHONNOUSERSITE": "0"},
+        tool="erp",
+    )
+    tool_home = str(sb._require(h) / ".tool-home")
+    assert seen["HOME"] == tool_home
+    assert seen["SANDBOX_HOME"] == tool_home
+    assert seen["PYTHONNOUSERSITE"] == "1"
+
+
+async def test_an_ordinary_commands_env_still_wins(tooled, monkeypatch):
+    """The pin is for tool commands only: the agent's own `exec` keeps the
+    precedence it always had."""
+    sb, _acl, _owned = tooled
+    h = await sb.create(SandboxSpec())
+    seen: dict[str, str] = {}
+
+    async def fake_spawn(*_argv, env, **_kw):
+        seen.update(env)
+        raise FileNotFoundError
+
+    monkeypatch.setattr(asyncio, "create_subprocess_exec", fake_spawn)
+    await sb.exec(h, ["true"], env={"HOME": "/elsewhere"})
+    assert seen["HOME"] == "/elsewhere"
+
+
+async def test_without_a_tool_group_a_tool_command_runs_as_the_sandbox(tmp_path, caplog):
+    """A host built without a tool group cannot separate the two; it says so once,
+    at construction, rather than pretending."""
+    with caplog.at_level(logging.WARNING):
+        sb = IsolatedProcessSandbox(
+            root_dir=tmp_path / "sb",
+            cgroup_root=tmp_path / "cg",
+            uid_min=os.getuid(),
+            uid_max=os.getuid(),
+            acl_runner=lambda argv: None,
+            chown_runner=lambda p, u: None,
+        )
+    assert "third-party tools run as the sandbox's own uid" in caplog.text
+    h = await sb.create(SandboxSpec())
+    assert sb._identities[h.id].tool_uid is None
+    argv, _cwd, _env = sb._exec_argv(h, ["true"], as_tool="erp")
+    assert f"--reuid={os.getuid()}" in argv
+    assert "--clear-groups" in argv
+
+
+async def test_a_failed_create_gives_back_every_uid_and_leaves_no_dir(tmp_path, monkeypatch):
+    """Review round 1: a pool with room for the sandbox uid but not the tool's
+    raised after taking the first one, which was then never freed."""
+    sb = IsolatedProcessSandbox(
+        root_dir=tmp_path / "sb",
+        cgroup_root=tmp_path / "cg",
+        uid_min=os.getuid(),
+        uid_max=os.getuid(),
+        tool_gid=TOOL_GID,
+        acl_runner=lambda argv: None,
+        chown_runner=lambda p, u: None,
+    )
+    with pytest.raises(RuntimeError, match="exhausted"):
+        await sb.create(SandboxSpec())
+    assert sb._pool._used == set()
+    assert list((tmp_path / "sb").iterdir()) == []
+
+
+async def test_a_create_that_fails_later_gives_its_uids_back_too(tooled, monkeypatch):
+    sb, _acl, _owned = tooled
+
+    def boom(*_a, **_k):
+        raise OSError("setfacl failed")
+
+    monkeypatch.setattr(sb, "_provision", boom)
+    with pytest.raises(OSError):
+        await sb.create(SandboxSpec())
+    assert sb._pool._used == set()
+
+
+def _record_around(sb, monkeypatch):
+    """Record, in order, the per-call widenings, any root walk, and the spawn."""
+    order: list[str] = []
+    monkeypatch.setattr(
+        sb, "_run_as", lambda uid, argv: order.append(f"as {uid}: {' '.join(argv[:3])}")
+    )
+    monkeypatch.setattr(sb, "_acl_runner", lambda argv: order.append("ROOT setfacl"))
+    monkeypatch.setattr(sb, "_chown_runner", lambda path, uid: order.append("ROOT chown"))
+
+    async def fake_spawn(*_argv, **_kw):
+        order.append("run")
+        raise FileNotFoundError
+
+    monkeypatch.setattr(asyncio, "create_subprocess_exec", fake_spawn)
+    return order
+
+
+async def test_around_a_tool_call_each_identity_opens_its_own_files_to_the_other(
+    tooled, monkeypatch
+):
+    """Review round 1 (regression, reproduced as root): a mode set after creation
+    shrinks a file's ACL mask, so the tool could not write where the agent had
+    unpacked an archive, and the agent could not read the tool's 0600 file.
+
+    Review round 2 (reproduced as root): fixing that with a ROOT `setfacl -R` or
+    `chown` walk over the workspace lets a process the agent left running swap a
+    file for a symlink mid-walk and have root grant it any file on the host. So
+    each identity widens ITS OWN files' group class (`chmod g+rwX` sets the mask
+    on a file that has an ACL), as itself: the sandbox uid before the call, the
+    tool uid after. A race can then only make a uid change what it already owns."""
+    sb, _acl, _owned = tooled
+    h = await sb.create(SandboxSpec())
+    ident = sb._identities[h.id]
+    order = _record_around(sb, monkeypatch)
+    monkeypatch.setattr(sb, "_refuse_tool_exec", lambda *_a: None)
+
+    await sb.exec(h, ["../.tools/erp/launch", "q", "{}"], tool="erp")
+
+    assert order == [
+        f"as {ident.uid}: find {sb._workspace(h)} (",
+        "run",
+        f"as {ident.tool_uid}: find {sb._workspace(h)} -user",
+    ]
+
+
+async def test_no_root_walk_happens_around_a_tool_call(tooled, monkeypatch):
+    sb, _acl, _owned = tooled
+    h = await sb.create(SandboxSpec())
+    order = _record_around(sb, monkeypatch)
+    monkeypatch.setattr(sb, "_refuse_tool_exec", lambda *_a: None)
+    await sb.exec(h, ["../.tools/erp/launch", "q", "{}"], tool="erp")
+    assert not [o for o in order if o.startswith("ROOT")]
+
+
+async def test_the_widening_runs_on_the_workspace_and_nowhere_else(tooled, monkeypatch):
+    sb, _acl, _owned = tooled
+    h = await sb.create(SandboxSpec())
+    seen: list[list[str]] = []
+    monkeypatch.setattr(sb, "_run_as", lambda uid, argv: seen.append(argv))
+    monkeypatch.setattr(sb, "_refuse_tool_exec", lambda *_a: None)
+
+    async def fake_spawn(*_argv, **_kw):
+        raise FileNotFoundError
+
+    monkeypatch.setattr(asyncio, "create_subprocess_exec", fake_spawn)
+    await sb.exec(h, ["../.tools/erp/launch", "q", "{}"], tool="erp")
+    ws = str(sb._workspace(h))
+    ident = sb._identities[h.id]
+    # Before: the agent's directories, and the files its group can already read
+    # (644 -> 664) — so the tool can create where the agent unpacked and edit
+    # what it could edit before; a file the agent made 600 (an SSH key) stays
+    # 600, as it chose (review round 2, M1). After: the tool's OWN files only.
+    assert seen == [
+        [
+            "find",
+            ws,
+            "(",
+            "-type",
+            "d",
+            "-o",
+            "-perm",
+            "-g+r",
+            ")",
+            "-exec",
+            "chmod",
+            "g+rwX",
+            "{}",
+            "+",
+        ],
+        ["find", ws, "-user", str(ident.tool_uid), "-exec", "chmod", "g+rwX", "{}", "+"],
+    ]
+
+
+async def test_a_refused_tool_call_touches_nothing(tooled, monkeypatch):
+    """Not a walk of the workspace for every request the agent sends itself."""
+    sb, _acl, _owned = tooled
+    h = await sb.create(SandboxSpec())
+    order = _record_around(sb, monkeypatch)
+    result = await sb.exec(h, ["sh", "-c", "id"], tool="erp")
+    assert result.exit_code == 126
+    assert order == []
+
+
+async def test_the_agents_own_command_walks_nothing(tooled, monkeypatch):
+    sb, _acl, _owned = tooled
+    h = await sb.create(SandboxSpec())
+    order = _record_around(sb, monkeypatch)
+    await sb.exec(h, ["true"])
+    assert order == ["run"]
+
+
+async def test_reown_after_a_restore_is_chown_only_as_it_was(tooled, monkeypatch):
+    """Round 2 removed the ACL re-apply round 1 added to `reown`: a restore keeps
+    the archived 770/660 modes (verified as root in round 1), so it bought
+    nothing — and it was one more root `setfacl -R` over an agent's tree."""
+    sb, acl, _owned = tooled
+    h = await sb.create(SandboxSpec())
+    acl.clear()
+    await sb.reown(h)
+    assert acl == []
+
+
+async def test_a_tool_command_points_at_nothing_the_agent_fills(tooled):
+    """Review rounds 1 and 3: the sandbox's PATH starts with a `python` shim that
+    can route to the project venv the agent fills, and these names point a
+    program at that venv, uv's cache or the shim's dir."""
+    from sandbox_host.local_process import _TOOL_PATH
+
+    sb, _acl, _owned = tooled
+    h = await sb.create(SandboxSpec())
+    _argv, _cwd, env = sb._exec_argv(h, ["true"], as_tool="erp")
+    assert env["PATH"] == _TOOL_PATH
+    for name in ("VIRTUAL_ENV", "UV_PROJECT_ENVIRONMENT", "UV_CACHE_DIR", "SANDBOX_JAILBIN"):
+        assert name not in env, name
diff --git a/sandbox-host/tests/test_tool_identity_integration.py b/sandbox-host/tests/test_tool_identity_integration.py
new file mode 100644
index 000000000..39d09d64c
--- /dev/null
+++ b/sandbox-host/tests/test_tool_identity_integration.py
@@ -0,0 +1,285 @@
+"""The tool identity, L3: REAL privilege separation (docs/plan-tool-identity-
+secrets.md P1). The unit tests assert the argv; these prove the kernel agrees.
+
+Needs root + `setpriv` + `setfacl`, so it is `integration`-tagged and skipped
+everywhere else (same arrangement as `test_isolated_process_integration.py`).
+"""
+
+from __future__ import annotations
+
+import io
+import os
+import shutil
+import tarfile
+
+import pytest
+
+from sandbox_host.isolated_process import IsolatedProcessSandbox
+from sandbox_host.protocol import SandboxSpec
+from sandbox_host.tool_cache import BUILTIN_DIR, EXT_DIR, ToolCache, _GroupHardener
+
+pytestmark = pytest.mark.integration
+
+_CAN_ISOLATE = os.getuid() == 0 and bool(shutil.which("setpriv")) and bool(shutil.which("setfacl"))
+requires_isolation = pytest.mark.skipif(not _CAN_ISOLATE, reason="needs root + setpriv + setfacl")
+
+TOOL_GID = 100000
+
+
+@pytest.fixture(autouse=True)
+def _traversable(tmp_path):
+    """pytest makes its temp dirs 0700 root, so no dropped uid could follow the
+    `/.tools` symlink chain (it resolves to an absolute path under here). In
+    production that chain is traversable — every sandbox runs
+    `../.tools/python-stack/launch` through it — so open the ancestors the same
+    way. Root-only tests, run in a throwaway environment."""
+    for node in [tmp_path, *tmp_path.parents]:
+        if node == node.parent:
+            break
+        node.chmod(node.stat().st_mode | 0o755)
+
+
+#: A test bundle whose launcher runs its arguments as a shell script — the
+#: author's own code, standing in for a real tool. Round 1 made the host accept
+#: a `tool` exec only in a tool call's shape, so every probe here goes
+#: through `launch <command> <args>`, as a real call does.
+_SCRIPTED = b'#!/bin/sh\nexec sh -c "$2"\n'
+
+
+@pytest.fixture
+def isolated(tmp_path):
+    tools = tmp_path / "scripted-tools"
+    sha = "b" * 64
+    buf = io.BytesIO()
+    with tarfile.open(fileobj=buf, mode="w:gz") as tar:
+        info = tarfile.TarInfo("launch")
+        info.size = len(_SCRIPTED)
+        info.mode = 0o755
+        tar.addfile(info, io.BytesIO(_SCRIPTED))
+    ToolCache(tools / EXT_DIR, harden=_GroupHardener(TOOL_GID)).ensure(sha, buf.getvalue())
+    sb = IsolatedProcessSandbox(
+        root_dir=tmp_path / "sb",
+        cgroup_root=tmp_path / "cg",
+        tool_gid=TOOL_GID,
+        uid_min=100001,
+        uid_max=100010,
+        memory_max="128M",
+        cpu_cores=1.0,
+        pids_max=128,
+        tools_dir=tools,
+    )
+    sb.mounts = {"erp": sha}  # ty: ignore[unresolved-attribute]
+    return sb
+
+
+async def _tool(sb, h, script: str, **kw):
+    return await sb.exec(h, ["../.tools/erp/launch", "run", script], tool="erp", **kw)
+
+
+@requires_isolation
+async def test_a_tool_command_runs_as_the_tool_uid_holding_the_tool_group(isolated):
+    h = await isolated.create(SandboxSpec(tools=isolated.mounts))
+    ident = isolated._identities[h.id]
+    result = await _tool(isolated, h, "id -u; id -G")
+    assert result.exit_code == 0, result.stderr
+    uid, groups = result.stdout.decode().split("\n")[:2]
+    assert uid == str(ident.tool_uid)
+    assert str(TOOL_GID) in groups.split()
+    # …and the agent's own command holds neither.
+    mine = await isolated.exec(h, ["sh", "-c", "id -u; id -G"])
+    uid, groups = mine.stdout.decode().split("\n")[:2]
+    assert uid == str(ident.uid)
+    assert str(TOOL_GID) not in groups.split()
+
+
+@requires_isolation
+async def test_a_tool_process_joins_the_items_cgroup(isolated):
+    """The tool identity changes WHO runs, not WHERE: the process the tool's code
+    runs in is the one written into the item's `cgroup.procs` — so the item's
+    limits apply to it and its owner is billed for it. (The wrapper's shell
+    writes its own pid, then execs down to the tool; the pid survives each exec.)"""
+    h = await isolated.create(SandboxSpec(tools=isolated.mounts))
+    ident = isolated._identities[h.id]
+    result = await _tool(isolated, h, "echo $$")
+    assert result.exit_code == 0, result.stderr
+    pid = result.stdout.strip().decode()
+    assert pid.isdigit(), result.stdout
+    assert (ident.cgroup / "cgroup.procs").read_text().split()[-1] == pid
+
+
+@requires_isolation
+async def test_each_identity_can_edit_and_delete_what_the_other_wrote(isolated):
+    h = await isolated.create(SandboxSpec(tools=isolated.mounts))
+    tool = await _tool(isolated, h, "mkdir -p out && echo t > out/report.txt")
+    assert tool.exit_code == 0, tool.stderr
+    agent = await isolated.exec(
+        h, ["sh", "-c", "echo a >> out/report.txt && echo a > mine.txt && rm out/report.txt"]
+    )
+    assert agent.exit_code == 0, agent.stderr
+    back = await _tool(isolated, h, "echo t >> mine.txt && cat mine.txt")
+    assert back.exit_code == 0, back.stderr
+    assert back.stdout == b"a\nt\n"
+
+
+@requires_isolation
+async def test_the_agent_cannot_read_a_running_tools_environment(isolated):
+    """The reason for a second uid at all: `/proc/<pid>/environ` answers only to
+    the same uid (or root), and a tool's credentials live there while it runs."""
+    h = await isolated.create(SandboxSpec(tools=isolated.mounts))
+    started = await _tool(
+        isolated,
+        h,
+        "sleep 20 >/dev/null 2>&1 & echo $!",
+        env={"MACHINE_PASSWORD": "hunter2"},
+    )
+    assert started.exit_code == 0, started.stderr
+    pid = started.stdout.strip().decode()
+    assert pid.isdigit(), started.stdout
+    try:
+        peek = await isolated.exec(h, ["cat", f"/proc/{pid}/environ"])
+        assert peek.exit_code != 0
+        assert b"hunter2" not in peek.stdout
+    finally:
+        await isolated.kill(h)
+
+
+@requires_isolation
+async def test_a_tools_temp_file_never_reaches_the_agent(isolated):
+    """Review round 3 (reproduced as root): a tool's temp file used to sit in the
+    workspace. It is under the tool's own HOME now, which the agent cannot enter
+    — during the call or after it."""
+    h = await isolated.create(SandboxSpec(tools=isolated.mounts))
+    tool = await _tool(isolated, h, 't=$(mktemp); echo s3cret > "$t"; echo "$t"')
+    assert tool.exit_code == 0, tool.stderr
+    path = tool.stdout.strip().decode()
+    assert "/.tool-home/tmp/" in path, path
+    peek = await isolated.exec(h, ["sh", "-c", f"cat {path}; grep -r s3cret . 2>/dev/null"])
+    assert b"s3cret" not in peek.stdout
+
+
+@requires_isolation
+async def test_the_agent_cannot_write_the_tools_home(isolated):
+    h = await isolated.create(SandboxSpec(tools=isolated.mounts))
+    tool_home = isolated._require(h) / ".tool-home"
+    result = await isolated.exec(h, ["sh", "-c", f"mkdir -p {tool_home}/.local/x"])
+    assert result.exit_code != 0
+
+
+def _bundle() -> bytes:
+    buf = io.BytesIO()
+    with tarfile.open(fileobj=buf, mode="w:gz") as tar:
+        for name, body, mode in (
+            ("launch", b"#!/bin/sh\necho ran-as-$(id -u)\n", 0o755),
+            ("creds.py", b"PASSWORD = 'hunter2'\n", 0o644),
+        ):
+            info = tarfile.TarInfo(name)
+            info.size = len(body)
+            info.mode = mode
+            tar.addfile(info, io.BytesIO(body))
+    return buf.getvalue()
+
+
+@pytest.fixture
+def with_tools(tmp_path):
+    """P2: a host whose third-party store is hardened for the tool group, plus
+    one first-party tool baked in the way the image ships them."""
+    tools = tmp_path / "tools"
+    sha = "e" * 64
+    ToolCache(tools / EXT_DIR, harden=_GroupHardener(TOOL_GID)).ensure(sha, _bundle())
+    builtin = tools / BUILTIN_DIR / "sci-plot"
+    builtin.mkdir(parents=True)
+    (builtin / "README").write_text("first-party\n")
+    tools.chmod(0o755)
+    (tools / BUILTIN_DIR).chmod(0o755)
+    builtin.chmod(0o755)
+    (builtin / "README").chmod(0o644)
+    sb = IsolatedProcessSandbox(
+        root_dir=tmp_path / "sb",
+        cgroup_root=tmp_path / "cg",
+        tool_gid=TOOL_GID,
+        uid_min=100001,
+        uid_max=100010,
+        tools_dir=tools,
+    )
+    return sb, {"erp": sha}
+
+
+@requires_isolation
+async def test_the_agent_can_neither_read_nor_run_a_third_party_tool(with_tools):
+    sb, mounts = with_tools
+    h = await sb.create(SandboxSpec(tools=mounts))
+    read = await sb.exec(h, ["cat", "../.tools/erp/creds.py"])
+    assert read.exit_code != 0
+    assert b"hunter2" not in read.stdout
+    run = await sb.exec(h, ["../.tools/erp/launch"])
+    assert run.exit_code != 0
+
+
+@requires_isolation
+async def test_the_tool_identity_runs_it(with_tools):
+    sb, mounts = with_tools
+    h = await sb.create(SandboxSpec(tools=mounts))
+    ident = sb._identities[h.id]
+    result = await sb.exec(h, ["../.tools/erp/launch", "q", "{}"], tool="erp")
+    assert result.exit_code == 0, result.stderr
+    assert result.stdout.strip() == f"ran-as-{ident.tool_uid}".encode()
+
+
+@requires_isolation
+async def test_a_first_party_tool_stays_readable_by_the_agent(with_tools):
+    sb, mounts = with_tools
+    h = await sb.create(SandboxSpec(tools=mounts))
+    result = await sb.exec(h, ["cat", "../.tools/sci-plot/README"])
+    assert result.exit_code == 0, result.stderr
+
+
+_WRITER = (
+    b"#!/bin/sh\nset -e\n"
+    b"echo out > data/out.csv\n"  # create in a 755 dir the agent made
+    b"echo x >> data/in.csv\n"  # write a 644 file the agent made
+    b"if cat data/secret 2>/dev/null; then exit 9; fi\n"  # a 600 file stays private
+    b"umask 077; echo result > atomic.tmp; mv atomic.tmp atomic.csv\n"  # 0600 atomic write
+)
+
+
+@requires_isolation
+async def test_modes_set_after_creation_do_not_lock_either_identity_out(tmp_path):
+    """Review rounds 1-2 (reproduced as root): modes set after creation shrink the
+    ACL mask. Around each tool call each identity widens its own files as itself
+    — so the tool works in what the agent unpacked, and the agent can read, edit
+    and delete what the tool wrote."""
+    tools = tmp_path / "tools"
+    sha = "c" * 64
+    buf = io.BytesIO()
+    with tarfile.open(fileobj=buf, mode="w:gz") as tar:
+        info = tarfile.TarInfo("launch")
+        info.size = len(_WRITER)
+        info.mode = 0o755
+        tar.addfile(info, io.BytesIO(_WRITER))
+    ToolCache(tools / EXT_DIR, harden=_GroupHardener(TOOL_GID)).ensure(sha, buf.getvalue())
+    sb = IsolatedProcessSandbox(
+        root_dir=tmp_path / "sb",
+        cgroup_root=tmp_path / "cg",
+        tool_gid=TOOL_GID,
+        uid_min=100001,
+        uid_max=100010,
+        tools_dir=tools,
+    )
+    h = await sb.create(SandboxSpec(tools={"erp": sha}))
+    setup = await sb.exec(
+        h,
+        [
+            "sh",
+            "-c",
+            "mkdir data && echo in > data/in.csv && echo s > data/secret "
+            "&& chmod 755 data && chmod 644 data/in.csv && chmod 600 data/secret",
+        ],
+    )
+    assert setup.exit_code == 0, setup.stderr
+    tool = await sb.exec(h, ["../.tools/erp/launch", "q", "{}"], tool="erp")
+    assert tool.exit_code == 0, tool.stderr
+    agent = await sb.exec(
+        h, ["sh", "-c", "cat atomic.csv && echo more >> atomic.csv && rm atomic.csv"]
+    )
+    assert agent.exit_code == 0, agent.stderr
+    assert agent.stdout == b"result\n"
diff --git a/sandbox-host/tests/test_tool_identity_wire.py b/sandbox-host/tests/test_tool_identity_wire.py
new file mode 100644
index 000000000..1d3fe1b69
--- /dev/null
+++ b/sandbox-host/tests/test_tool_identity_wire.py
@@ -0,0 +1,81 @@
+"""The host's half of `tool` (docs/plan-tool-identity-secrets.md P1): the
+`/exec` body carries which third-party tool a command launches, and the host
+hands it to the backend that decides the identity. The app's half is
+`tests/sandbox/test_http.py`.
+
+Asserted on both halves for the reason `exec_timeout` is: a host that parsed the
+key and dropped it would run every third-party tool as the sandbox uid, which
+looks exactly like working.
+"""
+
+from __future__ import annotations
+
+import httpx
+from httpx import ASGITransport
+
+from sandbox_host.app import make_host_app
+from sandbox_host.config import SandboxHostSettings
+from sandbox_host.mock import MockSandbox
+from sandbox_host.service import build_sandbox
+
+_ADVERTISE = "http://sandbox-host-pod:8000"
+
+
+async def _exec(body: dict[str, object]) -> MockSandbox:
+    backend = MockSandbox()
+    app = make_host_app(backend, advertise_url=_ADVERTISE)
+    async with httpx.AsyncClient(transport=ASGITransport(app=app), base_url="http://h") as client:
+        rid = (await client.post("/sandboxes", json={})).json()["remote_id"]
+        async with client.stream("POST", f"/sandboxes/{rid}/exec", json=body) as resp:
+            assert resp.status_code == 200
+            async for _ in resp.aiter_lines():
+                pass
+    return backend
+
+
+async def test_exec_hands_the_tool_name_to_the_backend():
+    backend = await _exec({"cmd": ["../.tools/erp/launch", "q", "{}"], "tool": "erp"})
+    assert backend.exec_tools[-1] == "erp"
+
+
+async def test_exec_from_an_older_client_runs_as_the_sandbox():
+    backend = await _exec({"cmd": ["true"]})
+    assert backend.exec_tools[-1] is False
+
+
+async def test_healthz_says_this_host_runs_tools_as_their_own_identity():
+    app = make_host_app(MockSandbox(), advertise_url=_ADVERTISE)
+    async with httpx.AsyncClient(transport=ASGITransport(app=app), base_url="http://h") as client:
+        body = (await client.get("/healthz")).json()
+    assert "tool-identity" in body["capabilities"]
+
+
+def test_the_production_host_reserves_the_pools_first_id_as_the_tool_group(tmp_path):
+    """The tool group is a number the operator already set aside — the bottom of
+    the sandbox uid range — so it needs no setting and can collide with nothing
+    on the host. The pool starts one above it, so no sandbox ever holds it."""
+    hs = SandboxHostSettings(
+        uid_min=200000, uid_max=200003, cgroup_root=str(tmp_path / "cg"), root=str(tmp_path)
+    )
+    sb = build_sandbox(hs)
+    assert sb._tool_gid == 200000
+    handed_out = {sb._pool.alloc()[0] for _ in range(3)}
+    assert handed_out == {200001, 200002, 200003}
+    # …and nothing else: the group id is never in the pool, so no sandbox's
+    # primary gid can be the one that reads every third-party bundle.
+    import pytest
+
+    with pytest.raises(RuntimeError, match="exhausted"):
+        sb._pool.alloc()
+
+
+def test_a_pool_too_small_for_one_sandbox_stops_the_host(tmp_path):
+    """Review round 1: the bottom id is the tool group and each sandbox takes
+    two uids, so MIN..MIN+1 — which used to run one sandbox — now runs none.
+    Refused at startup, where the operator is looking, rather than at the first
+    create."""
+    import pytest
+
+    hs = SandboxHostSettings(uid_min=200000, uid_max=200001, cgroup_root=str(tmp_path / "cg"))
+    with pytest.raises(ValueError, match="SANDBOX_HOST_UID_MIN"):
+        build_sandbox(hs)
diff --git a/sandbox-host/tests/test_tool_output.py b/sandbox-host/tests/test_tool_output.py
new file mode 100644
index 000000000..3bd23091f
--- /dev/null
+++ b/sandbox-host/tests/test_tool_output.py
@@ -0,0 +1,327 @@
+"""What a third-party tool prints is filtered before anyone sees it
+(docs/plan-tool-identity-secrets.md P3).
+
+Two rules, both applied where the output enters the platform — the host's exec
+pump — so the live stream, the tool card and the text the agent reads are one:
+
+- a Python traceback loses its SOURCE lines (the code under each `File …` and
+  the `^^^` markers), keeping the frames and the exception, unless the item's
+  `TOOL_DEBUG` lists the tool;
+- a credential the platform handed the tool is replaced by `***`, always.
+"""
+
+from __future__ import annotations
+
+import sys
+
+import pytest
+
+from sandbox_host.local_process import LocalProcessSandbox
+from sandbox_host.protocol import SandboxSpec
+from sandbox_host.tool_cache import EXT_DIR, ToolCache
+from sandbox_host.tool_output import ToolOutputFilter
+
+from .test_tool_secrets_host import _bundle
+
+TB = (
+    b"Traceback (most recent call last):\n"
+    b'  File "/x/.venv/bin/erp", line 8, in <module>\n'
+    b"    sys.exit(main())\n"
+    b"             ^^^^^^\n"
+    b'  File "/x/erp/cli.py", line 12, in main\n'
+    b"    conn = connect(user='svc', password=PASSWORD)\n"
+    b"ValueError: machine refused the login\n"
+)
+
+
+def _run(f: ToolOutputFilter, data: bytes, step: int | None = None) -> bytes:
+    if step is None:
+        return f.feed(data) + f.flush()
+    out = b"".join(f.feed(data[i : i + step]) for i in range(0, len(data), step))
+    return out + f.flush()
+
+
+def test_a_traceback_keeps_its_frames_and_exception_but_not_its_source():
+    out = _run(ToolOutputFilter(tool="erp", hide_source=True), TB)
+    assert b'File "/x/erp/cli.py", line 12, in main' in out
+    assert b"ValueError: machine refused the login" in out
+    assert b"password=PASSWORD" not in out
+    assert b"sys.exit(main())" not in out
+    assert b"^^^^^^" not in out
+
+
+def test_hidden_source_is_said_without_naming_how_to_unhide_it():
+    """The agent reads this line. Naming the variable that unhides source is an
+    invitation to ask the user for it (review round 1); the docs say how."""
+    out = _run(ToolOutputFilter(tool="erp", hide_source=True), TB)
+    assert b"source lines" in out and b"hidden" in out
+    assert b"TOOL_DEBUG" not in out
+
+
+# Captured from CPython 3.12 — the formats are Python's, not ours to invent.
+_GROUP = (
+    b"  + Exception Group Traceback (most recent call last):\n"
+    b'  |   File "/w/eg.py", line 8, in <module>\n'
+    b"  |     g()\n"
+    b'  |   File "/w/eg.py", line 4, in g\n'
+    b'  |     raise ExceptionGroup("grp", [ValueError("x")])  # SECRET-G\n'
+    b"  |     ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n"
+    b"  | ExceptionGroup: grp (1 sub-exception)\n"
+    b"  +-+---------------- 1 ----------------\n"
+    b"    | Traceback (most recent call last):\n"
+    b'    |   File "/w/eg.py", line 2, in f\n'
+    b'    |     raise ValueError("x")  # SECRET-F\n'
+    b"    | ValueError: x\n"
+    b"    +------------------------------------\n"
+)
+_WARNING = b'/w/w.py:2: UserWarning: careful\n  warnings.warn("careful")  # SECRET-W\n'
+_SYNTAX = (
+    b'  File "/w/s.py", line 1\n'
+    b"    x = (1 +  # SECRET-S\n"
+    b"        ^\n"
+    b"SyntaxError: '(' was never closed\n"
+)
+
+
+def test_an_exception_group_loses_its_source_lines():
+    out = _run(ToolOutputFilter(tool="erp", hide_source=True), _GROUP)
+    assert b"SECRET" not in out
+    assert b'File "/w/eg.py", line 4, in g' in out
+    assert b"ExceptionGroup: grp (1 sub-exception)" in out
+    assert b"ValueError: x" in out
+
+
+def test_a_warning_loses_the_source_line_it_quotes():
+    out = _run(ToolOutputFilter(tool="erp", hide_source=True), _WARNING)
+    assert b"SECRET" not in out
+    assert b"UserWarning: careful" in out
+
+
+def test_a_syntax_error_loses_its_source_line():
+    out = _run(ToolOutputFilter(tool="erp", hide_source=True), _SYNTAX)
+    assert b"SECRET" not in out
+    assert b"SyntaxError: '(' was never closed" in out
+
+
+def test_a_warning_hides_only_the_one_line_python_quotes():
+    """Review round 2 (L1): Python prints one source line under a warning. The
+    tool's own indented lines after it are its output, not a quote."""
+    data = _WARNING + b"  data row 1\n  data row 2\n"
+    out = _run(ToolOutputFilter(tool="erp", hide_source=True), data)
+    assert b"SECRET" not in out
+    assert b"  data row 1\n  data row 2\n" in out
+
+
+def test_a_frame_at_column_zero_is_not_a_frame():
+    """Python always indents `File "…"` under its header; a tool printing a
+    log line that starts with it at column 0 is not a traceback."""
+    data = b'File "report.py", line 3 is where the totals are\n    | col | val |\n'
+    assert _run(ToolOutputFilter(tool="erp", hide_source=True), data) == data
+
+
+def test_a_blank_line_ends_a_quote():
+    data = b'  File "/w/x.py", line 1, in f\n\n    indented answer text\n'
+    out = _run(ToolOutputFilter(tool="erp", hide_source=True), data)
+    assert b"    indented answer text\n" in out
+
+
+def test_crlf_output_is_filtered_the_same():
+    out = _run(ToolOutputFilter(tool="erp", hide_source=True), TB.replace(b"\n", b"\r\n"))
+    assert b"password=PASSWORD" not in out
+    assert b"ValueError: machine refused the login" in out
+
+
+def test_tool_debug_keeps_every_format():
+    data = _GROUP + _WARNING + _SYNTAX
+    assert _run(ToolOutputFilter(tool="erp", hide_source=False), data) == data
+
+
+def test_a_multi_line_credential_is_masked_line_by_line():
+    """A private key or a service-account JSON is a typical CI variable; the
+    filter works per line, so each of its lines is masked on its own."""
+    pem = (
+        "-----BEGIN KEY-----\n"
+        "MIIBVgIBADANBgkqhkiG9w0BAQEF\n"
+        "AASCAUAwggE8AgEAAkEAq7BFUpkG\n"
+        "-----END KEY-----"
+    )
+    f = ToolOutputFilter(tool="erp", hide_source=False, secrets=[pem])
+    out = _run(f, (pem + "\n").encode())
+    assert b"MIIBVgIBADANBgkqhkiG9w0BAQEF" not in out
+    assert b"AASCAUAwggE8AgEAAkEAq7BFUpkG" not in out
+
+
+def test_a_stream_that_does_not_carry_the_hint_stays_parseable():
+    """Review round 1: a tool that logs a handled traceback to stdout and then
+    prints its JSON answer there must still print valid JSON — the hint goes on
+    stderr only."""
+    f = ToolOutputFilter(tool="erp", hide_source=True, hint=False)
+    out = _run(f, TB + b'{"ok": true}\n')
+    assert out.endswith(b'{"ok": true}\n')
+    assert b"hidden" not in out
+
+
+def test_tool_debug_keeps_the_source():
+    out = _run(ToolOutputFilter(tool="erp", hide_source=False), TB)
+    assert out == TB
+
+
+def test_a_chained_traceback_is_filtered_in_every_part():
+    chained = TB + b"\nDuring handling of the above exception, another exception occurred:\n\n" + TB
+    out = _run(ToolOutputFilter(tool="erp", hide_source=True), chained)
+    assert out.count(b"ValueError: machine refused the login") == 2
+    assert b"password=PASSWORD" not in out
+    assert b"During handling" in out
+
+
+def test_indented_output_outside_a_traceback_is_untouched():
+    """A tool printing pretty JSON is not a traceback."""
+    data = b'{\n    "lot": "A1",\n    "yield": 0.93\n}\n'
+    assert _run(ToolOutputFilter(tool="erp", hide_source=True), data) == data
+
+
+def test_a_credential_is_masked_wherever_it_appears():
+    f = ToolOutputFilter(tool="erp", hide_source=False, secrets=["hunter2"])
+    out = _run(f, b"login as svc / hunter2 ok\nretry hunter2\n")
+    assert out == b"login as svc / *** ok\nretry ***\n"
+
+
+@pytest.mark.parametrize("step", [1, 2, 3, 5])
+def test_a_credential_split_across_chunks_is_still_masked(step):
+    """The pump reads 4 KiB at a time and a credential can straddle two reads;
+    every split must give what one read gives."""
+    data = b"token=s3cr3t-value\n" + TB + b"tail s3cr3t-value"
+    whole = _run(ToolOutputFilter(tool="erp", hide_source=True, secrets=["s3cr3t-value"]), data)
+    split = _run(
+        ToolOutputFilter(tool="erp", hide_source=True, secrets=["s3cr3t-value"]), data, step
+    )
+    assert split == whole
+    assert b"s3cr3t-value" not in split
+
+
+def test_the_longest_credential_is_masked_first():
+    """`abc` inside `abcdef` must not leave `***def` behind."""
+    f = ToolOutputFilter(tool="erp", hide_source=False, secrets=["abc", "abcdef"])
+    assert _run(f, b"abcdef\n") == b"***\n"
+
+
+def test_a_long_line_with_no_end_is_not_held_forever():
+    """A progress line can run long; it streams in pieces rather than at exit,
+    still without ever releasing a partial credential."""
+    f = ToolOutputFilter(tool="erp", hide_source=False, secrets=["hunter2"])
+    body = b"x" * 200_000 + b"hunter2"
+    first = f.feed(body)
+    assert first, "some of a long line must stream before the command ends"
+    out = first + f.flush()
+    assert b"hunter2" not in out
+    assert out.endswith(b"***")
+
+
+def test_carriage_returns_end_a_line_too():
+    """Progress bars redraw with `\\r`; waiting for `\\n` would hold them to the end."""
+    f = ToolOutputFilter(tool="erp", hide_source=True)
+    assert f.feed(b"10%\r20%\r") == b"10%\r20%\r"
+
+
+# ── wired into the host's exec ───────────────────────────────────────────────
+
+_RAISE = (
+    "def main():\n"
+    "    secret_password = 'hunter2'\n"
+    "    raise ValueError('refused ' + secret_password)\n"
+    "main()\n"
+)
+#: The line a traceback of `_RAISE` prints under its frame — the one to hide.
+_SOURCE_LINE = b"raise ValueError('refused ' + secret_password)"
+
+
+@pytest.fixture
+async def sandbox(tmp_path):
+    """A real file, not `python -c`: a `-c` traceback has no source lines at
+    all, so a test of hiding them would pass on unfiltered output."""
+    tools = tmp_path / "tools"
+    sha = "e" * 64
+    ToolCache(tools / EXT_DIR, harden=lambda _p: None).ensure(sha, _bundle(None))
+    sb = LocalProcessSandbox(root_dir=tmp_path / "sb", isolate=False, tools_dir=tools)
+    handle = await sb.create(SandboxSpec(tools={"erp": sha}))
+    await sb.upload(handle, _RAISE.encode(), "boom.py")
+    return sb, handle
+
+
+#: A tool call that runs `boom.py` through the mounted launcher — the only
+#: shape a `tool` exec may take.
+_BOOM = ["../.tools/erp/launch", "run", "import runpy; runpy.run_path('boom.py')"]
+
+
+async def test_a_tool_commands_traceback_reaches_nobody_with_its_source(sandbox):
+    sb, h = sandbox
+    live: list[bytes] = []
+    result = await sb.exec(h, _BOOM, on_output=live.append, tool="erp")
+    assert result.exit_code != 0
+    assert b"ValueError" in result.stderr
+    assert _SOURCE_LINE not in result.stderr
+    assert _SOURCE_LINE not in b"".join(live)
+
+
+async def test_tool_debug_lists_the_tool_and_its_source_comes_back(sandbox):
+    sb, h = sandbox
+    result = await sb.exec(h, _BOOM, env={"TOOL_DEBUG": "other, erp"}, tool="erp")
+    assert _SOURCE_LINE in result.stderr
+
+
+async def test_the_agents_own_command_is_not_filtered(sandbox):
+    sb, h = sandbox
+    result = await sb.exec(h, [sys.executable, "boom.py"])
+    assert _SOURCE_LINE in result.stderr
+
+
+async def test_a_credential_the_platform_handed_the_tool_is_masked(sandbox, monkeypatch):
+    sb, h = sandbox
+    monkeypatch.setattr(sb, "_tool_secrets", lambda handle, tool: {"MACHINE_PASSWORD": "hunter2"})
+    live: list[bytes] = []
+    result = await sb.exec(
+        h,
+        ["../.tools/erp/launch", "run", "import os; print('pw', os.environ['MACHINE_PASSWORD'])"],
+        on_output=live.append,
+        env={"TOOL_DEBUG": "erp"},
+        tool="erp",
+    )
+    assert result.exit_code == 0, result.stderr
+    assert result.stdout == b"pw ***\n"
+    assert b"hunter2" not in b"".join(live)
+
+
+def test_a_credential_straddling_a_long_line_release_is_still_masked():
+    """The release keeps back the tail a credential could still be completed in;
+    without it the head of one split across that point would go out bare."""
+    f = ToolOutputFilter(tool="erp", hide_source=False, secrets=["hunter2"])
+    first = f.feed(b"x" * 70_000 + b"hunt")
+    out = first + f.feed(b"er2 done\n") + f.flush()
+    assert b"hunt" not in first
+    assert b"hunter2" not in out
+    assert out.endswith(b"*** done\n")
+
+
+async def test_a_last_line_without_a_newline_and_the_hint_reach_the_result(sandbox):
+    """What the filters still hold when the command ends is flushed into the
+    result — the final line, and (on stderr) the line saying source was hidden."""
+    sb, h = sandbox
+    tail = "import sys; sys.stdout.write('last'); import runpy; runpy.run_path('boom.py')"
+    result = await sb.exec(h, ["../.tools/erp/launch", "run", tail], tool="erp")
+    assert result.stdout == b"last"
+    assert result.stderr.endswith(b"source lines in this output are hidden]\n")
+
+
+async def test_a_tools_stdout_never_carries_the_hint(sandbox):
+    """Review round 1: a tool that logs a handled traceback to stdout and then
+    prints its JSON answer there must still print valid JSON."""
+    sb, h = sandbox
+    code = (
+        "import traceback, runpy\n"
+        "try:\n    runpy.run_path('boom.py')\n"
+        "except ValueError:\n    traceback.print_exc(file=__import__('sys').stdout)\n"
+        "print('{\"ok\": true}')"
+    )
+    result = await sb.exec(h, ["../.tools/erp/launch", "run", code], tool="erp")
+    assert result.stdout.endswith(b'{"ok": true}\n')
+    assert b"hidden" not in result.stdout
