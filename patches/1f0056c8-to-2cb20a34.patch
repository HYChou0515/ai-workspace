diff --git a/tests/tooling/test_secret_env_app.py b/tests/tooling/test_secret_env_app.py
new file mode 100644
index 000000000..5ccdf9aae
--- /dev/null
+++ b/tests/tooling/test_secret_env_app.py
@@ -0,0 +1,67 @@
+"""A name `env.json` marks secret is the tool's own credential, so the app never
+treats it as something a person fills in (docs/plan-tool-identity-secrets.md P4).
+
+The user decided: "這組帳密是工具這一方的，不該讓使用者知道，也不該要使用者去填".
+So it is not a field in the environment panel, and the card that asks a user to
+set a variable refuses it — even when the tool printed it while failing.
+"""
+
+from __future__ import annotations
+
+from dataclasses import replace
+
+from agents import RunContextWrapper
+
+from tests.agent.test_request_env import _ctx, _pkg
+from workspace_app.agent.env_request import ENV_REQUEST_MARKER, request_env_impl
+from workspace_app.tooling.external import _package
+from workspace_app.tooling.registry import EnvNeed
+
+_DESCRIBED = {
+    "commands": [{"name": "lot-status", "description": "d", "params_json_schema": {}}],
+    "env": [
+        {"name": "MACHINE_PASSWORD", "description": "", "required": None, "secret": True},
+        {"name": "ERP_BASE", "description": "site", "required": False},
+    ],
+}
+
+
+def test_a_secret_name_is_not_a_field_anyone_fills_in():
+    pkg = _package("erp", _DESCRIBED)
+    assert pkg.env_needs == (EnvNeed(name="ERP_BASE", description="site", required=False),)
+    assert pkg.secret_env == ("MACHINE_PASSWORD",)
+
+
+def test_a_tool_with_only_secret_names_still_says_it_declared_something():
+    """`()` is "the author looked, nothing for you to set" — not `None`, which
+    is "nobody said", and which the panel words differently."""
+    described = {**_DESCRIBED, "env": [_DESCRIBED["env"][0]]}
+    assert _package("erp", described).env_needs == ()
+
+
+async def test_the_card_refuses_a_secret_name_even_when_the_tool_printed_it():
+    pkg = replace(_pkg("erp", "lot-status", third_party=True), secret_env=("MACHINE_PASSWORD",))
+    actx = _ctx(pkg, outputs={"erp__lot-status": "error: MACHINE_PASSWORD is not set"})
+    reply = await request_env_impl(
+        RunContextWrapper(actx),
+        tool="erp__lot-status",
+        names=["MACHINE_PASSWORD"],
+        reason="needs a password",
+    )
+    assert ENV_REQUEST_MARKER not in reply
+    assert "cannot set" in reply
+    assert "platform team" in reply
+
+
+async def test_the_card_never_asks_for_tool_debug():
+    """Review round 1: TOOL_DEBUG is how a PERSON chooses to see a tool's source;
+    an agent asking for it would be the agent choosing to see it."""
+    pkg = _pkg("erp", "lot-status", third_party=True)
+    actx = _ctx(pkg, outputs={"erp__lot-status": "set TOOL_DEBUG=erp to see more"})
+    reply = await request_env_impl(
+        RunContextWrapper(actx),
+        tool="erp__lot-status",
+        names=["TOOL_DEBUG"],
+        reason="see the source",
+    )
+    assert ENV_REQUEST_MARKER not in reply
diff --git a/tests/tooling/test_tool_identity_dispatch.py b/tests/tooling/test_tool_identity_dispatch.py
new file mode 100644
index 000000000..4bba7d23d
--- /dev/null
+++ b/tests/tooling/test_tool_identity_dispatch.py
@@ -0,0 +1,126 @@
+"""A third-party tool is dispatched AS ITSELF (docs/plan-tool-identity-secrets.md
+P1): the platform names the tool on the exec, so a backend with a second identity
+runs it as that one. What that exec may contain — its argv, which of the user's
+names reach it — is the sandbox host's to enforce
+(`sandbox-host/tests/test_as_tool_is_enforced_here.py`), because its API can be
+called without this app.
+
+First-party tools, `python` and view plugins are out of scope and must behave
+exactly as before — so each assertion here has its first-party twin.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+import pytest
+from agents.tool_context import ToolContext
+from agents.usage import Usage
+
+from workspace_app.agent import AgentToolContext
+from workspace_app.sandbox.mock import MockSandbox
+from workspace_app.sandbox.protocol import SandboxSpec
+from workspace_app.tooling.registry import (
+    CommandInfo,
+    PackageInfo,
+    _to_function_tool,
+    _tool_env,
+    exec_package_command,
+)
+
+_CMD = CommandInfo(name="q", description="d", params_json_schema={})
+_THIRD = PackageInfo(name="erp", install_dir="../.tools/erp", commands=(), third_party=True)
+_FIRST = PackageInfo(name="sci-plot", install_dir="../.tools/sci-plot", commands=())
+
+
+async def _dispatch(pkg: PackageInfo, env_vars: dict[str, str] | None = None) -> MockSandbox:
+    sandbox = MockSandbox()
+    handle = await sandbox.create(SandboxSpec())
+    actx = AgentToolContext(
+        investigation_id="inv", sandbox=sandbox, handle=handle, user_env=env_vars or {}
+    )
+    tool = _to_function_tool(pkg, _CMD)
+    tctx: ToolContext[Any] = ToolContext(
+        context=actx, tool_name="q", tool_call_id="id", tool_arguments="{}", usage=Usage()
+    )
+    await tool.on_invoke_tool(tctx, "{}")
+    return sandbox
+
+
+@pytest.mark.asyncio
+async def test_a_third_party_tool_is_dispatched_as_itself():
+    sandbox = await _dispatch(_THIRD)
+    assert sandbox.exec_tools[-1] == "erp"
+
+
+@pytest.mark.asyncio
+async def test_a_first_party_tool_is_dispatched_as_the_sandbox():
+    sandbox = await _dispatch(_FIRST)
+    assert sandbox.exec_tools[-1] is False
+
+
+_LOADERS = {
+    "PYTHONPATH": "/root/evil",
+    "PYTHONSTARTUP": "/root/evil.py",
+    "LD_PRELOAD": "/root/evil.so",
+    "LD_LIBRARY_PATH": "/root",
+    "HOME": "/root",
+    "PATH": "/root/bin",
+    "SANDBOX_HOME": "/root",
+    "BASH_ENV": "/root/evil.sh",
+    "NODE_OPTIONS": "--require /root/evil.js",
+}
+
+
+def test_the_app_hands_every_name_the_user_set_to_the_host():
+    """#581 / the reserved-names decision: the user wins for the platform's own
+    tools, PYTHONPATH and HOME included — and the app no longer filters for a
+    third-party one either; the host does (one rule, one place)."""
+    env = _tool_env({**_LOADERS, "ERP_TOKEN": "t"}, item_id="inv")
+    for name, value in _LOADERS.items():
+        assert env[name] == value
+    assert set(env["SANDBOX_USER_ENV_KEYS"].split()) == {*_LOADERS, "ERP_TOKEN"}
+
+
+@pytest.mark.asyncio
+async def test_the_dispatch_leaves_a_first_party_tools_env_alone():
+    sandbox = await _dispatch(_FIRST, {"PYTHONPATH": "/mine"})
+    assert sandbox.exec_envs[-1]["PYTHONPATH"] == "/mine"
+
+
+# ── view plugins (#847/#848): a plain PackageInfo, so the MOUNT decides ───────
+
+
+async def _plugin_dispatch(mounted: dict[str, str]) -> MockSandbox:
+    """A view plugin's command, dispatched the way both plugin call sites do:
+    a bare `PackageInfo` (never `third_party`), in a context whose sandbox spec
+    names what is mounted from the third-party store."""
+    sandbox = MockSandbox()
+    handle = await sandbox.create(SandboxSpec(tools=mounted))
+    actx = AgentToolContext(
+        investigation_id="inv",
+        sandbox=sandbox,
+        handle=handle,
+        sandbox_spec=SandboxSpec(tools=mounted),
+        user_env={"PYTHONPATH": "/root/evil"},
+    )
+    pkg = PackageInfo(name="wafermap", install_dir="../.tools/wafermap", commands=())
+    await exec_package_command(actx, handle, pkg, "validate", "{}")
+    return sandbox
+
+
+@pytest.mark.asyncio
+async def test_an_artifact_view_plugin_runs_as_the_tool_identity():
+    """An `{artifact: url}` plugin is resolved like an external tool, so its
+    bundle sits in the third-party store — which only the tool group may read. Run
+    as the sandbox uid it could no longer read its own files."""
+    sandbox = await _plugin_dispatch({"wafermap": "a" * 64})
+    assert sandbox.exec_tools[-1] == "wafermap"
+
+
+@pytest.mark.asyncio
+async def test_a_bundled_view_plugin_runs_as_the_sandbox():
+    """A `{bundle: ...}` plugin ships in `builtin/`: first-party, untouched."""
+    sandbox = await _plugin_dispatch({})
+    assert sandbox.exec_tools[-1] is False
+    assert sandbox.exec_envs[-1]["PYTHONPATH"] == "/root/evil"
diff --git a/tests/tooling/test_tool_secrets.py b/tests/tooling/test_tool_secrets.py
new file mode 100644
index 000000000..daa88c7d5
--- /dev/null
+++ b/tests/tooling/test_tool_secrets.py
@@ -0,0 +1,181 @@
+"""Credentials a third-party tool's author keeps out of its source
+(docs/plan-tool-identity-secrets.md P4).
+
+The author sets them in GitLab CI/CD Variables and marks the name `"secret":
+true` in `env.json`; the builder SEALS each value to the platform's public
+key(s) and the sandbox host OPENS them with its private key, handing the values
+to that tool's process only. HPKE (RFC 9180) from `cryptography`, which both
+sides already depend on — nothing home-made.
+
+`tool_secrets.py` is the same file on both sides (like `artifact.py`), so the
+format and the cipher suite cannot drift between the one that seals and the one
+that opens.
+"""
+
+from __future__ import annotations
+
+import base64
+import json
+from pathlib import Path
+
+import pytest
+from cryptography.hazmat.primitives.asymmetric.x25519 import X25519PrivateKey
+
+from workspace_app.tooling.artifact import (
+    EnvSpec,
+    Manifest,
+    parse_env_declaration,
+    parse_manifest,
+    render_manifest,
+)
+from workspace_app.tooling.tool_secrets import (
+    SecretsError,
+    key_id,
+    open_sealed,
+    parse_recipients,
+    private_key_from_text,
+    public_key_text,
+    seal,
+)
+
+
+def _recipient() -> tuple[X25519PrivateKey, str]:
+    key = X25519PrivateKey.generate()
+    return key, public_key_text(key.public_key())
+
+
+def test_a_sealed_value_opens_with_the_deployments_key():
+    key, pub = _recipient()
+    sealed = seal({"MACHINE_PASSWORD": "hunter2"}, parse_recipients(pub))
+    assert open_sealed(sealed, key) == {"MACHINE_PASSWORD": "hunter2"}
+
+
+def test_the_sealed_file_holds_no_value_in_the_clear():
+    _key, pub = _recipient()
+    sealed = seal({"MACHINE_PASSWORD": "hunter2"}, parse_recipients(pub))
+    assert b"hunter2" not in sealed
+    assert b"MACHINE_PASSWORD" in sealed  # the NAME is not a secret
+
+
+def test_one_build_opens_on_every_deployment_it_was_sealed_for():
+    """Staging and production hold different keys; one artifact serves both."""
+    staging, s_pub = _recipient()
+    prod, p_pub = _recipient()
+    sealed = seal({"PW": "x"}, parse_recipients(f"{s_pub}\n{p_pub}"))
+    assert open_sealed(sealed, staging) == {"PW": "x"}
+    assert open_sealed(sealed, prod) == {"PW": "x"}
+
+
+def test_a_deployment_it_was_not_sealed_for_is_told_so():
+    _key, pub = _recipient()
+    other = X25519PrivateKey.generate()
+    sealed = seal({"PW": "x"}, parse_recipients(pub))
+    with pytest.raises(SecretsError, match=key_id(other.public_key())):
+        open_sealed(sealed, other)
+
+
+def test_a_tampered_value_does_not_open():
+    key, pub = _recipient()
+    doc = json.loads(seal({"PW": "x"}, parse_recipients(pub)))
+    kid = key_id(key.public_key())
+    raw = bytearray(base64.b64decode(doc["recipients"][kid]["PW"]))
+    raw[-1] ^= 1
+    doc["recipients"][kid]["PW"] = base64.b64encode(bytes(raw)).decode()
+    with pytest.raises(SecretsError, match="PW"):
+        open_sealed(json.dumps(doc).encode(), key)
+
+
+def test_a_value_cannot_be_moved_to_another_name():
+    """Each ciphertext is bound to its variable's name, so relabelling one in a
+    bundle (say, a token as `PATH`) does not open."""
+    key, pub = _recipient()
+    doc = json.loads(seal({"PW": "x", "TOKEN": "y"}, parse_recipients(pub)))
+    kid = key_id(key.public_key())
+    entry = doc["recipients"][kid]
+    entry["PW"], entry["TOKEN"] = entry["TOKEN"], entry["PW"]
+    with pytest.raises(SecretsError):
+        open_sealed(json.dumps(doc).encode(), key)
+
+
+def test_no_recipient_is_refused_at_seal_time():
+    with pytest.raises(SecretsError, match="TOOL_SECRET_RECIPIENTS"):
+        seal({"PW": "x"}, [])
+
+
+@pytest.mark.parametrize("text", ["not-base64!", base64.b64encode(b"short").decode()])
+def test_a_malformed_recipient_is_refused(text):
+    with pytest.raises(SecretsError, match="TOOL_SECRET_RECIPIENTS"):
+        parse_recipients(text)
+
+
+def test_a_private_key_round_trips_through_its_text_form():
+    key = X25519PrivateKey.generate()
+    from cryptography.hazmat.primitives import serialization
+
+    raw = key.private_bytes(
+        serialization.Encoding.Raw,
+        serialization.PrivateFormat.Raw,
+        serialization.NoEncryption(),
+    )
+    again = private_key_from_text(base64.b64encode(raw).decode() + "\n")
+    assert key_id(again.public_key()) == key_id(key.public_key())
+
+
+def test_both_copies_of_the_module_are_the_same_file():
+    repo = Path(__file__).resolve().parents[2]
+    app = repo / "src" / "workspace_app" / "tooling" / "tool_secrets.py"
+    host = repo / "sandbox-host" / "src" / "sandbox_host" / "tool_secrets.py"
+    assert host.read_bytes() == app.read_bytes(), (
+        "sandbox-host/src/sandbox_host/tool_secrets.py has drifted from the app's copy — "
+        "copy it across; one side seals and the other opens, so they must agree exactly"
+    )
+
+
+# ── env.json + manifest carry which names are secret ─────────────────────────
+
+
+def test_env_json_marks_a_name_secret():
+    (pw, base) = parse_env_declaration(
+        '[{"name": "MACHINE_PASSWORD", "secret": true}, {"name": "ERP_BASE"}]'
+    )
+    assert pw.secret is True
+    assert base.secret is False
+
+
+def test_secret_must_be_a_boolean():
+    with pytest.raises(ValueError, match="`secret` must be true, false or absent"):
+        parse_env_declaration('[{"name": "PW", "secret": "yes"}]')
+
+
+def _manifest(env: tuple[EnvSpec, ...]) -> Manifest:
+    from workspace_app.tooling.artifact import BundleRef
+
+    return Manifest(
+        format_version=1,
+        name="erp",
+        version="1.0",
+        commands=(),
+        builder="b",
+        python="3.12",
+        arch="x86_64",
+        bundle=BundleRef(sha256="a" * 64, size=1),
+        source=None,
+        grant=None,
+        author=None,
+        description=None,
+        env=env,
+    )
+
+
+def test_the_manifest_carries_the_secret_flag():
+    env = (EnvSpec(name="PW", secret=True), EnvSpec(name="BASE"))
+    back = parse_manifest(render_manifest(_manifest(env)))
+    assert back.env is not None
+    assert [e.secret for e in back.env] == [True, False]
+
+
+def test_a_manifest_without_secrets_renders_as_it_always_did():
+    """A key written for every entry would change the bytes of every artifact
+    that has none — and with them nothing, except every diff in review."""
+    rendered = render_manifest(_manifest((EnvSpec(name="BASE"),)))
+    assert b"secret" not in rendered
