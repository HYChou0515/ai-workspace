+    await ask()
+    p = await _progress(files, item)
+    assert p is not None and p.heartbeat_at == clock.t
+
+    # A running stage IS judged by its heartbeat: a worker that stopped
+    # breathing past `stale_after_seconds` is replaced …
+    await files.write(
