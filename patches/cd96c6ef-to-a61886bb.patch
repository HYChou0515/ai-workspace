+    own copy. The page holds each file once, in a table the steps and the
+    answers point into."""
+    twenty = [_shown("/big.png", "image/png") for _ in range(20)]
+    answer = {"role": "assistant", "author": "AI", "content": "![](big.png) " * 50}
