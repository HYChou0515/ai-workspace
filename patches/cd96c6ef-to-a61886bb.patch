+
+.export-dialog__lede {
+  margin: 0;
+  font-size: var(--text-small);
+  line-height: var(--leading-body-sm, 1.5);
+  color: var(--text-paper-d);
+}
+
+.export-dialog__section {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-4);
+  min-width: 0;
+}
+
+.export-dialog__label {
+  font-size: var(--text-xs);
+  text-transform: uppercase;
+  letter-spacing: var(--tracking-mono-caps);
+  color: var(--text-paper-d);
+}
+
+/* Radios and their labels on one wrapping line; the "latest N" number sits
+   inside its radio's label. */
+.export-dialog__choices {
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--space-4) var(--space-12);
+  align-items: center;
+}
+
+.export-dialog__choice {
+  display: inline-flex;
+  align-items: center;
+  gap: var(--space-4);
+  font-size: var(--text-body-sm);
+  color: var(--text-paper);
+}
+
+.export-dialog__choice input[type="radio"]:disabled + * {
+  color: var(--text-paper-d);
+}
+
+/* The inline number beside "latest": the house chrome at a fixed width. */
+.export-dialog__num {
+  flex: none;
+  width: 5.5em;
+  min-height: 28px;
+  padding: 0 6px;
+  font-variant-numeric: tabular-nums;
+}
+
+/* Labelled fields two abreast — from / to, format / aspect / resolution, the
+   six tempo knobs; one column where two would leave a label nowhere to go. */
+.export-dialog__grid {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: var(--space-8) var(--space-12);
+}
+
+@media (max-width: 480px) {
+  .export-dialog__grid {
+    grid-template-columns: 1fr;
+  }
+}
+
+.export-dialog__field {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-4);
+  min-width: 0;
+}
+
+.export-dialog__field > label {
+  font-size: var(--text-small);
+  color: var(--text-paper-d);
+}
+
+/* The class sets `flex: 1` for row layouts; in a column it must fill. */
+.export-dialog__field > .input {
+  width: 100%;
+  flex: none;
+  font-variant-numeric: tabular-nums;
+}
+
+/* The resolution slider: `FontSizeSlider`'s shape — the track fills, the
