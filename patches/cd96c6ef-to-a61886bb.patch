+# ── lineage from .origin ─────────────────────────────────────────────────────
+
+
+async def test_a_copy_of_someone_elses_entry_publishes_as_a_fork_of_it():
+    hub = _hub()
+    bobs = await hub.publish(
+        owner="bob",
