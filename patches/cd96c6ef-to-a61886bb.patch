+    assert d["is_owner"] is True and d["source_item"] == "inv-src"
+    assert d["permission"]["visibility"] == "public" and d["permission"]["read_content"] == []
+
+
+async def test_a_non_owner_does_not_get_the_permission_object(harness: Harness):
