+  const onClose = vi.fn();
+  const onSave = vi.fn(async () => {});
+  renderWithQuery(
+    <ViewerClockPin viewer={viewer} now={NOW}>
+      <ScheduleTimeModal raw={raw} rowRef={REF} onSave={onSave} onSaved={vi.fn()} onClose={onClose} />
+    </ViewerClockPin>,
+  );
+  return { onClose, onSave };
+}
+
