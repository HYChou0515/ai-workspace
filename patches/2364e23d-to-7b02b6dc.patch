diff --git a/web/src/styles/schedule-overview.css b/web/src/styles/schedule-overview.css
new file mode 100644
index 00000000..3125f9da
--- /dev/null
+++ b/web/src/styles/schedule-overview.css
@@ -0,0 +1,76 @@
+/* `/schedules` — every schedule the viewer may read
+ * (docs/plan-schedule-overview.md). Rendered in the `.page` shell
+ * (my-resources.css), which owns the heading, the tools row and the empty
+ * state; these rules are the table only.
+ *
+ * The table scrolls inside its own box on a narrow viewport: six columns of
+ * times and names do not fit 390px, and squeezing them breaks every time into
+ * one character per line. The page itself never scrolls sideways.
+ *
+ * Tokens only — `no-undefined-tokens.test.ts` fails the build otherwise.
+ */
+
+.page .schedule-scroll {
+  overflow-x: auto;
+  margin-bottom: var(--space-24);
+}
+
+.page .schedule-table {
+  width: 100%;
+  border-collapse: collapse;
+  font-size: var(--text-body-sm);
+}
+
+.page .schedule-table th {
+  text-align: left;
+  font-weight: 600;
+  color: var(--text-paper-d);
+  padding: var(--space-8);
+  border-bottom: 1px solid var(--paper-3);
+  white-space: nowrap;
+}
+
+.page .schedule-table td {
+  padding: var(--space-8);
+  border-bottom: 1px solid var(--paper-2);
+  vertical-align: top;
+}
+
+.page .schedule-table .schedule-when,
+.page .schedule-table .schedule-next,
+.page .schedule-table .schedule-last {
+  white-space: nowrap;
+}
+
+.page .schedule-table .schedule-problem {
+  color: var(--err);
+  white-space: normal;
+}
+
+.page .schedule-table .schedule-actions {
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--space-4);
+}
+
+.page .schedule-table .schedule-status[data-status="error"],
+.page .schedule-table .schedule-status[data-status="cancelled"] {
+  color: var(--err);
+}
+
+/* A group is a heading row inside the one table, so every group's columns
+ * line up (docs/plan-schedule-overview-polish.md decision 11). */
+.page .schedule-table .schedule-group th {
+  padding-top: var(--space-16);
+  border-bottom: 1px solid var(--paper-3);
+}
+
+/* "手動" beside a last run started by Run now. */
+.page .schedule-table .schedule-tag {
+  margin-left: var(--space-4);
+  padding: 0 var(--space-4);
+  border: 1px solid var(--paper-3);
+  border-radius: var(--radius-btn);
+  color: var(--text-paper-d);
+  font-size: var(--text-xs);
+}
