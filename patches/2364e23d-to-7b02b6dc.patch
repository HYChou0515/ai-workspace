+    async def declared(item: str) -> dict[str, MountedTool]:
+        return _V2
+
+    a.tools_for = declared
+    await a.rebuild_io_handle("it")
+    assert sandbox.specs == [{"t": "s2"}]
+    assert (await addr.published("it")).tools == _V2  # type: ignore[union-attr]
+
