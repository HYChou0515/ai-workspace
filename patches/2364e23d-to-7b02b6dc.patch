+  const remove = vi.fn();
+  render(
+    <ActionMenu
+      label="管理"
+      items={[
+        { id: "edit", label: "修改", onSelect: edit },
+        { id: "off", label: "不能按", onSelect: vi.fn(), disabled: true },
+        { id: "delete", label: "刪除", onSelect: remove, danger: true },
+      ]}
+      disabled={disabled}
+    />,
+  );
+  return { edit, remove, trigger: screen.getByRole("button", { name: "管理" }) };
+}
+
