+
+    assert sorted((r["item_id"], r["path"], r["run"], r["item_title"]) for r in rows) == sorted(
+        [(iid, ITEM_SCHEDULES, "w0", "Line 3"), (iid, PAGE_SCHEDULES, "w0", "Line 3")]
