+    )
+
+    assert ctx.tool_versions == {"t": "2.0"}
+    await ctx.ensure_sandbox(prepare_env=False)
+    registry = captured["ex"]._turn_ctx._registry
+    assert (await registry.session(item)).tools == {"t": MountedTool(sha="s2", version="2.0")}
