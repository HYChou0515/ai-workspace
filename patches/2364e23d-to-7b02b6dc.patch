+_PNG = b"\x89PNG\r\n" + bytes(range(256)) * 40
+_PAYLOAD = {
+    "SKILL.md": b"---\nname: s\ndescription: d\n---\nbody\n",
+    "references/notes.md": b"notes\n",
+    "references/shot.png": _PNG,
+}
