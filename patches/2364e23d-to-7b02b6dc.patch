+def _workflow(title: str) -> str:
+    return json.dumps(
+        {
+            "id": "ignored",
+            "title": title,
+            "phases": [{"id": "p"}],
+            "steps": [{"type": "sandbox", "run": "echo ok", "phase": "p", "cache": False}],
+        }
+    )
+
