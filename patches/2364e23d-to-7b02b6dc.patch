+@pytest.mark.parametrize(
+    "blob",
+    [b"", b"version https://git-lfs.github.com/spec/v1\n", b"# a skill\n", b"oid sha256:abc\n"],
+)
+def test_anything_else_is_not_a_pointer(blob: bytes) -> None:
+    assert parse_lfs_pointer(blob) is None
