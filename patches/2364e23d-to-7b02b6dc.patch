+          <span style={{ whiteSpace: "nowrap" }}>{t("env.override", { tab: t(`env.tab.${TAB_OF[layer]}`) })}</span>
+        )}
+        <span style={{ marginLeft: "auto", whiteSpace: "nowrap" }}>
+          {layer === "none" ? (
+            t("env.inUse.none")
+          ) : (
+            <>
+              {inUse === "mine" || inUse === "personal" ? "✓ " : ""}
+              {t("env.inUse", { tab: t(`env.tab.${TAB_OF[layer]}`) })}
+            </>
+          )}
+        </span>
+      </span>
+    </div>
+  );
+}
