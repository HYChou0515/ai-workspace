+        sandbox=MockSandbox(),
+        filestore=SpecstarFileStore(spec),
+        runner=ScriptedAgentRunner([]),
+        lookup_targets=targets,
+    )
+
+    assert ApiTestClient(app).get("/lookup-targets").json() == targets
