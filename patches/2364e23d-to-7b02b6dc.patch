+const TPE = "Asia/Taipei";
+// Thursday 2026-10-08 14:00 in Taipei.
+const NOW = Date.UTC(2026, 9, 8, 6, 0);
+const FRIDAY_1730_TPE = { every: "weekly", dow: "fri", at: "17:30", tz: TPE, run: "r" };
+
