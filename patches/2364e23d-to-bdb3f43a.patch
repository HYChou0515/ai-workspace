+    await archive.persist("item-1", ws, delete=False)
+    first = _gen(root, "item-1")
+    await archive.persist("item-1", ws, delete=False)
+    assert seen[1] == _gen(root, "item-1") != first, (
+        "rsync ran while the generation still named the previous tree"
+    )
+
+
