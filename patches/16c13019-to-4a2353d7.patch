+  it("ignores tools this item is not running", () => {
+    const view = deriveEnvNeeds(
+      [
+        tool({
+          key: "off-tool",
+          label: "Switched Off",
+          effective: false,
+          env_needs: [{ name: "NEVER_READ", description: "", required: true }],
+        }),
