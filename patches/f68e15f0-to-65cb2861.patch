+};
+const facts: React.CSSProperties = {
+  display: "grid",
+  gridTemplateColumns: "minmax(6rem, max-content) 1fr",
+  gap: "6px 16px",
+  margin: 0,
+};
+const term: React.CSSProperties = { fontWeight: 600, color: "var(--ink-2)" };
+const def: React.CSSProperties = { margin: 0, overflowWrap: "anywhere" };
