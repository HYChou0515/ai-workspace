+// @vitest-environment happy-dom
+import "@testing-library/jest-dom/vitest";
+import { cleanup, fireEvent, render, screen, waitFor, within } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+
+vi.mock("../../api", () => ({
+  api: {
+    getUsers: vi.fn(async () => [{ id: "bob", name: "Bob Lin", section: "", email: "", photo_url: null }]),
+  },
+}));
+
+import type { AgentSummary } from "../../api/agents";
+import { FileServiceProvider, type FileService } from "../../api/fileService";
+import type { Published } from "../../api/publish";
+import { WorkspaceSlugProvider } from "../../hooks/useWorkspaceSlug";
+import { publishAgentTestChat, subscribeAgentTestChat } from "../../lib/agentTestChatBus";
+import { QueryWrap } from "../../test/queryWrapper";
+import { AgentYamlPanel } from "./AgentYamlPanel";
+
+const PATH = "/agents/sales/agent.ai.yaml";
+const YAML = "view: agent\ntitle: Sales helper\ninstructions: Help.\npublish:\n  reach: everyone\n";
+
+function fs(): FileService {
+  return {
+    scopeId: "item1",
+    caps: { write: true, delete: true },
+    readFile: vi.fn(async (path: string) => ({
+      kind: "text",
+      path,
+      size: YAML.length,
+      text: YAML,
+      encoding: "utf-8",
+    })),
+    writeFile: vi.fn(async () => {}),
+    fileDownloadUrl: (p: string) => `/api/files${p}`,
+  } as unknown as FileService;
+}
+
+const SUMMARY: AgentSummary = {
+  path: PATH,
+  valid: true,
+  problems: [],
+  title: "Sales helper",
+  description: "Order questions.",
+  icon: "",
+  color: "",
+  instructions: "Help.",
+  narrows: true,
+  tools: ["read_file", "list_files"],
+  not_available: ["kb_search"],
+  skills: ["grill", "quote"],
+  suggestions: [{ label: "Late orders", prompt: "Late orders" }],
+  published: null,
+  opens: 0,
+  people: 0,
+  notes: [],
+};
+
+const ROW: Published = {
+  id: "r",
+  kind: "agent",
+  slug: "rca",
+  item_id: "item1",
+  path: PATH,
+  title: "Sales helper",
+  sharing: "per_conversation",
+  reach: "subjects",
+  subjects: ["user:amy"],
+  role: "participant",
+  published_by: "bob",
+  published_at: Date.now() - 60_000,
+  icon: "",
+  color: "",
+  description: "",
+  files: 3,
+  bytes: 100,
+  based_on_title: "",
+  based_on_by: "",
+  cpu_cores: 2,
+  memory_bytes: null,
+};
+
+function renderPanel(summary: Partial<AgentSummary> = {}) {
+  const client = { summary: vi.fn(async () => ({ ...SUMMARY, ...summary })) };
+  const publisher = {
+    publish: vi.fn(async () => ROW),
+    unpublish: vi.fn(async () => {}),
+    estimate: vi.fn(async () => ({ files: 3, bytes: 100, biggest: [] })),
+  };
+  render(
+    <QueryWrap>
+      <WorkspaceSlugProvider value="rca">
+        <FileServiceProvider value={fs()}>
+          <AgentYamlPanel path={PATH} text={YAML} client={client} publisher={publisher} />
+        </FileServiceProvider>
+      </WorkspaceSlugProvider>
+    </QueryWrap>,
+  );
+  return { client, publisher };
+}
+
+afterEach(() => cleanup());
+
+describe("AgentYamlPanel", () => {
+  it("shows what a conversation with it will hold before it is published", async () => {
+    const { client } = renderPanel();
+    const panel = await screen.findByTestId("agent-panel");
+
+    expect(within(panel).getByRole("heading", { name: "Sales helper" })).toBeInTheDocument();
+    expect(panel).toHaveTextContent("Order questions.");
+    expect(within(panel).getByTestId("agent-tools")).toHaveTextContent("read_file, list_files");
+    expect(within(panel).getByTestId("agent-not-available")).toHaveTextContent("kb_search");
+    expect(within(panel).getByTestId("agent-skills")).toHaveTextContent("grill, quote");
+    expect(panel).toHaveTextContent("Late orders");
+    expect(within(panel).getByTestId("agent-publish-state")).toHaveTextContent("還沒發布。");
+    expect(client.summary).toHaveBeenCalledWith("rca", "item1", PATH);
+  });
+
+  it("says when it holds every tool the App gives", async () => {
+    renderPanel({ narrows: false, not_available: [] });
+
+    expect(await screen.findByTestId("agent-tools")).toHaveTextContent("全部工具");
+  });
+
+  it("names what the file gets wrong and will not publish until it is fixed", async () => {
+    renderPanel({ problems: ["unknown key `model`"] });
+    const panel = await screen.findByTestId("agent-panel");
+
+    expect(within(panel).getByRole("alert")).toHaveTextContent("unknown key `model`");
+    expect(within(panel).getByRole("button", { name: "發布 agent" })).toBeDisabled();
+  });
+
+  it("a file that is not an agent yet offers neither a summary nor a test", async () => {
+    renderPanel({ valid: false, problems: ["`title` is required"], title: "" });
+    const panel = await screen.findByTestId("agent-panel");
+
+    expect(within(panel).getByRole("alert")).toHaveTextContent("這個檔案還不是一個 agent");
+    expect(within(panel).queryByTestId("agent-tools")).toBeNull();
+    expect(within(panel).getByRole("button", { name: "測試對話" })).toBeDisabled();
+  });
+
+  it("publishes one conversation per copy, pre-filled from the yaml's publish:", async () => {
+    const { publisher } = renderPanel();
+    fireEvent.click(await screen.findByRole("button", { name: "發布 agent" }));
+    const dialog = screen.getByTestId("publish-dialog");
+
+    expect(within(dialog).getByRole("radio", { name: "所有登入的人" })).toBeChecked();
+    // A first publish has nothing to say "what changed" about.
+    expect(within(dialog).queryByRole("textbox", { name: "這次改了什麼（選填）" })).toBeNull();
+    fireEvent.click(within(dialog).getByRole("button", { name: "發布" }));
+
+    await waitFor(() =>
+      expect(publisher.publish).toHaveBeenCalledWith(
+        "rca",
+        "item1",
+        PATH,
+        expect.objectContaining({ sharing: "per_conversation", reach: "everyone" }),
+      ),
+    );
+    expect(await screen.findByText(/已發布。之後每個新對話都會用這一版/)).toBeInTheDocument();
+  });
+
+  it("once published, says how, by whom, its usage and notes — and re-publishes with a note", async () => {
+    const { publisher } = renderPanel({
+      published: ROW,
+      opens: 7,
+      people: 3,
+      notes: [{ at: Date.now() - 1000, by: "bob", text: "Answers in Chinese now." }],
+    });
+    const state = await screen.findByTestId("agent-publish-state");
+
+    expect(state).toHaveTextContent("指定的人或群組");
+    expect(state).toHaveTextContent("7 次打開 · 3 人");
+    expect(state).toHaveTextContent("Answers in Chinese now.");
+    await waitFor(() => expect(state).toHaveTextContent("Bob Lin"));
+
+    fireEvent.click(screen.getByRole("button", { name: "再次發布 agent" }));
+    const dialog = screen.getByTestId("publish-dialog");
+    // What is in effect now, not the yaml's first idea — the size too.
+    expect(within(dialog).getByRole("radio", { name: "指定的人或群組" })).toBeChecked();
+    expect(within(dialog).getByRole("textbox", { name: "CPU 核心數" })).toHaveValue("2");
+    // A note says who wrote it (A9) — in the note, not only the line above it.
+    const notes = within(state).getByRole("list", { name: "更新說明" });
+    expect(notes).toHaveTextContent("Bob Lin");
+    fireEvent.change(within(dialog).getByRole("textbox", { name: "這次改了什麼（選填）" }), {
+      target: { value: "Shorter answers." },
+    });
+    fireEvent.click(within(dialog).getByRole("button", { name: "發布" }));
+
+    await waitFor(() =>
+      expect(publisher.publish).toHaveBeenCalledWith(
+        "rca",
+        "item1",
+        PATH,
+        expect.objectContaining({ note: "Shorter answers.", subjects: ["user:amy"] }),
+      ),
+    );
+  });
+
+  it("unpublishes only after asking", async () => {
+    const { publisher } = renderPanel({ published: ROW });
+    fireEvent.click(await screen.findByRole("button", { name: "停止發布" }));
+    const ask = await screen.findByRole("dialog");
+    expect(ask).toHaveTextContent("停止發布「Sales helper」？");
+    expect(publisher.unpublish).not.toHaveBeenCalled();
+
+    fireEvent.click(within(ask).getByRole("button", { name: "停止發布" }));
+
+    await waitFor(() => expect(publisher.unpublish).toHaveBeenCalledWith("rca", "item1", PATH));
+  });
+
+  it("opens a test chat beside the file through the item's chat", async () => {
+    const asked = vi.fn();
+    const stop = subscribeAgentTestChat("item1", asked);
+    try {
+      renderPanel();
+      fireEvent.click(await screen.findByRole("button", { name: "測試對話" }));
+
+      expect(asked).toHaveBeenCalledWith({ path: PATH, title: "測試：Sales helper" });
+    } finally {
+      stop();
+    }
+  });
+
+  it("offers no test chat where no chat is beside it to answer", async () => {
+    renderPanel();
+
+    expect(await screen.findByRole("button", { name: "測試對話" })).toBeDisabled();
+    // (The bus itself is the one `ItemChatShell` listens on.)
+    expect(publishAgentTestChat).toBeTypeOf("function");
+  });
+});
diff --git a/web/src/renderers/agent/AgentYamlPanel.tsx b/web/src/renderers/agent/AgentYamlPanel.tsx
new file mode 100644
index 00000000..2047fac7
--- /dev/null
+++ b/web/src/renderers/agent/AgentYamlPanel.tsx
@@ -0,0 +1,298 @@
+/**
+ * The agent panel (`docs/plan-wui-publish-and-agent-hub.md` A6): what opening
+ * an `agent.ai.yaml` in the workspace shows.
+ *
+ * The author sees what others will get BEFORE publishing (NN/g, *Visibility of
+ * system status*): its name and look, the tools and skills a conversation with
+ * it holds — asked of the server's turn path, not re-derived here — what its
+ * file gets wrong, and whether and how it is published, with its usage. Then
+ * the two things to do: **Publish agent** (the shared dialog, A2's one way of
+ * sharing and A9's release note on a re-publish) and **Test chat**, which opens
+ * a chat beside the file that runs as this agent in the author's own
+ * workspace. The raw yaml is the pane's Edit switch away, like every other
+ * structured preview.
+ *
+ * Named `AgentYamlPanel` because `AgentPanel` is the chat panel.
+ */
+
+import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
+import { useState } from "react";
+
+import { agentApi, type AgentApi, type AgentSummary } from "../../api/agents";
+import { useFileService } from "../../api/fileService";
+import { publishApi, type PublishApi, type PublishChoices } from "../../api/publish";
+import { qk } from "../../api/queryKeys";
+import { exactTime, relativeTime } from "../../api/types";
+import { useDialog } from "../../components/Dialog";
+import { PageMark } from "../../components/PageMark";
+import { PublishDialog } from "../../components/PublishDialog";
+import { UserChip } from "../../components/UserChip";
+import { useWorkspaceSlug } from "../../hooks/useWorkspaceSlug";
+import { canOpenAgentTestChat, publishAgentTestChat } from "../../lib/agentTestChatBus";
+import { type MsgKey, useT } from "../../lib/i18n";
+import { choicesFromPublished, choicesFromSpec } from "../../lib/publishSpec";
+import { parseViewSpec, viewParam } from "../entity/shared";
+
+export function AgentYamlPanel({
+  path,
+  text,
+  client = agentApi,
+  publisher = publishApi,
+}: {
+  path: string;
+  /** The file as the pane holds it — what the summary is of. */
+  text: string;
+  /** Seams for tests. */
+  client?: Pick<AgentApi, "summary">;
+  publisher?: Pick<PublishApi, "publish" | "unpublish" | "estimate">;
+}) {
+  const t = useT();
+  const slug = useWorkspaceSlug();
+  const itemId = useFileService().scopeId;
+  const qc = useQueryClient();
+  const { confirm } = useDialog();
+  const [asking, setAsking] = useState(false);
+
+  // Keyed on the file's text: an edit is a different agent to summarise.
+  const summary = useQuery({
+    queryKey: qk.agentSummary(itemId, path, text),
+    queryFn: () => client.summary(slug, itemId, path),
+    enabled: !!slug,
+  });
+  const refresh = () => qc.invalidateQueries({ queryKey: qk.agentSummaryOf(itemId, path) });
+  const publish = useMutation({
+    mutationFn: (choices: PublishChoices) => publisher.publish(slug, itemId, path, choices),
+    onSuccess: refresh,
+    meta: { silentError: true },
+  });
+  const unpublish = useMutation({
+    mutationFn: () => publisher.unpublish(slug, itemId, path),
+    onSuccess: refresh,
+    meta: { silentError: true },
+  });
+
+  if (summary.isPending) return <p style={muted}>{t("agentPanel.loading")}</p>;
+  if (summary.isError) {
+    return (
+      <p role="alert" style={{ ...muted, color: "var(--err)" }}>
+        {t("agentPanel.failed", { why: summary.error.message })}
+      </p>
+    );
+  }
+  const s = summary.data;
+  const spec = parseViewSpec(text);
+  // A re-publish starts from what is in effect now, size included (C9/C10).
+  const initial: Partial<PublishChoices> = s.published
+    ? choicesFromPublished(s.published)
+    : choicesFromSpec(spec ? viewParam(spec, "publish") : undefined);
+  const canTest = s.valid && canOpenAgentTestChat(itemId);
+  const blockedReason = !s.valid || s.problems.length > 0 ? t("agentPanel.fixFirst") : null;
+
+  const askUnpublish = () => {
+    void confirm({
+      title: t("agentPanel.unpublish.title", { title: s.title }),
+      body: t("agentPanel.unpublish.body"),
+      actions: [
+        { id: "cancel", label: t("publish.cancel") },
+        { id: "go", label: t("agentPanel.unpublish"), variant: "danger" },
+      ],
+    }).then((choice) => {
+      if (choice === "go") unpublish.mutate();
+    });
+  };
+
+  return (
+    <section data-testid="agent-panel" aria-labelledby="agent-panel-title" style={panel}>
+      <header style={{ display: "flex", gap: 12, alignItems: "center" }}>
+        <PageMark
+          slug={slug}
+          itemId={itemId}
+          path={path}
+          icon={s.icon}
+          color={s.color}
+          title={s.title || path}
+          size={40}
+        />
+        <div style={{ minWidth: 0 }}>
+          <h2 id="agent-panel-title" style={{ margin: 0, fontSize: "1.15rem" }}>
+            {s.title || path}
+          </h2>
+          {s.description && <p style={{ ...muted, margin: "2px 0 0" }}>{s.description}</p>}
+        </div>
+      </header>
+
+      {s.problems.length > 0 && (
+        <div role="alert" style={problemBox}>
+          <strong>{t(s.valid ? "agentPanel.problems.warn" : "agentPanel.problems.fatal")}</strong>
+          <ul style={{ margin: "4px 0 0", paddingLeft: 18 }}>
+            {s.problems.map((p) => (
+              <li key={p}>{p}</li>
+            ))}
+          </ul>
+        </div>
+      )}
+
+      {s.valid && <Capabilities summary={s} />}
+
+      <PublishState summary={s} />
+
+      <div style={{ display: "flex", gap: 8, flexWrap: "wrap", alignItems: "center" }}>
+        <button
+          type="button"
+          className="btn"
+          data-variant="primary"
+          data-size="sm"
+          disabled={blockedReason !== null || publish.isPending}
+          onClick={() => setAsking(true)}
+        >
+          {t(s.published ? "agentPanel.republish" : "agentPanel.publish")}
+        </button>
+        <button
+          type="button"
+          className="btn"
+          data-variant="secondary"
+          data-size="sm"
+          disabled={!canTest}
+          title={canTest ? t("agentPanel.test.tip") : undefined}
+          onClick={() =>
+            publishAgentTestChat(itemId, { path, title: t("agentPanel.test.chatTitle", { title: s.title }) })
+          }
+        >
+          {t("agentPanel.test")}
+        </button>
+        {s.published && (
+          <button
+            type="button"
+            className="btn"
+            data-variant="secondary"
+            data-size="sm"
+            disabled={unpublish.isPending}
+            onClick={askUnpublish}
+          >
+            {t("agentPanel.unpublish")}
+          </button>
+        )}
+        {blockedReason && (
+          <span role="status" style={muted}>
+            {blockedReason}
+          </span>
+        )}
+      </div>
+      {(publish.isError || unpublish.isError) && (
+        <p role="alert" style={{ ...muted, color: "var(--err)" }}>
+          {t("agentPanel.publishFailed", {
+            why: (publish.error ?? unpublish.error)?.message ?? "",
+          })}
+        </p>
+      )}
+      {publish.isSuccess && !publish.isPending && (
+        <p role="status" style={muted}>
+          {t("agentPanel.published")}
+        </p>
+      )}
+
+      {asking && (
+        <PublishDialog
+          kind="agent"
+          slug={slug}
+          itemId={itemId}
+          path={path}
+          initial={initial}
+          republish={!!s.published}
+          client={publisher}
+          onClose={() => setAsking(false)}
+          onConfirm={(choices) => {
+            setAsking(false);
+            publish.mutate(choices);
+          }}
+        />
+      )}
+    </section>
+  );
+}
+
+function Capabilities({ summary: s }: { summary: AgentSummary }) {
+  const t = useT();
+  return (
+    <dl style={facts}>
+      <dt style={term}>{t("agentPanel.tools")}</dt>
+      <dd style={def} data-testid="agent-tools">
+        {s.tools.length === 0 ? t("agentPanel.tools.none") : s.tools.join(", ")}
+        {!s.narrows && <span style={muted}> · {t("agentPanel.tools.all")}</span>}
+        {s.not_available.length > 0 && (
+          <div style={muted} data-testid="agent-not-available">
+            {t("agentPanel.tools.missing", { names: s.not_available.join(", ") })}
+          </div>
+        )}
+      </dd>
+      <dt style={term}>{t("agentPanel.skills")}</dt>
+      <dd style={def} data-testid="agent-skills">
+        {s.skills.length === 0 ? t("agentPanel.skills.none") : s.skills.join(", ")}
+      </dd>
+      {s.suggestions.length > 0 && (
+        <>
+          <dt style={term}>{t("agentPanel.suggestions")}</dt>
+          <dd style={def}>{s.suggestions.map((x) => x.label).join(" · ")}</dd>
+        </>
+      )}
+    </dl>
+  );
+}
+
+function PublishState({ summary: s }: { summary: AgentSummary }) {
+  const t = useT();
+  const p = s.published;
+  if (!p) {
+    return (
+      <p style={muted} data-testid="agent-publish-state">
+        {t("agentPanel.notPublished")}
+      </p>
+    );
+  }
+  const iso = new Date(p.published_at).toISOString();
+  return (
+    <div data-testid="agent-publish-state" style={{ display: "flex", flexDirection: "column", gap: 4 }}>
+      <span>
+        {t("agentPanel.publishedBy")} <UserChip userId={p.published_by} nameOnly /> ·{" "}
+        <span title={exactTime(iso)}>{relativeTime(iso)}</span> · {t(`publish.reach.${p.reach}` as MsgKey)}
+      </span>
+      <span style={muted}>{t("publish.usage", { opens: s.opens, people: s.people })}</span>
+      {s.notes.length > 0 && (
+        <ul style={{ ...muted, margin: 0, paddingLeft: 18 }} aria-label={t("agentPanel.notes")}>
+          {s.notes.map((n) => (
+            <li key={`${n.at}-${n.text}`}>
+              <span title={exactTime(new Date(n.at).toISOString())}>{relativeTime(new Date(n.at).toISOString())}</span>
+              {" · "}
+              <UserChip userId={n.by} nameOnly />
+              {" · "}
+              {n.text}
+            </li>
+          ))}
+        </ul>
+      )}
+    </div>
+  );
+}
+
