+    expect(onConfirm).toHaveBeenCalledWith(
+      expect.objectContaining({
+        sharing: "per_person",
+        reach: "everyone",
+        cpu_cores: 2,
+        memory_bytes: 4 * 1024 ** 3,
+      }),
