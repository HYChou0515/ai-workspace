+def test_the_old_deploy_route_needs_what_publishing_needs():
+    """C9: listing a page for others is a sharing decision — `change_permission`,
+    the same as Publish, not `edit_content`."""
+    holder = {"id": "bob"}
+    client, spec, _s, _a = _app(holder)
