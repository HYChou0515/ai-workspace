@@ -0,0 +1,99 @@
+// @vitest-environment happy-dom
+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+import { LATER_MS, onRemindersChanged, reminderOf, remindLater, skipVersion } from "./skillUpdateReminders";
+
+// plan-skill-hub-release-notes D3 / D4: the first reminder offers Update and
+// Later; once a Later has run out, every reminder adds Skip. Later is 7 days.
+// Kept per person, entry and version, in this browser.
+const T0 = Date.UTC(2026, 10, 4, 9);
+const DAY = 24 * 3600 * 1000;
+
+describe("skill update reminders", () => {
+  beforeEach(() => localStorage.clear());
+
+  it("a version never answered is due, and cannot be skipped yet", () => {
+    expect(reminderOf("alice", "e1", 3, T0)).toEqual({ due: true, canSkip: false, skipped: false, until: null });
+  });
+
+  it("Later hides it for exactly 7 days; after that it is due again, now with Skip", () => {
+    expect(LATER_MS).toBe(7 * DAY);
+    remindLater("alice", "e1", 3, T0);
+    expect(reminderOf("alice", "e1", 3, T0 + 7 * DAY - 1)).toMatchObject({ due: false, until: T0 + 7 * DAY });
+    expect(reminderOf("alice", "e1", 3, T0 + 7 * DAY)).toEqual({ due: true, canSkip: true, skipped: false, until: null });
+  });
+
+  it("Skip silences that version for good; a newer version is due again from the start", () => {
+    remindLater("alice", "e1", 3, T0);
+    skipVersion("alice", "e1", 3);
+    expect(reminderOf("alice", "e1", 3, T0 + 100 * DAY)).toMatchObject({ due: false, skipped: true });
+    expect(reminderOf("alice", "e1", 4, T0 + 100 * DAY)).toEqual({ due: true, canSkip: false, skipped: false, until: null });
+  });
+
+  it("is one person's answer: someone else in the same browser is still reminded", () => {
+    remindLater("alice", "e1", 3, T0);
+    expect(reminderOf("bob", "e1", 3, T0 + DAY).due).toBe(true);
+    expect(reminderOf("alice", "e2", 3, T0 + DAY).due).toBe(true);
+  });
+
+  it("an unreadable store reminds rather than throws", () => {
+    localStorage.setItem("skillHub.updateReminders", "{not json");
+    expect(reminderOf("alice", "e1", 3, T0).due).toBe(true);
+  });
+
+  // Review round 1 (#1004): with storage blocked (a private window, quota
+  // full) the write was swallowed and the next read came back empty, so Later
+  // and Skip looked like buttons that do nothing. They hold for this page.
+  it("a store that refuses writes still keeps the answer for this page", () => {
+    const set = vi.spyOn(localStorage, "setItem").mockImplementation(() => {
+      throw new DOMException("blocked", "QuotaExceededError");
+    });
+    const get = vi.spyOn(localStorage, "getItem").mockImplementation(() => {
+      throw new DOMException("blocked", "SecurityError");
+    });
+    try {
+      remindLater("alice", "e1", 3, T0);
+      expect(reminderOf("alice", "e1", 3, T0 + DAY).due).toBe(false);
+      skipVersion("alice", "e1", 4);
+      expect(reminderOf("alice", "e1", 4, T0).skipped).toBe(true);
+      expect(set).toHaveBeenCalled();
+      expect(get).toHaveBeenCalled();
+    } finally {
+      set.mockRestore();
+      get.mockRestore();
+      // One write that succeeds ends the page-only fallback for the tests after.
+      skipVersion("reset", "reset", 0);
+      localStorage.clear();
+    }
+  });
+
+  // Review round 2: once a write here failed, reads stopped looking at the
+  // store, so another tab's later answer was hidden — and the next write that
+  // succeeded here erased it. The page's unsaved answers sit over a fresh read.
+  it("answers this page could not save do not hide or erase another tab's", () => {
+    const set = vi.spyOn(localStorage, "setItem").mockImplementation(() => {
+      throw new DOMException("full", "QuotaExceededError");
+    });
+    remindLater("alice", "e1", 3, T0);
+    set.mockRestore();
+    const theirs = ["alice", "e2", "5"].map(encodeURIComponent).join(":");
+    localStorage.setItem("skillHub.updateReminders", JSON.stringify({ [theirs]: { skipped: true } }));
+
+    expect(reminderOf("alice", "e2", 5, T0).skipped).toBe(true);
+    expect(reminderOf("alice", "e1", 3, T0 + DAY).due).toBe(false);
+    skipVersion("alice", "e9", 1);
+    const stored = JSON.parse(localStorage.getItem("skillHub.updateReminders") ?? "{}");
+    expect(Object.keys(stored)).toEqual(expect.arrayContaining([theirs, "alice:e1:3", "alice:e9:1"]));
+  });
+
+  // The same review: an answer given in another tab never reached this one.
+  it("an answer written by another tab is announced here", () => {
+    const heard = vi.fn();
+    const stop = onRemindersChanged(heard);
+    window.dispatchEvent(new StorageEvent("storage", { key: "skillHub.updateReminders" }));
+    window.dispatchEvent(new StorageEvent("storage", { key: "something.else" }));
+    stop();
+    window.dispatchEvent(new StorageEvent("storage", { key: "skillHub.updateReminders" }));
+    expect(heard).toHaveBeenCalledTimes(1);
+  });
+});
diff --git a/web/src/lib/skillUpdateReminders.ts b/web/src/lib/skillUpdateReminders.ts
new file mode 100644
index 00000000..53896137
--- /dev/null
+++ b/web/src/lib/skillUpdateReminders.ts
@@ -0,0 +1,104 @@
+// What a person told the skill-update reminder (docs/plan-skill-hub-release-notes
+// D3 / D4): "remind me later" — 7 days, fixed — or "skip this version". Kept
+// in this browser, per person + entry + version, so a newer version reminds
+// again from the start and someone else in the same browser is still told.
+// Callers judge only once the current user is KNOWN: on a cold load the id is
+// the "default-user" placeholder, and judging on it re-showed a reminder a
+// person had answered (the onboarding bug, #997).
+
+const KEY = "skillHub.updateReminders";
+
+/** "Remind me later" — fixed; the person cannot change it (D3). */
+export const LATER_MS = 7 * 24 * 3600 * 1000;
+
+type Answer = { until?: number; snoozed?: number; skipped?: boolean };
+type Store = Record<string, Answer>;
+
+export type Reminder = {
+  /** Remind now: never answered, or its Later has run out. */
+  due: boolean;
+  /** Offer "skip this version": from the second reminder on (D3). */
+  canSkip: boolean;
+  skipped: boolean;
+  /** While a Later runs: when it ends (epoch ms); `null` otherwise. */
+  until: number | null;
+};
+
+// The answers of this page when the browser's store refused a write (a
+// private window, a full quota): without it Later / Skip were recorded nowhere
+// and looked like buttons that do nothing. Until the next successful write.
+// Laid OVER a fresh read, never instead of it: another tab may still save, and
+// its answers must neither be hidden here nor erased by this page's next write.
+let unsaved: Store | null = null;
+
+function stored(): Store {
+  try {
+    const raw = localStorage.getItem(KEY);
+    const parsed: unknown = raw ? JSON.parse(raw) : null;
+    return parsed && typeof parsed === "object" ? (parsed as Store) : {};
+  } catch {
+    return {};
+  }
+}
+
+function read(): Store {
+  return unsaved ? { ...stored(), ...unsaved } : stored();
+}
+
+const CHANGED = "skillHub.updateReminders.changed";
+
+function write(store: Store): void {
+  try {
+    localStorage.setItem(KEY, JSON.stringify(store));
+    unsaved = null;
+  } catch {
+    // A full or blocked store: kept for this page, so the answer holds until
+    // it is closed — and the reminder comes back on the next visit.
+    unsaved = store;
+  }
+  // Every reader of an answer (the panel's row, the skills button's mark)
+  // re-reads at once.
+  window.dispatchEvent(new Event(CHANGED));
+}
+
+/** Call `listener` whenever a Later or a Skip is recorded — here, or in another
+ * tab of this browser (its `storage` event); returns the unsubscribe. */
+export function onRemindersChanged(listener: () => void): () => void {
+  const fromAnotherTab = (e: StorageEvent) => {
+    if (e.key === KEY || e.key === null) listener();
+  };
+  window.addEventListener(CHANGED, listener);
+  window.addEventListener("storage", fromAnotherTab);
+  return () => {
+    window.removeEventListener(CHANGED, listener);
+    window.removeEventListener("storage", fromAnotherTab);
+  };
+}
+
+// encodeURIComponent so a ":" in any part can never make two keys collide.
+const keyOf = (user: string, entry: string, version: number) =>
+  [user, entry, String(version)].map(encodeURIComponent).join(":");
+
+export function reminderOf(user: string, entry: string, version: number, now: number): Reminder {
+  const a = read()[keyOf(user, entry, version)] ?? {};
+  if (a.skipped) return { due: false, canSkip: true, skipped: true, until: null };
+  if (a.until !== undefined && now < a.until) {
+    return { due: false, canSkip: (a.snoozed ?? 0) > 0, skipped: false, until: a.until };
+  }
+  return { due: true, canSkip: (a.snoozed ?? 0) > 0, skipped: false, until: null };
+}
+
+export function remindLater(user: string, entry: string, version: number, now: number): void {
+  const store = read();
+  const key = keyOf(user, entry, version);
+  const a = store[key] ?? {};
+  store[key] = { ...a, until: now + LATER_MS, snoozed: (a.snoozed ?? 0) + 1 };
+  write(store);
+}
+
+export function skipVersion(user: string, entry: string, version: number): void {
+  const store = read();
+  const key = keyOf(user, entry, version);
+  store[key] = { ...(store[key] ?? {}), skipped: true };
+  write(store);
+}
