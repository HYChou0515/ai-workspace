+    await waitFor(() =>
+      expect(screen.getByRole("alert")).toHaveTextContent(
+        word("skills.banner.failedLine", { name: "b", error: "This copy can only be reset." }),
+      ),
+    );
+    expect(client.refreshItemSkill).toHaveBeenCalledTimes(3);
