+    jrm = spec.get_resource_manager(ImportJob)
+    with jrm.using(user="alice"):
+        job = jrm.create(
+            ImportJob(
+                payload=ImportPayload(
+                    run_id=run_id, kind="process", member_start=0, member_end=50, batch_index=0
+                )
