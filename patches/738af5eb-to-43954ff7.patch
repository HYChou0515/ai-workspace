+    coord = _coordinator(spec)
+    run_id = _staged_run(spec, cid, "alice")
+    rrm = spec.get_resource_manager(ImportRun)
+    cur = rrm.get(run_id)
+    assert isinstance(cur.data, ImportRun)
+    with rrm.using(user="alice"):
