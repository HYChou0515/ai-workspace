diff --git a/tests/api/test_answer_text.py b/tests/api/test_answer_text.py
new file mode 100644
index 00000000..0b89c1d2
--- /dev/null
+++ b/tests/api/test_answer_text.py
@@ -0,0 +1,137 @@
+"""Review round 1 (docs/plan-friendly-errors.md D3): a model call re-sent after
+it broke mid-answer has its partial text WITHDRAWN — and that has to hold for
+every caller that assembles an answer from a run's events, not only the chat
+transcript. Five of them joined `MessageDelta` text themselves and returned the
+broken half glued to the whole answer to the model that asked."""
+
+from __future__ import annotations
+
+from typing import Any
+
+import httpx
+import litellm
+import pytest
+
+from workspace_app.agent.context import AgentToolContext
+from workspace_app.api import litellm_runner as lr
+from workspace_app.api.events import AnswerText, MessageDelta, OutputRetracted
+from workspace_app.api.litellm_runner import LitellmAgentRunner
+from workspace_app.resources import AgentConfig
+
+from ._fake_llm import Fail, Say, ScriptedLlm
+
+
+def _unavailable() -> Exception:
+    resp = httpx.Response(503, request=httpx.Request("POST", "http://llm.test/v1"))
+    return litellm.ServiceUnavailableError("down", "openai", "m", response=resp)
+
+
+def _broke_then_whole() -> ScriptedLlm:
+    return ScriptedLlm([Fail(_unavailable(), deltas=["half an "]), Say(["the whole answer"])])
+
+
+def test_the_answer_withdraws_what_a_re_sent_call_showed() -> None:
+    answer = AnswerText()
+    for ev in (
+        MessageDelta(text="Before. "),
+        MessageDelta(text="thinking", reasoning=True),
+        MessageDelta(text="half an "),
+        OutputRetracted(text_chars=8, reasoning_chars=0),
+        MessageDelta(text="the whole answer"),
+    ):
+        answer.add(ev)
+    assert answer.text == "Before. the whole answer"
+
+
+def test_with_reasoning_kept_both_channels_are_withdrawn() -> None:
+    """The compaction summary keeps reasoning text too; a re-sent call's output
+    on BOTH channels is the tail of what it gathered."""
+    answer = AnswerText(include_reasoning=True)
+    for ev in (
+        MessageDelta(text="kept "),
+        MessageDelta(text="half", reasoning=True),
+        MessageDelta(text=" an"),
+        OutputRetracted(text_chars=3, reasoning_chars=4),
+        MessageDelta(text="whole"),
+    ):
+        answer.add(ev)
+    assert answer.text == "kept whole"
+
+
+async def _no_sleep(_s: float) -> None:
+    return None
+
+
+@pytest.mark.asyncio
+async def test_a_delegated_agents_report_is_the_answer_once(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """`run_agent` and the skill-hub review read their report through
+    `drive_subagent` — through the real runner, the broken half must not ride
+    along."""
+    from workspace_app.api.subagent_run import drive_subagent
+    from workspace_app.apps.subagents import SubagentDef
+
+    monkeypatch.setattr(lr, "LitellmModel", _broke_then_whole())
+    parent = AgentToolContext(investigation_id="i", agent_config=AgentConfig(name="p", model="m"))
+    defn = SubagentDef(name="x", description="d", tools=[], body="do it")
+
+    answer, failure = await drive_subagent(LitellmAgentRunner(sleep=_no_sleep), parent, defn, "go")
+
+    assert (answer, failure) == ("the whole answer", None)
+
+
+@pytest.mark.asyncio
+async def test_a_kb_answer_is_the_answer_once(monkeypatch: pytest.MonkeyPatch) -> None:
+    """`ask_knowledge_base` returns `answer_question`'s text to the model."""
+    from workspace_app.api.kb_chat_routes import answer_question
+
+    class _NoRetriever:
+        def search(self, *a: Any, **k: Any) -> list[Any]:
+            return []
+
+    monkeypatch.setattr(lr, "LitellmModel", _broke_then_whole())
+
+    answer = await answer_question(
+        LitellmAgentRunner(sleep=_no_sleep),
+        _NoRetriever(),  # ty: ignore[invalid-argument-type]
+        ["c"],
+        "q",
+        agent_config=AgentConfig(name="kb", model="m"),
+    )
+
+    assert answer == "the whole answer"
+
+
+def test_no_caller_assembles_an_answer_by_hand() -> None:
+    """The five callers above each joined `MessageDelta` text themselves, and
+    each one had to be found. A sixth would be written the same way, so the
+    rule is checked over the source: outside the modules that MAKE or REDUCE
+    the stream (and so already honour `OutputRetracted`), nothing inspects a
+    `MessageDelta` — an answer is read through `AnswerText`."""
+    import ast
+    from pathlib import Path
+
+    src = Path(__file__).parents[2] / "src" / "workspace_app"
+    allowed = {
+        "api/events.py",  # AnswerText itself
+        "api/turns.py",  # the transcript reducer
+        "api/repetition_guard.py",
+        "api/agent_progress.py",  # progress lines, never the answer
+        "api/litellm_runner.py",  # makes the stream
+    }
+    found: list[str] = []
+    for path in sorted(src.rglob("*.py")):
+        rel = path.relative_to(src).as_posix()
+        if rel in allowed:
+            continue
+        for node in ast.walk(ast.parse(path.read_text(encoding="utf-8"))):
+            if (
+                isinstance(node, ast.Call)
+                and isinstance(node.func, ast.Name)
+                and node.func.id == "isinstance"
+                and len(node.args) == 2
+                and "MessageDelta" in ast.unparse(node.args[1])
+            ):
+                found.append(f"{rel}:{node.lineno}")
+    assert found == []
diff --git a/tests/api/test_call_retry_runner.py b/tests/api/test_call_retry_runner.py
new file mode 100644
index 00000000..2da857eb
--- /dev/null
+++ b/tests/api/test_call_retry_runner.py
@@ -0,0 +1,220 @@
+"""docs/plan-friendly-errors.md D2/D3, through the runner's own composition: a
+provider failure is retried as THAT model call, inside the real
+`Runner.run_streamed`, never by re-running the turn.
+
+The case that started this is the first test: a 429 after the answer had begun
+used to end the turn with `RateLimitError: litellm.RateLimitError: …`."""
+
+from __future__ import annotations
+
+from typing import Any
+
+import httpx
+import litellm
+import pytest
+from agents import RunContextWrapper
+
+from workspace_app.agent.context import AgentToolContext
+from workspace_app.api import litellm_runner as lr
+from workspace_app.api.events import MessageDelta, OutputRetracted, RateLimited, RunDone, RunError
+from workspace_app.api.litellm_runner import LitellmAgentRunner
+from workspace_app.resources import AgentConfig
+
+from ._fake_llm import Call, Fail, Say, ScriptedLlm
+
+
+def _resp(status: int, headers: dict[str, str] | None = None) -> httpx.Response:
+    return httpx.Response(
+        status, headers=headers or {}, request=httpx.Request("POST", "http://llm.test/v1")
+    )
+
+
+def _rate_limited(retry_after: str) -> Exception:
+    return litellm.RateLimitError(
+        "slow down", "openai", "m", response=_resp(429, {"retry-after": retry_after})
+    )
+
+
+async def _no_sleep(_s: float) -> None:
+    return None
+
+
+async def _run(monkeypatch: pytest.MonkeyPatch, llm: ScriptedLlm, **kw: Any) -> list[Any]:
+    monkeypatch.setattr(lr, "LitellmModel", llm)
+    runner = LitellmAgentRunner(sleep=_no_sleep, **kw)
+    ctx = AgentToolContext(investigation_id="i", agent_config=AgentConfig(name="t", model="m"))
+    return [ev async for ev in runner.run("go", ctx)]
+
+
+def _answer(events: list[Any]) -> str:
+    """The visible answer as a reader of the stream assembles it — deltas, with
+    a retraction withdrawing what the failed call had shown."""
+    text = ""
+    for ev in events:
+        if isinstance(ev, MessageDelta) and not ev.reasoning:
+            text += ev.text
+        elif isinstance(ev, OutputRetracted):
+            text = text[: len(text) - ev.text_chars]
+    return text
+
+
+async def test_a_rate_limit_mid_answer_is_waited_out_and_the_answer_continues(monkeypatch):
+    llm = ScriptedLlm([Fail(_rate_limited("3"), deltas=["half an "]), Say(["the whole answer"])])
+
+    events = await _run(monkeypatch, llm)
+
+    assert not [e for e in events if isinstance(e, RunError)]
+    assert [e.seconds for e in events if isinstance(e, RateLimited)] == [3.0]
+    assert _answer(events) == "the whole answer"
+    assert isinstance(events[-1], RunDone)
+    assert len(llm.inputs) == 2 and llm.inputs[0] == llm.inputs[1], "the SAME call, re-sent"
+
+
+async def test_a_tool_that_already_ran_is_not_run_again(monkeypatch):
+    """The point of retrying the CALL: the turn loop restarted the whole run,
+    which would have executed the tool a second time — the reason it refused
+    once anything had streamed, and so the reason this failure ended turns."""
+    from agents import function_tool
+
+    runs: list[str] = []
+
+    @function_tool
+    def note(text: str) -> str:
+        """Record a note."""
+        runs.append(text)
+        return "noted"
+
+    monkeypatch.setattr(lr, "build_tools", lambda *a, **k: [note])
+    unavailable = litellm.ServiceUnavailableError("down", "openai", "m", response=_resp(503))
+    llm = ScriptedLlm(
+        [
+            Call("note", {"text": "once"}),
+            Fail(unavailable, deltas=["I noted it and "]),
+            Say(["I noted it."]),
+        ]
+    )
+
+    events = await _run(monkeypatch, llm)
+
+    assert runs == ["once"]
+    assert not [e for e in events if isinstance(e, RunError)]
+    assert _answer(events) == "I noted it."
+    assert llm.inputs[1] == llm.inputs[2], "the second call re-sent as it was"
+
+
+async def test_a_tool_can_put_a_hold_on_the_turns_own_status_line(monkeypatch):
+    """P4: a sub-agent's hold is the TURN waiting — the delegating tool hands it
+    to `ctx.on_turn_status`, and the runner puts it on this turn's stream."""
+    from agents import function_tool
+
+    @function_tool
+    async def delegate(ctx: RunContextWrapper[AgentToolContext]) -> str:
+        """Delegate."""
+        assert ctx.context.on_turn_status is not None
+        ctx.context.on_turn_status(RateLimited(seconds=7))
+        return "done"
+
+    monkeypatch.setattr(lr, "build_tools", lambda *a, **k: [delegate])
+    llm = ScriptedLlm([Call("delegate", {}), Say(["ok"])])
+
+    events = await _run(monkeypatch, llm)
+
+    assert [e.seconds for e in events if isinstance(e, RateLimited)] == [7.0]
+
+
+async def test_a_delegated_failure_reaches_the_tool_card_named_and_the_model_raw(monkeypatch):
+    """P4 / D10: the card says what happened to the sub-agent; the model reads the
+    raw text, which it can act on. The failure is recorded against the CALL, so
+    whatever the tool does to its result on the way out cannot unpair them."""
+    from agents import function_tool
+
+    from workspace_app.agent.tools import _delegation
+    from workspace_app.api.events import ToolEnd
+
+    @function_tool
+    async def delegate(ctx: RunContextWrapper[AgentToolContext]) -> str:
+        """Delegate."""
+        _delegation(ctx).failed(
+            RunError(message="RateLimitError: slow", kind="rate_limited", params={"waited_s": 120})
+        )
+        return "[sub-agent ran on m]\n\nsub-agent 'x' failed: RateLimitError: slow"
+
+    monkeypatch.setattr(lr, "build_tools", lambda *a, **k: [delegate])
+    llm = ScriptedLlm([Call("delegate", {}), Say(["ok"])])
+
+    events = await _run(monkeypatch, llm)
+
+    [end] = [e for e in events if isinstance(e, ToolEnd)]
+    assert end.failure == {
+        "kind": "rate_limited",
+        "params": {"waited_s": 120},
+        "raw": "RateLimitError: slow",
+    }
+    assert "RateLimitError: slow" in end.output, "the model still reads the raw text"
+
+
+def _unavailable() -> Exception:
+    return litellm.ServiceUnavailableError("down", "openai", "m", response=_resp(503))
+
+
+async def test_a_call_that_never_recovers_ends_the_turn_named_and_counted(monkeypatch):
+    """No turn-level retry on top: the call's own retries are the whole budget,
+    and the ending says what failed and how often it was tried (D5)."""
+    llm = ScriptedLlm([Fail(_unavailable()) for _ in range(9)])
+
+    events = await _run(monkeypatch, llm, max_retries=2)
+
+    [err] = [e for e in events if isinstance(e, RunError)]
+    assert (err.kind, err.params) == ("provider_error", {"attempts": 3})
+    assert "ServiceUnavailableError" in err.message, "the raw text is the technical detail"
+    assert len(llm.inputs) == 3, "three sends of ONE call — never the turn again"
+
+
+async def test_a_rate_limit_that_never_clears_says_how_long_it_waited(monkeypatch):
+    llm = ScriptedLlm([Fail(_rate_limited("50")) for _ in range(3)])
+
+    events = await _run(monkeypatch, llm, rate_limit_budget_s=60.0)
+
+    [err] = [e for e in events if isinstance(e, RunError)]
+    assert (err.kind, err.params) == ("rate_limited", {"waited_s": 50})
+    assert len(llm.inputs) == 2
+
+
+async def test_a_request_that_is_wrong_ends_the_turn_at_once(monkeypatch):
+    bad = litellm.BadRequestError("unsupported param", "m", "openai", response=_resp(400))
+    llm = ScriptedLlm([Fail(bad), Say(["never"])])
+
+    events = await _run(monkeypatch, llm)
+
+    [err] = [e for e in events if isinstance(e, RunError)]
+    assert (err.kind, err.params) == ("bad_request", None)
+    assert len(llm.inputs) == 1
+
+
+@pytest.mark.parametrize("stream", ["1", "0"])
+async def test_the_provider_client_does_not_retry_behind_our_back(monkeypatch, stream):
+    """Found recording the demo: a 429 with `Retry-After: 4` never reached this
+    layer. litellm builds its OpenAI client with `max_retries=2`, and that client
+    waits out a short Retry-After and re-sends on its own — so the turn sat on
+    "waiting for the model" with no hold, no count and no budget charged. The
+    wrapper is the one retry layer only if every call it makes says so; this
+    goes through the real `LitellmModel` to the `acompletion` it calls.
+
+    Both shapes of a call (review round 3): the SDK hands `stream_response` its
+    settings positionally and `get_response` (WORKSPACE_AGENT_STREAM=0) by
+    keyword, and reading only the first broke every non-streamed turn."""
+    monkeypatch.setenv("WORKSPACE_AGENT_STREAM", stream)
+    seen: list[dict[str, Any]] = []
+
+    async def acompletion(**kwargs: Any) -> Any:
+        seen.append(kwargs)
+        raise litellm.BadRequestError("stop here", "m", "openai", response=_resp(400))
+
+    monkeypatch.setattr(litellm, "acompletion", acompletion)
+    runner = LitellmAgentRunner(sleep=_no_sleep)
+    ctx = AgentToolContext(investigation_id="i", agent_config=AgentConfig(name="t", model="m"))
+
+    events = [ev async for ev in runner.run("go", ctx)]
+
+    assert [e.kind for e in events if isinstance(e, RunError)] == ["bad_request"]
+    assert [(k["max_retries"], k["num_retries"]) for k in seen] == [(0, 0)]
diff --git a/tests/api/test_failure_shapes.py b/tests/api/test_failure_shapes.py
new file mode 100644
index 00000000..6a9e1f6a
--- /dev/null
+++ b/tests/api/test_failure_shapes.py
@@ -0,0 +1,265 @@
+"""docs/plan-friendly-errors.md P8 (D13): every failure the plan names, made for
+real by an HTTP endpoint and met through the path a turn takes —
+`LitellmAgentRunner` → `CallRetryModel` → the SDK's `LitellmModel` → litellm →
+its async HTTP client.
+
+The rest of this feature's tests use doubles that raise at the model layer, so
+"a dropped connection arrives as an exception" was a premise built into the
+double. It was false: litellm's aiohttp transport turns a mid-answer drop into
+a normal end, and its wrappers put an invented 5xx over a refused connection.
+Both live under every double; this file is the gate that can see them. A
+litellm upgrade or a transport change that alters a shape reddens it."""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import socket
+import threading
+import time
+from collections.abc import AsyncIterator, Callable, Iterator
+from typing import Any
+
+import pytest
+import uvicorn
+from fastapi import FastAPI, Request
+from fastapi.responses import JSONResponse, Response, StreamingResponse
+
+from workspace_app.agent.context import AgentToolContext
+from workspace_app.api.events import MessageDelta, OutputRetracted, RunError
+from workspace_app.api.litellm_runner import LitellmAgentRunner
+from workspace_app.resources import AgentConfig
+
+Reply = Callable[[], Response]
+
+
+def _chunk(delta: dict[str, Any], finish: str | None = None) -> str:
+    body = {
+        "id": "chatcmpl-shape",
+        "object": "chat.completion.chunk",
+        "created": 0,
+        "model": "demo",
+        "choices": [{"index": 0, "delta": delta, "finish_reason": finish}],
+    }
+    return f"data: {json.dumps(body)}\n\n"
+
+
+def _say(text: str) -> Reply:
+    async def body() -> AsyncIterator[str]:
+        yield _chunk({"role": "assistant", "content": ""})
+        for word in text.split(" "):
+            yield _chunk({"content": word + " "})
+            await asyncio.sleep(0.01)
+        yield _chunk({}, "stop")
+        yield "data: [DONE]\n\n"
+
+    return lambda: StreamingResponse(body(), media_type="text/event-stream")
+
+
+def _drop_after(text: str) -> Reply:
+    """Stream some text, then close the connection mid-body."""
+
+    async def body() -> AsyncIterator[str]:
+        yield _chunk({"role": "assistant", "content": ""})
+        yield _chunk({"content": text})
+        await asyncio.sleep(0.05)
+        raise ConnectionResetError("dropped mid-answer")
+
+    return lambda: StreamingResponse(body(), media_type="text/event-stream")
+
+
+def _stall_after(text: str) -> Reply:
+    """Stream some text, then go silent (no bytes, connection kept open)."""
+
+    async def body() -> AsyncIterator[str]:
+        yield _chunk({"role": "assistant", "content": ""})
+        yield _chunk({"content": text})
+        await asyncio.sleep(5)
+        yield "data: [DONE]\n\n"
+
+    return lambda: StreamingResponse(body(), media_type="text/event-stream")
+
+
+def _silent() -> Reply:
+    """Accept the request and never send a byte."""
+
+    async def body() -> AsyncIterator[str]:
+        await asyncio.sleep(5)
+        yield "data: [DONE]\n\n"
+
+    return lambda: StreamingResponse(body(), media_type="text/event-stream")
+
+
+def _status(status: int, message: str, err_type: str, **extra: Any) -> Reply:
+    headers = extra.pop("headers", None)
+    return lambda: JSONResponse(
+        {"error": {"message": message, "type": err_type, **extra}},
+        status_code=status,
+        headers=headers,
+    )
+
+
+class _Endpoint:
+    """An OpenAI-compatible endpoint that plays one reply per request, in order,
+    repeating the last, and counts the requests it got."""
+
+    def __init__(self) -> None:
+        self.replies: list[Reply] = []
+        self.hits = 0
+        app = FastAPI()
+
+        @app.post("/v1/chat/completions")
+        async def completions(_: Request) -> Response:
+            reply = self.replies[min(self.hits, len(self.replies) - 1)]
+            self.hits += 1
+            return reply()
+
+        self._server = uvicorn.Server(
+            uvicorn.Config(app, host="127.0.0.1", port=0, log_level="error", lifespan="off")
+        )
+        self._thread = threading.Thread(target=self._server.run, daemon=True)
+
+    def __enter__(self) -> _Endpoint:
+        self._thread.start()
+        deadline = time.monotonic() + 10
+        while not self._server.started:
+            assert time.monotonic() < deadline, "stand-in endpoint did not start"
+            time.sleep(0.01)
+        return self
+
+    def __exit__(self, *_: object) -> None:
+        self._server.should_exit = True
+        self._thread.join(timeout=10)
+
+    @property
+    def base_url(self) -> str:
+        port = self._server.servers[0].sockets[0].getsockname()[1]
+        return f"http://127.0.0.1:{port}/v1"
+
+
+@pytest.fixture
+def endpoint() -> Iterator[_Endpoint]:
+    with _Endpoint() as e:
+        yield e
+
+
+def _closed_port_url() -> str:
+    with socket.socket() as s:
+        s.bind(("127.0.0.1", 0))
+        port = s.getsockname()[1]
+    return f"http://127.0.0.1:{port}/v1"
+
+
+async def _no_sleep(_s: float) -> None:
+    return None
+
+
+async def _turn(base_url: str) -> list[Any]:
+    # The bounds production always sets (`factories.py`: total_deadline_s,
+    # idle_timeout_s), shortened so a silent endpoint costs a second, not minutes.
+    runner = LitellmAgentRunner(sleep=_no_sleep, max_retries=2, stream_deadlines=(1.0, 0.5))
+    config = AgentConfig(name="t", model="openai/demo", llm_base_url=base_url, llm_api_key="x")
+    ctx = AgentToolContext(investigation_id="i", agent_config=config)
+    return [ev async for ev in runner.run("go", ctx)]
+
+
+def _answer(events: list[Any]) -> str:
+    text = ""
+    for ev in events:
+        if isinstance(ev, MessageDelta) and not ev.reasoning:
+            text += ev.text
+        elif isinstance(ev, OutputRetracted):
+            text = text[: len(text) - ev.text_chars]
+    return text.strip()
+
+
+def _kinds(events: list[Any]) -> list[str | None]:
+    return [e.kind for e in events if isinstance(e, RunError)]
+
+
+FULL = "the whole answer"
+
+# (case, replies in order, the turn's error kinds, requests the endpoint got)
+RECOVERED = [
+    (
+        "429 then an answer",
+        [_status(429, "slow down", "rate_limit_error", headers={"retry-after": "1"}), _say(FULL)],
+        2,
+    ),
+    ("503 then an answer", [_status(503, "busy", "server_error"), _say(FULL)], 2),
+    ("drop mid-answer then an answer", [_drop_after("half an "), _say(FULL)], 2),
+    ("stall mid-answer then an answer", [_stall_after("half an "), _say(FULL)], 2),
+    ("silent then an answer", [_silent(), _say(FULL)], 2),
+]
+
+GIVEN_UP = [
+    ("503 every time", [_status(503, "busy", "server_error")], "provider_error", 3),
+    (
+        "401",
+        [
+            _status(
+                401, "Incorrect API key provided", "invalid_request_error", code="invalid_api_key"
+            )
+        ],
+        "auth",
+        1,
+    ),
+    (
+        "400",
+        [_status(400, "Unrecognized request argument supplied: foo", "invalid_request_error")],
+        "bad_request",
+        1,
+    ),
+    (
+        # A one-message turn has no earlier history to give up, so the trim
+        # cannot make it smaller and the first rejection is the answer.
+        "400 context too long",
+        [
+            _status(
+                400,
+                "This model's maximum context length is 8192 tokens. However, your messages "
+                "resulted in 9000 tokens.",
+                "invalid_request_error",
+                code="context_length_exceeded",
+            )
+        ],
+        "context_overflow",
+        1,
+    ),
+    ("drop mid-answer every time", [_drop_after("half an ")], "connection", 3),
+    ("stall mid-answer every time", [_stall_after("half an ")], "timeout", 3),
+    ("silent every time", [_silent()], "timeout", 3),
+]
+
+
+@pytest.mark.parametrize(("case", "replies", "hits"), RECOVERED, ids=[c[0] for c in RECOVERED])
+async def test_a_failure_that_clears_is_resent_and_the_answer_is_whole(
+    endpoint, case, replies, hits
+):
+    endpoint.replies = replies
+
+    events = await _turn(endpoint.base_url)
+
+    assert _kinds(events) == [], case
+    assert _answer(events) == FULL, case
+    assert endpoint.hits == hits, case
+
+
+@pytest.mark.parametrize(
+    ("case", "replies", "kind", "hits"), GIVEN_UP, ids=[c[0] for c in GIVEN_UP]
+)
+async def test_a_failure_that_does_not_clear_ends_the_turn_named(
+    endpoint, case, replies, kind, hits
+):
+    endpoint.replies = replies
+
+    events = await _turn(endpoint.base_url)
+
+    assert _kinds(events) == [kind], case
+    assert endpoint.hits == hits, case
+
+
+async def test_an_endpoint_nobody_listens_on_is_named_as_unreachable():
+    events = await _turn(_closed_port_url())
+
+    assert _kinds(events) == ["connection"]
