+# between 2026-10-22 and 10-29, and the same master went red there — its newer
+# glibc refuses the carrier launcher's `ld-linux … python3` start ("Security
+# violation: Requested utility `python3` does not match executable name") and
+# the kb zip / document-render tests fail with it. Move this to 26.04 when the
+# code runs there (#1000), not by letting `latest` drift.
 jobs:
   # Lint / format / type — split out of the test matrix so it runs ONCE, not
   # once per shard. It's fast (seconds), so it never gates wall-clock time.
   backend-lint:
-    runs-on: ubuntu-latest
+    runs-on: ubuntu-24.04
     steps:
       - uses: actions/checkout@v4
 
@@ -84,7 +90,7 @@ jobs:
