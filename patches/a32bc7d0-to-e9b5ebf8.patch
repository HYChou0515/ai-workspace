diff --git a/web/src/hooks/useSameShape.ts b/web/src/hooks/useSameShape.ts
new file mode 100644
index 00000000..e354ade1
--- /dev/null
+++ b/web/src/hooks/useSameShape.ts
@@ -0,0 +1,19 @@
+import { useRef } from "react";
+
+import { sameShape } from "../lib/sameShape";
+
+/**
+ * `value`, or the previous render's value when it has the same shape
+ * (`sameShape`) — so a value recomputed on every render keeps its identity
+ * until its CONTENT changes, and a `memo`'d child or a context consumer that
+ * receives it is not redrawn for nothing.
+ *
+ * Built for the chat feed: a value derived from `log.entries` is recomputed on
+ * every streamed token, while what it says (which questions are answered)
+ * changes once in a whole turn.
+ */
+export function useSameShape<T>(value: T): T {
+  const kept = useRef(value);
+  if (kept.current !== value && !sameShape(kept.current, value)) kept.current = value;
+  return kept.current;
+}
diff --git a/web/src/hooks/useStableActions.ts b/web/src/hooks/useStableActions.ts
new file mode 100644
index 00000000..9525622d
--- /dev/null
+++ b/web/src/hooks/useStableActions.ts
@@ -0,0 +1,29 @@
+import { useMemo, useRef } from "react";
+
+type AnyFn = (...args: never[]) => unknown;
+
+/**
+ * `impl`'s functions behind proxies whose identity holds across renders: each
+ * proxy calls the LATEST `impl` at call time. The object is rebuilt only when
+ * the set of present actions changes (an action offered or withdrawn), which is
+ * when a row has a different affordance to draw.
+ *
+ * Only for functions called LATER — on a click, a submit. A function called
+ * while drawing (a URL resolver) must stay an ordinary prop: behind a proxy its
+ * identity never changes, so a memo'd child never learns its answer did.
+ */
+export function useStableActions<T extends Record<string, AnyFn | undefined>>(impl: T): T {
+  const latest = useRef(impl);
+  latest.current = impl;
+  const present = Object.keys(impl)
+    .filter((k) => impl[k] !== undefined)
+    .sort()
+    .join(",");
+  return useMemo(() => {
+    const out: Record<string, AnyFn> = {};
+    for (const key of present ? present.split(",") : []) {
+      out[key] = (...args: never[]) => (latest.current[key] as AnyFn)(...args);
+    }
+    return out as T;
+  }, [present]);
+}
