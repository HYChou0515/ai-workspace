         working-directory: view-plugins/chart/sandbox-src
@@ -294,7 +300,7 @@ jobs:
           uv run coverage report --fail-under=100
 
   frontend-test:
-    runs-on: ubuntu-latest
+    runs-on: ubuntu-24.04
