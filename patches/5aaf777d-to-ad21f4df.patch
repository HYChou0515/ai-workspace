+    await user.click(screen.getByTestId("dialog-action-discard"));
+
+    expect(onClose).toHaveBeenCalledTimes(1);
+  });
+
+  it("keeps the modal open when the user chooses to keep editing", async () => {
+    const user = userEvent.setup();
+    const onClose = vi.fn();
