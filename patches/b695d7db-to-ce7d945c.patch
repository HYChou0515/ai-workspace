+    log: list[Any] = []
+    replies: dict[str, list[Any]] = {}
+
+    def keep(name: str):
+        def on_complete(produced: list[Any]) -> None:
+            replies[name] = [
+                (m.role, m.created_at if m.role == PLACE_ROLE else m.content) for m in produced
+            ]
+
+        return on_complete
+
+    f1 = engine.enqueue(
+        "chat",
+        "Q1",
+        AgentToolContext(),
+        on_complete=keep("Q1"),
+        message=_message("ann", 1, log, place=False),
