+
+def _provider_retries_off(settings: ModelSettings) -> ModelSettings:
+    """`resolve` merges `extra_args`, so the call's own (`num_ctx`, `think`)
+    survive."""
+    return settings.resolve(_PROVIDER_RETRIES_OFF)
