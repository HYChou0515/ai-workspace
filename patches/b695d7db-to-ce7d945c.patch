+// @vitest-environment happy-dom
+import "@testing-library/jest-dom/vitest";
+import { act, cleanup, fireEvent, render, screen } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+
+import { translate } from "../lib/i18n";
+import { ErrorNotice } from "./ErrorNotice";
+
+const zh = (key: Parameters<typeof translate>[1], vars?: Record<string, string | number>) =>
+  translate("zh-TW", key, vars);
+
+const RAW = "RateLimitError: litellm.RateLimitError: slow down";
+
+describe("ErrorNotice (docs/plan-friendly-errors.md D1)", () => {
+  afterEach(cleanup);
+
+  it("says what happened and what to do — not the provider's string", () => {
+    render(<ErrorNotice failure={{ kind: "rate_limited", params: { waited_s: 120 }, raw: RAW }} />);
+
+    const notice = screen.getByTestId("error-notice");
+    expect(notice).toHaveTextContent(zh("failure.rate_limited.waited", { waited_s: 120 }));
+    expect(notice).toHaveTextContent(zh("failure.rate_limited.do"));
+  });
+
+  it("keeps the raw text for whoever debugs it, collapsed until asked for", () => {
+    render(<ErrorNotice failure={{ kind: "rate_limited", raw: RAW }} />);
+
+    const details = screen.getByTestId("error-notice-details");
+    expect(details.tagName).toBe("DETAILS");
+    expect(details).not.toHaveAttribute("open");
+    expect(details).toHaveTextContent(zh("failure.details"));
+    expect(details).toHaveTextContent(RAW);
+  });
+
+  it("copies the raw text exactly, so a report carries what was really said", async () => {
+    const writeText = vi.fn().mockResolvedValue(undefined);
+    Object.defineProperty(navigator, "clipboard", { value: { writeText }, configurable: true });
+    render(<ErrorNotice failure={{ kind: "timeout", raw: RAW }} />);
+
+    await act(async () => {
+      fireEvent.click(screen.getByRole("button", { name: zh("failure.copy") }));
+    });
+
+    expect(writeText).toHaveBeenCalledWith(RAW);
+    expect(screen.getByRole("button", { name: zh("failure.copied") })).toBeInTheDocument();
+  });
+
+  it("offers no copy button that would do nothing — an http deploy has no clipboard", () => {
+    Object.defineProperty(navigator, "clipboard", { value: undefined, configurable: true });
+    render(<ErrorNotice failure={{ kind: "timeout", raw: RAW }} />);
+
+    expect(screen.getByTestId("error-notice-details")).toHaveTextContent(RAW);
+    expect(screen.queryByRole("button", { name: zh("failure.copy") })).toBeNull();
+  });
+
+  it("words an old row's `error` as unknown, with its text under details", () => {
+    render(<ErrorNotice failure={{ kind: "error", raw: "giving up after 3 attempts: Boom" }} />);
+
+    expect(screen.getByTestId("error-notice")).toHaveTextContent(zh("failure.unknown.what"));
+    expect(screen.getByTestId("error-notice-details")).toHaveTextContent("giving up after 3 attempts");
+  });
+
+  it("has no details to open when there is nothing technical to show", () => {
+    render(<ErrorNotice failure={{ kind: "quota", headline: "工作區已滿", raw: "" }} />);
+
+    expect(screen.getByTestId("error-notice")).toHaveTextContent("工作區已滿");
+    expect(screen.queryByTestId("error-notice-details")).toBeNull();
+  });
+
+  it("announces a live failure to assistive tech, and only a live one", () => {
+    const { rerender } = render(<ErrorNotice failure={{ kind: "auth", raw: RAW }} live />);
+    expect(screen.getByTestId("error-notice")).toHaveAttribute("role", "alert");
+
+    rerender(<ErrorNotice failure={{ kind: "auth", raw: RAW }} />);
+    expect(screen.getByTestId("error-notice")).not.toHaveAttribute("role");
+  });
+});
diff --git a/web/src/components/ErrorNotice.tsx b/web/src/components/ErrorNotice.tsx
new file mode 100644
index 00000000..c57ae108
--- /dev/null
+++ b/web/src/components/ErrorNotice.tsx
@@ -0,0 +1,98 @@
+/**
+ * A failure, said so a reader can act on it (docs/plan-friendly-errors.md D1):
+ * what happened, what they can do, and — collapsed, with a copy button — the
+ * raw text for whoever debugs it. Everyone can open it: a person reporting a
+ * problem pastes it, and "it said there was an error" is all a report carries
+ * otherwise.
+ *
+ * The one component for every surface that shows a failure, so a turn's error
+ * box, its persisted banner and a job's status line read alike.
+ */
+import { type ReactNode, useState } from "react";
+
+import { describeFailure, type Failure } from "../lib/failure";
+import { useLocale, useT } from "../lib/i18n";
+import { pxToRem } from "../lib/pxToRem";
+import { ResourceLinkText } from "./ResourceLinkText";
+
+export function ErrorNotice({
+  failure,
+  live = false,
+  children,
+}: {
+  failure: Failure;
+  /** A failure happening NOW (the turn's own error box) is announced; one
+   *  re-read from the thread is not. */
+  live?: boolean;
+  /** What else the surface offers beside it (the environments a quota refusal
+   *  is holding). */
+  children?: ReactNode;
+}) {
+  const [locale] = useLocale();
+  const { headline, action, details } = describeFailure(failure, locale);
+
+  return (
+    <div
+      data-testid="error-notice"
+      role={live ? "alert" : undefined}
+      style={{
+        padding: "8px 10px",
+        border: "1px solid var(--err)",
+        borderRadius: "var(--radius-card)",
+        fontSize: pxToRem(13),
+        lineHeight: 1.5,
+        // A long raw message must not stretch the chat column.
+        overflowWrap: "anywhere",
+      }}
+    >
+      {/* #692: a refusal that names /my-resources links there. */}
+      <div style={{ fontWeight: 600, color: "var(--err)" }}>
+        <ResourceLinkText text={headline} />
+      </div>
+      {action && <div style={{ color: "var(--text-paper-d)" }}>{action}</div>}
+      {children}
+      {details && <FailureDetails raw={details} />}
+    </div>
+  );
+}
+
+/** The raw text of a failure, collapsed under "technical details" with a copy
+ *  button — the one shape every surface that shows a failure uses for it, so a
+ *  person reporting a problem finds it in the same place everywhere. */
+export function FailureDetails({ raw }: { raw: string }) {
+  const t = useT();
+  const [copied, setCopied] = useState(false);
+  return (
+    <details data-testid="error-notice-details" style={{ marginTop: 4 }}>
+      <summary style={{ cursor: "pointer", fontSize: pxToRem(12), color: "var(--text-paper-d)" }}>
+        {t("failure.details")}
+      </summary>
+      <pre
+        style={{
+          margin: "4px 0",
+          whiteSpace: "pre-wrap",
+          fontFamily: "var(--font-mono)",
+          fontSize: pxToRem(12),
+        }}
+      >
+        {raw}
+      </pre>
+      {/* No clipboard API on a plain-http deploy: no button that does
+          nothing — the text above can still be selected. */}
+      {typeof navigator !== "undefined" && navigator.clipboard && (
+        <button
+          type="button"
+          className="btn"
+          onClick={() => {
+            navigator.clipboard.writeText(raw).then(
+              () => setCopied(true),
+              () => setCopied(false),
+            );
+          }}
+        >
+          {copied ? t("failure.copied") : t("failure.copy")}
+        </button>
+      )}
+    </details>
+  );
+}
