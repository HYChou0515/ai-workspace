new file mode 100644
index 00000000..24590411
--- /dev/null
+++ b/web/src/pages/investigation/turnNote.test.ts
@@ -0,0 +1,30 @@
+// docs/plan-interjection.md Q2/Q7: what the composer says while a turn runs.
+import { describe, expect, it } from "vitest";
+
+import { EMPTY_LOG, type AgentLog } from "./agentLog";
+import { turnNote } from "./turnNote";
+
+const running = (by: string | null): AgentLog => ({ ...EMPTY_LOG, streaming: true, streamingBy: by });
+
+describe("turnNote", () => {
+  it("says nothing when no turn runs", () => {
+    expect(turnNote(EMPTY_LOG, "ann")).toBeNull();
+  });
+
+  it("on your own running turn: what a message sent now can and cannot change", () => {
+    expect(turnNote(running("ann"), "ann")).toEqual({ kind: "own" });
+  });
+
+  it("on someone else's running turn: sending takes it over", () => {
+    expect(turnNote(running("bob"), "ann")).toEqual({ kind: "others", who: "bob" });
+  });
+
+  it("says nothing until it knows who you are, rather than calling your own turn someone else's", () => {
+    expect(turnNote(running("ann"), undefined)).toBeNull();
+    expect(turnNote(running("ann"), null)).toBeNull();
+  });
+
+  it("a turn nobody is named for (a goal round, a reload) is not claimed as anyone's", () => {
+    expect(turnNote(running(null), "ann")).toBeNull();
+  });
+});
diff --git a/web/src/pages/investigation/turnNote.ts b/web/src/pages/investigation/turnNote.ts
new file mode 100644
index 00000000..8e96506a
--- /dev/null
+++ b/web/src/pages/investigation/turnNote.ts
@@ -0,0 +1,22 @@
+import type { AgentLog } from "./agentLog";
+
+/** What the composer says while a turn runs (docs/plan-interjection.md).
+ *
+ * - `own`: your turn is running. A message sent now is read after the AI's
+ *   current step (Q1) — and the turn's reasoning effort and disclosure were
+ *   settled when it started, so changing them now does not reach it (Q7).
+ * - `others`: someone else's turn is running. A turn runs as one person, so a
+ *   message sent now stops it and yours takes over (Q2) — said before you send,
+ *   not discovered after.
+ *
+ * Shared by both chat panels so they cannot come to say different things. */
+export type TurnNote = { kind: "own" } | { kind: "others"; who: string };
+
+export function turnNote(log: AgentLog, me: string | null | undefined): TurnNote | null {
+  if (!log.streaming || log.streamingBy == null) return null;
+  // Not yet known who is signed in: "someone else's turn" would be a guess, and
+  // for your own turn a wrong one — say nothing until it is known.
+  if (me == null) return null;
+  if (log.streamingBy === me) return { kind: "own" };
+  return { kind: "others", who: log.streamingBy };
+}
