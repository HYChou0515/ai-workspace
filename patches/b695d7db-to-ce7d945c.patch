+import { describe, expect, it } from "vitest";
+
+import { describeFailure, docFailure, failureFromHttp } from "./failure";
+import { translate } from "./i18n";
+
+const zh = (key: Parameters<typeof translate>[1], vars?: Record<string, string | number>) =>
+  translate("zh-TW", key, vars);
+
+describe("describeFailure (docs/plan-friendly-errors.md D1/D5)", () => {
+  it("words a rate limit from its kind, with how long it waited, and keeps the raw text", () => {
+    const out = describeFailure(
+      { kind: "rate_limited", params: { waited_s: 120 }, raw: "RateLimitError: litellm.RateLimitError: slow down" },
+      "zh-TW",
+    );
+
+    expect(out.headline).toBe(zh("failure.rate_limited.waited", { waited_s: 120 }));
+    expect(out.headline).toContain("120");
+    expect(out.action).toBe(zh("failure.rate_limited.do"));
+    expect(out.details).toBe("RateLimitError: litellm.RateLimitError: slow down");
+  });
+
+  it("has copy for every kind the backend names", () => {
+    // `failover.classify.ERROR_KINDS` — kept in step by hand, so a kind the
+    // backend adds without copy shows up here as the unknown wording.
+    for (const kind of [
+      "rate_limited",
+      "all_busy",
+      "auth",
+      "timeout",
+      "connection",
+      "provider_error",
+      "context_overflow",
+      "bad_request",
+      "unknown",
+    ]) {
+      const out = describeFailure({ kind, raw: "x" }, "zh-TW");
+      expect(out.headline, kind).not.toBe("");
+      expect(out.action, kind).not.toBeNull();
+      if (kind !== "unknown") expect(out.headline, kind).not.toBe(zh("failure.unknown.what"));
+    }
+  });
+
+  it("reads a kind it has no copy for — and an old row's `error` — as unknown", () => {
+    for (const kind of ["error", "something_new"]) {
+      const out = describeFailure({ kind, raw: "Boom: it broke" }, "zh-TW");
+      expect(out.headline).toBe(zh("failure.unknown.what"));
+      expect(out.details).toBe("Boom: it broke");
+    }
+  });
+
+  it("says nothing about how long or how often when the backend did not count it", () => {
+    const out = describeFailure({ kind: "timeout", raw: "TimeoutError: slow" }, "zh-TW");
+    expect(out.headline).toBe(zh("failure.timeout.what"));
+    expect(out.headline).not.toContain("{");
+  });
+
+  it("lets a writer that already has the whole sentence keep it", () => {
+    const out = describeFailure(
+      { kind: "quota", headline: "工作區已滿", raw: "507 Insufficient Storage" },
+      "zh-TW",
+    );
+    expect(out.headline).toBe("工作區已滿");
+    expect(out.details).toBe("507 Insufficient Storage");
+  });
+
+  it("has no details to show when the raw text says nothing the headline did not", () => {
+    expect(describeFailure({ kind: "unknown", raw: "" }, "zh-TW").details).toBeNull();
+    expect(
+      describeFailure({ kind: "quota", headline: "工作區已滿", raw: "工作區已滿" }, "zh-TW").details,
+    ).toBeNull();
+  });
+});
+
+describe("failureFromHttp — our own API refusing a request (docs/plan-friendly-errors.md P6)", () => {
+  it("names a permission refusal and a server fault, and keeps the status line as details", () => {
+    const forbidden = describeFailure(
+      failureFromHttp(Object.assign(new Error("messages failed: 403"), { status: 403 })),
+      "zh-TW",
+    );
+    expect(forbidden.headline).toBe(zh("failure.forbidden.what"));
+    expect(forbidden.details).toBe("messages failed: 403");
+
+    const fault = describeFailure(
+      failureFromHttp(Object.assign(new Error("messages failed: 500"), { status: 500 })),
+      "zh-TW",
+    );
+    expect(fault.headline).toBe(zh("failure.server_error.what"));
+    expect(fault.action).toBe(zh("failure.server_error.do"));
+  });
+
+  it("does not guess at anything else — the raw text stays, under unknown", () => {
+    const out = describeFailure(
+      failureFromHttp(Object.assign(new Error("messages failed: 409"), { status: 409 })),
+      "zh-TW",
+    );
+    expect(out.headline).toBe(zh("failure.unknown.what"));
+    expect(out.details).toBe("messages failed: 409");
+  });
+});
+
+describe("docFailure — a document that failed to process (docs/plan-friendly-errors.md P5)", () => {
+  it("words it from the kind the backend named, keeping the detail as the raw text", () => {
+    const f = docFailure(
+      { status_detail: "RateLimitError: slow down", status_error_kind: "rate_limited" },
+      "zh-TW",
+    );
+    expect(describeFailure(f, "zh-TW").headline).toBe(zh("failure.rate_limited.what"));
+    expect(describeFailure(f, "zh-TW").details).toBe("RateLimitError: slow down");
+  });
+
+  it("falls back to the page's own sentence when nothing named it — an older row, an interruption", () => {
+    const f = docFailure({ status_detail: "processing was interrupted", status_error_kind: null }, "zh-TW");
+    expect(describeFailure(f, "zh-TW").headline).toBe("處理失敗");
+    expect(describeFailure(f, "zh-TW").details).toBe("processing was interrupted");
+  });
+});
+
+describe("a document failure's remedy is a document's, not a chat's (P5)", () => {
+  it("offers re-reading the document rather than sending a message again", () => {
+    const f = docFailure(
+      { status_detail: "RateLimitError: slow down", status_error_kind: "rate_limited" },
+      "zh-TW",
+    );
+    expect(describeFailure(f, "zh-TW").action).toBe(zh("kb.doc.failedAction"));
+    expect(describeFailure(f, "zh-TW").action).not.toBe(zh("failure.rate_limited.do"));
+  });
+});
+
+describe("review round 1 — failure copy", () => {
+  it("keeps a surface's own remedy even when the headline is the surface's too", () => {
+    const f = docFailure({ status_detail: "processing was interrupted", status_error_kind: null }, "zh-TW");
+    expect(describeFailure(f, "zh-TW").action).toBe(zh("kb.doc.failedAction"));
+  });
+
+  it("words a lost turn with how often it was tried, and tells the reader to send again", () => {
+    const out = describeFailure(
+      { kind: "turn_lost", params: { attempts: 3 }, raw: "The assistant could not finish…" },
+      "zh-TW",
+    );
+    expect(out.headline).toBe(zh("failure.turn_lost.tried", { attempts: 3 }));
+    expect(out.action).toBe(zh("failure.turn_lost.do"));
+  });
+
+  it("words a failed Stop and a dropped stream in the language shown NOW, not when it happened", () => {
+    for (const kind of ["stop_failed", "stream_dropped"]) {
+      const en = describeFailure({ kind, raw: "x" }, "en").headline;
+      const tw = describeFailure({ kind, raw: "x" }, "zh-TW").headline;
+      expect(en, kind).not.toBe(tw);
+      expect(tw, kind).not.toBe(zh("failure.unknown.what"));
+    }
+  });
+
+  it("says what the user approved (D5)", () => {
+    expect(zh("failure.rate_limited.do")).toBe(
+      "過幾分鐘再送一次；常發生請管理員提高額度或加備援模型。",
+    );
+    expect(zh("failure.context_overflow.do")).toBe("請把訊息拆小，或開一個新對話重試。");
+  });
+});
+
+describe("review round 2 — the counted copy says what happened", () => {
+  it("counts tries as tries: three sends are not three RE-sends", () => {
+    // `attempts` is every send (`ModelCallFailed.attempts`): max_retries=2 → 3.
+    const tw = describeFailure({ kind: "timeout", params: { attempts: 3 }, raw: "x" }, "zh-TW").headline;
+    expect(tw).toBe("模型太久沒有回應，試了 3 次都沒能完成。");
+    expect(tw).not.toContain("重試 3 次");
+  });
+
+  it("never says it waited 0 seconds — a wait that could not fit was not waited at all", () => {
+    const out = describeFailure({ kind: "rate_limited", params: { waited_s: 0 }, raw: "x" }, "zh-TW");
+    expect(out.headline).toBe(zh("failure.rate_limited.what"));
+  });
+});
diff --git a/web/src/lib/failure.ts b/web/src/lib/failure.ts
new file mode 100644
index 00000000..34dc9c69
--- /dev/null
+++ b/web/src/lib/failure.ts
@@ -0,0 +1,151 @@
+/**
+ * A failure as the reader is shown it (docs/plan-friendly-errors.md D1/D5):
+ * what happened, what they can do, and — collapsed, for whoever debugs it —
+ * the raw text the backend kept.
+ *
+ * The backend names the failure (`failover.classify.ERROR_KINDS`) and keeps
+ * the raw text as the message; the WORDS are chosen here, in the reader's
+ * language. A kind with no copy — a newer backend, or a row persisted before
+ * kinds existed (`error`) — reads as `unknown`: never the raw string as the
+ * whole message, which is what this exists to stop.
+ */
+
+import { type Locale, type MsgKey, translate } from "./i18n";
+
+export type Failure = {
+  /** The backend's kind, or a front-end one (`quota`, `send_failed`, …). */
+  kind: string;
+  /** The numbers the kind's copy says (`waited_s`, `attempts`). */
+  params?: Record<string, number> | null;
+  /** The technical details: the raw text, as the backend or the request kept it. */
+  raw: string;
+  /** For a writer that already has the whole sentence (a quota refusal). */
+  headline?: string;
+  /** What to do, when the surface's remedy is not the kind's own — a document
+   *  is re-read, not sent again. */
+  action?: string;
+};
+
+export type FailureText = {
+  headline: string;
+  /** What the reader can do about it; null when the writer's own headline says it. */
+  action: string | null;
+  /** The raw text, or null when it says nothing the headline did not. */
+  details: string | null;
+};
+
+/** Kinds with their own copy. Anything else is `unknown`. */
+const WORDED = new Set([
+  "rate_limited",
+  "all_busy",
+  "auth",
+  "timeout",
+  "connection",
+  "provider_error",
+  "context_overflow",
+  "bad_request",
+  "unknown",
+  // Our own API (P6, `failureFromHttp`).
+  "forbidden",
+  "server_error",
+  // Named by the app itself (review round 1): a turn given up after its pod
+  // was replaced too often, a Stop that did not get through, our own stream.
+  "turn_lost",
+  "stop_failed",
+  "stream_dropped",
+]);
+
+/** The variant of a kind's headline that says the number, when it was counted. */
+const COUNTED: Record<string, { param: string; key: MsgKey }> = {
+  rate_limited: { param: "waited_s", key: "failure.rate_limited.waited" },
+  timeout: { param: "attempts", key: "failure.timeout.tried" },
+  turn_lost: { param: "attempts", key: "failure.turn_lost.tried" },
+};
+
+/** A failure caught in the browser (a request that was refused, a stream that
+ *  dropped): the thrown message is its technical details. */
+export function failureFromError(err: unknown, kind = "unknown", headline?: string): Failure {
+  const raw = err instanceof Error ? err.message : String(err);
+  return headline === undefined ? { kind, raw } : { kind, raw, headline };
+}
+
+/** A request OUR API refused (P6). Only the two answers with a remedy of their
+ *  own are named — "ask for access" and "the server broke, not you"; any other
+ *  status is `unknown` with its status line kept as the details, rather than
+ *  copy guessed for a status nobody has seen in this app. */
+export function failureFromHttp(err: unknown): Failure {
+  const status = (err as { status?: number } | null)?.status;
+  if (status === 403) return failureFromError(err, "forbidden");
+  if (status !== undefined && status >= 500) return failureFromError(err, "server_error");
+  return failureFromError(err);
+}
+
+/** A document that failed to process (P5): worded from the kind the backend
+ *  named its exception by; with no kind (a row from before kinds, or a failure
+ *  that was a sentence to begin with — "processing was interrupted") the page's
+ *  own `fallback` is the headline. The detail is the raw text either way. */
+export function docFailure(
+  doc: { status_detail?: string | null; status_error_kind?: string | null },
+  locale: Locale,
+): Failure {
+  const raw = doc.status_detail ?? "";
+  // The kind's own remedy is a chat's ("send it again", "split the message");
+  // a document's is to re-read it.
+  const action = translate(locale, "kb.doc.failedAction");
+  return doc.status_error_kind
+    ? { kind: doc.status_error_kind, raw, action }
+    : { kind: "doc_failed", headline: translate(locale, "kb.doc.processingFailed"), raw, action };
+}
+
+/** A workflow run that ended in error (P5), from its `result` — null when it
+ *  recorded none. A step's own failure leads with its REASON, which was written
+ *  for the reader; anything else is worded from its kind. */
+export function runFailure(result: Record<string, unknown> | null | undefined): Failure | null {
+  const raw = result?.error;
+  if (typeof raw !== "string") return null;
+  const kind = typeof result?.error_kind === "string" ? result.error_kind : "unknown";
+  const reason = result?.error_reason;
+  if (kind === "step_failed" && typeof reason === "string" && reason) {
+    return { kind, headline: reason, raw };
+  }
+  return { kind, raw };
+}
+
+/** One line for a developer's log: the headline, then the raw text. */
+export function failureLine(failure: Failure, locale: Locale): string {
+  const { headline, details } = describeFailure(failure, locale);
+  return details ? `${headline} — ${details}` : headline;
+}
+
+/** What happened, in one sentence, for ``kind`` — the red box's headline when
+ * there is no number to say, and the retry status's opening (D14). One source,
+ * so the two cannot drift apart. */
+export function failureWhat(kind: string, locale: Locale): string {
+  return translate(locale, `failure.${WORDED.has(kind) ? kind : "unknown"}.what` as MsgKey);
+}
+
+export function describeFailure(failure: Failure, locale: Locale): FailureText {
+  const raw = failure.raw.trim();
+  if (failure.headline) {
+    return {
+      headline: failure.headline,
+      action: failure.action ?? null,
+      details: raw && raw !== failure.headline ? raw : null,
+    };
+  }
+  const kind = WORDED.has(failure.kind) ? failure.kind : "unknown";
+  const counted = COUNTED[kind];
+  const n = counted ? failure.params?.[counted.param] : undefined;
+  // Only a number that happened: a wait that could not fit the budget gave up
+  // before waiting at all (`waited_s` 0), and "waited about 0 seconds" is not
+  // something that occurred (review round 2).
+  const headline =
+    counted && n != null && n > 0
+      ? translate(locale, counted.key, { [counted.param]: n })
+      : failureWhat(kind, locale);
+  return {
+    headline,
+    action: failure.action ?? translate(locale, `failure.${kind}.do` as MsgKey),
+    details: raw || null,
+  };
+}
