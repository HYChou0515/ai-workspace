     doc = (_REPO / "docs" / "deployment.md").read_text("utf-8")
-    section = doc[doc.index("### 15.6") : doc.index("### 15.7")]
+    section = _section(doc, "工具憑證")
 
     assert "這是**你**取的" in section
     assert "和作者的 command 叫什麼無關" in section
