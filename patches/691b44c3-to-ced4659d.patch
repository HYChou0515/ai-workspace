+    assert capped.count("B") <= 60 and capped.count("C") <= 60  # a window, not the whole thing
+    assert prompt_for(0).count("B") == 0 and "alpha" in prompt_for(0)  # 0 = the bare hit
+    assert prompt_for(None).count("B") == 3000  # None = uncapped
+
+
