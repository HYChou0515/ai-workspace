+        items: [],
+        dirs: ["/dist/assets"],
+        unwalked: ["/dist/assets"],
+        truncated: false,
+      },
+    });
+    renderWithQuery(
+      <FileServiceProvider value={svc}>
+        <FileTree
+          files={[{ path: "/src/a.py", size: 1 }]}
+          dirs={["/src", "/dist"]}
+          unwalked={["/dist"]}
+          activePath={null}
+          onOpen={onOpen}
