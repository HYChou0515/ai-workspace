+    real_edit = ctx.context.files.edit
+
+    async def revoke_then_edit(*a, **k):
+        out = await real_edit(*a, **k)
+        rm = spec.get_resource_manager(RcaInvestigation)  # ty: ignore[unresolved-attribute]
+        with rm.using("bob") as op:
