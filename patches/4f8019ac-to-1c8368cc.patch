+    seen: dict[str, str] = {}
+
+    class _Response:
+        def read(self) -> bytes:
+            return b"{}"
+
+        def __enter__(self):
+            return self
+
+        def __exit__(self, *_):
+            return False
+
+    def urlopen(request):
+        seen.update(request.headers)
+        return _Response()
