+        kwarg = m.group(1)
+        # It has to arrive AND leave: `create_app` must accept the parameter and
+        # pass it on, not merely have a name that looks like it.
+        if f"{kwarg}=" not in app or app.count(f"{kwarg}") < 2:
+            dropped.append(kwarg)
