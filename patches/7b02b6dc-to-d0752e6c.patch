--- /dev/null
+++ b/sample-tools/job-tool-template/template/tests/test_envfile.py
@@ -0,0 +1,47 @@
+"""`env.json` is written from the contract, never by hand (D19)."""
+
+from __future__ import annotations
+
+import json
+
+from backends import SPEC, Minimal
+
+from job_contract import Contract, EnvVar, Idempotency
+from job_tool.envfile import render, write
+
+
+def _backend(env):
+    class Declared(Minimal):
+        contract = Contract(spec_schema=SPEC, idempotency=Idempotency(fields=("image",)), env=env)
+
+    return Declared
+
+
+def test_each_variable_carries_only_what_was_said_about_it():
+    rendered = render(
+        _backend(
+            (
+                EnvVar("GPU_API_TOKEN", "Personal token from the cluster portal", required=True),
+                EnvVar("GPU_API_BASE"),
+            )
+        ).contract
+    )
+
+    # An unsaid `required` stays unsaid: it is a third state, not `false`.
+    assert json.loads(rendered) == [
+        {
+            "name": "GPU_API_TOKEN",
+            "description": "Personal token from the cluster portal",
+            "required": True,
+        },
+        {"name": "GPU_API_BASE"},
+    ]
+
+
+def test_saying_nothing_writes_no_file_and_needing_nothing_writes_an_empty_one(tmp_path):
+    write(tmp_path, _backend(()).contract)
+    assert json.loads((tmp_path / "env.json").read_text()) == []
+
+    # Said nothing: the file goes, so the panel reports "did not say".
+    write(tmp_path, _backend(None).contract)
+    assert not (tmp_path / "env.json").exists()
diff --git a/sample-tools/job-tool-template/template/tests/test_identity_check.py b/sample-tools/job-tool-template/template/tests/test_identity_check.py
new file mode 100644
index 00000000..54ac0dbb
--- /dev/null
+++ b/sample-tools/job-tool-template/template/tests/test_identity_check.py
@@ -0,0 +1,119 @@
+"""The check the shape tests run on an author's `identity` (D49): a gate that
+exists is only a gate if it fails on what it guards against."""
+
+from __future__ import annotations
+
+import itertools
+from pathlib import Path
+
+from backends import SPEC, HashDrift
+
+from job_contract import Contract, Idempotency
+from job_tool.shape import identity_drift_across_processes, identity_problems
+
+EXAMPLE = {"image": "trainer:3", "command": "train.py"}
+
+
+def _contract(identity, example=EXAMPLE):
+    rule = type("Rule", (Idempotency,), {"identity": identity})(fields=("image", "command"))
+    return Contract(spec_schema=SPEC, idempotency=rule, example_spec=example)
+
+
+def test_a_steady_sameness_passes():
+    assert identity_problems(_contract(lambda self, spec: {"image": spec["image"].lower()})) == []
+
+
+def test_a_sameness_that_changes_between_two_calls_is_caught():
+    tick = itertools.count()
+    problems = identity_problems(_contract(lambda self, spec: {"n": next(tick)}))
+    assert any("same" in p for p in problems)
+
+
+def test_a_sameness_that_cannot_be_written_as_json_is_caught():
+    problems = identity_problems(_contract(lambda self, spec: {"at": object()}))
+    assert any("JSON" in p for p in problems)
+
+
+def test_an_example_the_spec_schema_rejects_is_caught():
+    problems = identity_problems(_contract(lambda self, spec: spec, example={"image": 3}))
+    assert any("example_spec" in p for p in problems)
+
+
+TESTS = str(Path(__file__).resolve().parent)
+
+
+def test_a_sameness_that_changes_from_one_process_to_the_next_is_caught():
+    # Every tool call is a new process: an identity steady within one process
+    # but not across them makes every resubmit a new job. Twice in-process
+    # cannot see it.
+    assert identity_problems(HashDrift.contract) == []  # the in-process check passes
+    problems = identity_drift_across_processes("backends:HashDrift", extra_path=[TESTS])
+    assert any("process" in p for p in problems)
+
+
+def test_a_two_element_set_is_caught_too():
+    # Two strings have two orders; five fixed seeds put img23/train.py in the
+    # same one every time, so the check passed what production would break.
+    problems = identity_drift_across_processes("backends:PairDrift", extra_path=[TESTS])
+    assert any("process" in p for p in problems)
+
+
+def test_what_the_backend_prints_on_import_is_not_mistaken_for_its_answer():
+    # A timestamped banner differs in every process; the identity does not.
+    assert identity_drift_across_processes("probe_backends:Noisy", extra_path=[TESTS]) == []
+
+
+def test_a_probe_that_cannot_load_the_backend_says_why(monkeypatch):
+    import probe_backends  # noqa: F401 - loaded here first, so only the probes are refused
+
+    monkeypatch.setenv("PROBE_BREAK_IMPORT", "1")
+
+    problems = identity_drift_across_processes("probe_backends:Noisy", extra_path=[TESTS])
+
+    (problem,) = problems
+    # The exception's own message — not the traceback frames that precede it,
+    # which a long path would let crowd the message out.
+    assert "RuntimeError: set ACME_TOKEN" in problem
+    assert "probe_backends.py" not in problem
+    # The reason, not a 5000-character wall of it.
+    assert len(problem) < 600
+
+
+def test_a_banner_left_without_a_newline_does_not_swallow_the_answer(monkeypatch):
+    monkeypatch.setenv("PROBE_BANNER_NO_NEWLINE", "1")
+    assert identity_drift_across_processes("probe_backends:Noisy", extra_path=[TESTS]) == []
+
+
+def test_a_probe_that_takes_too_long_is_a_named_problem(monkeypatch):
+    import probe_backends  # noqa: F401 - loaded here first, so only the probes are slow
+
+    monkeypatch.setenv("PROBE_SLOW_IMPORT", "1")
+    monkeypatch.setattr("job_tool.shape.PROBE_TIMEOUT", 0.5)
+
+    problems = identity_drift_across_processes("probe_backends:Noisy", extra_path=[TESTS])
+
+    assert any("did not answer within 0.5s" in p for p in problems)
+
+
+def test_a_probe_that_exits_without_answering_is_a_named_problem(monkeypatch):
+    import probe_backends  # noqa: F401 - loaded here first, so only the probes leave
+
+    monkeypatch.setenv("PROBE_SILENT_EXIT", "1")
+
+    problems = identity_drift_across_processes("probe_backends:Noisy", extra_path=[TESTS])
+
+    assert any("no answer" in p for p in problems)
+
+
+def test_a_backend_named_by_a_dotted_path_is_found():
+    assert identity_drift_across_processes("backends:Holder.Inner", extra_path=[TESTS]) == []
+
+
+def test_a_steady_sameness_is_the_same_in_every_process():
+    # An override, so the processes really are started and compared.
+    assert identity_drift_across_processes("backends:SteadyOverride", extra_path=[TESTS]) == []
+
+
+def test_the_default_sameness_needs_no_example():
+    plain = Contract(spec_schema=SPEC, idempotency=Idempotency(fields=("image",)))
+    assert identity_problems(plain) == []
diff --git a/sample-tools/job-tool-template/template/tests/test_output.py b/sample-tools/job-tool-template/template/tests/test_output.py
new file mode 100644
index 00000000..4b77cc99
--- /dev/null
+++ b/sample-tools/job-tool-template/template/tests/test_output.py
@@ -0,0 +1,192 @@
+"""What leaves the process: stdout holds exactly the answer, the exit code is
+the one the outcome calls for, and the process ends when the answer is given."""
+
+from __future__ import annotations
+
+import json
+import math
+import subprocess
+import sys
+import time
+from datetime import UTC, datetime
+from pathlib import Path
+
+import pytest
+from backends import Scripted
+
+from job_contract import JobStatus, Submitted
+from job_tool.cli import main
+
+TESTS = Path(__file__).resolve().parent
+
+
+@pytest.fixture(autouse=True)
+def fresh_script():
+    Scripted.answers = {}
+    Scripted.delay = {}
+    Scripted.calls = []
+
+
+def _strict(text: str):
+    """json.loads that refuses NaN/Infinity, which are not JSON."""
+
+    def refuse(token):
+        raise ValueError(f"not JSON: {token}")
+
+    return json.loads(text, parse_constant=refuse)
+
+
+def test_the_process_ends_at_the_budget_even_when_the_backend_waits_on_a_pool():
+    # The interpreter joins pool workers at exit; abandoning the call is not
+    # enough unless the process also refuses to wait for them.
+    program = (
+        "import sys; sys.path.insert(0, sys.argv[1]);"
+        "from backends import Pooled; from job_tool.cli import entry;"
+        "raise SystemExit(entry(['get', '{\"job_id\": \"j1\"}'], backend=Pooled))"
+    )
+    started = time.monotonic()
+    proc = subprocess.run(
+        [sys.executable, "-c", program, str(TESTS)], capture_output=True, text=True, timeout=60
+    )
+    took = time.monotonic() - started
+
+    assert proc.returncode == 2, proc.stderr
+    assert "0.2s" in proc.stderr
+    assert took < 10  # the pool sleeps 30
+
+
+def _entry(backend: str, argv: list[str]) -> subprocess.CompletedProcess:
+    """The installed command, in a real process with real file descriptors."""
+    program = (
+        "import sys, json; sys.path.insert(0, sys.argv[1]);"
+        f"from backends import {backend}; from job_tool.cli import entry;"
+        f"raise SystemExit(entry(json.loads(sys.argv[2]), backend={backend}))"
+    )
+    return subprocess.run(
+        [sys.executable, "-c", program, str(TESTS), json.dumps(argv)],
+        capture_output=True,
+        text=True,
+        timeout=60,
+    )
+
+
+def test_what_a_child_process_of_the_backend_writes_never_reaches_the_answer():
+    proc = _entry("Shelling", ["submit", json.dumps({"image": "a", "command": "b"})])
+
+    assert proc.returncode == 0, proc.stderr
+    assert _strict(proc.stdout)["job_id"] == "j1"  # exactly one JSON document
+    assert "CHILD-OUTPUT" in proc.stderr
+
+
+def test_what_the_backend_left_running_never_follows_the_answer():
+    # The installed command exits right after `main`; whatever speaks during
+    # that exit (pool workers being joined, atexit handlers) must not land on
+    # the stdout the platform parses.
+    proc = _entry("Lingering", ["get", json.dumps({"job_id": "j1"})])
+
+    assert proc.returncode == 0, proc.stderr
+    assert _strict(proc.stdout)["job"]["job_id"] == "j1"  # nothing after it
+    assert "POOL-NOISE" in proc.stderr and "POOL-CHILD" in proc.stderr
+    assert "ATEXIT-NOISE" in proc.stderr
+
+
+def test_stdout_is_given_back_after_a_call_that_finished_in_time():
+    # The channel points fd 1 at stderr for the duration; a call that was not
+    # abandoned must leave it as it found it, or the next answer in the same
+    # process lands on stderr.
+    program = (
+        "import sys; sys.path.insert(0, sys.argv[1]);"
+        "from backends import Minimal; from job_tool.cli import main;"
+        "main([], backend=Minimal); main(['get'], backend=Minimal)"
+    )
+    proc = subprocess.run(
+        [sys.executable, "-c", program, str(TESTS)], capture_output=True, text=True, timeout=60
+    )
+
+    first, second = proc.stdout.splitlines()
+    assert [c["name"] for c in _strict(first)] == ["submit", "get", "list"]
+    assert _strict(second)["name"] == "get"
+
+
+def test_what_the_backend_prints_never_reaches_the_answer(capsys):
+    class Chatty(Scripted):
+        def get(self, job_id):
+            print("debug: fetching", job_id)
+            return JobStatus(job_id=job_id, phase="running", state="queued")
+
+    code = main(["get", json.dumps({"job_id": "j1"})], backend=Chatty)
+    out, err = capsys.readouterr()
+
+    assert code == 0
+    assert _strict(out)["job"]["job_id"] == "j1"
+    assert "debug: fetching" in err
+
+
+def test_what_the_backend_prints_when_it_is_imported_never_reaches_the_answer(capsys, monkeypatch):
+    # A module-level print or a library banner runs when the backend is
+    # loaded — before any call, in stages 1 and 2 too, whose JSON the builder
+    # and the platform parse.
+    def noisy_load():
+        print("acme-sdk v2.1 loaded")
+        return Scripted
+
+    monkeypatch.setattr("job_tool.cli.load_backend", noisy_load)
+
+    assert main([]) == 0
+    out, err = capsys.readouterr()
+    assert [c["name"] for c in _strict(out)] == ["submit", "get", "list"]
+    assert "acme-sdk" in err
+
+
+def test_a_backend_that_tries_to_exit_is_a_failure_not_a_silent_success(capsys):
+    Scripted.answers["get"] = SystemExit(0)
+
+    code = main(["get", json.dumps({"job_id": "j1"})], backend=Scripted)
+    out, err = capsys.readouterr()
+
+    assert (code, out) == (1, "")
+    assert "SystemExit" in err
+
+
+def test_detail_the_backend_could_not_spell_as_json_still_makes_a_json_answer(capsys):
+    # The call succeeded; reporting it as a failure would make the model redo it.
+    Scripted.answers["get"] = JobStatus(
+        job_id="j1",
+        phase="running",
+        state="queued",
+        detail={"at": datetime(2026, 10, 12, tzinfo=UTC), "loss": math.nan},
+    )
+
+    code = main(["get", json.dumps({"job_id": "j1"})], backend=Scripted)
+    out, _ = capsys.readouterr()
+
+    assert code == 0
+    detail = _strict(out)["job"]["detail"]
+    assert detail["at"].startswith("2026-10-12")
+    assert detail["loss"] == "nan"
+
+
+def test_a_whole_number_written_with_a_point_is_the_same_whole_number(capsys):
+    # JSON Schema counts 5.0 as an integer, so it passes validation; left a
+    # float, it gives the same spec a different key (two jobs, two bills) and
+    # breaks a backend that slices or ranges with it.
+    Scripted.answers["submit"] = Submitted("j1", created=True)
+    spec = {"image": "trainer:3", "command": "train.py", "gpus": 2.0, "lr": 0.5}
+
+    assert main(["submit", json.dumps(spec)], backend=Scripted) == 0
+    assert main(["submit", json.dumps({**spec, "gpus": 2})], backend=Scripted) == 0
+    capsys.readouterr()
+
+    (first, second) = [call for call in Scripted.calls if call[0] == "submit"]
+    assert first == second  # same spec, same key
+    sent = first[1]
+    assert type(sent["gpus"]) is int and sent["lr"] == 0.5
+
+
+def test_more_arguments_than_one_json_object_are_refused(capsys):
+    code = main(["get", '{"job_id": "x"}', '{"job_id": "y"}'], backend=Scripted)
+    _, err = capsys.readouterr()
+
+    assert code == 2
+    assert "one" in err
+    assert Scripted.calls == []
diff --git a/sample-tools/job-tool-template/template/tests/test_run.py b/sample-tools/job-tool-template/template/tests/test_run.py
new file mode 100644
index 00000000..731f02af
--- /dev/null
+++ b/sample-tools/job-tool-template/template/tests/test_run.py
@@ -0,0 +1,435 @@
+"""Running one call: what the model is told, and the exit code that tells it
+what to do next."""
+
+from __future__ import annotations
+
+import json
+import time
+
+import pytest
+from backends import Scripted, ScriptedFull
+
+from job_contract import JobError, JobStatus, NeedsAction, NotFound, Retryable, Submitted
+from job_tool.cli import main
+from job_tool.commands import LIST_PAGE, LOG_PAGE
+
+
+ITEM = "item-1"
+
+
+@pytest.fixture(autouse=True)
+def fresh_script(monkeypatch):
+    Scripted.answers = {}
+    Scripted.delay = {}
+    Scripted.calls = []
+    # As the platform sets it on every dispatch (D44).
+    monkeypatch.setenv("WORKSPACE_ITEM_ID", ITEM)
+
+
+def _run(capsys, name, args):
+    code = main([name, json.dumps(args)], backend=Scripted)
+    out, err = capsys.readouterr()
+    return code, out, err
+
+
+def test_a_running_job_is_reported_with_the_advice_to_ask_again_later(capsys):
+    Scripted.answers["get"] = JobStatus(job_id="j1", phase="running", state="suspended")
+
+    code, out, _ = _run(capsys, "get", {"job_id": "j1"})
+
+    answer = json.loads(out)
+    assert code == 0
+    assert answer["job"] == {
+        "job_id": "j1",
+        "phase": "running",
+        "state": "suspended",
+        "detail": {},
+        "item_id": None,
+        "from_this_item": False,
+    }
+    assert "get" in answer["next"] and "later" in answer["next"]
+
+
+def test_a_backend_that_overruns_its_budget_is_abandoned_at_the_budget(capsys):
+    Scripted.answers["get"] = JobStatus(job_id="j1", phase="running", state="queued")
+    Scripted.delay["get"] = 30.0  # budget is 0.2
+
+    started = time.monotonic()
+    code, out, err = _run(capsys, "get", {"job_id": "j1"})
+    took = time.monotonic() - started
+
+    # The budget, not the backend, decided when to answer. Far from both
+    # numbers, so a slow machine cannot make this flip.
+    assert took < 10
+    assert code == 2
+    assert out == ""
+    assert "0.2s" in err and "again" in err
+
+
+def test_a_backend_that_cannot_say_is_not_reported_as_a_job_that_is_gone(capsys):
+    Scripted.answers["get"] = JobStatus(job_id="j1", phase="unknown", state="scheduler down")
+
+    code, out, _ = _run(capsys, "get", {"job_id": "j1"})
+
+    answer = json.loads(out)
+    assert code == 2  # asking again may work
+    assert answer["job"]["state"] == "scheduler down"
+    assert "not" in answer["next"] and "exist" in answer["next"]
+
+
+def test_a_job_the_backend_is_certain_of_not_having_is_a_plain_failure(capsys):
+    Scripted.answers["get"] = NotFound("no job j9 for ann")
+
+    code, out, err = _run(capsys, "get", {"job_id": "j9"})
+
+    assert (code, out) == (1, "")
+    assert "no job j9 for ann" in err
+
+
+class WithLogs(Scripted):
+    def logs(self, job_id, offset, limit):
+        return "", 0
+
+
+def test_a_finished_job_points_only_at_the_calls_the_backend_has(capsys):
+    Scripted.answers["get"] = JobStatus(job_id="j1", phase="done", state="failed: OOM")
+
+    _, out, _ = _run(capsys, "get", {"job_id": "j1"})
+    assert json.loads(out)["next"] == "Finished; its state says how it ended."
+
+    code = main(["get", json.dumps({"job_id": "j1"})], backend=WithLogs)
+    out, _ = capsys.readouterr()
+    assert code == 0
+    assert "logs" in json.loads(out)["next"] and "fetch" not in json.loads(out)["next"]
+
+
+def test_a_finished_job_is_not_promised_outputs_it_may_not_have(capsys):
+    # The shell reads only `phase`: "done" may be a success or a cancel, so
+    # fetch is offered as a possibility, never as the next step.
+    Scripted.answers["cancel"] = JobStatus(job_id="j1", phase="done", state="cancelled")
+
+    _, out, _ = _run_full(capsys, "cancel", {"job_id": "j1"})
+
+    advice = json.loads(out)["next"]
+    assert "state" in advice
+    assert "if it produced any" in advice
+
+
+def test_a_backend_that_breaks_unexpectedly_is_a_plain_failure_not_a_traceback(capsys):
+    Scripted.answers["get"] = KeyError("job_id")
+
+    code, out, err = _run(capsys, "get", {"job_id": "j1"})
+
+    assert (code, out) == (1, "")
+    assert "KeyError" in err and "Traceback" not in err
+
+
+def test_arguments_outside_the_schema_never_reach_the_backend(capsys):
+    code, out, err = _run(capsys, "submit", {"image": "trainer:3"})  # no `command`
+
+    assert (code, out) == (2, "")  # the model can fix it and call again
+    assert "command" in err
+    assert Scripted.calls == []
+
+
+SPEC_IN = {"image": "trainer:3", "command": "train.py"}
+
+
+def test_submit_sends_the_key_the_contract_derives_for_this_item(capsys):
+    Scripted.answers["submit"] = Submitted("j1", created=True)
+
+    code, out, _ = _run(capsys, "submit", SPEC_IN)
+
+    expected = Scripted.contract.idempotency.key(SPEC_IN, item_id=ITEM)
+    assert ("submit", SPEC_IN, expected, ITEM) in Scripted.calls
+    answer = json.loads(out)
+    assert code == 0
+    assert answer["job_id"] == "j1"
+    # Nothing will call the user back (D10): the model has to say so.
+    assert "get" in answer["next"] and "later" in answer["next"]
+
+
+def test_a_submit_that_found_the_job_already_there_says_so(capsys):
+    # D51: within the window the backend returns the job it already has; the
+    # model must not tell the user a new one was started.
+    Scripted.answers["submit"] = Submitted("j1", created=False)
+
+    code, out, _ = _run(capsys, "submit", SPEC_IN)
+
+    answer = json.loads(out)
+    assert code == 0
+    assert answer["job_id"] == "j1" and answer["created"] is False
+    assert "already" in answer["next"] and "not a new" in answer["next"]
+
+
+def test_with_no_item_the_job_already_there_is_not_called_this_items(capsys, monkeypatch):
+    # D47: under the MCP runner there is no item to speak of.
+    monkeypatch.delenv("WORKSPACE_ITEM_ID")
