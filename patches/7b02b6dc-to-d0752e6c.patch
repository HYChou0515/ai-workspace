diff --git a/sample-tools/job-tool-template/template/pyproject.toml b/sample-tools/job-tool-template/template/pyproject.toml
new file mode 100644
index 00000000..0ee9816f
--- /dev/null
+++ b/sample-tools/job-tool-template/template/pyproject.toml
@@ -0,0 +1,47 @@
+[project]
+# Rename: this is your tool's name, and the [project.scripts] key below with it.
+name = "job-tool"
+# Required. The version a person says out loud when something breaks.
+version = "0.1.0"
+description = "Submit work to a backend and ask about it later."
+requires-python = ">=3.12"
+# The contract, and YOUR backend. Both are separate packages so that changing
+# the backend and upgrading this template never touch each other.
+dependencies = [
+    "job-contract",
+    # YOUR backend. Replace this with your own package; it registers itself
+    # under the `job_tool.backend` entry point group and this tool finds it.
+    "example-jobs",
+    # Arguments are checked against the schema the model was shown, before the
+    # backend sees them.
+    "jsonschema>=4",
+]
+
+[project.scripts]
+# EXACTLY ONE: the command the bundle's launcher runs. Every job command
+# (submit, get, …) lives behind it.
+job-tool = "job_tool.cli:entry"
+
+[build-system]
+requires = ["hatchling"]
+build-backend = "hatchling.build"
+
+[tool.hatch.build.targets.wheel]
+packages = ["src/job_tool"]
+
+[dependency-groups]
+dev = ["pytest>=8"]
+
+# In this sample both live next door. In your repository, point them at a git
+# URL or an index instead: the builder mounts only your repository, so a path
+# outside it does not exist there.
+[tool.uv.sources]
+job-contract = { path = "../contract", editable = true }
+example-jobs = { path = "../example-impl", editable = true }
+
+# Self-contained rootdir so `pytest` doesn't walk up into the parent repo's config.
+[tool.pytest.ini_options]
+testpaths = ["tests"]
+
+[tool.ruff]
+line-length = 100
