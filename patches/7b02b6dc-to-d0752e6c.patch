diff --git a/sample-tools/job-tool-template/example-impl/src/example_jobs/backend.py b/sample-tools/job-tool-template/example-impl/src/example_jobs/backend.py
new file mode 100644
index 00000000..9d0d60fa
--- /dev/null
+++ b/sample-tools/job-tool-template/example-impl/src/example_jobs/backend.py
@@ -0,0 +1,224 @@
+"""A DEMO backend: a job is a file in the workspace that finishes after a set
+number of seconds.
+
+It talks to nothing, so it is wrong for real work and right for seeing the
+template run end to end. Replace this package with one that talks to your
+scheduler; keep its shape.
+
+What it shows a real backend doing:
+- who may see a job comes from the credential (here a plain variable,
+  DEMO_JOBS_USER), and a missing one is `NeedsAction` naming the variable;
+- the same key twice is one job; the key is per item, so the same work from
+  two items is two jobs — and `list` shows both, each with its `item_id`;
+- a job the credential cannot see does not exist for it (`NotFound`);
+- `phase` is the template's three words; `state` is this backend's own.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import time
+from pathlib import Path
+from typing import Any
+
+from job_contract import (
+    Contract,
+    EnvVar,
+    Idempotency,
+    JobBackend,
+    JobError,
+    JobStatus,
+    NeedsAction,
+    NotFound,
+    Retryable,
+    Submitted,
+)
+
+#: Where the jobs live, inside the workspace (the working directory).
+STORE = Path(".demo-jobs")
+
+
+class DemoBackend(JobBackend):
+    contract = Contract(
+        domain_description=(
+            "Runs a DEMO job: it does nothing for the given number of seconds, then "
+            "finishes with a one-line result."
+        ),
+        spec_schema={
+            "type": "object",
+            "properties": {
+                "task": {"type": "string", "description": "What to call the job."},
+                "seconds": {
+                    "type": "integer",
+                    "minimum": 0,
+                    "maximum": 3600,
+                    "description": "How long the job runs before it finishes.",
+                },
+                "label": {
+                    "type": "string",
+                    "description": "Change it to run the same task again as a new job.",
+                },
+            },
+            "required": ["task", "seconds"],
+        },
+        idempotency=Idempotency(fields=("task", "seconds", "label")),
+        patch_schema={
+            "type": "object",
+            "properties": {
+                "seconds": {
+                    "type": "integer",
+                    "minimum": 0,
+                    "maximum": 3600,
+                    "description": "A new total run time; only a running job can change.",
+                }
+            },
+            "required": ["seconds"],
+        },
+        env=(
+            EnvVar(
+                "DEMO_JOBS_USER",
+                "Who you are to the demo backend; any name. Jobs are listed per name.",
+                required=True,
+            ),
+        ),
+    )
+
+    # ── storage ─────────────────────────────────────────────────────────────
+
+    def _records(self) -> list[dict[str, Any]]:
+        if not STORE.is_dir():
+            return []
+        return [json.loads(path.read_text()) for path in STORE.glob("*.json")]
+
+    def _save(self, record: dict[str, Any]) -> None:
+        STORE.mkdir(exist_ok=True)
+        (STORE / f"{record['job_id']}.json").write_text(json.dumps(record))
+
+    def _mine(self, job_id: str) -> dict[str, Any]:
+        caller = self._credential()  # asked first, as a real backend checks the token first
+        path = STORE / f"{job_id}.json"
+        record = json.loads(path.read_text()) if path.is_file() else None
+        if record is None or record["caller"] != caller:
+            raise NotFound(f"no job {job_id!r} for {self._credential()}")
+        return record
+
+    def _status(self, record: dict[str, Any]) -> JobStatus:
+        elapsed = time.time() - record["submitted_at"]
+        detail = {"task": record["spec"]["task"], "seconds": record["seconds"]}
+        item = record.get("item_id")
+        if record["cancelled"]:
+            return JobStatus(record["job_id"], "done", "cancelled", detail, item)
+        if elapsed >= record["seconds"]:
+            return JobStatus(record["job_id"], "done", "succeeded", detail, item)
+        detail["remaining"] = round(record["seconds"] - elapsed)
+        return JobStatus(record["job_id"], "running", "running", detail, item)
+
+    def _credential(self) -> str:
+        """Whose jobs these are, as a real backend learns it from the token it
+        is called with. Who may see or change a job is decided here (D43) —
+        the item is only a label."""
+        user = os.environ.get("DEMO_JOBS_USER", "").strip()
+        if not user:
+            raise NeedsAction("set DEMO_JOBS_USER to say who you are to the demo backend")
+        return user
+
+    # ── required ────────────────────────────────────────────────────────────
+
+    def submit(self, spec: dict[str, Any], key: str, item_id: str | None) -> Submitted:
+        existing = self.find_by_key(key)
+        if existing is not None:
+            return Submitted(existing.job_id, created=False)
+        caller, now = self._credential(), time.time()
+        record = {
+            # Unique per credential and per submission: the key no longer says
+            # who sent it, and after the window the same key is a new job.
+            "job_id": hashlib.sha256(f"{caller}\0{key}\0{now}".encode()).hexdigest()[:12],
+            "key": key,
+            "item_id": item_id,
+            "caller": caller,
+            "spec": spec,
+            "seconds": spec["seconds"],
+            "submitted_at": now,
+            "cancelled": False,
+        }
+        self._save(record)
+        return Submitted(record["job_id"], created=True)
+
+    def find_by_key(self, key: str) -> JobStatus | None:
+        """The newest job under `key` still inside the window (D50)."""
+        caller = self._credential()
+        since = time.time() - self.contract.idempotency.window_seconds
+        recent = [
+            record
+            for record in self._records()
+            if record["key"] == key
+            and record["caller"] == caller
+            and record["submitted_at"] > since
+        ]
+        if not recent:
+            return None
+        return self._status(max(recent, key=lambda record: record["submitted_at"]))
+
+    def get(self, job_id: str) -> JobStatus:
+        return self._status(self._mine(job_id))
+
+    def list(self, cursor: str | None, limit: int) -> tuple[list[JobStatus], str | None]:
+        caller = self._credential()
+        mine = [r for r in self._records() if r["caller"] == caller]
+        mine.sort(key=lambda r: r["submitted_at"], reverse=True)
+        try:
+            start = int(cursor or 0)
+        except ValueError:
+            start = -1
+        if start < 0:
+            # Not a cursor this backend gave: the model can drop it and start over.
+            raise Retryable(f"cursor {cursor!r} is not one list returned; leave it out to start")
+        page = mine[start : start + limit]
+        after = str(start + limit) if start + limit < len(mine) else None
+        return [self._status(r) for r in page], after
+
+    # ── optional ────────────────────────────────────────────────────────────
+
+    def update(self, job_id: str, patch: dict[str, Any]) -> JobStatus:
+        record = self._mine(job_id)
+        if self._status(record).phase == "done":
+            # A plain failure: submitting a new job is something the model can
+            # do itself, so this is not NeedsAction (a person must act first).
+            raise JobError(f"job {job_id} already finished; submit a new one instead")
+        record["seconds"] = patch["seconds"]
+        self._save(record)
+        return self._status(record)
+
+    def cancel(self, job_id: str) -> JobStatus:
+        record = self._mine(job_id)
+        if self._status(record).phase == "running":
+            record["cancelled"] = True
+            record["stopped_at"] = time.time()
+            self._save(record)
+        return self._status(record)
+
+    def logs(self, job_id: str, offset: int, limit: int) -> tuple[str, int]:
+        record = self._mine(job_id)
+        status = self._status(record)
+        # Only the seconds it really ran: up to now, or to when it was cancelled.
+        until = record.get("stopped_at") or time.time()
+        ran = int(min(record["seconds"], until - record["submitted_at"]))
+        log = "".join(f"second {n} of {record['seconds']}\n" for n in range(1, ran + 1))
+        log += f"{status.state}\n" if status.phase == "done" else ""
+        return log[offset : offset + limit], len(log)
+
+    def fetch(self, job_id: str, name: str, dest: str) -> str:
+        status = self._status(self._mine(job_id))
+        if name != "result":
+            raise NotFound(f"job {job_id} has one output, 'result'; there is no {name!r}")
+        if status.phase == "running":
+            raise Retryable(f"job {job_id} is still running; its result exists once it succeeds")
+        if status.state != "succeeded":
+            # Never coming: saying "try again" here would send the model round in circles.
+            raise JobError(f"job {job_id} was {status.state}; it has no result")
+        target = Path(dest)
+        target.parent.mkdir(parents=True, exist_ok=True)
+        target.write_text(f"{status.detail['task']} finished after {status.detail['seconds']}s\n")
+        return dest
diff --git a/sample-tools/job-tool-template/example-impl/tests/test_demo.py b/sample-tools/job-tool-template/example-impl/tests/test_demo.py
new file mode 100644
index 00000000..46a90e4a
--- /dev/null
+++ b/sample-tools/job-tool-template/example-impl/tests/test_demo.py
@@ -0,0 +1,173 @@
+"""The demo backend keeps the promises the contract asks of every backend.
+
+It is a demo — these tests exist so the template has a backend that really
+runs, not to prescribe how yours should be tested.
+"""
+
+from __future__ import annotations
+
+import time
+
+import pytest
+
+from example_jobs.backend import DemoBackend
+from job_contract import JobError, NeedsAction, NotFound, Retryable
+
+
+@pytest.fixture
+def backend(tmp_path, monkeypatch):
+    monkeypatch.chdir(tmp_path)  # the working directory is the workspace
+    monkeypatch.setenv("DEMO_JOBS_USER", "ann")
+    return DemoBackend()
+
+
+ITEM = "item-1"
+
+
+def _key(spec, item=ITEM):
+    return DemoBackend.contract.idempotency.key(spec, item_id=item)
+
+
+def _submit(backend, spec, item=ITEM):
+    """What the shell does: key by item, then submit with the item."""
+    return backend.submit(spec, _key(spec, item), item)
+
+
+def _send(backend, spec, item=ITEM):
+    return _submit(backend, spec, item).job_id
+
+
+def test_within_the_window_the_same_work_is_the_job_already_there(backend):
+    spec = {"task": "train", "seconds": 600}
+
+    first, again = _submit(backend, spec), _submit(backend, spec)
+
+    assert first.created is True and again.created is False
+    assert first.job_id == again.job_id
+
+
+def test_after_the_window_the_same_work_is_a_new_job(backend, monkeypatch):
+    # D50: a day later, the same work runs again instead of answering with the
+    # day-old job.
+    spec = {"task": "train", "seconds": 600}
+    first = _submit(backend, spec)
+
+    later = time.time() + DemoBackend.contract.idempotency.window_seconds + 1
+    monkeypatch.setattr("example_jobs.backend.time.time", lambda: later)
+
+    again = _submit(backend, spec)
+    assert again.created is True and again.job_id != first.job_id
+    assert backend.find_by_key(_key(spec)).job_id == again.job_id
+
+
+def test_the_item_a_job_came_from_is_recorded_and_reported(backend):
+    job_id = _send(backend, {"task": "train", "seconds": 600})
+
+    assert backend.get(job_id).item_id == ITEM
+    assert [job.item_id for job in backend.list(None, 10)[0]] == [ITEM]
+
+
+def test_two_credentials_sending_the_same_work_from_one_item_do_not_overwrite_each_other(
+    backend, monkeypatch
+):
+    # The key no longer carries who sent it; the job id must, or the second
+    # credential's record would replace the first's.
+    spec = {"task": "train", "seconds": 600}
+    anns = _send(backend, spec)
+    monkeypatch.setenv("DEMO_JOBS_USER", "bob")
+    bobs = _send(backend, spec)
+
+    assert anns != bobs
+    monkeypatch.setenv("DEMO_JOBS_USER", "ann")
+    assert backend.get(anns).item_id == ITEM
+
+
+def test_the_same_work_from_two_items_is_two_jobs_and_the_list_shows_both(backend):
+    # D41 + D42: sameness is per item; what the credential sees is not.
+    spec = {"task": "train", "seconds": 600}
+    here, there = _send(backend, spec, "item-1"), _send(backend, spec, "item-2")
+
+    assert here != there
+    assert {job.item_id for job in backend.list(None, 10)[0]} == {"item-1", "item-2"}
+
+
+def test_the_same_key_twice_is_one_job(backend):
+    spec = {"task": "train", "seconds": 60}
+
+    first = _send(backend, spec)
+    again = _send(backend, spec)
+
+    assert first == again
+    jobs, _ = backend.list(None, 10)
+    assert [job.job_id for job in jobs] == [first]
+    assert backend.find_by_key(_key(spec)).job_id == first
+
+
+def test_a_job_runs_then_finishes_and_its_result_can_be_fetched(backend, tmp_path):
+    spec = {"task": "train", "seconds": 0}
+    job_id = _send(backend, spec)
+
+    status = backend.get(job_id)
+    assert (status.phase, status.state) == ("done", "succeeded")
+    assert backend.fetch(job_id, "result", "out/result.txt") == "out/result.txt"
+    assert "train" in (tmp_path / "out/result.txt").read_text()
+
+
+def test_a_cancelled_job_is_done_and_cancelling_it_again_is_not_an_error(backend):
+    spec = {"task": "train", "seconds": 600}
+    job_id = _send(backend, spec)
+
+    with pytest.raises(Retryable):  # not yet — later it will be there
+        backend.fetch(job_id, "result", "r.txt")
+
+    assert backend.cancel(job_id).state == "cancelled"
+    assert backend.cancel(job_id).phase == "done"
+
+    # Never — asking again cannot help, so it must not say it might.
+    with pytest.raises(JobError) as never:
+        backend.fetch(job_id, "result", "r.txt")
+    assert not isinstance(never.value, Retryable)
+
+
+def test_a_cancelled_jobs_log_shows_only_what_it_ran(backend):
+    spec = {"task": "train", "seconds": 100}
+    job_id = _send(backend, spec)
+    backend.cancel(job_id)
+
+    log, total = backend.logs(job_id, 0, 10_000)
+
+    assert "second 100" not in log
+    assert log.endswith("cancelled\n") and total == len(log)
+
+
+def test_changing_a_finished_job_is_a_plain_failure_the_model_can_act_on(backend):
+    # Submitting a new job is something the model can do itself: not exit 3,
+    # which tells it a person must act first.
+    spec = {"task": "train", "seconds": 0}
+    job_id = _send(backend, spec)
+
+    with pytest.raises(JobError) as refused:
+        backend.update(job_id, {"seconds": 10})
+    assert not isinstance(refused.value, NeedsAction | Retryable)
+
+
+@pytest.mark.parametrize("cursor", ["abc", "-1"])
+def test_a_cursor_this_backend_never_gave_is_refused_so_it_can_be_corrected(backend, cursor):
+    with pytest.raises(Retryable, match="cursor"):
+        backend.list(cursor, 10)
+
+
+def test_another_callers_job_does_not_exist_for_you(backend, monkeypatch):
+    spec = {"task": "train", "seconds": 600}
+    job_id = _send(backend, spec)
+
+    monkeypatch.setenv("DEMO_JOBS_USER", "bob")
+    with pytest.raises(NotFound):
+        backend.get(job_id)
+    assert backend.list(None, 10) == ([], None)
+
+
+def test_no_user_set_is_a_person_s_job_naming_the_variable(backend, monkeypatch):
+    monkeypatch.delenv("DEMO_JOBS_USER")
+    with pytest.raises(NeedsAction, match="DEMO_JOBS_USER"):
+        backend.list(None, 10)
