+++ b/sample-tools/job-tool-template/template/src/job_tool/cli.py
@@ -0,0 +1,192 @@
+"""The three-stage contract. You will rarely need to edit this file.
+
+The platform talks to the tool through argv and stdout, and nothing else:
+
+    job-tool                     -> [{"name", "description"}, …]   which commands exist
+    job-tool submit              -> {"name", "description", "params_json_schema"}
+    job-tool submit '<json>'     -> the answer                       do the work
+
+Which commands exist is decided by the backend: one per call it supports.
+"""
+
+from __future__ import annotations
+
+import io
+import json
+import math
+import os
+import sys
+from collections.abc import Iterator
+from contextlib import contextmanager
+from typing import Any, TextIO
+
+from job_contract import JobBackend
+from jsonschema import Draft202012Validator
+
+from job_tool.commands import commands
+from job_tool.describe import describe
+from job_tool.discover import NoBackend, load_backend
+from job_tool.run import abandoned, run
+
+
+def _fail(message: str, exit_code: int) -> int:
+    """The detail on stderr, the next step in the exit code. stdout stays
+    clean: it is the channel the platform reads as the answer."""
+    print(message, file=sys.stderr)
+    return exit_code
+
+
+@contextmanager
+def _answer_channel(*, restore: bool) -> Iterator[TextIO]:
+    """A stream that reaches the real stdout, while everything else that would
+    have — a backend's `print`, a library's banner at import, the output of a
+    command the backend runs (`sbatch`, `kubectl`), a C extension — goes to
+    stderr instead. stdout is the channel the platform parses as the answer,
+    so one stray line there corrupts it.
+
+    Swapping `sys.stdout` alone catches only Python-level prints: a child
+    process writes to file descriptor 1 directly. So when stdout is a real
+    file descriptor, fd 1 itself is pointed at stderr for the duration and the
+    answer is written to a duplicate of the original.
+
+    `restore` puts stdout back afterwards, for a caller that goes on in the
+    same process (a test). The installed command does not: after the answer
+    the process only exits, and exiting is when a backend's leftovers speak —
+    pool workers the interpreter joins, atexit handlers. Nor is anything
+    restored once a call was abandoned: its thread may still be writing."""
+    original = sys.stdout
+    answer: TextIO = original
+    saved: int | None = None
+    try:
+        is_fd1 = original.fileno() == 1
+    except (AttributeError, OSError, ValueError, io.UnsupportedOperation):
+        is_fd1 = False  # not a real descriptor (a test's capture): sys level only
+    if is_fd1:
+        original.flush()
+        saved = os.dup(1)
+        os.dup2(2, 1)
+        answer = open(saved, "w", encoding="utf-8", closefd=False)  # noqa: SIM115
+    sys.stdout = sys.stderr
+    try:
+        yield answer
+    finally:
+        answer.flush()
+        if restore and not abandoned():
+            if saved is not None:
+                os.dup2(saved, 1)
+                os.close(saved)
+            sys.stdout = original
+
+
+def main(
+    argv: list[str] | None = None,
+    *,
+    backend: type[JobBackend] | None = None,
+    restore_stdout: bool = True,
+) -> int:
+    """The three stages. `restore_stdout=False` is for the installed command
+    (`entry`), which only exits afterwards; see `_answer_channel`."""
+    with _answer_channel(restore=restore_stdout) as answer:
+        return _main(sys.argv[1:] if argv is None else argv, backend, answer)
+
+
+def _main(argv: list[str], backend: type[JobBackend] | None, answer: TextIO) -> int:
+    if backend is None:
+        try:
+            backend = load_backend()  # imports the backend: inside the channel
+        except NoBackend as exc:
+            return _fail(str(exc), 1)
+
+    offered = commands(backend)
+    if not argv:
+        listed = [{"name": n, "description": describe(n, backend)} for n in offered]
+        print(json.dumps(listed), file=answer)
+        return 0
+
+    name, rest = argv[0], argv[1:]
+    command = offered.get(name)
+    if command is None:
+        return _fail(f"unknown command {name!r}; this tool has {list(offered)}", 2)
+
+    if not rest:
+        described = {
+            "name": name,
+            "description": describe(name, backend),
+            "params_json_schema": command.params_json_schema,
+        }
+        print(json.dumps(described), file=answer)
+        return 0
+
+    if len(rest) > 1:
+        return _fail(f"{name} takes one JSON object of arguments; got {len(rest)} values", 2)
+    try:
+        args = json.loads(rest[0])
+    except ValueError as exc:
+        return _fail(f"arguments for {name} are not JSON: {exc}", 2)
+    # The schema the model was shown is the one its arguments are held to, so
+    # what reaches the backend is what the backend declared it accepts.
+    problems = sorted(Draft202012Validator(command.params_json_schema).iter_errors(args), key=str)
+    if problems:
+        detail = "; ".join(
+            f"{'/'.join(map(str, p.absolute_path)) or 'arguments'}: {p.message}" for p in problems
+        )
+        return _fail(f"bad arguments for {name}: {detail}", 2)
+    args = _whole(args)
+
+    outcome = run(name, args, backend)
+    if outcome.answer is not None:
+        print(_dump(outcome.answer), file=answer)
+    if outcome.error is not None:
+        print(outcome.error, file=sys.stderr)
+    return outcome.exit_code
+
+
+def _whole(value: Any) -> Any:
+    """`value` with every whole-number float made an int. JSON Schema counts
+    `5.0` as an integer, so it passes validation; left a float it would give
+    the same spec a different idempotency key and break a backend that slices
+    or ranges with it."""
+    if isinstance(value, float) and value.is_integer():
+        return int(value)
+    if isinstance(value, dict):
+        return {key: _whole(item) for key, item in value.items()}
+    if isinstance(value, list):
+        return [_whole(item) for item in value]
+    return value
+
+
+def _jsonable(value: Any) -> Any:
+    """`value` with what JSON cannot say spelled as text: NaN and infinities
+    (which `json` would write as bare, invalid tokens) and anything that is
+    not a JSON type (a datetime in `detail`, say)."""
+    if isinstance(value, float) and not math.isfinite(value):
+        return str(value)
+    if isinstance(value, dict):
+        return {str(key): _jsonable(item) for key, item in value.items()}
+    if isinstance(value, list | tuple):
+        return [_jsonable(item) for item in value]
+    if value is None or isinstance(value, str | int | float):
+        return value
+    return str(value)
+
+
+def _dump(answer: dict[str, Any]) -> str:
+    return json.dumps(_jsonable(answer), allow_nan=False)
+
+
+def entry(argv: list[str] | None = None, *, backend: type[JobBackend] | None = None) -> int:
+    """The installed command. Like `main`, except that once a call has been
+    abandoned it ends the process the moment the answer is out: the backend
+    may have left a thread pool running, and the interpreter would wait for
+    it at exit — up to the platform's whole ceiling."""
+    code = main(argv, backend=backend, restore_stdout=False)
+    if abandoned():
+        sys.stdout.flush()
+        sys.__stdout__.flush()
+        sys.stderr.flush()
+        os._exit(code)
+    return code
+
+
+if __name__ == "__main__":
+    raise SystemExit(entry())
diff --git a/sample-tools/job-tool-template/template/src/job_tool/commands.py b/sample-tools/job-tool-template/template/src/job_tool/commands.py
new file mode 100644
index 00000000..6d5ac62c
--- /dev/null
+++ b/sample-tools/job-tool-template/template/src/job_tool/commands.py
@@ -0,0 +1,93 @@
+"""The commands a backend is offered to the model as.
+
+A command exists for each call the backend supports (`JobBackend.offers`),
+except the one the shell keeps to itself: `find_by_key` (did a submit that ran
+out of time land?).
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any
+
+from job_contract import JobBackend
+
+#: Calls the shell makes on its own and never offers.
+INTERNAL = ("find_by_key",)
+
+
+@dataclass(frozen=True)
+class Command:
+    name: str
+    params_json_schema: dict[str, Any]
+
+
+#: How many characters of log one `logs` call returns unless asked otherwise.
+#: Tool output is capped by the platform; a page this size stays well inside it.
+LOG_PAGE = 4000
+#: How many jobs one `list` call returns unless asked otherwise, and at most.
+#: Tool output is capped by the platform, so an unbounded page would come back
+#: cut off — and a cut-off list reads as "these are all my jobs".
+LIST_PAGE = 20
+LIST_MAX = 100
+
+_JOB_ID = {"type": "string", "description": "The job's id, as `submit` or `list` returned it."}
+
+
+def _object(properties: dict[str, Any], required: list[str]) -> dict[str, Any]:
+    return {"type": "object", "properties": properties, "required": required}
+
+
+def _params(name: str, backend: type[JobBackend]) -> dict[str, Any]:
+    contract = backend.contract
+    if name == "submit":
+        # The author's spec IS the argument: no wrapper for the model to get wrong.
+        return contract.spec_schema
+    if name == "list":
+        return _object(
+            {
+                "cursor": {
+                    "type": ["string", "null"],
+                    "description": "Where the previous page ended; leave out for the newest jobs.",
+                },
+                "limit": {
+                    "type": "integer",
+                    "minimum": 1,
+                    "maximum": LIST_MAX,
+                    "default": LIST_PAGE,
+                },
+            },
+            [],
+        )
+    if name == "update":
+        assert contract.patch_schema is not None
+        return _object({"job_id": _JOB_ID, "patch": contract.patch_schema}, ["job_id", "patch"])
+    if name == "logs":
+        return _object(
+            {
+                "job_id": _JOB_ID,
+                "offset": {"type": "integer", "minimum": 0, "default": 0},
+                "limit": {"type": "integer", "minimum": 1, "default": LOG_PAGE},
+            },
+            ["job_id"],
+        )
+    if name == "fetch":
+        return _object(
+            {
+                "job_id": _JOB_ID,
+                "name": {"type": "string", "description": "Which output to fetch."},
+                "dest": {
+                    "type": "string",
+                    "description": "Where to write it, relative to the workspace.",
+                },
+            },
+            ["job_id", "name", "dest"],
+        )
+    # get, cancel
+    return _object({"job_id": _JOB_ID}, ["job_id"])
+
+
+def commands(backend: type[JobBackend]) -> dict[str, Command]:
+    """The commands to offer for `backend`, in a fixed order."""
+    offered = [name for name in backend.offers() if name not in INTERNAL]
+    return {name: Command(name=name, params_json_schema=_params(name, backend)) for name in offered}
diff --git a/sample-tools/job-tool-template/template/src/job_tool/describe.py b/sample-tools/job-tool-template/template/src/job_tool/describe.py
new file mode 100644
index 00000000..e4f4399f
--- /dev/null
+++ b/sample-tools/job-tool-template/template/src/job_tool/describe.py
@@ -0,0 +1,57 @@
+"""What the model reads about each command.
+
+Two halves. What the jobs ARE is the author's (`Contract.domain_description`,
+and the descriptions inside their schemas). How a job BEHAVES — returns at
+once, unknown is not gone, accepted is not applied, nothing calls back — is the
+same for every backend and is written here, from the contract, so no author
+restates it and no restatement drifts.
+"""
+
+from __future__ import annotations
+
+from job_contract import JobBackend
+
+from job_tool.run import describe_window
+
+
+def _submit(backend: type[JobBackend]) -> str:
+    rule = backend.contract.idempotency
+    return (
+        "Submit a job. Returns at once with its job_id; the job then runs on its own and "
+        "nothing announces when it ends, so tell the user to ask about it later. "
+        f"If the same {', '.join(rule.fields)} was already submitted from here — the same "
+        "item, where there is one, under the same credential — within the last "
+        f"{describe_window(rule.window_seconds)}, this returns that job instead of starting "
+        "another; after that, the same work starts a new job."
+    )
+
+
+_FIXED = {
+    "get": (
+        "Show one job. Its phase is running, done or unknown; unknown means the backend "
+        "could not say just now and does NOT mean the job does not exist. Its state is the "
+        "backend's own word for where the job is."
+    ),
+    "list": (
+        "List the jobs this backend shows you, newest first, one page at a time — not only "
+        "this item's; each says from_this_item."
+    ),
+    "update": (
+        "Change a job that was already submitted; the patch says what can change. The "
+        "change is accepted, not necessarily applied: call get to see when it has taken "
+        "effect."
+    ),
+    "cancel": "Cancel a job. Cancelling a job that already finished is not an error.",
+    "logs": (
+        "Read part of a job's log. The answer says the log's total length and where to "
+        "continue reading."
+    ),
+    "fetch": "Save one of a job's outputs to a path in the workspace.",
+}
+
+
+def describe(name: str, backend: type[JobBackend]) -> str:
+    if name != "submit":
+        return _FIXED[name]
+    domain = backend.contract.domain_description.strip()
+    return f"{domain} {_submit(backend)}" if domain else _submit(backend)
diff --git a/sample-tools/job-tool-template/template/src/job_tool/discover.py b/sample-tools/job-tool-template/template/src/job_tool/discover.py
new file mode 100644
index 00000000..91d8189c
--- /dev/null
+++ b/sample-tools/job-tool-template/template/src/job_tool/discover.py
@@ -0,0 +1,46 @@
+"""Finding the backend this tool talks to.
+
+The backend is its own package. It registers its `JobBackend` subclass under
+one entry point group, and this tool loads whatever is registered there — so
+replacing the backend is a dependency change, never an edit to this repository.
+
+In the backend's pyproject.toml:
+
+    [project.entry-points."job_tool.backend"]
+    acme = "acme_jobs.backend:AcmeBackend"
+"""
+
+from __future__ import annotations
+
+from collections.abc import Iterable
+from importlib.metadata import EntryPoint, entry_points
+
+from job_contract import ContractError, JobBackend
+
+GROUP = "job_tool.backend"
+
+
+class NoBackend(Exception):
+    """Not exactly one usable backend is installed. The tool cannot start."""
+
+
+def load_backend(found: Iterable[EntryPoint] | None = None) -> type[JobBackend]:
+    """The one backend registered under `GROUP`."""
+    registered = list(entry_points(group=GROUP) if found is None else found)
+    if not registered:
+        raise NoBackend(
+            f"no backend is installed: register your JobBackend subclass under the "
+            f"entry point group {GROUP!r} in your backend package"
+        )
+    if len(registered) > 1:
+        names = ", ".join(f"{ep.name} ({ep.value})" for ep in registered)
+        raise NoBackend(f"more than one backend is installed ({names}); install exactly one")
+    (ep,) = registered
+    backend = ep.load()
+    if not (isinstance(backend, type) and issubclass(backend, JobBackend)):
+        raise NoBackend(f"{ep.value} is not a JobBackend subclass")
+    try:
+        backend.check()
+    except ContractError as exc:
+        raise NoBackend(f"{ep.value} cannot keep the job contract: {exc}") from exc
+    return backend
diff --git a/sample-tools/job-tool-template/template/src/job_tool/envfile.py b/sample-tools/job-tool-template/template/src/job_tool/envfile.py
