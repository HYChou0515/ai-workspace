@@ -0,0 +1,91 @@
+/**
+ * The 小幫手 page (docs/plan-outside-helper.md §3.6, D16): where a person
+ * gets the helper and reads the one line on installing it.
+ */
+// @vitest-environment happy-dom
+import "@testing-library/jest-dom/vitest";
+import { cleanup, screen } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+
+import type { HelperRelease } from "../api/outsideLookup";
+import { renderWithQuery } from "../test/queryWrapper";
+
+import { AiWorkspaceHelperPage } from "./AiWorkspaceHelperPage";
+
+afterEach(() => {
+  cleanup();
+  vi.restoreAllMocks();
+});
+
+const RELEASE: HelperRelease = {
+  version: "0.3.0",
+  min_version: "0.2.0",
+  file: "ai-workspace-helper-0.3.0.zip",
+  sha256: "ab".repeat(32),
+  size: 41_943_040,
+};
+
+function draw({
+  release = RELEASE as HelperRelease | null,
+  online = false,
+}: { release?: HelperRelease | null; online?: boolean } = {}) {
+  renderWithQuery(
+    <AiWorkspaceHelperPage
+      client={{
+        release: vi.fn(async () => release),
+        helperStatus: vi.fn(async () => ({ online })),
+      }}
+    />,
+  );
+}
+
+describe("the helper page", () => {
+  // NN/g / GOV.UK: a link to a file says what the file is and how big.
+  it("offers the published zip by name, type and size", async () => {
+    draw();
+
+    const link = await screen.findByRole("link", { name: /ai-workspace-helper-0\.3\.0\.zip/ });
+    expect(link).toHaveAttribute("href", "/api/ai-workspace-helper/download/ai-workspace-helper-0.3.0.zip");
+    expect(link).toHaveAccessibleName(expect.stringMatching(/ZIP.*40 MB/));
+    expect(screen.getByText(/0\.3\.0/, { selector: "[data-testid=ai-workspace-helper-version]" })).toBeInTheDocument();
+  });
+
+  it("says how to install it, and the address the helper asks for", async () => {
+    draw();
+
+    expect(await screen.findByText(/install\.pyw/)).toBeInTheDocument();
+    expect(screen.getByText(window.location.origin)).toBeInTheDocument();
+  });
+
+  // plan D19: no admin rights needed, but a company PC may refuse what the
+  // helper runs — the precheck, before installing, says which.
+  it("says to check the PC with precheck.pyw before installing", async () => {
+    draw();
+
+    const steps = (await screen.findAllByRole("listitem")).map((li) => li.textContent ?? "");
+    const check = steps.findIndex((s) => s.includes("precheck.pyw"));
+    const install = steps.findIndex((s) => s.includes("install.pyw"));
+    expect(check).toBeGreaterThanOrEqual(0);
+    expect(check).toBeLessThan(install);
+    expect(steps[check]).toMatch(/不安裝任何東西/);
+  });
+
+  it("says when nothing is published", async () => {
+    draw({ release: null });
+
+    expect(await screen.findByTestId("ai-workspace-helper-unpublished")).toBeInTheDocument();
+    expect(screen.queryByRole("link", { name: /\.zip/ })).not.toBeInTheDocument();
+  });
+
+  it("says whether the person's own helper is connected", async () => {
+    draw({ online: true });
+
+    expect(await screen.findByText("小幫手已連線")).toBeInTheDocument();
+  });
+
+  it("says when it is not", async () => {
+    draw({ online: false });
+
+    expect(await screen.findByText("小幫手未連線")).toBeInTheDocument();
+  });
+});
diff --git a/web/src/pages/AiWorkspaceHelperPage.tsx b/web/src/pages/AiWorkspaceHelperPage.tsx
new file mode 100644
index 00000000..74052e33
--- /dev/null
+++ b/web/src/pages/AiWorkspaceHelperPage.tsx
@@ -0,0 +1,102 @@
+/**
+ * 小幫手 (docs/plan-outside-helper.md §3.6, D16): where a person downloads
+ * the helper the operator published and reads how to install it, and sees
+ * whether their own helper is connected.
+ *
+ * The download is a link that names the file, its type and its size — what a
+ * link to a non-web file should say before it is followed (NN/g, "Avoid PDF
+ * for On-Screen Reading": link text states file type and size; GOV.UK Design
+ * System, attachment pattern).
+ */
+
+import { useQuery } from "@tanstack/react-query";
+
+import { API_BASE, API_PREFIX } from "../api/http";
+import { type HelperRelease, outsideLookupApi } from "../api/outsideLookup";
+import { qk } from "../api/queryKeys";
+import { Icon } from "../components/Icon";
+import { useT } from "../lib/i18n";
+import { pxToRem } from "../lib/pxToRem";
+
+const MUTED = { fontSize: pxToRem(12), color: "var(--text-paper-d)" } as const;
+const MONO = { fontFamily: "var(--font-mono, ui-monospace, monospace)" } as const;
+
+export type AiWorkspaceHelperPageClient = {
+  release: () => Promise<HelperRelease | null>;
+  helperStatus: () => Promise<{ online: boolean }>;
+};
+
+/** Bytes as people read them: whole megabytes past one. */
+export function fileSize(bytes: number): string {
+  if (bytes >= 1024 * 1024) return `${Math.round(bytes / (1024 * 1024))} MB`;
+  return `${Math.max(1, Math.round(bytes / 1024))} KB`;
+}
+
+export function AiWorkspaceHelperPage({
+  client = outsideLookupApi,
+}: {
+  client?: AiWorkspaceHelperPageClient;
+}) {
+  const t = useT();
+  const release = useQuery({ queryKey: qk.aiWorkspaceHelperRelease(), queryFn: () => client.release() });
+  const status = useQuery({
+    queryKey: qk.aiWorkspaceHelper(),
+    queryFn: () => client.helperStatus(),
+    refetchInterval: 15_000,
+  });
+
+  return (
+    <div className="page">
+      <h1>{t("aiWorkspaceHelper.title")}</h1>
+      <p style={MUTED}>{t("aiWorkspaceHelper.desc")}</p>
+      {status.isSuccess && (
+        <p data-testid="ai-workspace-helper-status">
+          {t(status.data.online ? "aiWorkspaceHelper.online" : "aiWorkspaceHelper.offline")}
+        </p>
+      )}
+
+      {release.isPending ? (
+        <p style={MUTED}>…</p>
+      ) : !release.data ? (
+        <p data-testid="ai-workspace-helper-unpublished" style={MUTED}>
+          {t("aiWorkspaceHelper.unpublished")}
+        </p>
+      ) : (
+        <section aria-labelledby="ai-workspace-helper-install" style={{ display: "grid", gap: 8 }}>
+          <h2 id="ai-workspace-helper-install">{t("aiWorkspaceHelper.install")}</h2>
+          <p data-testid="ai-workspace-helper-version" style={MUTED}>
+            {t("aiWorkspaceHelper.version", { version: release.data.version })}
+          </p>
+          <p>
+            {/* Getting a file is an action, so it is drawn as the page's one
+                primary button (Material 3, buttons; the app's own download in
+                KbDocViewer); still an <a download> for what it does. */}
+            <a
+              className="btn"
+              data-variant="primary"
+              href={`${API_PREFIX}/ai-workspace-helper/download/${encodeURIComponent(release.data.file)}`}
+              download={release.data.file}
+            >
+              <Icon name="download" size={14} />{" "}
+              {t("aiWorkspaceHelper.download", {
+                file: release.data.file,
+                size: fileSize(release.data.size),
+              })}
+            </a>
+          </p>
+          <ol style={{ display: "grid", gap: 4, paddingLeft: pxToRem(20) }}>
+            <li>{t("aiWorkspaceHelper.step1")}</li>
+            <li>{t("aiWorkspaceHelper.stepCheck")}</li>
+            <li>{t("aiWorkspaceHelper.step2")}</li>
+            <li>
+              {/* With the deploy's base path: the helper asks `<this>/api/…`. */}
+              {t("aiWorkspaceHelper.step3")}{" "}
+              <code style={MONO}>{`${window.location.origin}${API_BASE}`}</code>
+            </li>
+            <li>{t("aiWorkspaceHelper.step4")}</li>
+          </ol>
+        </section>
+      )}
+    </div>
+  );
+}
