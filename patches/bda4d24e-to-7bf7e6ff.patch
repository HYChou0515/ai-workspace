new file mode 100644
index 00000000..e2f0d5d0
--- /dev/null
+++ b/tests/ai_workspace_helper/test_pack.py
@@ -0,0 +1,135 @@
+"""Packing the helper on the dev server (docs/plan-outside-helper.md D14,
+§3.6, §3.7.2): one offline zip a Windows PC with any CPython 3.10–3.14
+installs from, and the manifest the backend serves.
+
+The commands (pnpm, uv, pip) go through an injected `run`, recorded here and
+made to leave the files they would; the real run is the live check (P10).
+"""
+
+from __future__ import annotations
+
+import hashlib
+import importlib.util
+import json
+import zipfile
+from pathlib import Path
+
+import pytest
+
+_ROOT = Path(__file__).resolve().parents[2]
+_spec = importlib.util.spec_from_file_location(
+    "_pack_ai_workspace_helper", _ROOT / "scripts" / "pack_ai_workspace_helper.py"
+)
+assert _spec and _spec.loader
+pack_mod = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(pack_mod)
+
+
+# §3.6: pip downloads for the Python RUNNING it unless told otherwise, and
+# greenlet has one wheel per CPython minor — so each version is asked for
+# explicitly, Windows, binary only, every package pinned with `==`.
+def test_every_python_gets_its_own_pinned_windows_wheels():
+    commands = [pack_mod.download_command(["pip"], v, Path("/wh")) for v in pack_mod.PYTHONS]
+
+    assert pack_mod.PYTHONS == ["3.10", "3.11", "3.12", "3.13", "3.14"]
+    for version, argv in zip(pack_mod.PYTHONS, commands, strict=True):
+        abi = "cp" + version.replace(".", "")
+        assert argv[:2] == ["pip", "download"]
+        for flag in (
+            ["--platform", "win_amd64"],
+            ["--implementation", "cp"],
+            ["--python-version", version],
+            ["--abi", abi],
+        ):
+            assert _has(argv, flag), (version, flag)
+        assert "--only-binary=:all:" in argv and "--no-deps" in argv
+    assert all(pin.count("==") == 1 for pin in pack_mod.PINS)
+    assert {p.split("==")[0] for p in pack_mod.PINS} >= {"playwright", "greenlet"}
+
+
+# P7's acceptance: with nothing but the wheelhouse, pip resolves the helper and
+# everything it needs, for Windows, on every Python the zip claims.
+def test_the_wheelhouse_is_checked_to_install_offline_on_every_python():
+    argv = pack_mod.verify_command(["pip"], "3.13", Path("/wh"), "0.3.0", Path("/t"))
+
+    assert argv[:2] == ["pip", "install"]
+    for flag in (["--find-links", "/wh"], ["--python-version", "3.13"], ["--abi", "cp313"]):
+        assert _has(argv, flag)
+    assert "--dry-run" in argv and "--no-index" in argv
+    assert argv[-1] == "ai-workspace-helper==0.3.0"
+
+
+class _Run:
+    def __init__(self) -> None:
+        self.commands: list[list[str]] = []
+
+    def __call__(self, argv: list[str], cwd: Path | None = None) -> None:
+        self.commands.append(argv)
+        if argv[:2] == ["uv", "build"]:
+            out = Path(argv[argv.index("-o") + 1])
+            version = (Path(argv[-1]) / "src/ai_workspace_helper/version.py").read_text()
+            stamped = version.split('__version__ = "')[1].split('"')[0]
+            (out / f"ai_workspace_helper-{stamped}-py3-none-any.whl").write_text("wheel")
+        if "download" in argv:
+            dest = Path(argv[argv.index("-d") + 1])
+            (dest / "greenlet-3.5.6-cp312-cp312-win_amd64.whl").write_text("greenlet")
+
+
+def test_the_zip_carries_the_installer_and_the_wheels_and_the_manifest_names_it(tmp_path):
+    run = _Run()
+
+    zip_path, manifest = pack_mod.pack("0.3.0", tmp_path / "out", min_version="0.2.0", run=run)
+
+    assert zip_path == tmp_path / "out" / "ai-workspace-helper-0.3.0.zip"
+    with zipfile.ZipFile(zip_path) as z:
+        names = sorted(z.namelist())
+        readme = z.read("README.txt").decode("utf-8")
+    assert "precheck.pyw" in readme  # plan D19: check the PC before installing
+    assert names == [
+        "README.txt",
+        "install.pyw",
+        "launch.pyw",
+        "precheck.pyw",  # plan D19: run it before installing
+        "setup_core.py",
+        "wheelhouse/ai_workspace_helper-0.3.0-py3-none-any.whl",
+        "wheelhouse/greenlet-3.5.6-cp312-cp312-win_amd64.whl",
+    ]
+    assert json.loads(manifest.read_text()) == {
+        "version": "0.3.0",
+        "min_version": "0.2.0",
+        "file": "ai-workspace-helper-0.3.0.zip",
+        "sha256": hashlib.sha256(zip_path.read_bytes()).hexdigest(),
+    }
+    # the converter is built from the frontend before the wheel is (D11)
+    assert run.commands[0][:2] == ["pnpm", "run"]
+
+
+# The zip's setup_core.py IS the package's: one file, copied, never edited.
+def test_the_installer_core_in_the_zip_is_the_packages_own(tmp_path):
+    zip_path, _ = pack_mod.pack("0.3.0", tmp_path / "out", run=_Run())
+
+    with zipfile.ZipFile(zip_path) as z:
+        shipped = z.read("setup_core.py")
+    assert (
+        shipped
+        == (_ROOT / "ai-workspace-helper/src/ai_workspace_helper/setup_core.py").read_bytes()
+    )
+
+
+def test_the_source_tree_is_not_stamped(tmp_path):
+    version_py = _ROOT / "ai-workspace-helper/src/ai_workspace_helper/version.py"
+    before = version_py.read_text()
+
+    pack_mod.pack("9.9.9", tmp_path / "out", run=_Run())
+
+    assert version_py.read_text() == before
+
+
+@pytest.mark.parametrize("bad", ["1.0", "v1.0.0", "1.0.0rc1", "../1.0.0"])
+def test_a_version_must_be_three_numbers(tmp_path, bad):
+    with pytest.raises(ValueError):
+        pack_mod.pack(bad, tmp_path / "out", run=_Run())
+
+
+def _has(argv: list[str], pair: list[str]) -> bool:
+    return any(argv[i : i + 2] == pair for i in range(len(argv) - 1))
diff --git a/tests/ai_workspace_helper/test_setup_core.py b/tests/ai_workspace_helper/test_setup_core.py
new file mode 100644
index 00000000..57bfcbfb
--- /dev/null
+++ b/tests/ai_workspace_helper/test_setup_core.py
@@ -0,0 +1,352 @@
+"""Installing the helper on the person's PC (docs/plan-outside-helper.md D16,
+§3.7.1): standard library only, because it runs before anything is installed.
+
+The commands it runs (venv, pip, the self-test, the shortcut) go through an
+injected `run`, recorded here; the folders it builds are real.
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+from ai_workspace_helper import setup_core
+from ai_workspace_helper.setup_core import (
+    SetupFailed,
+    install,
+    install_version,
+    read_state,
+    shortcut_command,
+    write_state,
+)
+
+
+class _Run:
+    """Stands in for subprocess: records each command; `python -m venv`
+    makes the venv's interpreter, as the real one would."""
+
+    def __init__(self, fail_on: str | None = None) -> None:
+        self.commands: list[list[str]] = []
+        self.fail_on = fail_on
+
+    def __call__(self, argv: list[str]) -> None:
+        self.commands.append(argv)
+        if self.fail_on and any(self.fail_on in a for a in argv):
+            raise SetupFailed(f"{self.fail_on} failed")
+        if argv[1:3] == ["-m", "venv"]:
+            python = setup_core.venv_python(Path(argv[-1]))  # the venv path is last
+            python.parent.mkdir(parents=True, exist_ok=True)
+            python.write_text("")
+
+
+def _wheelhouse(tmp_path: Path, version: str = "0.3.0") -> Path:
+    wh = tmp_path / "zip" / "wheelhouse"
+    wh.mkdir(parents=True)
+    (wh / f"ai_workspace_helper-{version}-py3-none-any.whl").write_text("")
+    (wh / "playwright-1.63.0-py3-none-win_amd64.whl").write_text("")
+    return wh
+
+
+def test_a_version_is_installed_into_a_folder_of_its_own(tmp_path):
+    home, run = tmp_path / "home", _Run()
+
+    where = install_version(home, "/py/python", _wheelhouse(tmp_path), "0.3.0", run=run)
+
+    assert where == home / "versions" / "0.3.0"
+    python = str(setup_core.venv_python(where / "venv"))
+    # built by the Python the person confirmed; packages only from the zip;
+    # tried before it counts as installed (§3.7.4 steps 3–4)
+    assert run.commands == [
+        ["/py/python", "-m", "venv", str(home / "versions" / "0.3.0.partial" / "venv")],
+        [
+            str(setup_core.venv_python(home / "versions" / "0.3.0.partial" / "venv")),
+            "-m",
+            "pip",
+            "install",
+            "--no-index",
+            "--find-links",
+            str(tmp_path / "zip" / "wheelhouse"),
+            "ai-workspace-helper==0.3.0",
+        ],
+        [
+            str(setup_core.venv_python(home / "versions" / "0.3.0.partial" / "venv")),
+            "-m",
+            "ai_workspace_helper",
+            "--self-test",
+        ],
+    ]
+    assert Path(python).exists()
+    assert not (home / "versions" / "0.3.0.partial").exists()
+
+
+# Half-installed is never installed: a failed step leaves nothing the
+# launcher could pick up, and nothing the next try trips over.
+@pytest.mark.parametrize("step", ["venv", "pip", "--self-test"])
+def test_a_failed_step_leaves_no_version_behind(tmp_path, step):
+    home = tmp_path / "home"
+
+    with pytest.raises(SetupFailed):
+        install_version(home, "/py/python", _wheelhouse(tmp_path), "0.3.0", run=_Run(step))
+
+    assert list((home / "versions").iterdir()) == []
+
+
+def test_state_is_written_whole_or_not_at_all(tmp_path):
+    write_state(tmp_path, {"current": "0.3.0", "bad": []})
+
+    assert read_state(tmp_path) == {"current": "0.3.0", "bad": []}
+    assert sorted(p.name for p in tmp_path.iterdir()) == ["state.json"]
+    (tmp_path / "state.json").write_text("{")
+    assert read_state(tmp_path) == {}
+
+
+# D16: the shortcut names the Python the person confirmed, by its absolute
+# path — never the .pyw file association, which may point at another Python.
+def test_the_shortcut_runs_the_confirmed_python_on_the_fixed_launcher():
+    argv = shortcut_command(
+        "Desktop",
+        target=r"C:\Python312\pythonw.exe",
+        arguments=r'"C:\Users\me\AppData\Local\AIWorkspaceHelper\launch.pyw"',
+        workdir=r"C:\Users\me\AppData\Local\AIWorkspaceHelper",
+    )
+
+    assert argv[:3] == ["powershell", "-NoProfile", "-Command"]
+    script = argv[3]
+    assert "GetFolderPath('Desktop')" in script  # follows a redirected Desktop
+    assert "AI Workspace Helper.lnk" in script
+    assert r"$s.TargetPath = 'C:\Python312\pythonw.exe'" in script
+    launcher = r"C:\Users\me\AppData\Local\AIWorkspaceHelper\launch.pyw"
+    assert f"""$s.Arguments = '"{launcher}"'""" in script
+
+
+def test_a_quote_in_a_path_cannot_break_out_of_the_shortcut_script():
+    script = shortcut_command("Desktop", target="C:\\it's\\pythonw.exe", arguments="", workdir="")[
+        3
+    ]
+
+    assert "'C:\\it''s\\pythonw.exe'" in script
+
+
+def test_install_lays_out_the_folder_and_puts_the_shortcut_on_the_desktop(tmp_path):
+    home, run = tmp_path / "home", _Run()
+    wheelhouse = _wheelhouse(tmp_path)
+    for name in ("launch.pyw", "setup_core.py"):
+        (wheelhouse.parent / name).write_text(f"# {name}")
+
+    installed = install(wheelhouse.parent, home, base_python="/py/pythonw", run=run)
+
+    assert installed == ("0.3.0", "")
+    assert read_state(home) == {
+        "base_python": "/py/pythonw",
+        "current": "0.3.0",
+        "previous": None,
+        "pending": None,
+        "pending_attempts": 0,
+        "bad": [],
+    }
+    assert (home / "launch.pyw").read_text() == "# launch.pyw"
+    assert (home / "setup_core.py").read_text() == "# setup_core.py"
+    shortcut = run.commands[-1]
+    assert shortcut[0] == "powershell" and "GetFolderPath('Desktop')" in shortcut[3]
+    assert "'/py/pythonw'" in shortcut[3]
+
+
+# D16: running install.pyw again (a new Python, a broken install) keeps what
+# the person and the helper recorded — the Startup shortcut is still there, so
+# the window must still show 「開機時自動啟動」 ticked (review round 1).
+def test_installing_again_keeps_what_was_recorded(tmp_path):
+    home = tmp_path / "home"
+    write_state(home, {"current": "0.2.0", "start_at_login": True, "update": "已更新到 0.2.0"})
+    wheelhouse = _wheelhouse(tmp_path)
+    for name in ("launch.pyw", "setup_core.py"):
+        (wheelhouse.parent / name).write_text(name)
+
+    install(wheelhouse.parent, home, base_python="/py/pythonw", run=_Run())
+
+    state = read_state(home)
+    assert (state["current"], state["previous"]) == ("0.3.0", "0.2.0")
+    assert state["start_at_login"] is True
+    assert state["update"] == "已更新到 0.2.0"
+
+
+def test_a_zip_with_no_helper_in_it_says_so(tmp_path):
+    (tmp_path / "zip" / "wheelhouse").mkdir(parents=True)
+
+    with pytest.raises(SetupFailed, match="ai_workspace_helper"):
+        install(tmp_path / "zip", tmp_path / "home", base_python="/py/pythonw", run=_Run())
+
+
+# The fixed launcher starts the version state.json names, windowless.
+def test_the_launcher_starts_the_current_version(tmp_path):
+    argv = setup_core.launch_command(tmp_path, {"current": "0.3.0"})
+
+    assert argv == [
+        str(setup_core.venv_python(tmp_path / "versions" / "0.3.0" / "venv", windowed=True)),
+        "-m",
+        "ai_workspace_helper",
+    ]
+
+
+# On Windows that is pythonw.exe: python.exe would open a console window every
+# time the helper starts.
+def test_on_windows_the_launcher_starts_it_without_a_console(monkeypatch, tmp_path):
+    monkeypatch.setattr(setup_core.sys, "platform", "win32")
+
+    argv = setup_core.launch_command(tmp_path, {"current": "0.3.0"})
+
+    assert argv[0] == str(tmp_path / "versions" / "0.3.0" / "venv" / "Scripts" / "pythonw.exe")
+    assert setup_core.venv_python(tmp_path) == tmp_path / "Scripts" / "python.exe"
+
+
+def test_nothing_installed_is_said_not_launched(tmp_path):
+    with pytest.raises(SetupFailed, match="install"):
+        setup_core.launch_command(tmp_path, {})
+
+
+def test_the_state_file_is_json(tmp_path):
+    write_state(tmp_path, {"current": "0.3.0"})
+
+    assert json.loads((tmp_path / "state.json").read_text()) == {"current": "0.3.0"}
+
+
+# Without admin rights a PowerShell locked to its constrained language mode
+# cannot make the shortcut (New-Object -ComObject). Everything else is in
+# place by then: the install stands, and the person is told how to start it.
+def test_a_shortcut_that_cannot_be_made_does_not_undo_the_install(tmp_path):
+    home = tmp_path / "home"
+    wheelhouse = _wheelhouse(tmp_path)
+    for name in ("launch.pyw", "setup_core.py"):
+        (wheelhouse.parent / name).write_text(name)
+
+    installed = install(wheelhouse.parent, home, base_python="/py/pythonw", run=_Run("WScript"))
+
+    assert installed.version == "0.3.0" and "WScript failed" in installed.shortcut_error
+    assert read_state(home)["current"] == "0.3.0"
+
+
+# `powershell -Command` can carry on past an error and still exit 0: any
+# error must fail the command, or a shortcut that was never made reads as made.
+def test_the_shortcut_script_stops_at_any_error():
+    script = shortcut_command("Desktop", target="t", arguments="", workdir="")[3]
+
+    assert script.startswith("$ErrorActionPreference = 'Stop'; ")
+
+
+def test_a_shortcut_can_go_to_a_folder_by_its_path():
+    script = shortcut_command("", target="t", arguments="", workdir="", in_dir=r"C:\it's")[3]
+
+    assert "$d = 'C:\\it''s'" in script and "GetFolderPath" not in script
+
+
+# ── the precheck (plan D19): may this PC run the helper, before installing ──
+
+
+def _zip_with_node(tmp_path: Path) -> Path:
+    import zipfile
+
+    wh = tmp_path / "zip" / "wheelhouse"
+    wh.mkdir(parents=True)
+    with zipfile.ZipFile(wh / "playwright-1.63.0-py3-none-win_amd64.whl", "w") as z:
+        z.writestr("playwright/driver/node.exe", "MZ")
+    return wh.parent
+
+
+class _PrecheckRun(_Run):
+    """Also makes the shortcut the precheck asks PowerShell for — unless told
+    the shortcut fails silently, as PowerShell can."""
+
+    def __init__(self, fail_on: str | None = None, *, silent_shortcut: bool = False) -> None:
+        super().__init__(fail_on)
+        self.silent_shortcut = silent_shortcut
+
+    def __call__(self, argv: list[str]) -> None:
+        super().__call__(argv)
+        if argv[0] == "powershell" and not self.silent_shortcut:
+            folder = argv[3].split("$d = '")[1].split("'")[0]
+            (Path(folder) / "precheck.lnk").write_text("")
+
+
+def _precheck(tmp_path, run=None, **over):
+    from ai_workspace_helper.setup_core import precheck
+
+    chrome = tmp_path / "chrome.exe"
+    chrome.write_text("")
+    kwargs = {
+        "base_python": "/py/pythonw",
+        "python_version": (3, 12, 5),
+        "chrome_paths": [tmp_path / "nowhere.exe", chrome],
+        "chrome_policy": lambda _name: None,
+        "run": run or _PrecheckRun(),
+        **over,
+    }
+    return precheck(_zip_with_node(tmp_path), tmp_path / "scratch", **kwargs)
+
+
+def test_a_pc_that_can_run_the_helper_passes_every_check_and_keeps_nothing(tmp_path):
+    run = _PrecheckRun()
+    checks = _precheck(tmp_path, run)
+
+    assert [c.ok for c in checks] == [True] * 6, checks
+    assert [c.name for c in checks] == [
+        "Python 3.10 以上",
+        "在使用者資料夾執行程式",
+        "Playwright 的 node.exe",
+        "建立桌面捷徑（PowerShell）",
+        "Chrome",
+        "Chrome 允許自動化",
+    ]
+    ran = [a for a in run.commands]
+    assert ran[0][1:4] == ["-m", "venv", "--without-pip"]
+    assert ran[2][0].endswith("node.exe") and ran[2][1] == "--version"
+    assert not (tmp_path / "scratch").exists()  # it installs nothing
+
+
+@pytest.mark.parametrize(
+    ("breakage", "failed", "hint"),
+    [
+        ({"python_version": (3, 9, 1)}, "Python 3.10 以上", "3.9.1"),
+        ({"run": _PrecheckRun("-c")}, "在使用者資料夾執行程式", "%LOCALAPPDATA%"),
+        ({"run": _PrecheckRun("--version")}, "Playwright 的 node.exe", "防毒"),
+        ({"run": _PrecheckRun("WScript")}, "建立桌面捷徑（PowerShell）", "PowerShell"),
+        ({"run": _PrecheckRun(silent_shortcut=True)}, "建立桌面捷徑（PowerShell）", "PowerShell"),
+        ({"chrome_paths": []}, "Chrome", "沒有找到 Chrome"),
+        ({"chrome_policy": lambda name: 0}, "Chrome 允許自動化", "RemoteDebuggingAllowed"),
+    ],
+)
+def test_each_check_fails_on_its_own_and_says_what_to_do(tmp_path, breakage, failed, hint):
+    checks = _precheck(tmp_path, **breakage)
+
+    bad = [c for c in checks if not c.ok]
+    assert [c.name for c in bad] == [failed]
+    assert hint in bad[0].detail
+    assert len(checks) == 6  # one failing check does not stop the rest
+    assert not (tmp_path / "scratch").exists()
+
+
+def test_a_zip_without_playwright_s_node_says_the_zip_is_incomplete(tmp_path):
+    from ai_workspace_helper.setup_core import precheck
+
+    (tmp_path / "zip" / "wheelhouse").mkdir(parents=True)
+    checks = precheck(
+        tmp_path / "zip",
+        tmp_path / "scratch",
+        base_python="/py/pythonw",
+        python_version=(3, 12, 5),
+        chrome_paths=[],
+        chrome_policy=lambda _n: None,
+        run=_PrecheckRun(),
+    )
+
+    node = next(c for c in checks if c.name == "Playwright 的 node.exe")
+    assert not node.ok and "zip 不完整" in node.detail
+
+
+def test_the_summary_says_what_to_do_next():
+    from ai_workspace_helper.setup_core import Check, precheck_summary
+
+    ok = [Check("A", True, "可以"), Check("B", True, "可以")]
+    assert "接著雙擊 install.pyw" in precheck_summary(ok)
+    one_bad = [Check("A", True, "可以"), Check("B", False, "被擋")]
+    summary = precheck_summary(one_bad)
+    assert "1 項沒有通過" in summary and "✘ B：被擋" in summary and "✔ A：可以" in summary
diff --git a/tests/ai_workspace_helper/test_updater.py b/tests/ai_workspace_helper/test_updater.py
new file mode 100644
index 00000000..5b6efc23
--- /dev/null
+++ b/tests/ai_workspace_helper/test_updater.py
@@ -0,0 +1,204 @@
+"""The running helper keeps itself current (docs/plan-outside-helper.md
+§3.7.4, §3.7.6): it checks at start and every six hours, fetches through its
+own signed-in line, prepares in the background — never in the way of the
+person's lookups — and a version the backend refuses is updated at once."""
+
+from __future__ import annotations
+
+import hashlib
+from pathlib import Path
+
+from ai_workspace_helper.setup_core import read_state, write_state
+from ai_workspace_helper.updates import CHECK_EVERY_S, RETRY_AFTER_S, Updater
+
+from tests.ai_workspace_helper.test_setup_core import _Run
+from tests.ai_workspace_helper.test_updates import _zip
+
+
+class _Backend:
+    def __init__(self, manifest: dict | None, data: bytes = b"") -> None:
+        self._manifest = manifest
+        self._data = data
+        self.manifests = 0
+        self.downloads: list[str] = []
+
+    def manifest(self):
+        self.manifests += 1
+        return self._manifest
+
+    def download(self, file: str) -> bytes:
+        self.downloads.append(file)
+        return self._data
+
+
+def _release(version: str) -> tuple[dict, bytes]:
+    data = _zip(version)
+    return (
+        {
+            "version": version,
+            "min_version": "0.0.0",
+            "file": f"ai-workspace-helper-{version}.zip",
+            "sha256": hashlib.sha256(data).hexdigest(),
+        },
+        data,
+    )
+
+
+def _home(tmp_path: Path, current: str = "0.3.0") -> Path:
+    (tmp_path / "versions" / current / "venv").mkdir(parents=True)
+    write_state(tmp_path, {"base_python": "/py/pythonw", "current": current, "bad": []})
+    return tmp_path
+
+
+def _updater(home, backend, clock, run=None, version="0.3.0"):
+    return Updater(
+        home,
+        backend,
+        clock=lambda: clock[0],
+        spawn=lambda work: work(),  # the background thread, run inline
+        run=run or _Run(),
+        version=version,
+    )
+
+
+def test_a_newer_release_is_prepared_for_the_next_start(tmp_path):
+    manifest, data = _release("0.4.0")
+    backend, clock = _Backend(manifest, data), [0.0]
+    up = _updater(_home(tmp_path), backend, clock)
+
+    up.tick()
+
+    assert backend.downloads == ["ai-workspace-helper-0.4.0.zip"]
+    assert read_state(tmp_path)["pending"] == "0.4.0"
+    assert up.status == "ready"
+
+
+def test_it_checks_at_start_then_every_six_hours(tmp_path):
+    backend, clock = _Backend(None), [0.0]
+    up = _updater(_home(tmp_path), backend, clock)
+
+    up.tick()
+    clock[0] = CHECK_EVERY_S - 1
+    up.tick()
+    clock[0] = CHECK_EVERY_S
+    up.tick()
+
+    assert backend.manifests == 2
+
+
+def test_nothing_newer_fetches_nothing(tmp_path):
+    manifest, data = _release("0.3.0")
+    backend, clock = _Backend(manifest, data), [0.0]
+    up = _updater(_home(tmp_path), backend, clock)
+
+    up.tick()
+
+    assert backend.downloads == []
+    assert up.status == ""
+
+
+def test_a_failed_preparation_is_shown_and_the_running_version_carries_on(tmp_path):
+    manifest, data = _release("0.4.0")
+    backend, clock = _Backend(manifest, data), [0.0]
+    up = _updater(_home(tmp_path), backend, clock, run=_Run("--self-test"))
+
+    up.tick()
+
+    assert up.status.startswith("failed")
+    assert read_state(tmp_path)["current"] == "0.3.0"
+    assert read_state(tmp_path).get("pending") is None
+
+
+# §3.7.6: refused by the backend, the helper updates at once — from the release
+# the refusal named — and does not hammer the backend when that fails.
+def test_a_refused_version_updates_at_once_from_the_release_it_was_given(tmp_path):
+    manifest, data = _release("0.4.0")
+    backend, clock = _Backend(None, data), [0.0]
+    up = _updater(_home(tmp_path), backend, clock)
+    up.tick()  # the scheduled check, nothing published then
+    clock[0] = 10.0
+
+    up.tick(required=manifest)
+
+    assert backend.downloads == ["ai-workspace-helper-0.4.0.zip"]
+    assert up.status == "ready"
+
+
+# Refused, and the release it must update to already failed here three times:
+# it will not be tried again, so the window must say what is left — a
+# reinstall — rather than nothing at all (review round 1).
+def test_a_refused_helper_whose_update_is_marked_bad_says_to_reinstall(tmp_path):
+    manifest, data = _release("0.4.0")
+    home = _home(tmp_path)
+    write_state(home, {**read_state(home), "bad": ["0.4.0"]})
+    backend = _Backend(None, data)
+    up = _updater(home, backend, [0.0])
+
+    up.tick(required=manifest)
+
+    assert backend.downloads == []
+    assert up.status.startswith("failed")
+
+
+# A manifest's version names folders on the PC (versions/<v>): only a version.
+def test_a_release_whose_version_is_not_a_version_is_not_installed(tmp_path):
+    manifest, data = _release("0.4.0")
+    manifest["version"] = "../../0.9.0"
+    backend = _Backend(manifest, data)
+    up = _updater(_home(tmp_path), backend, [0.0])
+
+    up.tick()
+
+    assert backend.downloads == []
+    assert not (tmp_path.parent / "0.9.0").exists()
+
+
+def test_a_forced_update_that_failed_waits_before_trying_again(tmp_path):
+    manifest, data = _release("0.4.0")
+    backend, clock = _Backend(None, data), [0.0]
+    up = _updater(_home(tmp_path), backend, clock, run=_Run("--self-test"))
+
+    up.tick(required=manifest)
+    clock[0] = RETRY_AFTER_S - 1
+    up.tick(required=manifest)
+    clock[0] = RETRY_AFTER_S
+    up.tick(required=manifest)
+
+    assert len(backend.downloads) == 2
+
+
+# §3.7.5 step 3: the waiting version, once up, makes itself current — once.
+def test_the_new_version_confirms_itself_once_connected(tmp_path):
+    home = _home(tmp_path)
+    (home / "versions" / "0.4.0" / "venv").mkdir(parents=True)
+    state = read_state(home)
+    write_state(home, {**state, "pending": "0.4.0", "pending_attempts": 1})
+    up = _updater(home, _Backend(None), [0.0], version="0.4.0")
+
+    up.connected()
+    up.connected()
+
+    assert read_state(home)["current"] == "0.4.0"
+    assert read_state(home)["previous"] == "0.3.0"
+
+
+# Asked once per run, not on every poll: the check-in happens every couple of
+# seconds, and there is nothing to confirm after the first.
+def test_it_asks_to_be_confirmed_once_per_run(tmp_path, monkeypatch):
+    from ai_workspace_helper import setup_core
+
+    asked: list[str] = []
+    monkeypatch.setattr(setup_core, "confirm", lambda home, v: asked.append(v) or False)
+    up = _updater(_home(tmp_path), _Backend(None), [0.0])
+
+    for _ in range(5):
+        up.connected()
+
+    assert asked == ["0.3.0"]
+
+
+def test_what_it_reports_on_each_check_in(tmp_path):
+    home = _home(tmp_path)
+    write_state(home, {**read_state(home), "update": "0.4.0 起不來,已退回 0.3.0"})
+
+    assert _updater(home, _Backend(None), [0.0]).report() == "0.4.0 起不來,已退回 0.3.0"
diff --git a/tests/ai_workspace_helper/test_updates.py b/tests/ai_workspace_helper/test_updates.py
new file mode 100644
index 00000000..745d8b8e
--- /dev/null
+++ b/tests/ai_workspace_helper/test_updates.py
@@ -0,0 +1,376 @@
+"""Updating the helper on the person's PC (docs/plan-outside-helper.md §3.7.4–
+§3.7.6) and removing it (D17). Never in place: a new version is installed
+beside the running one and taken on the next start; one that will not start is
+rolled back by the fixed launcher; nothing half-done is ever started.
+
+All on Linux with the commands recorded (D14: Windows is checked by hand).
+"""
+
+from __future__ import annotations
+
+import hashlib
+import io
+import zipfile
+from pathlib import Path
+
+import pytest
+from ai_workspace_helper import setup_core
+from ai_workspace_helper.setup_core import (
+    SetupFailed,
+    confirm,
+    prepare_update,
+    read_state,
+    start_choice,
+    startup_command,
+    uninstall,
+    write_state,
+)
+
+from tests.ai_workspace_helper.test_setup_core import _Run
+
+
+def _zip(version: str, launcher: str = "# launch v") -> bytes:
+    buf = io.BytesIO()
+    with zipfile.ZipFile(buf, "w") as z:
+        z.writestr(f"wheelhouse/ai_workspace_helper-{version}-py3-none-any.whl", "wheel")
+        z.writestr("launch.pyw", f"{launcher}{version}")
+        z.writestr("setup_core.py", f"# setup_core {version}")
+        z.writestr("install.pyw", "# install")
+    return buf.getvalue()
+
+
+def _manifest(version: str, data: bytes, **over) -> dict:
+    return {
+        "version": version,
+        "min_version": "0.0.0",
+        "file": f"ai-workspace-helper-{version}.zip",
+        "sha256": hashlib.sha256(data).hexdigest(),
+        **over,
+    }
+
+
+def _installed(home: Path, current: str = "0.3.0", **state) -> None:
+    for v in {current, *([state["previous"]] if state.get("previous") else [])}:
+        (home / "versions" / v / "venv").mkdir(parents=True, exist_ok=True)
+    write_state(
+        home,
+        {
+            "base_python": "/py/pythonw",
+            "current": current,
+            "previous": None,
+            "pending": None,
+            "pending_attempts": 0,
+            "bad": [],
+            **state,
+        },
+    )
+
+
+# ── §3.7.4: preparing the next version in the background ────────────────────
+
+
+def test_a_newer_release_is_installed_beside_and_waits_for_the_next_start(tmp_path):
+    _installed(tmp_path)
+    data = _zip("0.4.0")
+    run = _Run()
+
+    outcome = prepare_update(tmp_path, _manifest("0.4.0", data), lambda _f: data, run=run)
+
+    assert outcome == "ready"
+    assert (tmp_path / "versions" / "0.4.0" / "venv").is_dir()
+    # the running version is untouched, and nothing switches until next start
+    state = read_state(tmp_path)
+    assert (state["current"], state["pending"], state["pending_attempts"]) == ("0.3.0", "0.4.0", 0)
+    # the new version keeps its own launcher, to put in place once it is confirmed
+    assert (tmp_path / "versions" / "0.4.0" / "launch.pyw").read_text() == "# launch v0.4.0"
+    # the venv is built from the Python the person confirmed at install (D16)
+    assert run.commands[0][0] == "/py/pythonw"
+
+
+@pytest.mark.parametrize("version", ["0.3.0", "0.2.9"])
+def test_a_release_no_newer_than_this_one_is_left_alone(tmp_path, version):
+    _installed(tmp_path)
+    data = _zip(version)
+
+    assert prepare_update(tmp_path, _manifest(version, data), _fail_fetch, run=_Run()) == "current"
+
+
+def test_a_release_marked_bad_is_not_tried_again(tmp_path):
+    _installed(tmp_path, bad=["0.4.0"])
+    data = _zip("0.4.0")
+
+    assert prepare_update(tmp_path, _manifest("0.4.0", data), _fail_fetch, run=_Run()) == "bad"
+
+
+def test_a_release_already_waiting_is_not_fetched_again(tmp_path):
+    _installed(tmp_path, pending="0.4.0")
+    (tmp_path / "versions" / "0.4.0" / "venv").mkdir(parents=True)
+    data = _zip("0.4.0")
+
+    assert prepare_update(tmp_path, _manifest("0.4.0", data), _fail_fetch, run=_Run()) == "ready"
+
+
+# A download that does not match the manifest is never installed.
+def test_a_download_that_does_not_match_is_thrown_away(tmp_path):
+    _installed(tmp_path)
+    data = _zip("0.4.0")
+
+    with pytest.raises(SetupFailed, match="sha256"):
+        prepare_update(tmp_path, _manifest("0.4.0", data), lambda _f: data + b"x", run=_Run())
+
+    assert not (tmp_path / "versions" / "0.4.0").exists()
+    assert list((tmp_path / "downloads").iterdir()) == []
+    assert read_state(tmp_path)["pending"] is None
+
+
+# §3.7.4 step 5: the running version carries on; the same release failing three
+# times is marked bad and left until the next one.
+def test_a_release_that_fails_three_times_is_marked_bad(tmp_path):
+    _installed(tmp_path)
+    data = _zip("0.4.0")
+
+    for attempt in range(1, 4):
+        with pytest.raises(SetupFailed):
+            prepare_update(
+                tmp_path, _manifest("0.4.0", data), lambda _f: data, run=_Run("--self-test")
+            )
+        state = read_state(tmp_path)
+        assert state["current"] == "0.3.0"
+        assert ("0.4.0" in state["bad"]) is (attempt == 3)
+
+    assert prepare_update(tmp_path, _manifest("0.4.0", data), _fail_fetch, run=_Run()) == "bad"
+
+
+# A zip whose entries climb out of its folder (zip slip) writes nothing — even
+# one that matches its manifest's checksum.
+def test_an_update_zip_that_names_paths_outside_itself_is_refused(tmp_path):
+    home = tmp_path / "home"
+    _installed(home)
+    buf = io.BytesIO()
+    with zipfile.ZipFile(buf, "w") as z:
+        z.writestr("wheelhouse/ai_workspace_helper-0.4.0-py3-none-any.whl", "wheel")
+        z.writestr("../../escaped.txt", "out")
+    data = buf.getvalue()
+
+    with pytest.raises(SetupFailed, match="outside"):
+        prepare_update(home, _manifest("0.4.0", data), lambda _f: data, run=_Run())
+
+    assert not (tmp_path / "escaped.txt").exists()
+    assert not (home / "escaped.txt").exists()
+
+
+def test_a_manifest_naming_a_path_is_refused(tmp_path):
+    _installed(tmp_path)
+    data = _zip("0.4.0")
+
+    with pytest.raises(SetupFailed):
+        prepare_update(
+            tmp_path, _manifest("0.4.0", data, file="../x.zip"), lambda _f: data, run=_Run()
+        )
+
+
+# ── §3.7.5: the fixed launcher switches, and rolls back ──────────────────────
+
+
+def test_with_nothing_waiting_the_current_version_starts(tmp_path):
+    version, state = start_choice({"current": "0.3.0", "pending": None})
+
+    assert version == "0.3.0"
+    assert state["pending"] is None
+
+
+def test_a_waiting_version_is_tried_and_counted(tmp_path):
+    version, state = start_choice({"current": "0.3.0", "pending": "0.4.0", "pending_attempts": 1})
+
+    assert version == "0.4.0"
+    assert state["pending_attempts"] == 2
+
+
+def test_a_version_that_never_confirms_is_rolled_back_after_three_starts(tmp_path):
+    state = {"current": "0.3.0", "pending": "0.4.0", "pending_attempts": 0, "bad": []}
+
+    started = []
+    for _ in range(4):
+        version, state = start_choice(state)
+        started.append(version)
+
+    assert started == ["0.4.0", "0.4.0", "0.4.0", "0.3.0"]
+    assert (state["pending"], state["bad"]) == (None, ["0.4.0"])
+    # said once, on the next check-in (§3.7.5 step 4)
+    assert state["update"] == "0.4.0 起不來,已退回 0.3.0"
+
+
+def test_the_new_version_confirms_itself_and_takes_over(tmp_path):
+    _installed(tmp_path, current="0.3.0", previous="0.2.0", pending="0.4.0", pending_attempts=1)
+    new = tmp_path / "versions" / "0.4.0"
+    (new / "venv").mkdir(parents=True)
+    (new / "launch.pyw").write_text("# launch v0.4.0")
+    (new / "setup_core.py").write_text("# setup_core 0.4.0")
+    (tmp_path / "launch.pyw").write_text("# launch v0.3.0")
+    (tmp_path / "versions" / "0.1.0" / "venv").mkdir(parents=True)
+
+    assert confirm(tmp_path, "0.4.0") is True
+
+    state = read_state(tmp_path)
+    assert (state["current"], state["previous"], state["pending"], state["pending_attempts"]) == (
+        "0.4.0",
+        "0.3.0",
+        None,
+        0,
+    )
+    # only the version running and the one before it are kept
+    assert sorted(p.name for p in (tmp_path / "versions").iterdir()) == ["0.3.0", "0.4.0"]
+    # the launcher is replaced only now, once the new version has proven itself
+    assert (tmp_path / "launch.pyw").read_text() == "# launch v0.4.0"
+    assert (tmp_path / "setup_core.py").read_text() == "# setup_core 0.4.0"
+
+
+def test_a_version_that_is_not_the_one_waiting_confirms_nothing(tmp_path):
+    _installed(tmp_path, current="0.3.0", pending="0.4.0")
+    (tmp_path / "launch.pyw").write_text("# launch v0.3.0")
+
+    assert confirm(tmp_path, "0.3.0") is False
+
+    assert read_state(tmp_path)["pending"] == "0.4.0"
+    assert (tmp_path / "launch.pyw").read_text() == "# launch v0.3.0"
+
+
+# ── D13: start at login ─────────────────────────────────────────────────────
+
+
+def test_start_at_login_puts_the_same_shortcut_in_startup(tmp_path):
+    on = startup_command(True, base_python=r"C:\Py\pythonw.exe", home=Path(r"C:\H"))
+    off = startup_command(False, base_python=r"C:\Py\pythonw.exe", home=Path(r"C:\H"))
+
+    assert "GetFolderPath('Startup')" in on[3] and "CreateShortcut" in on[3]
+    assert "GetFolderPath('Startup')" in off[3] and "Remove-Item" in off[3]
+    assert "AI Workspace Helper.lnk" in off[3]
+
+
+# ── D17: uninstall ──────────────────────────────────────────────────────────
+
+
+def test_uninstall_removes_the_folder_and_both_shortcuts(tmp_path):
+    home = tmp_path / "AIWorkspaceHelper"
+    _installed(home)
+    run = _Run()
+
+    left = uninstall(home, run=run)
+
+    assert left == []
+    assert not home.exists()
+    folders = sorted(c[3].split("GetFolderPath(")[1].split(")")[0] for c in run.commands)
+    assert folders == ["'Desktop'", "'Startup'"]
+    assert all("Remove-Item" in c[3] for c in run.commands)
+
+
+def test_what_uninstall_cannot_remove_is_listed(tmp_path):
+    home = tmp_path / "AIWorkspaceHelper"
+    _installed(home)
+
+    def stuck(path, onexc=None):  # an antivirus holding a file
+        raise PermissionError(13, "in use", str(home / "versions"))
+
+    left = uninstall(home, run=_Run(), remove_tree=stuck)
+
+    assert left == [str(home)]
+
+
+# ── launch.pyw (§3.7.5) ─────────────────────────────────────────────────────
+
+
+def test_the_launcher_starts_the_chosen_version_after_writing_down_the_try(tmp_path):
+    _installed(tmp_path, pending="0.4.0", pending_attempts=0)
+    started: list[list[str]] = []
+
+    assert setup_core.launch(tmp_path, popen=lambda argv, cwd: started.append(argv)) == "0.4.0"
+
+    assert started == [setup_core.version_command(tmp_path, "0.4.0")]
+    # written BEFORE starting: a version that crashes on start is still counted
+    assert read_state(tmp_path)["pending_attempts"] == 1
+
+
+# One helper at a time (§3.7 table): started at login AND double-clicked, the
+# second one brings the first one's window forward instead of starting.
+def test_with_a_helper_running_the_launcher_brings_it_forward_instead(tmp_path):
+    _installed(tmp_path)
+    running = setup_core.InstanceLock(tmp_path / "helper.lock")
+    assert running.acquire()
+    started: list[list[str]] = []
+    try:
+        outcome = setup_core.launch(tmp_path, popen=lambda argv, cwd: started.append(argv))
+    finally:
+        running.release()
+
+    assert outcome == "shown"
+    assert started == []
+    assert (tmp_path / "show.request").exists()
+
+
+# 「立即更新」 (§3.7.6): the old helper is still ending when the launcher starts
+# — its lock goes with its process, which still holds Chrome's profile. Asked
+# to wait, the launcher waits for the lock rather than bringing a dying window
+# forward, and only then starts the new version (review round 1).
+def test_a_restarting_launcher_waits_for_the_old_helper_to_end(tmp_path):
+    _installed(tmp_path, pending="0.4.0")
+    running = setup_core.InstanceLock(tmp_path / "helper.lock")
+    assert running.acquire()
+    waited: list[float] = []
+
+    def sleep(s: float) -> None:
+        waited.append(s)
+        if len(waited) == 2:
+            running.release()  # the old process has ended
+
+    started: list[list[str]] = []
+    version = setup_core.launch(
+        tmp_path, popen=lambda argv, cwd: started.append(argv), wait_s=15, sleep=sleep
+    )
+
+    assert version == "0.4.0" and len(started) == 1 and len(waited) == 2
+
+
+def test_with_nothing_installed_the_launcher_says_so(tmp_path):
+    with pytest.raises(SetupFailed, match="install"):
+        setup_core.launch(tmp_path, popen=lambda argv, cwd: None)
+
+
+# ── the uninstall clean-up process (D17) ────────────────────────────────────
+
+
+def test_the_clean_up_waits_for_the_helper_to_end_then_removes_it(tmp_path):
+    home = tmp_path / "AIWorkspaceHelper"
+    _installed(home)
+    running = setup_core.InstanceLock(home / "helper.lock")
+    assert running.acquire()
+    waited: list[float] = []
+
+    def sleep(s: float) -> None:
+        waited.append(s)
+        if len(waited) == 3:
+            running.release()  # the helper has ended
+
+    left = setup_core.uninstall_main(home, run=_Run(), sleep=sleep, log_dir=tmp_path)
+
+    assert len(waited) == 3
+    assert left == [] and not home.exists()
+    assert not (tmp_path / "ai-workspace-helper-uninstall.log").exists()
+
+
+def test_what_the_clean_up_cannot_remove_is_written_down(tmp_path):
+    home = tmp_path / "AIWorkspaceHelper"
+    _installed(home)
+
+    def stuck(path):
+        raise PermissionError(13, "in use")
+
+    left = setup_core.uninstall_main(
+        home, run=_Run(), sleep=lambda s: None, log_dir=tmp_path, remove_tree=stuck
+    )
+
+    assert left == [str(home)]
+    assert str(home) in (tmp_path / "ai-workspace-helper-uninstall.log").read_text(encoding="utf-8")
+
+
+def _fail_fetch(_file: str) -> bytes:
+    raise AssertionError("nothing should be downloaded")
diff --git a/tests/ai_workspace_helper/test_worker.py b/tests/ai_workspace_helper/test_worker.py
new file mode 100644
index 00000000..16512a92
--- /dev/null
+++ b/tests/ai_workspace_helper/test_worker.py
@@ -0,0 +1,393 @@
+"""The helper's loop (docs/plan-outside-helper.md §3.4, P5), against the REAL
+backend routes: check in, take the person's job, run its errand in the browser,
+hand the page back — or say why it could not.
+
+The browser here is a stand-in (the real one is exercised in P6's integration
+tests); the backend is the app itself, through the same HTTP the helper speaks.
+"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+
+from ai_workspace_helper.backend import Backend
+from ai_workspace_helper.errands import FetchedPage
+from ai_workspace_helper.version import PROTOCOL, __version__
+from ai_workspace_helper.worker import Worker
+from starlette.testclient import TestClient as RawClient
+
+from tests.api.test_outside_answers import _answers, _asked
+
+
+def _backend(client) -> Backend:
+    """The helper's backend client over the app's own HTTP (raw: the helper
+    speaks the real `/api/…` paths)."""
+    raw = RawClient(client.app)
+
+    def send(method: str, path: str, body: dict | None, headers: dict[str, str]):
+        r = raw.request(method, path, json=body, headers=headers)
+        try:
+            data = r.json() if r.content else None
+        except ValueError:
+            data = None
+        return r.status_code, data
+
+    def fetch_bytes(path: str, headers: dict[str, str]):
+        r = raw.get(path, headers=headers)
+        return r.status_code, r.content
+
+    return Backend(send, fetch_bytes=fetch_bytes)
+
+
+@dataclass
+class _Browser:
+    """Stands in for Chrome: each errand gets `page`, records what it was asked."""
+
+    asked: list[tuple[str, str]]
+
+    def run(self, errand, args: str, note, where=None) -> FetchedPage:
+        self.note = note
+        self.where = where or (lambda _site: None)
+        return errand(self, args)
+
+
+def _errands(**over):
+    def search(browser, query: str) -> FetchedPage:
+        browser.asked.append(("search", query))
+        return FetchedPage(
+            title="results",
+            url=f"https://www.google.com/search?q={query}",
+            markdown="- [a](https://a.example/)",
+        )
+
+    return {"search": search, **over}
+
+
+def _hand(client, iid, **body):
+    r = client.post(f"/a/rca/items/{iid}/outside-jobs", json={"tool_call_id": "c1", **body})
+    assert r.status_code == 201, r.text
+
+
+def test_the_helper_takes_the_job_fetches_and_the_card_is_answered():
+    client, spec, iid = _asked()
+    browser = _Browser(asked=[])
+    worker = Worker(
+        _backend(client), browser, errands=_errands(), date=lambda: "2031-01-02"
+    )  # not today: the backend would fill today in
+    worker.tick()  # checks in: the card may now hand over
+    _hand(client, iid, query="pandas 2.0 新功能")
+
+    worker.tick()
+
+    assert browser.asked == [("search", "pandas 2.0 新功能")]
+    [answer] = _answers(spec)
+    assert "lookups/2031-01-02-" in answer.content
+    assert worker.status == "connected"
+
+
+def test_an_errand_that_fails_reports_why_and_the_card_shows_it():
+    client, spec, iid = _asked()
+
+    def broken(browser, query):
+        raise RuntimeError("page timed out")
+
+    worker = Worker(_backend(client), _Browser([]), errands=_errands(search=broken))
+    worker.tick()
+    _hand(client, iid)
+
+    worker.tick()
+
+    job = client.get(f"/a/rca/items/{iid}/outside-jobs/c1").json()
+    assert (job["state"], job["error"]) == ("failed", "page timed out")
+    assert _answers(spec) == []
+
+
+def test_a_kind_this_helper_cannot_do_says_so():
+    client, _spec, iid = _asked()
+    worker = Worker(_backend(client), _Browser([]), errands={})
+    worker.tick()
+    _hand(client, iid)
+
+    worker.tick()
+
+    job = client.get(f"/a/rca/items/{iid}/outside-jobs/c1").json()
+    assert job["state"] == "failed"
+    assert "search" in job["error"] and "update" in job["error"]
+
+
+def test_the_helper_says_which_version_it_is():
+    client, _spec, _iid = _asked()
+    seen: list[dict[str, str]] = []
+    backend = _backend(client)
+    inner = backend._send
+
+    def spy(method, path, body, headers):
+        seen.append(headers)
+        return inner(method, path, body, headers)
+
+    backend._send = spy
+    Worker(backend, _Browser([]), errands={}).tick()
+
+    assert seen and all(
+        h["X-AI-Workspace-Helper-Version"] == __version__
+        and h["X-AI-Workspace-Helper-Protocol"] == str(PROTOCOL)
+        for h in seen
+    )
+
+
+# Paused: the helper takes nothing — and does not check in either, so the card
+# offers the manual flow rather than a 「查」 nobody will act on (D7).
+def test_a_paused_helper_takes_nothing_and_is_offline():
+    client, _spec, iid = _asked()
+    worker = Worker(_backend(client), _Browser([]), errands=_errands())
+    worker.paused = True
+
+    worker.tick()
+
+    assert client.get("/ai-workspace-helper/status").json() == {"online": False}
+    assert worker.status == "paused"
+
+
+# Signed out (the deploy's login expired): say so, take nothing, keep trying.
+def test_a_signed_out_helper_asks_for_the_login():
+    worker = Worker(Backend(lambda m, p, b, h: (401, None)), _Browser([]), errands={})
+
+    worker.tick()
+
+    assert worker.status == "needs_login"
+
+
+def test_a_backend_that_cannot_be_reached_reads_as_offline_not_a_crash():
+    def down(method, path, body, headers):
+        raise OSError("connection refused")
+
+    worker = Worker(Backend(down), _Browser([]), errands={})
+
+    worker.tick()
+
+    assert worker.status == "unreachable"
+
+
+# A captcha: the errand says it is waiting on the person, and the card shows it
+# while the job is still under way (§3.4).
+def test_what_the_errand_waits_on_reaches_the_card_while_it_runs():
+    client, _spec, iid = _asked()
+    during: list[str] = []
+
+    def search(browser, query):
+        browser.note("captcha")
+        during.append(client.get(f"/a/rca/items/{iid}/outside-jobs/c1").json()["note"])
+        return FetchedPage(title="t", url="https://www.google.com/search?q=x", markdown="ok")
+
+    worker = Worker(_backend(client), _Browser([]), errands=_errands(search=search))
+    worker.tick()
+    _hand(client, iid)
+
+    worker.tick()
+
+    assert during == ["captcha"]
+
+
+# 403 is "not allowed", not "signed out": signing in again changes nothing, so
+# the helper must not keep popping the login page at the person (review r1).
+def test_a_refusal_is_not_taken_for_an_expired_login():
+    worker = Worker(
+        Backend(lambda m, p, b, h: (403, {"detail": "you may not converse here"})),
+        _Browser([]),
+        errands={},
+    )
+
+    worker.tick()
+
+    assert (worker.status, worker.detail) == ("error", "you may not converse here")
+
+
+# Behind a company gateway an expired login is usually not a 401 but a redirect
+# to the SSO page; followed, that is a 200 login page the helper would take for
+# a check-in. The helper does not follow redirects, and a 3xx means: sign in.
+def test_a_redirect_to_the_login_page_asks_for_the_login():
+    worker = Worker(Backend(lambda m, p, b, h: (302, None)), _Browser([]), errands={})
+
+    worker.tick()
+
+    assert worker.status == "needs_login"
+
+
+# §3.7.6: below the minimum version the backend refuses with the manifest of
+# the current one; the helper stops taking jobs and knows what to fetch.
+def test_a_version_no_longer_accepted_says_an_update_is_needed(tmp_path):
+    from tests.api.test_ai_workspace_helper_release import _publish
+
+    manifest, _ = _publish(tmp_path, "0.9.0", min_version="0.9.0")
+    client, _spec, _iid = _asked(ai_workspace_helper_dir=str(tmp_path))
+    worker = Worker(_backend(client), _Browser([]), errands={})
+
+    worker.tick()
+
+    assert worker.status == "update_required"
+    assert worker.manifest == {**manifest, "size": len(b"zip of 0.9.0")}
+
+
+# §3.7.4: the helper reads the published release and fetches its zip through
+# the same signed-in line it takes jobs through.
+def test_the_helper_reads_and_fetches_the_published_release(tmp_path):
+    from tests.api.test_ai_workspace_helper_release import _publish
+
+    manifest, zip_bytes = _publish(tmp_path, "0.9.0")
+    client, _spec, _iid = _asked(ai_workspace_helper_dir=str(tmp_path))
+    backend = _backend(client)
+
+    release = backend.manifest()
+    assert release is not None and release["version"] == "0.9.0"
+    assert backend.download(manifest["file"]) == zip_bytes
+
+
+def test_with_nothing_published_there_is_no_release():
+    client, _spec, _iid = _asked()
+
+    assert _backend(client).manifest() is None
+
+
+# §3.7.7: each check-in says what the helper runs on.
+def test_the_check_in_says_what_the_helper_runs_on():
+    client, _spec, _iid = _asked()
+    info = {"chrome": "141.0", "playwright": "1.63.0", "python": "3.12.5", "update": ""}
+    worker = Worker(_backend(client), _Browser([]), errands={}, info=lambda: info)
+
+    worker.tick()
+
+    seen = client.app.state.outside_jobs.presence("u")
+    assert (seen.version, seen.chrome, seen.playwright, seen.python) == (
+        __version__,
+        "141.0",
+        "1.63.0",
+        "3.12.5",
+    )
+
+
+def test_any_other_refusal_shows_the_backends_reason():
+    worker = Worker(
+        Backend(lambda m, p, b, h: (500, {"detail": "store unavailable"})), _Browser([]), errands={}
+    )
+
+    worker.tick()
+
+    assert (worker.status, worker.detail) == ("error", "store unavailable")
+
+
+# The login expires while a page is being fetched: that is not the page's
+# failure — the job is left to come back once the person has signed in again.
+def test_a_login_that_expires_mid_errand_does_not_fail_the_job():
+    client, _spec, iid = _asked()
+    backend = _backend(client)
+    inner = backend._send
+    expired = [False]
+
+    paths: list[str] = []
+
+    def send(method, path, body, headers):
+        paths.append(path)
+        return (401, None) if expired[0] else inner(method, path, body, headers)
+
+    backend._send = send
+
+    def search(browser, query):
+        expired[0] = True
+        browser.note("captcha")
+        raise AssertionError("unreachable: the note above signs out")
+
+    worker = Worker(backend, _Browser([]), errands=_errands(search=search))
+    worker.tick()
+    _hand(client, iid)
+
+    worker.tick()
+
+    assert worker.status == "needs_login"
+    # it does not even try to report the job failed
+    assert not any(p.endswith("/fail") for p in paths)
+    expired[0] = False
+    assert client.get(f"/a/rca/items/{iid}/outside-jobs/c1").json()["state"] == "claimed"
+
+
+# A search goes where the card's own buttons go — the deploy's
+# `server.lookup_targets`, read from the backend, not a list of the helper's.
+def test_the_helper_searches_where_the_deploy_says():
+    targets = [{"name": "Corp search", "url": "https://search.corp/?q={q}"}]
+    client, _spec, _iid = _asked(lookup_targets=targets)
+
+    assert _backend(client).lookup_targets() == targets
+
+
+# The window's 查詢紀錄 (D13): each job the helper ran leaves one line — what,
+# on which site, and how it ended — and the log says the same.
+def test_each_job_leaves_a_line_in_the_history_and_the_log(caplog):
+    import logging
+
+    from ai_workspace_helper.errands import ErrandFailed
+    from ai_workspace_helper.history import History
+
+    def found(browser, query: str) -> FetchedPage:
+        browser.where("Google")
+        return FetchedPage(title="r", url="https://www.google.com/search?q=x", markdown="ok")
+
+    def not_found(browser, query: str) -> FetchedPage:
+        browser.where("Google")
+        raise ErrandFailed("the page answered 404")
+
+    history = History(None)
+    for errand, query in ((found, "pandas 2.0"), (not_found, "numpy 3")):
+        client, _spec, iid = _asked()
+        worker = Worker(_backend(client), _Browser([]), errands={"search": errand}, history=history)
+        worker.tick()
+        _hand(client, iid, query=query)
+        with caplog.at_level(logging.INFO, logger="ai_workspace_helper.worker"):
+            worker.tick()
+
+    rows = [(r["kind"], r["args"], r["site"], r["outcome"], r["reason"]) for r in history.recent()]
+    assert rows == [
+        ("search", "numpy 3", "Google", "failed", "the page answered 404"),
+        ("search", "pandas 2.0", "Google", "done", ""),
+    ]
+    # what it did comes first — the 記錄檔 tab is narrow; the job id is short, last
+    assert re.search(r"search 'pandas 2\.0' done \(job [0-9a-f]{8}\)$", caplog.text, re.M)
+
+
+# Review round 4: the history is best-effort. A file Excel or an antivirus
+# holds (Windows refuses the append) must not turn a job that was answered
+# into 「連不上 AI Workspace」.
+def test_a_history_that_cannot_be_written_changes_nothing():
+    from ai_workspace_helper.history import History
+
+    class _Locked(History):
+        def add(self, **_row) -> None:
+            raise PermissionError(13, "Permission denied", "history.jsonl")
+
+    client, spec, iid = _asked()
+    worker = Worker(_backend(client), _Browser([]), errands=_errands(), history=_Locked(None))
+    worker.tick()
+    _hand(client, iid, query="pandas 2.0")
+    worker.tick()
+
+    assert worker.status == "connected"
+    assert _answers(spec)  # the card was answered all the same
+
+
+# A job cut short by a lapsed login is not finished: it stays queued and runs
+# again, so the history does not call it 「沒查到」 now.
+def test_a_job_cut_short_by_the_login_leaves_no_row():
+    from ai_workspace_helper.backend import NeedsLogin
+    from ai_workspace_helper.history import History
+
+    def signed_out(browser, query: str) -> FetchedPage:
+        raise NeedsLogin()
+
+    client, _spec, iid = _asked()
+    history = History(None)
+    worker = Worker(_backend(client), _Browser([]), errands={"search": signed_out}, history=history)
+    worker.tick()
+    _hand(client, iid, query="pandas 2.0")
+    worker.tick()
+
+    assert worker.status == "needs_login"
+    assert history.recent() == []
diff --git a/tests/api/test_ai_workspace_helper_release.py b/tests/api/test_ai_workspace_helper_release.py
new file mode 100644
index 00000000..a4057a7f
--- /dev/null
+++ b/tests/api/test_ai_workspace_helper_release.py
@@ -0,0 +1,105 @@
+"""Publishing the helper (docs/plan-outside-helper.md §3.7.2): the
+operator drops `ai-workspace-helper.json` + the zip it names into
+`server.ai_workspace_helper_dir`; the backend serves exactly those, read on every
+request, so a new release needs no redeploy."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+
+from tests.api.test_outside_answers import _app
+
+
+def _publish(folder, version="0.3.0", **over):
+    zip_bytes = f"zip of {version}".encode()
+    (folder / f"ai-workspace-helper-{version}.zip").write_bytes(zip_bytes)
+    manifest = {
+        "version": version,
+        "min_version": "0.2.0",
+        "file": f"ai-workspace-helper-{version}.zip",
+        "sha256": hashlib.sha256(zip_bytes).hexdigest(),
+        **over,
+    }
+    (folder / "ai-workspace-helper.json").write_text(json.dumps(manifest))
+    return manifest, zip_bytes
+
+
+def test_a_published_release_is_described_and_downloadable(tmp_path):
+    manifest, zip_bytes = _publish(tmp_path)
+    client, _spec = _app(ai_workspace_helper_dir=str(tmp_path))
+
+    r = client.get("/ai-workspace-helper/manifest")
+
+    assert r.status_code == 200, r.text
+    assert r.json() == {**manifest, "size": len(zip_bytes)}
+    d = client.get(f"/ai-workspace-helper/download/{manifest['file']}")
+    assert d.status_code == 200
+    assert d.content == zip_bytes
+    assert manifest["file"] in d.headers["content-disposition"]
+
+
+# §3.7.2: "沒設或資料夾空 → 尚未發布".
+def test_with_nothing_published_there_is_no_release(tmp_path):
+    for client, _spec in (_app(), _app(ai_workspace_helper_dir=str(tmp_path))):
+        assert client.get("/ai-workspace-helper/manifest").status_code == 404
+        assert (
+            client.get("/ai-workspace-helper/download/ai-workspace-helper-0.3.0.zip").status_code
+            == 404
+        )
+
+
+# "只給版本資訊裡列的那個檔,不能拿來讀資料夾裡別的東西".
+def test_only_the_file_the_manifest_names_is_served(tmp_path):
+    _publish(tmp_path)
+    (tmp_path / "notes.txt").write_text("operator's notes")
+    (tmp_path / "ai-workspace-helper-0.2.0.zip").write_bytes(b"an old release")
+    client, _spec = _app(ai_workspace_helper_dir=str(tmp_path))
+
+    for name in (
+        "notes.txt",
+        "ai-workspace-helper-0.2.0.zip",
+        "ai-workspace-helper.json",
+        "..%2F..%2Fetc%2Fpasswd",
+    ):
+        assert client.get(f"/ai-workspace-helper/download/{name}").status_code == 404, name
+
+
+# A manifest that names a path (an operator's slip, or worse) publishes
+# nothing rather than opening the disk beyond the folder.
+def test_a_manifest_naming_a_path_publishes_nothing(tmp_path):
+    (tmp_path / "sub").mkdir()
+    (tmp_path / "sub" / "x.zip").write_bytes(b"x")
+    for bad in ("sub/x.zip", "../x.zip", "sub\\x.zip", ""):
+        _publish(tmp_path, file=bad)
+        client, _spec = _app(ai_workspace_helper_dir=str(tmp_path))
+        assert client.get("/ai-workspace-helper/manifest").status_code == 404, bad
+        assert client.get("/ai-workspace-helper/download/x.zip").status_code == 404, bad
+
+
+def test_a_new_release_is_served_without_a_restart(tmp_path):
+    _publish(tmp_path, "0.3.0")
+    client, _spec = _app(ai_workspace_helper_dir=str(tmp_path))
+    assert client.get("/ai-workspace-helper/manifest").json()["version"] == "0.3.0"
+
+    _publish(tmp_path, "0.4.0")
+
+    assert client.get("/ai-workspace-helper/manifest").json()["version"] == "0.4.0"
+    assert (
+        client.get("/ai-workspace-helper/download/ai-workspace-helper-0.4.0.zip").status_code == 200
+    )
+
+
+def test_a_manifest_that_names_a_missing_file_is_not_a_release(tmp_path):
+    manifest, _ = _publish(tmp_path)
+    (tmp_path / manifest["file"]).unlink()
+    client, _spec = _app(ai_workspace_helper_dir=str(tmp_path))
+
+    assert client.get("/ai-workspace-helper/manifest").status_code == 404
+
+
+def test_a_manifest_that_is_not_json_is_not_a_release(tmp_path):
+    (tmp_path / "ai-workspace-helper.json").write_text("{")
+    client, _spec = _app(ai_workspace_helper_dir=str(tmp_path))
+
+    assert client.get("/ai-workspace-helper/manifest").status_code == 404
diff --git a/tests/api/test_ai_workspace_helper_versions.py b/tests/api/test_ai_workspace_helper_versions.py
new file mode 100644
index 00000000..152b1ae1
--- /dev/null
+++ b/tests/api/test_ai_workspace_helper_versions.py
@@ -0,0 +1,142 @@
+"""The helper and the backend agree on a version (docs/plan-outside-helper.md
+§3.7.3): every helper request says its version and protocol; one the backend
+no longer accepts gets a 426 carrying where the current release is — an
+explicit "please update", not something the helper could mistake for the
+network being down."""
+
+from __future__ import annotations
+
+import pytest
+
+from tests.api.test_ai_workspace_helper_release import _publish
+from tests.api.test_outside_answers import _app
+from workspace_app.api.outside_jobs import MIN_PROTOCOL
+
+
+def _headers(version="0.3.0", protocol=MIN_PROTOCOL):
+    return {
+        "X-AI-Workspace-Helper-Version": version,
+        "X-AI-Workspace-Helper-Protocol": str(protocol),
+    }
+
+
+_HELPER_CALLS = [
+    ("post", "/ai-workspace-helper/heartbeat", {"version": "x"}),
+    ("post", "/ai-workspace-helper/jobs/claim", None),
+    ("post", "/ai-workspace-helper/jobs/j1/result", {"markdown": "x"}),
+    ("post", "/ai-workspace-helper/jobs/j1/fail", {"error": "x"}),
+    ("post", "/ai-workspace-helper/jobs/j1/note", {"note": "x"}),
+]
+
+
+@pytest.mark.parametrize(("method", "path", "body"), _HELPER_CALLS)
