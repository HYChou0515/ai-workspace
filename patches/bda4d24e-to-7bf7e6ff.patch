diff --git a/tests/api/test_outside_job_results.py b/tests/api/test_outside_job_results.py
new file mode 100644
index 00000000..e1a3fe9e
--- /dev/null
+++ b/tests/api/test_outside_job_results.py
@@ -0,0 +1,217 @@
+"""The helper's result goes to the AI (docs/plan-outside-helper.md §3.2, P3).
+
+What the helper fetched is saved and sent exactly as a person's paste is — the
+same code (`outside_lookup_routes`) writes `lookups/` and sends the message that
+answers the card — so the AI reads one shape whichever way the page arrived.
+And the links in anything a lookup brought back are remembered for the chat, so
+a later open-URL card for one of them needs no nod (D12).
+"""
+
+from __future__ import annotations
+
+from tests.api.test_outside_answers import _answer, _answers, _read
+from tests.api.test_outside_jobs import _beat, _claim, _hand, _state
+
+PAGE = "# Results\n\n- [pandas 2.0 whatsnew](https://pandas.example/whatsnew#top)\n- plain text"
+
+
+def _result(client, jid, **body):
+    data = {
+        "title": "Google 搜尋",
+        "url": "https://www.google.com/search?q=pandas",
+        "markdown": PAGE,
+        "date": "2026-10-12",
+        **body,
+    }
+    return client.post(f"/ai-workspace-helper/jobs/{jid}/result", json=data)
+
+
+def _taken(client, iid):
+    _beat(client)
+    assert _hand(client, iid).status_code == 201
+    return _claim(client).json()["id"]
+
+
+def test_what_the_helper_fetched_is_saved_and_answers_the_card():
+    from tests.api.test_outside_answers import _asked
+
+    client, spec, iid = _asked()
+    jid = _taken(client, iid)
+
+    r = _result(client, jid)
+
+    assert r.status_code == 200, r.text
+    path = r.json()["path"]
+    assert path.startswith("lookups/2026-10-12-") and path.endswith(".md")
+    saved = _read(client, iid, path)
+    assert "由小幫手抓取" in saved  # who fetched it
+    assert "https://www.google.com/search?q=pandas" in saved  # where from
+    assert "[pandas 2.0 whatsnew](https://pandas.example/whatsnew#top)" in saved
+    [answer] = _answers(spec)
+    assert answer.content.startswith("我在外面查了:pandas 2.0 新功能")
+    assert path in answer.content
+    assert _state(client, iid)["state"] == "done"
+
+
+# The same shape as a hand-pasted answer: the same function writes both.
+def test_a_helper_answer_reads_like_a_pasted_one():
+    from tests.api.test_outside_answers import _asked
+
+    by_hand, hand_spec, hand_iid = _asked()
+    assert _answer(by_hand, hand_iid, content=PAGE, date="2026-10-12").status_code == 200
+    by_helper, helper_spec, helper_iid = _asked()
+    _result(by_helper, _taken(by_helper, helper_iid))
+
+    [pasted] = _answers(hand_spec)
+    [fetched] = _answers(helper_spec)
+    assert pasted.content == fetched.content
+
+
+# The message says what was actually searched — the query as the person
+# edited it before 「查」 — as a hand-pasted answer does (D8).
+def test_the_answer_names_the_query_the_person_edited():
+    from tests.api.test_outside_answers import _asked
+
+    client, spec, iid = _asked()
+    _beat(client)
+    _hand(client, iid, query="pandas 3 roadmap")
+    jid = _claim(client).json()["id"]
+
+    _result(client, jid)
+
+    [answer] = _answers(spec)
+    assert answer.content.startswith("我在外面查了:pandas 3 roadmap")
+
+
+def test_a_helper_cannot_answer_with_a_job_that_is_not_its_own():
+    from tests.api.test_outside_answers import _asked
+
+    holder = {"id": "u"}
+    client, spec, iid = _asked(holder=holder)
+    jid = _taken(client, iid)
+
+    holder["id"] = "someone-else"
+    assert _result(client, jid).status_code == 404
+    holder["id"] = "u"
+    assert _answers(spec) == []
+    assert _state(client, iid)["state"] == "claimed"
+
+
+def test_a_job_not_taken_cannot_be_answered():
+    from tests.api.test_outside_answers import _asked
+
+    client, spec, iid = _asked()
+    _beat(client)
+    jid = _hand(client, iid).json()["id"]
+
+    assert _result(client, jid).status_code == 404
+    assert _answers(spec) == []
+
+
+# §3.5: done, the card says where the page was saved.
+def test_a_done_job_names_where_it_was_saved():
+    from tests.api.test_outside_answers import _asked
+
+    client, _spec, iid = _asked()
+    jid = _taken(client, iid)
+
+    saved = _result(client, jid).json()["path"]
+
+    job = _state(client, iid)
+    assert job["state"] == "done"
+    assert job["saved"] == saved and saved.startswith("lookups/")
+    assert job["auto"] is False
+
+
+# Someone answered the card by hand while the helper was fetching: theirs
+# stands, the helper's is refused, and the job does not hang.
+def test_a_card_answered_meanwhile_refuses_the_helpers_result():
+    from tests.api.test_outside_answers import _asked
+
+    client, spec, iid = _asked()
+    jid = _taken(client, iid)
+    assert _answer(client, iid, kind="not_found").status_code == 200
+
+    r = _result(client, jid)
+
+    assert r.status_code == 409
+    assert len(_answers(spec)) == 1
+    assert _state(client, iid)["state"] == "cancelled"
+
+
+# A page that can never be sent (an empty page, a PDF viewer; a chat deleted;
+# the right to send revoked) must end the job, with why — left claimed it went
+# back to the queue every two minutes, to be fetched and refused forever
+# (review round 1).
+def test_a_result_that_cannot_be_sent_ends_the_job_with_why():
+    from tests.api.test_outside_answers import _asked
+    from workspace_app.api.outside_jobs import CLAIM_TIMEOUT_MS
+
+    client, spec, iid = _asked()
+    store = client.app.state.outside_jobs
+    t = [1_000_000]
+    store.now = lambda: t[0]
+    jid = _taken(client, iid)
+
+    r = _result(client, jid, markdown="   ")
+
+    assert r.status_code == 422
+    state = _state(client, iid)
+    assert state["state"] == "failed" and "nothing to send" in state["error"]
+    t[0] += CLAIM_TIMEOUT_MS + 1
+    _beat(client)
+    assert _claim(client).status_code == 204
+    assert _answers(spec) == []
+
+
+# A refusal that may pass (the server briefly unable — a 5xx) leaves the job
+# claimed, to be taken and tried again; only a page that can never be sent
+# ends it (review round 2).
+def test_a_result_refused_for_now_is_tried_again():
+    from tests.api.test_outside_answers import _asked
+    from workspace_app.api.request_env import IRequestEnv
+
+    down = [False]
+
+    class _Source(IRequestEnv):
+        async def env_for(self, request, *, user_id, item_id):
+            if down[0]:
+                raise RuntimeError("the env source is briefly down")
+            return {}
+
+    client, _spec, iid = _asked(request_env=_Source())
+    jid = _taken(client, iid)
+    down[0] = True
+
+    r = _result(client, jid)
+
+    assert r.status_code == 500
+    assert _state(client, iid)["state"] == "claimed"
+
+
+# A refusal's reason reaches the card as words, not a dict's repr.
+def test_a_refusals_reason_is_said_in_words():
+    from tests.api.test_outside_answers import _asked
+
+    client, _spec, iid = _asked()
+    jid = _taken(client, iid)
+
+    _result(client, jid, markdown="  ")
+
+    assert _state(client, iid)["error"] == "nothing to send — paste or attach"
+
+
+# A result too large for the workspace's file limit is refused like a paste.
+def test_a_result_larger_than_a_file_may_be_is_refused():
+    from tests.api.conftest import register_rca_item
+    from tests.api.test_outside_answers import _app
+
+    client, spec = _app(max_file_size=1000)
+    iid = register_rca_item(spec)
+    assert client.post(f"/a/rca/items/{iid}/messages", json={"content": "q"}).status_code == 202
+    jid = _taken(client, iid)
+
+    r = _result(client, jid, markdown="x" * 1001)
+
+    assert r.status_code == 413
+    assert _state(client, iid)["state"] == "failed"
diff --git a/tests/api/test_outside_jobs.py b/tests/api/test_outside_jobs.py
new file mode 100644
index 00000000..db280af1
--- /dev/null
+++ b/tests/api/test_outside_jobs.py
@@ -0,0 +1,421 @@
+"""The helper's jobs (docs/plan-outside-helper.md §3.2, P2).
+
+The card hands a lookup to the person's own helper — a Python program on their
+PC that drives Chrome — instead of the person fetching it by hand. The job lives
+in the shared backend, so any pod can take the card's request and any pod can
+answer the helper's poll.
+"""
+
+from __future__ import annotations
+
+from tests.api.test_outside_answers import _asked
+
+
+def _beat(client) -> None:
+    r = client.post("/ai-workspace-helper/heartbeat", json={"version": "0.1.0", "protocol": 1})
+    assert r.status_code == 204, r.text
+
+
+def _hand(client, iid, call="c1", **body):
+    return client.post(f"/a/rca/items/{iid}/outside-jobs", json={"tool_call_id": call, **body})
+
+
+def _claim(client):
+    return client.post("/ai-workspace-helper/jobs/claim")
+
+
+def test_the_card_hands_a_search_to_the_persons_helper():
+    client, _spec, iid = _asked()
+    _beat(client)
+
+    r = _hand(client, iid, query="pandas 2.0 新功能 改過")
+
+    assert r.status_code == 201, r.text
+    job = _claim(client).json()
+    assert job["kind"] == "search"
+    # what the person edited on the card, not the AI's original (D4)
+    assert job["args"] == "pandas 2.0 新功能 改過"
+    assert job["id"] == r.json()["id"]
+
+
+# D7: with no helper connected the card stays on the manual flow — a 「查」 nobody
+# will act on is refused rather than queued.
+def test_with_no_helper_connected_nothing_is_queued():
+    client, _spec, iid = _asked()
+
+    r = _hand(client, iid)
+
+    assert r.status_code == 409, r.text
+    _beat(client)
+    assert _claim(client).status_code == 204
+
+
+def test_a_helper_checked_in_too_long_ago_is_offline():
+    client, _spec, iid = _asked()
+    store = client.app.state.outside_jobs
+    t = [1_000_000]
+    store.now = lambda: t[0]
+    _beat(client)
+    t[0] += 31_000
+
+    assert _hand(client, iid).status_code == 409
+    assert client.get("/ai-workspace-helper/status").json() == {"online": False}
+
+
+# A job belongs to the person who pressed 「查」; only their own helper takes it.
+def test_only_the_persons_own_helper_takes_their_job():
+    holder = {"id": "u"}
+    client, _spec, iid = _asked(holder=holder)
+    _beat(client)
+    assert _hand(client, iid).status_code == 201
+
+    holder["id"] = "someone-else"
+    _beat(client)
+    assert _claim(client).status_code == 204
+
+    holder["id"] = "u"
+    assert _claim(client).status_code == 200
+
+
+def test_a_job_is_taken_once():
+    client, _spec, iid = _asked()
+    _beat(client)
+    _hand(client, iid)
+
+    assert _claim(client).status_code == 200
+    assert _claim(client).status_code == 204
+
+
+def test_an_answered_card_hands_nothing_over():
+    from tests.api.test_outside_answers import _answer
+
+    client, _spec, iid = _asked()
+    _beat(client)
+    assert _answer(client, iid, kind="not_found").status_code == 200
+
+    assert _hand(client, iid).status_code == 409
+
+
+def test_a_card_that_does_not_exist_hands_nothing_over():
+    client, _spec, iid = _asked()
+    _beat(client)
+
+    assert _hand(client, iid, call="nope").status_code == 404
+
+
+def _state(client, iid, call="c1"):
+    r = client.get(f"/a/rca/items/{iid}/outside-jobs/{call}")
+    assert r.status_code == 200, r.text
+    return r.json()
+
+
+def test_the_card_reads_how_its_job_is_going():
+    client, _spec, iid = _asked()
+    _beat(client)
+    _hand(client, iid)
+    assert _state(client, iid)["state"] == "queued"
+
+    _claim(client)
+
+    assert _state(client, iid)["state"] == "claimed"
+
+
+def test_a_card_with_no_job_reads_as_none():
+    client, _spec, iid = _asked()
+
+    r = client.get(f"/a/rca/items/{iid}/outside-jobs/c1")
+
+    assert r.status_code == 404
+
+
+# The helper was closed or crashed after taking the job: it goes back to the
+# queue rather than hanging the card forever.
+def test_a_job_taken_and_never_finished_goes_back_to_the_queue():
+    from workspace_app.api.outside_jobs import CLAIM_TIMEOUT_MS
+
+    client, _spec, iid = _asked()
+    store = client.app.state.outside_jobs
+    t = [1_000_000]
+    store.now = lambda: t[0]
+    _beat(client)
+    _hand(client, iid)
+    assert _claim(client).status_code == 200
+
+    t[0] += CLAIM_TIMEOUT_MS + 1
+    _beat(client)
+
+    assert _claim(client).status_code == 200
+
+
+# The helper died mid-job (laptop closed): its claim lapses, and the card must
+# read the job as waiting again — read as "claimed" it showed the helper at
+# work forever, with no way back to the manual flow (review round 2).
+def test_the_card_reads_a_lapsed_claim_as_waiting():
+    from workspace_app.api.outside_jobs import CLAIM_TIMEOUT_MS
+
+    client, _spec, iid = _asked()
+    store = client.app.state.outside_jobs
+    t = [1_000_000]
+    store.now = lambda: t[0]
+    _beat(client)
+    _hand(client, iid)
+    _claim(client)
+    assert _state(client, iid)["state"] == "claimed"
+
+    t[0] += CLAIM_TIMEOUT_MS + 1
+
+    assert _state(client, iid)["state"] == "queued"
+
+
+# A job its helper keeps taking and never finishes (the workspace full, a
+# refusal that persists, a helper crashing on that page) ends, with why,
+# after MAX_CLAIMS takes — never fetched again every two minutes (round 3).
+def test_a_job_taken_too_often_ends_with_why():
+    from workspace_app.api.outside_jobs import CLAIM_TIMEOUT_MS, MAX_CLAIMS
+
+    client, _spec, iid = _asked()
+    store = client.app.state.outside_jobs
+    t = [1_000_000]
+    store.now = lambda: t[0]
+    _beat(client)
+    _hand(client, iid)
+    for _ in range(MAX_CLAIMS):
+        assert _claim(client).status_code == 200
+        t[0] += CLAIM_TIMEOUT_MS + 1
+        _beat(client)
+
+    assert _claim(client).status_code == 204
+    job = _state(client, iid)
+    assert job["state"] == "failed" and str(MAX_CLAIMS) in job["error"]
+
+
+# On a shared item someone else's job — their helper gone — is not handed
+# back to this person's 「查」: theirs would spin forever (round 3).
+def test_a_lookup_is_not_handed_back_someone_elses_job():
+    holder = {"id": "bob"}
+    client, _spec, iid = _asked(holder=holder)
+    _beat(client)
+    bobs = _hand(client, iid).json()
+    _claim(client)
+
+    holder["id"] = "alice"
+    _beat(client)
+    mine = _hand(client, iid)
+
+    assert mine.status_code == 201 and mine.json()["id"] == bobs["id"]
+    assert _claim(client).status_code == 200  # alice's helper takes it now
+
+
+def test_a_job_taken_recently_is_not_taken_again():
+    from workspace_app.api.outside_jobs import CLAIM_TIMEOUT_MS
+
+    client, _spec, iid = _asked()
+    store = client.app.state.outside_jobs
+    t = [1_000_000]
+    store.now = lambda: t[0]
+    _beat(client)
+    _hand(client, iid)
+    _claim(client)
+
+    t[0] += CLAIM_TIMEOUT_MS - 1
+
+    assert _claim(client).status_code == 204
+
+
+# The helper could not do it (page not found, timed out, blocked): the card
+# says why, and the person can retry or fall back to the manual flow.
+def test_a_failure_reaches_the_card_with_its_reason():
+    client, _spec, iid = _asked()
+    _beat(client)
+    _hand(client, iid)
+    jid = _claim(client).json()["id"]
+
+    r = client.post(f"/ai-workspace-helper/jobs/{jid}/fail", json={"error": "page timed out"})
+
+    assert r.status_code == 204, r.text
+    assert _state(client, iid) | {"id": None} == {
+        "id": None,
+        "kind": "search",
+        "args": "pandas 2.0 新功能",
+        "state": "failed",
+        "error": "page timed out",
+        "note": "",
+        "auto": False,
+        "saved": "",
+    }
+
+
+def test_a_helper_cannot_fail_someone_elses_job():
+    holder = {"id": "u"}
+    client, _spec, iid = _asked(holder=holder)
+    _beat(client)
+    _hand(client, iid)
+    jid = _claim(client).json()["id"]
+
+    holder["id"] = "someone-else"
+    r = client.post(f"/ai-workspace-helper/jobs/{jid}/fail", json={"error": "x"})
+
+    assert r.status_code == 404
+    holder["id"] = "u"
+    assert _state(client, iid)["state"] == "claimed"
+
+
+def test_cancelling_takes_the_job_from_the_queue():
+    client, _spec, iid = _asked()
+    _beat(client)
+    _hand(client, iid)
+
+    r = client.delete(f"/a/rca/items/{iid}/outside-jobs/c1")
+
+    assert r.status_code == 204, r.text
+    assert _state(client, iid)["state"] == "cancelled"
+    assert _claim(client).status_code == 204
+
+
+# A job that has ended stays as it ended: a cancel after a failure does not
+# rewrite the reason the card is showing.
+def test_a_job_that_has_ended_cannot_be_cancelled():
+    client, _spec, iid = _asked()
+    _beat(client)
+    _hand(client, iid)
+    jid = _claim(client).json()["id"]
+    client.post(f"/ai-workspace-helper/jobs/{jid}/fail", json={"error": "page timed out"})
+
+    r = client.delete(f"/a/rca/items/{iid}/outside-jobs/c1")
+
+    assert r.status_code == 404
+    assert _state(client, iid)["error"] == "page timed out"
+
+
+# Handing the same card over again (「重查」 after a failure) replaces the job.
+def test_handing_a_card_over_again_replaces_its_job():
+    client, _spec, iid = _asked()
+    _beat(client)
+    _hand(client, iid)
+    jid = _claim(client).json()["id"]
+    client.post(f"/ai-workspace-helper/jobs/{jid}/fail", json={"error": "x"})
+
+    _hand(client, iid, query="again")
+
+    job = _claim(client).json()
+    assert (job["id"], job["args"], job["state"]) == (jid, "again", "claimed")
+
+
+# The card's routes ask what answering the card by hand asks: someone who may
+# not see the item learns nothing and changes nothing.
+def test_someone_who_may_only_read_sees_the_job_but_cannot_hand_over_or_cancel():
+    from tests.api.test_outside_answers import _as_carol
+
+    client, _spec, iid = _as_carol()  # carol may read the item and its chat
+    _beat(client)
+
+    assert _hand(client, iid).status_code == 403
+    assert client.delete(f"/a/rca/items/{iid}/outside-jobs/c1").status_code == 403
+    assert client.get(f"/a/rca/items/{iid}/outside-jobs/c1").status_code == 404  # no job yet
+
+
+def test_someone_with_no_access_to_the_item_learns_nothing_of_its_job():
+    from tests.api.test_outside_answers import _app, _restricted_item
+
+    holder = {"id": "bob"}
+    client, spec = _app(holder)
+    iid = _restricted_item(spec)  # bob's; nobody else may see it
+    assert client.post(f"/a/rca/items/{iid}/messages", json={"content": "q"}).status_code == 202
+    _beat(client)
+    assert _hand(client, iid).status_code == 201
+
+    holder["id"] = "intruder"
+    _beat(client)
+
+    assert _hand(client, iid).status_code == 404
+    assert client.get(f"/a/rca/items/{iid}/outside-jobs/c1").status_code == 404
+    assert client.delete(f"/a/rca/items/{iid}/outside-jobs/c1").status_code == 404
+    holder["id"] = "bob"
+    assert _state(client, iid)["state"] == "queued"
+
+
+# §3.4: a captcha stops the helper until the person solves it in the helper's
+# Chrome window — the card says so, or the person is left watching 「正在查…」.
+def test_the_helper_tells_the_card_it_is_waiting_on_the_person():
+    client, _spec, iid = _asked()
+    _beat(client)
+    _hand(client, iid)
+    jid = _claim(client).json()["id"]
+
+    r = client.post(f"/ai-workspace-helper/jobs/{jid}/note", json={"note": "captcha"})
+
+    assert r.status_code == 204, r.text
+    assert _state(client, iid)["note"] == "captcha"
+
+
+# A person solving a captcha can take longer than a claim lasts; the job they
+# are working on must not go back to the queue (and be fetched twice) meanwhile.
+def test_a_job_waiting_on_the_person_is_not_taken_again():
+    from workspace_app.api.outside_jobs import CLAIM_TIMEOUT_MS
+
+    client, _spec, iid = _asked()
+    store = client.app.state.outside_jobs
+    t = [1_000_000]
+    store.now = lambda: t[0]
+    _beat(client)
+    _hand(client, iid)
+    jid = _claim(client).json()["id"]
+
+    t[0] += CLAIM_TIMEOUT_MS - 1
+    client.post(f"/ai-workspace-helper/jobs/{jid}/note", json={"note": "captcha"})
+    t[0] += CLAIM_TIMEOUT_MS - 1
+    _beat(client)
+
+    assert _claim(client).status_code == 204
+
+
+# A card reloaded mid-errand used to offer 「查」 again, and pressing it reset
+# the helper's running job to `queued` — fetched twice, the first result then
+# refused. A job under way is returned as it is (review round 1).
+def test_handing_over_a_job_under_way_does_not_restart_it():
+    client, _spec, iid = _asked()
+    _beat(client)
+    first = _hand(client, iid).json()
+    _claim(client)
+
+    again = _hand(client, iid)
+
+    assert again.status_code == 201
+    assert again.json()["id"] == first["id"]
+    assert _state(client, iid)["state"] == "claimed"
+    assert _claim(client).status_code == 204
+
+
+# A helper waiting on the person is busy, not gone: what it says while it waits
+# counts as checking in, so it still reads as connected (review round 1).
+def test_a_helper_waiting_on_the_person_still_reads_as_connected():
+    client, _spec, iid = _asked()
+    store = client.app.state.outside_jobs
+    t = [1_000_000]
+    store.now = lambda: t[0]
+    _beat(client)
+    _hand(client, iid)
+    jid = _claim(client).json()["id"]
+
+    t[0] += 25_000
+    client.post(f"/ai-workspace-helper/jobs/{jid}/note", json={"note": "captcha"})
+    t[0] += 25_000
+
+    assert client.get("/ai-workspace-helper/status").json() == {"online": True}
+    # and what it last reported on its check-in is kept
+    assert store.presence("u").version == "0.1.0"
+
+
+def test_a_helper_cannot_note_someone_elses_job():
+    holder = {"id": "u"}
+    client, _spec, iid = _asked(holder=holder)
+    _beat(client)
+    _hand(client, iid)
+    jid = _claim(client).json()["id"]
+
+    holder["id"] = "someone-else"
+    r = client.post(f"/ai-workspace-helper/jobs/{jid}/note", json={"note": "captcha"})
+
+    assert r.status_code == 404
+    holder["id"] = "u"
+    assert _state(client, iid)["note"] == ""
diff --git a/tests/api/test_outside_seen_urls.py b/tests/api/test_outside_seen_urls.py
new file mode 100644
index 00000000..068ad92a
--- /dev/null
+++ b/tests/api/test_outside_seen_urls.py
@@ -0,0 +1,243 @@
+"""A URL an earlier lookup brought back opens with no nod (docs/plan-outside-helper.md D12).
+
+Links in anything a lookup in this chat returned — fetched by the helper or
+pasted by a person — are outside content, so opening one sends nothing the
+person has not already seen come in. A URL the AI wrote itself could carry
+internal words, so that one waits for 「查」. The server holds that line: the
+card's automatic hand-over (`auto`) is refused for any other URL.
+"""
+
+from __future__ import annotations
+
+import json
+
+from tests.api._client import TestClient
+from tests.api.conftest import register_rca_item
+from tests.api.test_outside_answers import _answer
+from tests.api.test_outside_jobs import _beat, _claim
+from workspace_app.agent.outside_lookup import OUTSIDE_LOOKUP_MARKER
+from workspace_app.api import MessageDelta, RunDone, ToolEnd, ToolStart, create_app
+from workspace_app.filestore.memory import MemoryFileStore
+from workspace_app.resources import make_spec
+from workspace_app.sandbox.mock import MockSandbox
+
+
+class _Turns:
+    """A different script each turn."""
+
+    def __init__(self, *turns):
+        self._turns = list(turns)
+
+    async def run(self, prompt, ctx):  # noqa: ANN001, ANN201
+        for ev in self._turns.pop(0):
+            yield ev
+
+
+def _card(call: str, **card) -> list:
+    out = f"Asked.{OUTSIDE_LOOKUP_MARKER}{json.dumps({'why': 'need it', **card})}"
+    return [
+        ToolStart(call_id=call, name="ask_outside", args={"why": "need it", **card}),
+        ToolEnd(call_id=call, output=out),
+        MessageDelta(text="ok"),
+        RunDone(),
+    ]
+
+
+def _chat(url: str = "", **second):
+    """Turn 1 asks to search (`c1`); turn 2 asks to open `url` (`c2`) — or, given
+    `second`, draws that card instead."""
+    spec = make_spec(default_user="u")
+    runner = _Turns(_card("c1", query="pandas"), _card("c2", **(second or {"url": url})))
+    client = TestClient(
+        create_app(
+            spec=spec,
+            sandbox=MockSandbox(),
+            filestore=MemoryFileStore(),
+            runner=runner,
+            get_user_id=lambda: "u",
+        )
+    )
+    iid = register_rca_item(spec)
+    assert client.post(f"/a/rca/items/{iid}/messages", json={"content": "q1"}).status_code == 202
+    return client, iid
+
+
+def _second_turn(client, iid):
+    assert client.post(f"/a/rca/items/{iid}/messages", json={"content": "q2"}).status_code == 202
+
+
+def _auto(client, iid, call="c2"):
+    return client.post(
+        f"/a/rca/items/{iid}/outside-jobs", json={"tool_call_id": call, "auto": True}
+    )
+
+
+PAGE = "results\n- [whatsnew](https://pandas.example/whatsnew#top)\n- <https://b.example/x>"
+
+
+def test_a_link_a_pasted_answer_brought_back_opens_without_a_nod():
+    client, iid = _chat("https://pandas.example/whatsnew")
+    _beat(client)
+    assert _answer(client, iid, content=PAGE).status_code == 200
+    _second_turn(client, iid)
+
+    r = _auto(client, iid)
+
+    assert r.status_code == 201, r.text
+    job = _claim(client).json()
+    assert (job["kind"], job["args"]) == ("open_url", "https://pandas.example/whatsnew")
+
+
+def test_a_link_the_helper_brought_back_opens_without_a_nod():
+    client, iid = _chat("https://b.example/x")
+    _beat(client)
+    client.post(f"/a/rca/items/{iid}/outside-jobs", json={"tool_call_id": "c1"})
+    jid = _claim(client).json()["id"]
+    r = client.post(f"/ai-workspace-helper/jobs/{jid}/result", json={"markdown": PAGE})
+    assert r.status_code == 200, r.text
+    _second_turn(client, iid)
+
+    assert _auto(client, iid).status_code == 201
+
+
+def test_a_url_no_lookup_brought_back_waits_for_the_nod():
+    client, iid = _chat("https://internal-words.example/?q=secret")
+    _beat(client)
+    assert _answer(client, iid, content=PAGE).status_code == 200
+    _second_turn(client, iid)
+
+    r = _auto(client, iid)
+
+    assert r.status_code == 409, r.text
+    assert _claim(client).status_code == 204
+    # …and the person's 「查」 is the nod
+    r = client.post(f"/a/rca/items/{iid}/outside-jobs", json={"tool_call_id": "c2"})
+    assert r.status_code == 201
+
+
+def test_a_search_card_never_goes_without_the_nod():
+    client, iid = _chat("https://pandas.example/whatsnew")
+    _beat(client)
+
+    assert _auto(client, iid, call="c1").status_code == 409
+
+
+# …even when what it would search for is, character for character, a link a
+# lookup brought back: a search sends the AI's words out, and those wait.
+def test_a_search_for_a_seen_link_still_waits_for_the_nod():
+    client, iid = _chat(query="https://pandas.example/whatsnew")
+    _beat(client)
+    assert _answer(client, iid, content=PAGE).status_code == 200
+    _second_turn(client, iid)
+
+    assert _auto(client, iid).status_code == 409
+
+
+# Opened automatically once; a second automatic request (another tab drawing
+# the same card) must not start it over.
+def test_an_automatic_request_leaves_a_job_already_running_alone():
+    client, iid = _chat("https://pandas.example/whatsnew")
+    _beat(client)
+    _answer(client, iid, content=PAGE)
+    _second_turn(client, iid)
+    assert _auto(client, iid).status_code == 201
+    assert _claim(client).status_code == 200
+
+    r = _auto(client, iid)
+
+    assert r.status_code == 201
+    assert r.json()["state"] == "claimed"
+    assert _claim(client).status_code == 204
+
+
+# D12's no-nod open belongs to the person whose answer led to it (plan §3.2:
+# "為送出這一輪的人"), not to whoever else in a shared item has the chat open —
+# their helper would fetch it as them (review round 1).
+def test_a_link_opens_by_itself_only_for_the_person_who_asked():
+    spec = make_spec(default_user="u")
+    holder = {"id": "u"}
+    runner = _Turns(_card("c1", query="pandas"), _card("c2", url="https://pandas.example/whatsnew"))
+    client = TestClient(
+        create_app(
+            spec=spec,
+            sandbox=MockSandbox(),
+            filestore=MemoryFileStore(),
+            runner=runner,
+            get_user_id=lambda: holder["id"],
+        )
+    )
+    iid = register_rca_item(spec)  # public: anyone may converse
+    assert client.post(f"/a/rca/items/{iid}/messages", json={"content": "q1"}).status_code == 202
+    assert _answer(client, iid, call="c1", content=PAGE).status_code == 200
+
+    holder["id"] = "colleague"
+    _beat(client)
+    assert _auto(client, iid).status_code == 409
+
+    holder["id"] = "u"
+    _beat(client)
+    assert _auto(client, iid).status_code == 201
+
+
+# The person stopped a page that opened by itself: reloading the chat (the card
+# asks again on every mount) must not start it again — the card offers 「查」
+# instead (review round 2).
+def test_a_stopped_automatic_open_is_not_started_again():
+    client, iid = _chat("https://pandas.example/whatsnew")
+    _beat(client)
+    _answer(client, iid, content=PAGE)
+    _second_turn(client, iid)
+    assert _auto(client, iid).status_code == 201
+    assert client.delete(f"/a/rca/items/{iid}/outside-jobs/c2").status_code == 204
+
+    r = _auto(client, iid)
+
+    assert r.json()["state"] == "cancelled"
+    assert _claim(client).status_code == 204
+
+
+class _Watching(_Turns):
+    """Records, as each turn STARTS, whether `url` is already a seen link."""
+
+    def __init__(self, spec, url, *turns):
+        super().__init__(*turns)
+        self._spec, self._url = spec, url
+        self.seen_at_start: list[bool] = []
+
+    async def run(self, prompt, ctx):  # noqa: ANN001, ANN201
+        from workspace_app.api.outside_jobs import _OutsideSeenUrls
+
+        rm = self._spec.get_resource_manager(_OutsideSeenUrls)
+        rows = [rm.get(m.resource_id).data for m in rm.search_resources(query=None)]
+        self.seen_at_start.append(any(self._url in row.urls for row in rows))
+        async for ev in super().run(prompt, ctx):
+            yield ev
+
+
+# The answer's message starts the AI's next turn, and that turn may at once ask
+# to open a link the answer brought back — the card then asks the server whether
+# the link was seen. Remembered only after the message went out, the card could
+# lose that race and ask for a nod D12 says it need not (found live in P10).
+def test_a_link_is_already_seen_when_the_next_turn_starts():
+    spec = make_spec(default_user="u")
+    runner = _Watching(
+        spec,
+        "https://pandas.example/whatsnew",
+        _card("c1", query="pandas"),
+        _card("c2", url="https://pandas.example/whatsnew"),
+    )
+    client = TestClient(
+        create_app(
+            spec=spec,
+            sandbox=MockSandbox(),
+            filestore=MemoryFileStore(),
+            runner=runner,
+            get_user_id=lambda: "u",
+        )
+    )
+    iid = register_rca_item(spec)
+    assert client.post(f"/a/rca/items/{iid}/messages", json={"content": "q1"}).status_code == 202
+
+    assert _answer(client, iid, call="c1", content=PAGE).status_code == 200
+
+    assert runner.seen_at_start == [False, True]
