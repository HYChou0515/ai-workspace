+"""Talking to the AI Workspace backend (docs/plan-outside-helper.md §3.2, §3.7.3).
+
+The transport is injected (`Send`): on the PC it is Playwright's request
+context, which shares the cookie jar of the helper's own Chrome profile — the
+person signed in there, through the deploy's normal login (D6) — and in tests it
+is the app itself. Every request says which helper version and protocol it is.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+from dataclasses import dataclass
+from typing import Any
+
+from .version import PROTOCOL, __version__
+
+#: (method, path, json body or None, headers) -> (status, decoded json or None).
+#: Raises OSError when the backend cannot be reached at all. Must NOT follow
+#: redirects: a redirect is the gateway sending an expired login to sign in.
+Send = Callable[[str, str, "dict[str, Any] | None", dict[str, str]], tuple[int, Any]]
+
+
+class NeedsLogin(Exception):
+    """The deploy's login is missing or expired: the person signs in again."""
+
+
+class UpdateRequired(Exception):
+    """The backend no longer accepts this version (426); `manifest` says where
+    the current one is."""
+
+    def __init__(self, manifest: Any) -> None:
+        super().__init__("this helper version is no longer accepted")
+        self.manifest = manifest
+
+
+class BackendError(Exception):
+    """Any other refusal, with the backend's reason."""
+
+
+@dataclass(frozen=True)
+class Job:
+    id: str
+    kind: str
+    args: str
+
+
+#: (path, headers) -> (status, body bytes): a GET whose answer is a file.
+FetchBytes = Callable[[str, dict[str, str]], tuple[int, bytes]]
+
+
+def _headers() -> dict[str, str]:
+    return {
+        "X-AI-Workspace-Helper-Version": __version__,
+        "X-AI-Workspace-Helper-Protocol": str(PROTOCOL),
+    }
+
+
+def _refusal(status: int, data: Any) -> None:
+    # A gateway in front of the app sends an expired login to the SSO page
+    # (3xx) rather than answering 401; the transport never follows it.
+    # 403 is "not allowed" — signing in again would change nothing.
+    if status == 401 or 300 <= status < 400:
+        raise NeedsLogin()
+    detail = data.get("detail") if isinstance(data, dict) else None
+    if status == 426:
+        # §3.7.3: the body names the current release to update to
+        raise UpdateRequired(detail.get("release") if isinstance(detail, dict) else None)
+    if status >= 400:
+        raise BackendError(str(detail or f"HTTP {status}"))
+
+
+class Backend:
+    def __init__(self, send: Send, *, fetch_bytes: FetchBytes | None = None) -> None:
+        self._send = send
+        self._fetch_bytes = fetch_bytes
+
+    def _call(self, method: str, path: str, body: dict[str, Any] | None = None) -> Any:
+        status, data = self._send(method, f"/api{path}", body, _headers())
+        _refusal(status, data)
+        return data if status != 204 else None
+
+    def manifest(self) -> dict[str, Any] | None:
+        """The release the operator published (§3.7.2), or None."""
+        try:
+            return self._call("GET", "/ai-workspace-helper/manifest")
+        except BackendError:
+            return None
+
+    def download(self, file: str) -> bytes:
+        """The release's zip — through the same signed-in line as the jobs, so
+        it never carries a browser's "downloaded from the internet" mark."""
+        if self._fetch_bytes is None:
+            raise BackendError("this transport cannot fetch files")
+        status, data = self._fetch_bytes(f"/api/ai-workspace-helper/download/{file}", _headers())
+        _refusal(status, None)
+        return data
+
+    def heartbeat(self, **info: Any) -> None:
+        self._call(
+            "POST",
+            "/ai-workspace-helper/heartbeat",
+            {"version": __version__, "protocol": PROTOCOL, **info},
+        )
+
+    def claim(self) -> Job | None:
+        data = self._call("POST", "/ai-workspace-helper/jobs/claim")
+        if not data:
+            return None
+        return Job(id=data["id"], kind=data["kind"], args=data["args"])
+
+    def result(self, job_id: str, *, title: str, url: str, markdown: str, date: str) -> None:
+        self._call(
+            "POST",
+            f"/ai-workspace-helper/jobs/{job_id}/result",
+            {"title": title, "url": url, "markdown": markdown, "date": date},
+        )
+
+    def fail(self, job_id: str, error: str) -> None:
+        self._call("POST", f"/ai-workspace-helper/jobs/{job_id}/fail", {"error": error})
+
+    def lookup_targets(self) -> list[dict[str, str]]:
+        """The card's search destinations (`server.lookup_targets`)."""
+        data = self._call("GET", "/lookup-targets")
+        return [t for t in data or [] if isinstance(t, dict)]
+
+    def note(self, job_id: str, note: str) -> None:
+        self._call("POST", f"/ai-workspace-helper/jobs/{job_id}/note", {"note": note})
+
+
+__all__ = ["Backend", "BackendError", "FetchBytes", "Job", "NeedsLogin", "Send", "UpdateRequired"]
diff --git a/ai-workspace-helper/src/ai_workspace_helper/builtin_errands.py b/ai-workspace-helper/src/ai_workspace_helper/builtin_errands.py
new file mode 100644
index 00000000..ab225df0
--- /dev/null
+++ b/ai-workspace-helper/src/ai_workspace_helper/builtin_errands.py
@@ -0,0 +1,109 @@
+"""The errands this helper ships with (docs/plan-outside-helper.md D9, D10):
+`search` and `open_url`, keyed by the job `kind` the backend hands out.
+
+Both bring back ONE page, whole, as the person would have copied it: a search
+brings back the results page itself — links and all — and the AI picks which
+to open next (D10); nothing here guesses which result matters.
+"""
+
+from __future__ import annotations
+
+import contextlib
+from collections.abc import Callable
+from typing import Any
+from urllib.parse import quote, urlsplit
+
+from .errands import Errand, ErrandContext, ErrandFailed, FetchedPage
+
+#: How long a page may take to start answering before the errand gives up.
+PAGE_TIMEOUT_MS = 30_000
+#: After the document is there, how long to let the rest (images, late
+#: scripts that draw the results) arrive before reading it anyway.
+SETTLE_MS = 5_000
+
+#: What `encodeURIComponent` leaves unescaped besides letters and digits —
+#: the card fills `{q}` with it (web/src/api/outsideLookup.ts).
+_URI_COMPONENT_SAFE = "-_.!~*'()"
+
+#: The page as the person would copy it: the body, with every link and image
+#: made absolute against the page's own address (a copy from the browser
+#: carries absolute links; the raw HTML of, say, Google's results does not,
+#: and a relative link is one the AI cannot open). Only READS the live page —
+#: the conversion runs elsewhere, so the page's CSP / Trusted Types never apply.
+_PAGE_HTML = """() => {
+  const body = document.body ? document.body.cloneNode(true) : document.createElement("body");
+  for (const [selector, attr] of [["a[href]", "href"], ["img[src]", "src"]]) {
+    for (const el of body.querySelectorAll(selector)) {
+      try {
+        el.setAttribute(attr, new URL(el.getAttribute(attr), document.baseURI).href);
+      } catch (e) {}
+    }
+  }
+  return body.innerHTML;
+}"""
+
+#: Signs that a page put a verification in the person's way rather than the
+#: content: Google's "unusual traffic" page, and the common challenge widgets.
+_VERIFICATION_FRAMES = (
+    'iframe[src*="recaptcha"]',
+    'iframe[src*="hcaptcha"]',
+    'iframe[src*="challenges.cloudflare.com"]',
+)
+
+
+def search_url(template: str, query: str) -> str:
+    """`template` with every `{q}` filled the way the card fills it."""
+    return template.replace("{q}", quote(query, safe=_URI_COMPONENT_SAFE))
+
+
+def pick_search_target(targets: list[dict[str, str]]) -> dict[str, str]:
+    """The card's Google button, or — on a deploy that lists its own — the
+    first destination it lists."""
+    for target in targets:
+        if target.get("name") == "Google":
+            return target
+    if not targets:
+        raise ErrandFailed("this deploy lists no search destination")
+    return targets[0]
+
+
+def looks_like_a_verification(page: Any) -> bool:
+    if "/sorry/" in urlsplit(page.url).path:
+        return True
+    return any(page.locator(selector).count() for selector in _VERIFICATION_FRAMES)
+
+
+def fetch(ctx: ErrandContext, url: str) -> FetchedPage:
+    page = ctx.page
+    response = page.goto(url, wait_until="domcontentloaded", timeout=PAGE_TIMEOUT_MS)
+    if response is not None and response.status >= 400:
+        raise ErrandFailed(f"the page answered {response.status}")
+    from playwright.sync_api import TimeoutError as PlaywrightTimeout
+
+    with contextlib.suppress(PlaywrightTimeout):  # a slow image is no reason to give up the page
+        page.wait_for_load_state("load", timeout=SETTLE_MS)
+    ctx.wait_for_person(lambda: looks_like_a_verification(page))
+    title, where = page.title(), page.url
+    html = page.evaluate(_PAGE_HTML)
+    return FetchedPage(title=title, url=where, markdown=ctx.convert(html))
+
+
+def build(targets: Callable[[], list[dict[str, str]]]) -> dict[str, Errand]:
+    """The errands, given where the deploy's search destinations come from
+    (`GET /api/lookup-targets`, asked per search so an operator's change
+    reaches a helper that is already running)."""
+
+    def search(ctx: ErrandContext, query: str) -> FetchedPage:
+        target = pick_search_target(targets())
+        ctx.where(target.get("name", ""))
+        return fetch(ctx, search_url(target["url"], query))
+
+    def open_url(ctx: ErrandContext, url: str) -> FetchedPage:
+        if urlsplit(url).scheme not in ("http", "https"):
+            raise ErrandFailed(f"not a web address: {url!r}")
+        return fetch(ctx, url)
+
+    return {"search": search, "open_url": open_url}
+
+
+__all__ = ["build", "fetch", "looks_like_a_verification", "pick_search_target", "search_url"]
diff --git a/ai-workspace-helper/src/ai_workspace_helper/chrome.py b/ai-workspace-helper/src/ai_workspace_helper/chrome.py
new file mode 100644
index 00000000..da073cc2
--- /dev/null
+++ b/ai-workspace-helper/src/ai_workspace_helper/chrome.py
@@ -0,0 +1,191 @@
+"""The helper's own Chrome (docs/plan-outside-helper.md §3.3, §3.4).
+
+A Playwright persistent context over the person's INSTALLED Chrome
+(`channel="chrome"`) — the only program on their PC that reaches the internet —
+with a profile of its own: the person signs into the app there once, through the
+deploy's normal login (D6), and the cookies stay in that profile, apart from
+their everyday browser's (a refresh token is single-use; sharing one would sign
+each other out).
+
+The same context is the helper's line to the backend: `send` goes through the
+context's `APIRequestContext`, which carries — and stores back — that profile's
+cookies. Python speaks HTTP directly (D5); no page JavaScript is involved.
+
+Headed by default: a visible browser is less often taken for a robot, and is
+where the person solves a captcha (§3.4).
+
+All Playwright calls must come from the thread that created the `Chrome` (the
+sync API is not thread-safe); the window drives it from one worker thread.
+"""
+
+from __future__ import annotations
+
+import json
+from collections.abc import Callable
+from pathlib import Path
+from typing import Any
+
+from .errands import Errand, ErrandContext, ErrandFailed, FetchedPage
+
+#: A backend request that takes longer than this is treated as unreachable.
+REQUEST_TIMEOUT_MS = 30_000
+#: The update zip is ~40 MB; on an office LAN that is seconds, not minutes.
+DOWNLOAD_TIMEOUT_MS = 300_000
+
+#: The card's paste converter, built from the frontend source into this
+#: package (web/vite.ai-workspace-helper.config.ts) — defines `__aiWorkspaceHelper`.
+_CONVERTER = Path(__file__).with_name("page_to_markdown.js")
+
+
+def _converter_source() -> str:
+    try:
+        return _CONVERTER.read_text(encoding="utf-8")
+    except OSError as exc:
+        raise ErrandFailed("the helper's page converter is missing — reinstall the helper") from exc
+
+
+class Chrome:
+    def __init__(
+        self,
+        profile: Path,
+        app_url: str,
+        *,
+        channel: str | None = "chrome",
+        headless: bool = False,
+        args: list[str] | None = None,
+    ) -> None:
+        from playwright.sync_api import sync_playwright
+
+        self.app_url = app_url.rstrip("/")
+        profile.mkdir(parents=True, exist_ok=True)
+        self._pw = sync_playwright().start()
+        try:
+            self._ctx = self._pw.chromium.launch_persistent_context(
+                str(profile), channel=channel, headless=headless, no_viewport=True, args=args
+            )
+        except BaseException:
+            self._pw.stop()
+            raise
+        #: The window was closed under the helper (or by `close`): its
+        #: Playwright objects are dead, and a new `Chrome` is needed.
+        self.gone = False
+        self._ctx.on("close", lambda _ctx: setattr(self, "gone", True))
+
+    def send(
+        self, method: str, path: str, body: dict[str, Any] | None, headers: dict[str, str]
+    ) -> tuple[int, Any]:
+        """One backend request with the profile's cookies; see `backend.Send`.
+        Redirects are NOT followed — a redirect is the gateway sending an
+        expired login to sign in, and followed it would read as a success."""
+        from playwright.sync_api import Error as PlaywrightError
+
+        try:
+            r = self._ctx.request.fetch(
+                f"{self.app_url}{path}",
+                method=method,
+                headers={**headers, "Content-Type": "application/json"},
+                data=json.dumps(body) if body is not None else None,
+                max_redirects=0,
+                fail_on_status_code=False,
+                timeout=REQUEST_TIMEOUT_MS,
+            )
+        except PlaywrightError as exc:
+            # refused, DNS, timeout, TLS: the backend is not reachable from here
+            raise OSError(str(exc)) from exc
+        try:
+            try:
+                data = r.json() if r.body() else None
+            except (ValueError, PlaywrightError):
+                data = None
+            return r.status, data
+        finally:
+            r.dispose()
+
+    def fetch_bytes(self, path: str, headers: dict[str, str]) -> tuple[int, bytes]:
+        """A GET whose answer is a file (the update zip, §3.7.4), with the
+        profile's login; see `backend.FetchBytes`. Redirects not followed."""
+        from playwright.sync_api import Error as PlaywrightError
+
+        try:
+            r = self._ctx.request.get(
+                f"{self.app_url}{path}",
+                headers=headers,
+                max_redirects=0,
+                fail_on_status_code=False,
+                timeout=DOWNLOAD_TIMEOUT_MS,
+            )
+        except PlaywrightError as exc:
+            raise OSError(str(exc)) from exc
+        try:
+            return r.status, r.body()
+        finally:
+            r.dispose()
+
+    def version(self) -> str:
+        """The Chrome being driven, e.g. `141.0.7390.55` (§3.7.7). A persistent
+        context has no `Browser` object to ask, so the browser itself is."""
+        page = self._ctx.pages[0] if self._ctx.pages else self._ctx.new_page()
+        session = self._ctx.new_cdp_session(page)
+        try:
+            product = str(session.send("Browser.getVersion")["product"])
+        finally:
+            session.detach()
+        return product.split("/", 1)[-1]
+
+    def run(
+        self,
+        errand: Errand,
+        args: str,
+        note: Callable[[str], None],
+        where: Callable[[str], None] | None = None,
+    ) -> FetchedPage:
+        """Run one errand in a fresh tab, closed afterwards whatever happens.
+        `note` reaches the card; `where` the window."""
+        page = self._ctx.new_page()
+        try:
+            ctx = ErrandContext(
+                page=page,
+                note=note,
+                convert=lambda html: self._convert_in(page, html),
+                sleep=lambda s: page.wait_for_timeout(s * 1000),
+                where=where if where is not None else (lambda _site: None),
+            )
+            return errand(ctx, args)
+        finally:
+            page.close()
+
+    def convert(self, html: str) -> str:
+        """`html` as Markdown, by the card's own converter (D11), in a tab of
+        its own."""
+        page = self._ctx.new_page()
+        try:
+            return self._convert_in(page, html)
+        finally:
+            page.close()
+
+    def _convert_in(self, page: Any, html: str) -> str:
+        # On a blank page of the helper's own: the fetched page's CSP or
+        # Trusted Types (Google enforces them) would refuse the converter's
+        # HTML parsing, and nothing here needs the network.
+        page.goto("about:blank")
+        page.evaluate(_converter_source())
+        return page.evaluate(
+            "html => __aiWorkspaceHelper.aiWorkspaceHelper.htmlToMarkdown(html)", html
+        )
+
+    def open_login(self) -> None:
+        """Bring the browser forward on the app, so the person signs in the way
+        they always do (the deploy's SSO); the cookies land in this profile."""
+        page = self._ctx.pages[0] if self._ctx.pages else self._ctx.new_page()
+        page.goto(self.app_url)
+        page.bring_to_front()
+
+    def close(self) -> None:
+        try:
+            if not self.gone:
+                self._ctx.close()
+        finally:
+            self._pw.stop()
+
+
+__all__ = ["REQUEST_TIMEOUT_MS", "Chrome"]
diff --git a/ai-workspace-helper/src/ai_workspace_helper/errands.py b/ai-workspace-helper/src/ai_workspace_helper/errands.py
new file mode 100644
index 00000000..1e1d3b62
--- /dev/null
+++ b/ai-workspace-helper/src/ai_workspace_helper/errands.py
@@ -0,0 +1,95 @@
+"""Errands: what the helper can do in the browser (docs/plan-outside-helper.md D9).
+
+An errand is a function `(ctx, args) -> FetchedPage`, registered under the job
+`kind` the backend hands out. `ctx` carries the Playwright page to work in and
+what every errand shares — waiting for the person when a verification stands in
+the way. A new errand is a new function; the backend and the card need no
+change.
+"""
+
+from __future__ import annotations
+
+import time
+from collections.abc import Callable
+from dataclasses import dataclass, field
+from typing import Any
+
+#: How long the helper waits for the person to complete a verification in its
+#: Chrome window before giving the job up (the card then offers 「重查」).
+VERIFY_TIMEOUT_S = 300.0
+
+#: What the card shows while the helper waits on the person.
+CAPTCHA = "captcha"
+#: While waiting, the card is told again this often. Each time renews the claim
+#: on the job (the backend's CLAIM_TIMEOUT_MS is 120 s) and counts as checking
+#: in (the backend reads a helper silent for 30 s as gone).
+RENEW_S = 20.0
+
+
+class ErrandFailed(Exception):
+    """The errand could not bring the page back; the message goes to the card."""
+
+
+@dataclass(frozen=True)
+class FetchedPage:
+    """One page as the person would have copied it: its title, where it was,
+    and the page as Markdown (the card's own paste converter, D11)."""
+
+    title: str
+    url: str
+    markdown: str
+
+
+def _no_converter(_html: str) -> str:
+    raise ErrandFailed("no page converter in this context")
+
+
+def _nowhere(_site: str) -> None:
+    pass
+
+
+@dataclass
+class ErrandContext:
+    #: The Playwright `Page` the errand works in (a fresh tab, closed after).
+    page: Any
+    #: Tell the card what the helper waits on (`captcha`), or "" once it doesn't.
+    note: Callable[[str], None]
+    #: A page's HTML as Markdown — the card's own paste converter (D11), run in
+    #: the helper's Chrome. It may navigate `page` away: call it last.
+    convert: Callable[[str], str] = field(default=_no_converter)
+    sleep: Callable[[float], None] = field(default=time.sleep)
+    #: Tell the window which site the errand is on (「正在搜尋（Google）」).
+    where: Callable[[str], None] = field(default=_nowhere)
+    clock: Callable[[], float] = field(default=time.monotonic)
+
+    def wait_for_person(
+        self, blocked: Callable[[], bool], *, timeout_s: float = VERIFY_TIMEOUT_S
+    ) -> None:
+        """While `blocked()` (a captcha, a "are you a robot" page), bring the
+        helper's Chrome window (that tab) forward and wait for the person to clear it — the
+        helper runs headed for exactly this (§3.4). Fails the errand if nobody
+        does within `timeout_s`."""
+        if not blocked():
+            return
+        self.page.bring_to_front()
+        self.note(CAPTCHA)
+        start = self.clock()
+        deadline, renew_at = start + timeout_s, start + RENEW_S
+        while blocked():
+            now = self.clock()
+            if now >= deadline:
+                raise ErrandFailed(
+                    "the verification in the helper's Chrome window was not completed"
+                )
+            if now >= renew_at:
+                # telling the card again renews the claim on the job: a person
+                # may take longer than a claim lasts (120 s on the backend)
+                self.note(CAPTCHA)
+                renew_at = now + RENEW_S
+            self.sleep(1.0)
+        self.note("")
+
+
+Errand = Callable[[ErrandContext, str], FetchedPage]
+
+__all__ = ["CAPTCHA", "Errand", "ErrandContext", "ErrandFailed", "FetchedPage", "VERIFY_TIMEOUT_S"]
diff --git a/ai-workspace-helper/src/ai_workspace_helper/history.py b/ai-workspace-helper/src/ai_workspace_helper/history.py
new file mode 100644
index 00000000..cc159f2d
--- /dev/null
+++ b/ai-workspace-helper/src/ai_workspace_helper/history.py
@@ -0,0 +1,106 @@
+"""The window's 查詢紀錄 (docs/plan-outside-helper.md D13): what the helper ran
+on this PC — when, what, on which site, and how it ended.
+
+Kept only here (`history.jsonl` in the helper's folder, gone with an
+uninstall), never sent anywhere: the card already shows each job's state. One
+JSON object per line; the newest `keep` are what the window shows, and the
+file is rewritten to those whenever it has grown to twice that. A line that
+does not read is skipped — a history is not worth failing a start over.
+
+The worker thread adds, the window thread reads: both under one lock.
+"""
+
+from __future__ import annotations
+
+import datetime
+import json
+import os
+import threading
+from collections.abc import Callable
+from pathlib import Path
+from typing import Any
+
+#: Rows the window keeps.
+KEEP = 200
+
+_FIELDS = ("at", "kind", "args", "site", "outcome", "reason")
+
+
+def _now() -> str:
+    return datetime.datetime.now().isoformat(timespec="seconds")
+
+
+class History:
+    def __init__(
+        self, path: Path | None, *, keep: int = KEEP, clock: Callable[[], str] = _now
+    ) -> None:
+        #: None keeps it in memory only (tests, the live check).
+        self._path = path
+        self._keep = keep
+        self._clock = clock
+        self._lock = threading.Lock()
+        #: Lines in the file now — it is rewritten once that reaches 2 × keep.
+        self._lines = 0
+        #: The file ends inside a line (cut short by a crash): the next row
+        #: starts on a line of its own rather than glued onto that one.
+        self._cut = False
+        self._rows: list[dict[str, Any]] = self._read()
+        #: Changes on every `add`: the window redraws the tab when it does.
+        self.version = 0
+
+    def _read(self) -> list[dict[str, Any]]:
+        if self._path is None:
+            return []
+        try:
+            # a line cut inside a character (a crash mid-append) or a file
+            # re-saved in another encoding only spoils its own lines
+            text = self._path.read_text(encoding="utf-8", errors="replace")
+        except OSError:
+            return []
+        rows = []
+        self._lines = len(text.splitlines())
+        self._cut = bool(text) and not text.endswith("\n")
+        for line in text.splitlines():
+            try:
+                row = json.loads(line)
+            except ValueError:
+                continue
+            if isinstance(row, dict):
+                rows.append({k: str(row.get(k, "")) for k in _FIELDS})
+        return rows[-self._keep :]
+
+    def add(self, *, kind: str, args: str, site: str, outcome: str, reason: str = "") -> None:
+        row = {
+            "at": self._clock(),
+            "kind": kind,
+            "args": args,
+            "site": site,
+            "outcome": outcome,
+            "reason": reason,
+        }
+        with self._lock:
+            self._rows = [*self._rows, row][-self._keep :]
+            self.version += 1
+            if self._path is None:
+                return
+            self._lines += 1
+            if self._lines >= 2 * self._keep:
+                # whole or not at all: written beside it, then moved over it
+                text = "".join(json.dumps(r, ensure_ascii=False) + "\n" for r in self._rows)
+                beside = self._path.with_name(self._path.name + ".new")
+                beside.write_text(text, encoding="utf-8")
+                os.replace(beside, self._path)
+                self._lines = len(self._rows)
+            else:
+                with self._path.open("a", encoding="utf-8") as f:
+                    line = json.dumps(row, ensure_ascii=False) + "\n"
+                    f.write(("\n" if self._cut else "") + line)
+            self._cut = False
+
+    def recent(self) -> list[dict[str, Any]]:
+        """The newest first."""
+        with self._lock:
+            return list(reversed(self._rows))
+
+
+__all__ = ["KEEP", "History"]
diff --git a/ai-workspace-helper/src/ai_workspace_helper/home.py b/ai-workspace-helper/src/ai_workspace_helper/home.py
new file mode 100644
index 00000000..4bf54718
--- /dev/null
+++ b/ai-workspace-helper/src/ai_workspace_helper/home.py
@@ -0,0 +1,60 @@
+"""The helper's own folder (docs/plan-outside-helper.md §3.7.1).
+
+`%LOCALAPPDATA%\\AIWorkspaceHelper\\` on Windows; `AI_WORKSPACE_HELPER_HOME` overrides it
+(tests, a developer's Linux box). Holds the single-instance lock, the settings
+the person gave on first start, the helper's own Chrome profile, its logs and
+the window's 查詢紀錄 (history.jsonl).
+
+The folder, the lock and the atomic writer are `setup_core`'s — one definition
+shared with the installer, the launcher and the uninstaller, which run with no
+package installed.
+"""
+
+from __future__ import annotations
+
+import json
+import time
+from pathlib import Path
+from typing import Any
+
+from . import setup_core
+
+root = setup_core.root
+InstanceLock = setup_core.InstanceLock
+
+
+def profile_dir(home: Path) -> Path:
+    """The helper's own Chrome profile — outside the version folders, so an
+    update does not sign the person out (§3.7.7)."""
+    return home / "profile"
+
+
+def reset_profile(home: Path) -> None:
+    """「重設登入」 (§3.7.7): move the profile aside — not deleted, so a reset
+    by mistake loses nothing — for Chrome to start on a fresh one."""
+    profile = profile_dir(home)
+    if profile.exists():
+        profile.rename(home / f"profile.old-{time.strftime('%Y%m%d-%H%M%S')}-{time.time_ns()}")
+
+
+def read_settings(home: Path) -> dict[str, Any]:
+    try:
+        data = json.loads((home / "settings.json").read_text(encoding="utf-8"))
+    except (OSError, ValueError):
+        return {}
+    return data if isinstance(data, dict) else {}
+
+
+def write_settings(home: Path, settings: dict[str, Any]) -> None:
+    """Atomic: a crash leaves the old settings or the new ones, never half."""
+    setup_core.write_json(home / "settings.json", settings)
+
+
+__all__ = [
+    "InstanceLock",
+    "profile_dir",
+    "read_settings",
+    "reset_profile",
+    "root",
+    "write_settings",
+]
