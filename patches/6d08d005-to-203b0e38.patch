+
 def test_only_a_declaration_as_the_tool_writes_it_is_a_card() -> None:
     m = OUTSIDE_LOOKUP_MARKER
     assert declared_lookup(f'x{m}{{"why":"w","query":"q"}}') == {"why": "w", "query": "q"}
