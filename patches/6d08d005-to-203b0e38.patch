+    seen = page.client.get(BASE).json()["draft"]
+    theirs = {"config": {"agents": {"presets": {"kb-default": {"model": "openai/theirs"}}}}}
+    page.client.put(f"{BASE}/draft", json={"patch": theirs})
+    mine = {"config": {"agents": {"presets": {"kb-default": {"model": "openai/mine"}}}}}
+
+    response = page.client.put(f"{BASE}/draft", json={"patch": mine, "based_on": seen})
+
+    assert response.status_code == 409
+    assert isinstance(response.json()["detail"], str)
+    assert page.client.get(BASE).json()["draft"] == theirs
+    again = page.client.put(f"{BASE}/draft", json={"patch": mine, "based_on": theirs})
+    assert again.status_code == 200
+
+
+def test_a_key_set_while_apply_checks_is_not_published_unseen(page, monkeypatch):
+    # final review 11: Apply compared the key revision, then checked, then
+    # published whatever keys were staged by then — a key set in between went
+    # into force although the dialog never listed it.
+    import workspace_app.api.model_settings_routes as routes
+
+    seen = page.client.get(BASE).json()
+    real = routes.problems
+
+    def meanwhile(*args, **kwargs):
+        SettingsStore(page.spec).set_key(API_KEY, "sk-sneaked-0000-0000", by=ALICE)
+        return real(*args, **kwargs)
+
+    monkeypatch.setattr(routes, "problems", meanwhile)
+
+    response = page.client.post(
+        f"{BASE}/apply",
+        json={"draft": seen["draft"], "pending_keys": [], "key_revision": seen["key_revision"]},
+    )
+
+    assert response.status_code == 409
+    assert page.client.get(BASE).json()["applied_keys"] == []
+
+
+def test_the_page_offers_the_places_a_key_can_go_from_the_saved_draft(page):
+    # M22: picked, not typed; a preset the saved draft adds is a place too.
+    page.client.put(
+        f"{BASE}/draft",
+        json={"patch": {"config": {"agents": {"presets": {"brand-new": {"model": "openai/x"}}}}}},
+    )
+
+    slots = page.client.get(BASE).json()["key_slots"]
+
+    paths = {slot["path"] for slot in slots}
+    assert API_KEY in paths
+    assert "config.agents.presets.brand-new.llm.api_key" in paths
+    assert {"path": API_KEY, "owner": "kb-default", "kind": "api_key", "name": ""} in slots
+
+
+def test_the_page_has_the_whole_boot_config_to_diff_a_paste_against(page):
+    # M23: a pasted resolved config's sections the page does not edit drop out
+    # when unchanged — so the baseline is the whole boot config, secrets masked.
+    from workspace_app.model_settings.page import SET, UNSET
+
+    boot = page.client.get(BASE).json()["boot_config"]
+
+    assert boot["server"]["port"] == 9090
+    assert boot["llm"]["api_key"] in (SET, UNSET)
+    assert "sub_agents" not in boot["agents"]  # spelled as config.yaml spells it
+
+
+def test_a_broker_url_with_its_password_never_reaches_the_page(tmp_path):
+    # review 17: M23's boot_config sends the whole boot config; the event bus's
+    # amqp URL embeds credentials like the message queue's and went in clear.
+    page = Page(
+        tmp_path,
+        "event_bus:\n  url: amqp://user:hunter2@broker:5672/\n"
+        "message_queue:\n  rabbitmq:\n    url: amqp://user:hunter3@broker:5672/\n",
+    )
+    try:
+        body = page.client.get(BASE).text
+    finally:
+        overlay.set_source(None)
+
+    assert "hunter2" not in body and "hunter3" not in body
+
+
+def test_test_connection_waits_long_enough_for_a_model_to_load(page, monkeypatch):
+    # demo 2026-10-15: since M24 nothing streams until the model is loaded, and a
+    # CPU model read back from disk took over 30 s — the test timed out twice on
+    # a model that works. The running line already says it can take tens of
+    # seconds; the bound only costs anything when the endpoint never answers.
+    from workspace_app.kb.llm import LitellmLlm
+
+    seen: list[float | None] = []
+
+    def stream(self, prompt):
+        seen.append(self._timeout)
+        return iter([("OK", False)])
+
+    monkeypatch.setattr(LitellmLlm, "stream", stream)
+
+    page.client.post(f"{BASE}/test-connection", json={"preset": "kb-default"})
+
+    assert seen and seen[0] is not None and seen[0] >= 120
