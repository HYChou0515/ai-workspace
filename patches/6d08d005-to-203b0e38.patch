index 00000000..11420a64
--- /dev/null
+++ b/tests/capacity/test_fe_fixtures.py
@@ -0,0 +1,59 @@
+"""The page's test fixtures are what the API really returns (docs/plan-capacity-usage.md
+P13): a double whose shape drifted from the real one tests a page nobody runs.
+Regenerate with `uv run python scripts/capacity_fixtures.py`."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+
+from workspace_app.api.capacity_routes import CapacitySummary, PersonOut, WhatIfOut
+
+FIXTURES = Path(__file__).resolve().parents[2] / "web" / "src" / "capacity" / "fixtures"
+
+
+@pytest.mark.parametrize(
+    ("name", "model"),
+    [("summary.json", CapacitySummary), ("person.json", PersonOut), ("whatif.json", WhatIfOut)],
+)
+def test_each_fixture_is_a_valid_response(name, model):
+    model.model_validate(json.loads((FIXTURES / name).read_text(encoding="utf-8")))
+
+
+def _keys(node: object, path: str = "") -> set[str]:
+    """Every key path in a JSON tree (list items share their first item's paths)."""
+    if isinstance(node, dict):
+        out = set()
+        for k, v in node.items():
+            here = f"{path}.{k}"
+            out |= {here} | _keys(v, here)
+        return out
+    if isinstance(node, list) and node and isinstance(node[0], dict):
+        return _keys(node[0], f"{path}[]")
+    return set()
+
+
+def test_the_summary_fixture_has_every_field_a_fresh_one_has():
+    import scripts.capacity_fixtures as gen
+
+    fresh = gen.fixtures()["summary.json"]
+    kept = json.loads((FIXTURES / "summary.json").read_text(encoding="utf-8"))
+
+    assert _keys(fresh) == _keys(kept), "rerun scripts/capacity_fixtures.py"
+
+
+@pytest.mark.parametrize(
+    ("name", "model"),
+    [("summary.json", CapacitySummary), ("person.json", PersonOut), ("whatif.json", WhatIfOut)],
+)
+def test_the_api_passes_on_every_field_the_analysis_makes(name, model):
+    """A response model silently drops a field it does not declare: the page's
+    tests, run on the analysis' own output, would then pass on a field the
+    page never receives."""
+    import scripts.capacity_fixtures as gen
+
+    fresh = json.loads(json.dumps(gen.fixtures()[name]))
+
+    assert _keys(model.model_validate(fresh).model_dump()) == _keys(fresh)
diff --git a/tests/capacity/test_jobs.py b/tests/capacity/test_jobs.py
new file mode 100644
index 00000000..edbaf1eb
--- /dev/null
+++ b/tests/capacity/test_jobs.py
@@ -0,0 +1,97 @@
+"""Background jobs on the usage record (docs/plan-capacity-usage.md §5.2 `job`,
+§6.4): each attempt's requester, wait and run time, charged as `job:<type>`
+work while it runs, inside the job's own usage scope."""
+
+from __future__ import annotations
+
+import datetime as dt
+import time
+from types import SimpleNamespace
+
+import pytest
+
+from workspace_app.capacity.jobs import recorded_job
+from workspace_app.capacity.recorder import UsageRecorder
+from workspace_app.capacity.scope import UsageScope, current
+from workspace_app.capacity.sink import UsageSink
+
+
+class _ListSink(UsageSink):
+    def __init__(self) -> None:
+        self.docs: list[dict] = []
+
+    def write(self, documents):
+        self.docs.extend(documents)
+
+
+def _job(created_by: str | None = "alice", retries: int = 0, ago_s: float = 30.0):
+    created = dt.datetime.now(dt.UTC) - dt.timedelta(seconds=ago_s)
+    return SimpleNamespace(
+        info=SimpleNamespace(created_by=created_by, created_time=created),
+        data=SimpleNamespace(retries=retries, payload=None),
+    )
+
+
+def _usage(sink: _ListSink, kind: str) -> list[dict]:
+    return [d["usage"] for d in sink.docs if d["usage"]["kind"] == kind]
+
+
+def test_without_a_recorder_the_handler_is_untouched():
+    def handle(job):  # noqa: ANN001, ANN202
+        return None
+
+    assert recorded_job("index", handle, None) is handle
+
+
+def test_an_attempt_is_recorded_with_its_requester_wait_and_run_time():
+    sink = _ListSink()
+    rec = UsageRecorder(sink, component="worker", pod="w-1", window_s=300, queue_max=100)
+    scopes: list[UsageScope | None] = []
+
+    def handle(job):  # noqa: ANN001, ANN202
+        scopes.append(current())
+        time.sleep(0.05)
+
+    job = _job(created_by="alice", retries=2, ago_s=30)
+    recorded_job("index", handle, rec)(job)
+    rec.close()
+
+    (rec_job,) = _usage(sink, "job")
+    enqueued = int(job.info.created_time.timestamp() * 1000)
+    assert (rec_job["user"], rec_job["jobtype"], rec_job["outcome"], rec_job["attempt"]) == (
+        "alice",
+        "index",
+        "done",
+        3,
+    )
+    assert rec_job["enqueued_ms"] == enqueued
+    assert rec_job["started_ms"] - enqueued >= 30_000, "it waited the 30 s since it was queued"
+    assert rec_job["ended_ms"] - rec_job["started_ms"] >= 50
+    assert scopes == [UsageScope(user="alice", purpose="index")]
+    (work,) = _usage(sink, "work")
+    assert (work["work"], work["user"], work["count"]) == ("job:index", "alice", 1)
+    assert work["seconds"] >= 0.05
+
+
+def test_a_failing_attempt_is_recorded_as_failed_and_still_fails():
+    sink = _ListSink()
+    rec = UsageRecorder(sink, component="worker", pod="w-1", window_s=300, queue_max=100)
+
+    def handle(job):  # noqa: ANN001, ANN202
+        raise RuntimeError("embedding endpoint down")
+
+    with pytest.raises(RuntimeError, match="embedding endpoint down"):
+        recorded_job("wiki", handle, rec)(_job())
+    rec.close()
+
+    assert [j["outcome"] for j in _usage(sink, "job")] == ["failed"]
+
+
+def test_a_job_nobody_requested_is_the_systems():
+    sink = _ListSink()
+    rec = UsageRecorder(sink, component="worker", pod="w-1", window_s=300, queue_max=100)
+
+    recorded_job("blob-gc", lambda job: None, rec)(_job(created_by=None))
+    rec.close()
+
+    assert [j["user"] for j in _usage(sink, "job")] == ["system"]
diff --git a/tests/capacity/test_jobs_registration.py b/tests/capacity/test_jobs_registration.py
new file mode 100644
index 00000000..e88d437e
--- /dev/null
+++ b/tests/capacity/test_jobs_registration.py
@@ -0,0 +1,131 @@
+"""Every job type is on the usage record (docs/plan-capacity-usage.md §6.4).
+
+A coordinator that registers its handler without `recorded_job` is a job type
+missing from every view and every attribution — silently, since nothing else
+reads the record. So: every `job_handler=` in `src/` is a `recorded_job(...)`
+call whose label is a JobType the worker knows (`worker._JOBTYPE_ATTR`, the
+list `python -m workspace_app.worker <jobtype>` accepts — not derived from the
+lines checked here), every JobType is covered, and the recorder passed is the
+coordinator's own `self._usage_recorder`, which `build_coordinators` sets
+(`test_every_coordinator_built_holds_the_recorder`).
+"""
+
+from __future__ import annotations
+
+import ast
+from pathlib import Path
+
+from workspace_app.worker import _JOBTYPE_ATTR
+
+SRC = Path(__file__).resolve().parents[2] / "src" / "workspace_app"
+
+
+def _registrations() -> list[tuple[str, ast.expr]]:
+    found = []
+    for path in sorted(SRC.rglob("*.py")):
+        for node in ast.walk(ast.parse(path.read_text(encoding="utf-8"))):
+            if isinstance(node, ast.keyword) and node.arg == "job_handler":
+                found.append((f"{path.relative_to(SRC)}:{node.value.lineno}", node.value))
+    return found
+
+
+def _label(call: ast.expr) -> str | None:
+    """The JobType a `recorded_job("<jobtype>", self._handle, self._usage_recorder)` call names."""
+    if not (isinstance(call, ast.Call) and getattr(call.func, "id", None) == "recorded_job"):
+        return None
+    if len(call.args) != 3 or not isinstance(call.args[0], ast.Constant):
+        return None
+    recorder = call.args[2]
+    if not (
+        isinstance(recorder, ast.Attribute)
+        and recorder.attr == "_usage_recorder"
+        and getattr(recorder.value, "id", None) == "self"
+    ):
+        return None
+    label = call.args[0].value
+    return label if isinstance(label, str) else None
+
+
+def test_every_job_handler_is_registered_through_recorded_job():
+    registrations = _registrations()
+    assert registrations, "no job_handler= found — the scan is looking in the wrong place"
+
+    unwrapped = [where for where, call in registrations if _label(call) is None]
+
+    assert unwrapped == [], (
+        f"registered without recorded_job(<jobtype>, handler, self._usage_recorder): {unwrapped}"
+    )
+
+
+def test_every_jobtype_the_worker_knows_is_recorded_under_its_own_name():
+    labels = [_label(call) for _where, call in _registrations()]
+
+    assert sorted(labels) == sorted(_JOBTYPE_ATTR)
+
+
+class _ListSink:
+    def __init__(self) -> None:
+        self.docs: list[dict] = []
+
+    def write(self, documents):
+        self.docs.extend(documents)
+
+
+def _recorder():
+    from workspace_app.capacity.recorder import UsageRecorder
+    from workspace_app.capacity.sink import UsageSink
+
+    class _Sink(_ListSink, UsageSink):
+        pass
+
+    sink = _Sink()
+    return sink, UsageRecorder(sink, component="worker", pod="w", window_s=300, queue_max=100)
+
+
+class _Llm:
+    """Never called: the coordinators that need a model are only built here."""
+
+
+def test_every_coordinator_built_holds_the_recorder():
+    from workspace_app.resources import make_spec
+
+    from ..test_coordinators import _build, _FakeIngestor
+
+    _sink, rec = _recorder()
+    bundle = _build(
+        make_spec(default_user="u"),
+        _FakeIngestor(),
+        usage_recorder=rec,
+        sanity_llm_factory=lambda *_a, **_kw: _Llm(),
+        eval_llm=_Llm(),
+        graph_llm=_Llm(),
+    )
+
+    queued = {name: getattr(bundle, attr) for name, attr in _JOBTYPE_ATTR.items()}
+    assert all(c is not None for c in queued.values()), "every JobType's coordinator was built"
+    assert {name: c._usage_recorder is rec for name, c in queued.items()} == dict.fromkeys(  # noqa: SLF001
+        queued, True
+    )
+
+
+async def test_an_index_job_through_the_real_queue_is_recorded():
+    from workspace_app.resources import make_spec
+
+    from ..test_coordinators import _build, _collection, _doc, _FakeIngestor
+
+    sink, rec = _recorder()
+    spec = make_spec(default_user="alice")
+    cid = _collection(spec)
+    doc_id = _doc(spec, cid)
+    ingestor = _FakeIngestor()
+    bundle = _build(spec, ingestor, usage_recorder=rec, get_user_id=lambda: "alice")
+
+    bundle.index.enqueue(doc_id, cid)
+    await bundle.index.aclose()
+    rec.close()
+
+    assert ingestor.indexed == [doc_id]
+    jobs = [d["usage"] for d in sink.docs if d["usage"]["kind"] == "job"]
+    assert [(j["jobtype"], j["outcome"]) for j in jobs] == [("index", "done")]
+    work = [d["usage"]["work"] for d in sink.docs if d["usage"]["kind"] == "work"]
+    assert work == ["job:index"]
diff --git a/tests/capacity/test_lines.py b/tests/capacity/test_lines.py
new file mode 100644
index 00000000..f5c92c85
--- /dev/null
+++ b/tests/capacity/test_lines.py
@@ -0,0 +1,478 @@
+"""Each component × resource and each person's share (docs/plan-capacity-usage.md
+§9.1, §9.3), against a world whose costs are known: the regression finds them,
+the shares add up to what was measured, and direct lines are exactly measured."""
+
+from __future__ import annotations
+
+import gc
+import tracemalloc
+from functools import cache
+from zoneinfo import ZoneInfo
+
+import numpy as np
+import pytest
+
+from workspace_app.capacity.analysis.lines import build_lines
+from workspace_app.capacity.analysis.observe import (
+    Measures,
+    Observations,
+    Samples,
+    SourceStatus,
+    WorkSeries,
+    observe,
+)
+from workspace_app.capacity.analysis.period import Period
+from workspace_app.capacity.sources import CapacityEntry, CapacitySources
+
+from .world import (
+    EVENTS,
+    FILES,
+    KB,
+    SEND,
+    STREAM,
+    World,
+    WorldGpus,
+    WorldLlm,
+    WorldPods,
+    WorldRecords,
+)
+
+
+@cache
+def _world() -> World:
+    return World(days=10, users=20)
+
+
+@cache
+def _lines() -> dict:
+    w = _world()
+    sources = CapacitySources(WorldRecords(w), WorldPods(w), WorldGpus(w), WorldLlm(w))
+    obs = observe(sources, Period(w.start_ms, w.end_ms, w.step_s, ZoneInfo(w.tz)))
+    return {line.id: line for line in build_lines(obs)}
+
+
+def test_the_regression_finds_what_each_kind_of_request_costs():
+    w, api = _world(), _lines()["api.cpu"]
+    assert api.fit is not None
+    costs = dict(api.fit.columns)
+
+    assert costs[FILES] == pytest.approx(w.costs[FILES], rel=0.15)
+    assert costs["stream"] == pytest.approx(w.costs[STREAM], rel=0.15)
+    # A send and its turn's events always come together (≈260 events a send):
+    # only their sum is identifiable, and it is said so rather than guessed.
+    per_send = costs[SEND] + 260 * costs[EVENTS]
+    assert per_send == pytest.approx(w.costs[SEND] + 260 * w.costs[EVENTS], rel=0.15)
+    assert (SEND, EVENTS) in api.fit.collinear or (EVENTS, SEND) in api.fit.collinear
+    assert api.fit.r2 is not None and api.fit.r2 > 0.9
+    assert api.fit.holdout_mape is not None and api.fit.holdout_mape < 0.1
+    # The idle pods: fixed is their idle cost, wherever they were measured.
+    assert np.median(api.fixed) == pytest.approx(w.api_idle_cores * len(w.api_pods), rel=0.15)
+    assert KB in costs or "req:(other GET)" in costs
+
+
+def test_a_persons_api_share_is_their_own_work_at_those_costs():
+    w, api = _world(), _lines()["api.cpu"]
+    u = api.users.index("user00")
+    truth = sum(w.costs[k] * w.counts[k][0] for k in w.costs) / w.step_s
+
