index 00000000..a93494a9
--- /dev/null
+++ b/src/workspace_app/capacity/service.py
@@ -0,0 +1,122 @@
+"""The capacity analysis, on demand (docs/plan-capacity-usage.md §11, E6).
+
+One analysis per period, built in a worker thread (never on the event loop),
+one build at a time across periods (each holds a period's records in the API
+process), and kept in memory for `TTL_S` — then let go, whether or not anyone
+asks again. The build belongs to no request: everyone asking for the period
+while it runs waits for the same one, and a request that goes away (a page
+closed) neither cancels it for the others nor makes the next one start
+another. Nothing is written anywhere (D3). The 90-day period is analysed at
+15-minute slots or coarser, so three months of a large deployment stays
+within memory.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import datetime as dt
+import time
+from collections.abc import Callable
+from functools import partial
+from zoneinfo import ZoneInfo
+
+from ..config.schema import CapacitySettings
+from .analysis.model import Analysis, analyse
+from .analysis.observe import TooManyRows, observe
+from .analysis.period import Period
+from .sources import CapacitySources
+
+#: The periods the page offers (E7).
+PERIODS = (7, 28, 90)
+TTL_S = 600.0
+#: The coarsest slot the 90-day period is analysed at.
+LONG_STEP_S = 900
+
+Workday = Callable[[dt.date], bool]
+
+
+class CapacityService:
+    def __init__(
+        self,
+        sources: CapacitySources,
+        settings: CapacitySettings,
+        *,
+        workday: Callable[[], Workday] | None = None,
+        clock: Callable[[], float] = time.time,
+        ttl_s: float = TTL_S,
+    ) -> None:
+        """`workday()` is asked per analysis, so a make-up workday recorded in
+        the work calendar counts from the next analysis on."""
+        self._sources = sources
+        self._settings = settings
+        self._workday = workday
+        self._clock = clock
+        self._ttl_s = ttl_s
+        #: period → (built at, analysis, the timer that lets it go)
+        self._kept: dict[int, tuple[float, Analysis, asyncio.TimerHandle]] = {}
+        self._building: dict[int, asyncio.Task[Analysis]] = {}
+        self._one_at_a_time = asyncio.Lock()
+
+    def period(self, days: int) -> Period:
+        step = self._settings.step_s
+        if days > 28:
+            step = long_step(step)
+        tz = ZoneInfo(self._settings.timezone) if self._settings.timezone else ZoneInfo("UTC")
+        now_ms = int(self._clock() * 1000)
+        return Period.ending(now_ms, days=days, step_s=step, lag_s=self._settings.lag_s, tz=tz)
+
+    def drop(self, days: int) -> None:
+        """Let go of the period's analysis, and cancel the timer that would
+        have — left running, it would let go of the next analysis early."""
+        kept = self._kept.pop(days, None)
+        if kept is not None:
+            kept[2].cancel()
+
+    async def analysis(self, days: int) -> Analysis:
+        """This period's analysis, built if none is kept or it is older than
+        the TTL. Raises `TooManyRows` when it would load more than allowed."""
+        kept = self._kept.get(days)
+        if kept is not None and self._clock() - kept[0] < self._ttl_s:
+            return kept[1]
+        task = self._building.get(days)
+        if task is None:
+            task = asyncio.get_running_loop().create_task(self._build_and_keep(days))
+            self._building[days] = task
+            task.add_done_callback(partial(self._built, days))
+        return await asyncio.shield(task)
+
+    def _built(self, days: int, task: asyncio.Task[Analysis]) -> None:
+        if self._building.get(days) is task:
+            del self._building[days]
+        if not task.cancelled():
+            task.exception()  # retrieved: each waiter re-raises it; nobody else must log it
+
+    async def _build_and_keep(self, days: int) -> Analysis:
+        async with self._one_at_a_time:
+            result = await asyncio.to_thread(self._build, days)
+        self.drop(days)
+        timer = asyncio.get_running_loop().call_later(self._ttl_s, self.drop, days)
+        self._kept[days] = (self._clock(), result, timer)
+        return result
+
+    def _build(self, days: int) -> Analysis:
+        period = self.period(days)
+        obs = observe(self._sources, period, max_rows=self._settings.max_rows)
+        is_workday = self._workday() if self._workday is not None else None
+        now_ms = int(self._clock() * 1000)
+        if is_workday is None:
+            return analyse(obs, now_ms=now_ms)
+        return analyse(obs, now_ms=now_ms, is_workday=is_workday)
+
+
+def long_step(step_s: int) -> int:
+    """The 90-day period's slot: at least `LONG_STEP_S`, a whole number of
+    `step_s` (so of windows — a slot holding one window and two by turn reads
+    a steady load as 1.33 and 0.67 by turn), and a whole number per day."""
+    step = step_s * -(-LONG_STEP_S // step_s)
+    while 86_400 % step:
+        step += step_s
+    return step
+
+
+__all__ = ["PERIODS", "CapacityService", "TooManyRows"]
diff --git a/src/workspace_app/capacity/sink.py b/src/workspace_app/capacity/sink.py
new file mode 100644
index 00000000..ab6da5eb
--- /dev/null
+++ b/src/workspace_app/capacity/sink.py
@@ -0,0 +1,130 @@
+"""Where usage records go (docs/plan-capacity-usage.md §5, §6.7).
+
+The platform stores nothing (D3): by default each record is one JSON line on
+stdout, which the deploy's collector ships to ES. A deploy that would rather
+write elsewhere names its own `UsageSink` in `capacity.sink`.
+
+Records reach the sink through `UsageWriter`: a bounded queue drained by one
+thread. Producing a record is a `put_nowait` — a slow or stuck stdout costs the
+request path nothing — and a full queue drops the record and counts it, so the
+loss is reported (`meta` rows) rather than paid for in memory.
+"""
+
+from __future__ import annotations
+
+import logging
+import queue
+import sys
+import threading
+import time
+from abc import ABC, abstractmethod
+from collections.abc import Mapping, Sequence
+from typing import Any, TextIO
+
+from .usage_wire import line
+
+logger = logging.getLogger(__name__)
+
+#: How many records one `UsageSink.write` call receives at most.
+BATCH_MAX = 500
+#: A failing sink is logged at most this often.
+_COMPLAIN_EVERY_S = 60.0
+
+
+class UsageSink(ABC):
+    """Receives finished records (the envelope of §5.1), in batches, on the
+    writer thread — never on the event loop, so it may block. An exception
+    loses that batch and is logged; the next batch is tried as usual.
+
+    Configured by dotted path (`capacity.sink`), so a subclass must be
+    constructible with no arguments."""
+
+    @abstractmethod
+    def write(self, documents: Sequence[Mapping[str, Any]]) -> None: ...
+
+
+class StdoutSink(UsageSink):
+    """One JSON line per record on stdout (the default, D3 「A」)."""
+
+    def __init__(self, stream: TextIO | None = None) -> None:
+        self._stream = stream
+
+    def write(self, documents: Sequence[Mapping[str, Any]]) -> None:
+        out = self._stream if self._stream is not None else sys.stdout
+        out.write("".join(line(doc) + "\n" for doc in documents))
+        out.flush()
+
+
+class UsageWriter:
+    """The bounded queue and the one thread that hands its records to a sink."""
+
+    def __init__(self, sink: UsageSink, *, queue_max: int) -> None:
+        self._sink = sink
+        self._queue: queue.Queue[Mapping[str, Any] | None] = queue.Queue(maxsize=queue_max)
+        self._dropped = 0
+        self._lock = threading.Lock()
+        self._last_complaint = 0.0
+        self._thread = threading.Thread(target=self._run, name="usage-writer", daemon=True)
+        self._thread.start()
+
+    def put(self, doc: Mapping[str, Any]) -> bool:
+        """Queue one record; False (and counted) when the queue is full."""
+        try:
+            self._queue.put_nowait(doc)
+        except queue.Full:
+            with self._lock:
+                self._dropped += 1
+            return False
+        return True
+
+    def take_dropped(self) -> int:
+        """How many records were dropped since the last call."""
+        with self._lock:
+            dropped, self._dropped = self._dropped, 0
+        return dropped
+
+    def return_dropped(self, n: int) -> None:
+        """Give back a count `take_dropped` handed out that could not be
+        reported, so the next report includes it."""
+        with self._lock:
+            self._dropped += n
+
+    def close(self, *, timeout_s: float) -> None:
+        """Deliver what is queued, then stop. Bounded: a stuck sink cannot hold
+        a shutdown longer than `timeout_s` all told — waiting for room in the
+        queue and for the thread share it (the thread is a daemon)."""
+        deadline = time.monotonic() + timeout_s
+        try:
+            self._queue.put(None, timeout=timeout_s)
+        except queue.Full:
+            return
+        self._thread.join(max(0.0, deadline - time.monotonic()))
+
+    def _run(self) -> None:
+        while True:
+            first = self._queue.get()
+            if first is None:
+                return
+            batch = [first]
+            stop = False
+            while len(batch) < BATCH_MAX:
+                try:
+                    more = self._queue.get_nowait()
+                except queue.Empty:
+                    break
+                if more is None:
+                    stop = True
+                    break
+                batch.append(more)
+            self._write(batch)
+            if stop:
+                return
+
+    def _write(self, batch: list[Mapping[str, Any]]) -> None:
+        try:
+            self._sink.write(batch)
+        except Exception:
+            now = time.monotonic()
+            if now - self._last_complaint >= _COMPLAIN_EVERY_S:
+                self._last_complaint = now
+                logger.warning("usage: the sink failed; %d records lost", len(batch), exc_info=True)
