+
+    def counted(source: str) -> np.ndarray:
+        walked.append(source)
+        return real(source)
+
+    a.obs._days_with = counted
+    a.readiness()
+    a.summary()
+    a.whatif(50)
+
+    assert len(walked) == len(set(walked))
+
+
+def test_coverage_counts_the_slots_the_gaps_do_not():
+    """A source's coverage and its gaps are one question: a slot with a sample
+    is covered and no gap. An idle GPU (utilisation 0, the model still in its
+    memory) was a gap-free slot that coverage called missing."""
+    w = _world()
+
+    class Idle(WorldGpus):
+        def usage(self, start_ms, end_ms, step_s):  # noqa: ANN001, ANN201
+            return [
+                GpuSample(s.t_ms, s.card, s.model, 0.0, s.memory_bytes)
+                for s in super().usage(start_ms, end_ms, step_s)
+            ]
+
+    sources = CapacitySources(WorldRecords(w), WorldPods(w), Idle(w), WorldLlm(w))
+    s = analyse(
+        observe(sources, Period(w.start_ms, w.end_ms, w.step_s, ZoneInfo(w.tz))), now_ms=w.end_ms
+    ).summary()
+
+    assert s["confidence"]["gaps"]["gpu_metrics"] == []
+    assert s["confidence"]["coverage"]["gpu_metrics"] == 1.0
+
+
+def test_no_headroom_is_served_while_the_what_if_cannot_say():
+    """View 1 states the headroom as view 6 does (§9.10). With too few people
+    the headline said it could not tell, while the rows under it drew people
+    per line and the line that binds first — and the runway dated an order
+    by them."""
+    w = World(days=20, users=6)
+    sources = CapacitySources(WorldRecords(w), WorldPods(w), WorldGpus(w), WorldLlm(w))
+    s = analyse(
+        observe(sources, Period(w.start_ms, w.end_ms, w.step_s, ZoneInfo(w.tz))), now_ms=w.end_ms
+    ).summary()
+
+    assert s["readiness"]["whatif"]["reason"] == "too_few_people"
+    assert s["headroom"] is None
+    assert s["runway"]["reach"] is None
+
+
+def test_no_knee_is_used_before_the_thresholds_view_can_show_it():
+    """Four days in, view 8 says it needs seven; the overview still called a
+    knee from those four days the API's measured threshold, and a model's
+    capacity."""
+    s = _analysis(days=4).summary()
+    lines = {line["id"]: line for line in s["lines"]}
+
+    assert s["readiness"]["thresholds"]["reason"] == "period_too_short"
+    assert lines["api.cpu"]["threshold_source"] == "default"
+    assert lines["gpu.qwen3"]["capacity"] is None
+
+
+def test_the_kept_columns_say_what_the_records_said():
+    """The pairs and a person's detail read turn and job records through five
+    kept columns. Parity with the records themselves, read as the dicts they
+    were: every wait in the same slot, and the same counts."""
+    from workspace_app.capacity.analysis.thresholds import _events
+
+    w = World(days=10, users=12)
+    p = Period(w.start_ms, w.end_ms, w.step_s, ZoneInfo(w.tz))
+    sources = CapacitySources(WorldRecords(w), WorldPods(w), WorldGpus(w), WorldLlm(w))
+    obs = observe(sources, p)
+    a = analyse(obs, now_ms=w.end_ms)
+    turns = list(WorldRecords(w).records("turn", p.start_ms, p.end_ms))
+    jobs = list(WorldRecords(w).records("job", p.start_ms, p.end_ms))
+
+    def waits(rows, at: str, since: str, until: str) -> list[tuple[int, float]]:  # noqa: ANN001
+        out = []
+        for r in rows:
+            if r.get(since) is None or r.get(until) is None:
+                continue
+            slot = p.index(int(r[at]))
+            if slot is not None:
+                out.append((slot, (int(r[until]) - int(r[since])) / 1000))
+        return sorted(out)
+
+    model = np.array([obs.turns.names[i] == w.gpu_model for i in obs.turns.label])
+    index = np.array([obs.jobs.names[i] == "index" for i in obs.jobs.label])
+    turn_waits = waits(turns, "accepted_ms", "accepted_ms", "first_output_ms")
+    assert turn_waits and sorted(_events(p, obs.turns)) == turn_waits
+    assert sorted(_events(p, obs.turns, model)) == waits(
+        [t for t in turns if t.get("model") == w.gpu_model],
+        "accepted_ms",
+        "accepted_ms",
+        "first_output_ms",
+    )
+    job_waits = waits(
+        [j for j in jobs if j.get("jobtype") == "index"], "started_ms", "enqueued_ms", "started_ms"
+    )
+    assert job_waits and sorted(_events(p, obs.jobs, index)) == job_waits
+
+    person = a.person("user01")
+    assert person is not None
+    items: dict[str, int] = {}
+    for t in turns:
+        if t.get("user") == "user01":
+            items[str(t.get("item", ""))] = items.get(str(t.get("item", "")), 0) + 1
+    assert person["turns"] == sum(1 for t in turns if t.get("user") == "user01") > 0
+    assert person["jobs"] == sum(1 for j in jobs if j.get("user") == "user01") > 0
+    assert {i["id"]: i["turns"] for i in person["items"] if "turns" in i} == items
diff --git a/tests/capacity/test_cgroup_usage.py b/tests/capacity/test_cgroup_usage.py
new file mode 100644
index 00000000..31ec5a62
--- /dev/null
+++ b/tests/capacity/test_cgroup_usage.py
@@ -0,0 +1,189 @@
+"""A sandbox's measured use (docs/plan-capacity-usage.md §5.2 `sandbox`, §6.5):
+read from its cgroup, integrated between samples, and split across the
+windows each interval spans — on a fake cgroup tree, the same plain files the
+kernel serves."""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+from workspace_app.capacity.cgroup_usage import Target, UsageSampler, read_cgroup
+
+W0 = 1_760_501_100.0  # a multiple of 300 s
+
+
+def _cgroup(
+    root: Path,
+    name: str,
+    *,
+    cpu_us: int,
+    mem: int,
+    periods: int = 0,
+    throttled_n: int = 0,
+    throttled_us: int = 0,
+    oom: int = 0,
+    cpu_psi_us: int | None = 0,
+    mem_psi_us: int | None = 0,
+    cpu_max: str = "100000 100000",
+    mem_max: str = "536870912",
+) -> Path:
+    cg = root / name
+    cg.mkdir(parents=True, exist_ok=True)
+    (cg / "cpu.stat").write_text(
+        f"usage_usec {cpu_us}\nuser_usec 0\nsystem_usec 0\n"
+        f"nr_periods {periods}\nnr_throttled {throttled_n}\nthrottled_usec {throttled_us}\n"
+    )
+    (cg / "memory.current").write_text(f"{mem}\n")
+    (cg / "memory.events").write_text(f"low 0\nhigh 0\nmax 0\noom 0\noom_kill {oom}\n")
+    for name_, total in (("cpu.pressure", cpu_psi_us), ("memory.pressure", mem_psi_us)):
+        path = cg / name_
+        if total is None:
+            path.unlink(missing_ok=True)
+        else:
+            path.write_text(
+                f"some avg10=0.00 avg60=0.00 avg300=0.00 total={total}\n"
+                "full avg10=0.00 avg60=0.00 avg300=0.00 total=0\n"
+            )
+    (cg / "cpu.max").write_text(f"{cpu_max}\n")
+    (cg / "memory.max").write_text(f"{mem_max}\n")
+    return cg
+
+
+def test_a_cgroup_reads_as_the_kernel_writes_it(tmp_path):
+    cg = _cgroup(
+        tmp_path,
+        "s1",
+        cpu_us=2_500_000,
+        mem=1024,
+        periods=10,
+        throttled_n=3,
+        throttled_us=400_000,
+        oom=1,
+        cpu_psi_us=7_000,
+        cpu_max="50000 100000",
+        mem_max="max",
+    )
+
+    r = read_cgroup(cg, 5.0)
+
+    assert r is not None
+    assert (r.cpu_us, r.periods, r.throttled_n, r.throttled_us) == (2_500_000, 10, 3, 400_000)
+    assert (r.mem_bytes, r.oom_kills, r.cpu_psi_us) == (1024, 1, 7_000)
+    assert r.cpu_limit == 0.5
+    assert r.mem_limit is None, "max is no limit"
+
+
+def test_a_cgroup_that_is_gone_reads_as_nothing(tmp_path):
+    assert read_cgroup(tmp_path / "reaped", 0.0) is None
+
+
+def test_a_kernel_without_psi_reads_as_unknown_not_zero(tmp_path):
+    cg = _cgroup(tmp_path, "s1", cpu_us=0, mem=0, cpu_psi_us=None, mem_psi_us=None)
+
+    r = read_cgroup(cg, 0.0)
+
+    assert r is not None and r.cpu_psi_us is None and r.mem_psi_us is None
+
+
+class _Clock:
+    def __init__(self, t: float) -> None:
+        self.t = t
+
+    def __call__(self) -> float:
+        return self.t
+
+
+def _sampler(tmp_path: Path, clock: _Clock, targets: list[Target], out: list[dict]) -> UsageSampler:
+    host = tmp_path / "host-pressure"
+    host.mkdir(exist_ok=True)
+    for name in ("cpu", "memory"):
+        (host / name).write_text("some avg10=0.00 avg60=0.00 avg300=0.00 total=0\n")
+    return UsageSampler(
+        tmp_path / "cg",
+        window_s=300,
+        pod="sh-1",
+        component="sandbox-host",
+        targets=lambda: list(targets),
+        write=out.extend,
+        clock=clock,
+        host_pressure=host,
+    )
+
+
+def _rows(out: list[dict], kind: str = "sandbox") -> list[dict]:
+    return [d["usage"] | {"@": d["@timestamp"][11:16]} for d in out if d["usage"]["kind"] == kind]
+
+
+def test_use_between_samples_is_split_across_the_windows_it_spans(tmp_path):
+    clock, out = _Clock(W0 + 240), []
+    target = Target(sandbox="s1", item="i1", user="alice", app="pm")
+    root = tmp_path / "cg"
+    _cgroup(root, "s1", cpu_us=0, mem=100)
+    sampler = _sampler(tmp_path, clock, [target], out)
+    sampler.sample()  # 04:09:00 — the first pass is a baseline
+    _cgroup(root, "s1", cpu_us=120_000_000, mem=300, throttled_us=6_000_000, cpu_psi_us=60_000)
+    clock.t = W0 + 360  # 04:11:00, one minute into the next window
+    sampler.sample()
+    clock.t = W0 + 600  # 04:15:00 — the second window has closed
+    sampler.sample()
+    sampler.close()
+
+    rows = {r["@"]: r for r in _rows(out)}
+    # 120 s of CPU over 120 s, 60 s in each window.
+    assert rows["04:05"]["cpu_s"] == 60.0 and rows["04:10"]["cpu_s"] == 60.0
+    assert rows["04:05"]["thr_s"] == 3.0
+    assert rows["04:05"]["cpu_psi_s"] == 0.03
+    # Memory rises 100 → 300 over the interval: trapezoids of each half.
+    assert rows["04:05"]["mem_bs"] == 60 * 150
+    assert rows["04:05"]["mem_max"] == 200
+    assert (rows["04:05"]["user"], rows["04:05"]["app"], rows["04:05"]["item"]) == (
+        "alice",
+        "pm",
+        "i1",
+    )
+    assert rows["04:05"]["cpu_limit"] == 1.0
+    assert rows["04:05"]["window_s"] == 300
+    hosts = {r["@"]: r for r in _rows(out, "sandbox_host")}
+    assert hosts["04:05"]["live_s"] == 60.0
+
+
+def test_a_counter_that_went_backwards_is_a_new_cgroup_counted_from_zero(tmp_path):
+    clock, out = _Clock(W0 + 60), []
+    root = tmp_path / "cg"
+    _cgroup(root, "s1", cpu_us=500_000_000, mem=0)
+    sampler = _sampler(tmp_path, clock, [Target("s1", "i1", "alice", "pm")], out)
+    sampler.sample()
+    _cgroup(root, "s1", cpu_us=2_000_000, mem=0)  # recreated: 2 s since
+    clock.t = W0 + 120
+    sampler.sample()
+    sampler.close()
+
+    assert [r["cpu_s"] for r in _rows(out)] == [2.0]
+
+
+def test_a_sandbox_born_after_the_first_pass_is_counted_from_zero(tmp_path):
+    clock, out = _Clock(W0 + 60), []
+    targets: list[Target] = []
+    root = tmp_path / "cg"
+    sampler = _sampler(tmp_path, clock, targets, out)
+    sampler.sample()  # nothing running yet
+    _cgroup(root, "s2", cpu_us=30_000_000, mem=0)
+    targets.append(Target("s2", "i2", "bob", ""))
+    clock.t = W0 + 120
+    sampler.sample()
+    sampler.close()
+
+    assert [(r["sandbox"], r["cpu_s"]) for r in _rows(out)] == [("s2", 30.0)]
+
+
+def test_a_sandbox_present_at_the_first_pass_is_only_a_baseline(tmp_path):
+    """The host restarted under running sandboxes: their counters hold hours of
+    use from before, which belong to no window this host saw."""
+    clock, out = _Clock(W0 + 60), []
+    root = tmp_path / "cg"
+    _cgroup(root, "s1", cpu_us=9_000_000_000, mem=0)
+    sampler = _sampler(tmp_path, clock, [Target("s1", "i1", "alice", "pm")], out)
+    sampler.sample()
+    sampler.close()
+
+    assert _rows(out) == []
diff --git a/tests/capacity/test_check.py b/tests/capacity/test_check.py
new file mode 100644
index 00000000..d20bdb86
--- /dev/null
+++ b/tests/capacity/test_check.py
@@ -0,0 +1,275 @@
+"""`python -m workspace_app.capacity check` (docs/plan-capacity-usage.md §8): the
+operator implements the four sources, runs this, and learns what is wrong
+before the dashboard silently draws it wrong."""
+
+from __future__ import annotations
+
+from workspace_app.capacity.check import check_sources, main
+from workspace_app.capacity.sources import (
+    CapacityEntry,
+    CapacitySources,
+    GpuMetricsSource,
+    GpuSample,
+    ResourceMetricsSource,
+    ResourceSample,
+)
+
+from .world import World, WorldGpus, WorldLlm, WorldPods, WorldRecords
+
+
+def _world() -> World:
+    return World(days=2, users=6)
+
+
+def _errors(findings) -> list[str]:  # noqa: ANN001
+    return [f.message for f in findings if f.level == "error"]
+
+
+def test_sources_that_keep_the_contract_have_no_errors():
+    w = _world()
+    sources = CapacitySources(WorldRecords(w), WorldPods(w), WorldGpus(w), WorldLlm(w))
+
+    findings = check_sources(sources, now_ms=w.end_ms, hours=24, step_s=w.step_s)
+
+    assert _errors(findings) == []
+    assert any(f.source == "usage_records" and "rows" in f.message for f in findings)
+
+
+def test_unaligned_buckets_unknown_components_and_impossible_values_are_errors():
+    w = _world()
+
+    class _Wrong(ResourceMetricsSource):
+        def usage(self, start_ms, end_ms, step_s):
+            return [
+                ResourceSample(start_ms + 1234, "api", "api-1", cpu_cores=0.5),
+                ResourceSample(start_ms, "apiserver", "api-2", cpu_cores=0.5),
+                ResourceSample(start_ms, "api", "api-3", cpu_cores=64.0),
+            ]
+
+        def capacity(self):
+            return [CapacityEntry("api", 2.0, None, None, 1, "pod")]
+
+    class _BadGpu(GpuMetricsSource):
+        def usage(self, start_ms, end_ms, step_s):
+            return [GpuSample(start_ms, "gpu0", "qwen3", 87.0, 1.0)]
+
+        def cards(self):
+            return []
+
+    findings = check_sources(
+        CapacitySources(resource_metrics=_Wrong(), gpu_metrics=_BadGpu()),
+        now_ms=w.end_ms,
+        hours=24,
+        step_s=w.step_s,
+    )
+
+    errors = " | ".join(_errors(findings))
+    assert "not aligned" in errors
+    assert "apiserver" in errors
+    assert "more CPU than" in errors
+    assert "util" in errors
+
+
+def test_a_source_that_raises_is_reported_with_its_error():
+    class _Down(ResourceMetricsSource):
+        def usage(self, start_ms, end_ms, step_s):
+            raise ConnectionError("prometheus unreachable")
+
+        def capacity(self):
+            return []
+
+    w = _world()
+    findings = check_sources(
+        CapacitySources(resource_metrics=_Down()), now_ms=w.end_ms, hours=24, step_s=w.step_s
+    )
+
+    assert any("prometheus unreachable" in m for m in _errors(findings))
+    assert any(f.source == "usage_records" and f.level == "info" for f in findings)
+
+
+def test_the_command_exits_non_zero_on_an_error(tmp_path, capsys):
+    cfg = tmp_path / "config.yaml"
+    cfg.write_text(
+        "capacity:\n  resource_metrics: tests.capacity.test_check.Unreachable\n", encoding="utf-8"
+    )
+
+    code = main(["check", "--config", str(cfg), "--hours", "1"])
+
+    assert code == 1
+    assert "prometheus unreachable" in capsys.readouterr().out
+
+
+class Unreachable(ResourceMetricsSource):
+    def usage(self, start_ms, end_ms, step_s):
+        raise ConnectionError("prometheus unreachable")
+
+    def capacity(self):
+        return []
+
+
+def _findings(sources, w: World):  # noqa: ANN001, ANN202
+    return check_sources(sources, now_ms=w.end_ms, hours=24, step_s=w.step_s)
+
+
+def _said(findings, source: str, level: str) -> str:  # noqa: ANN001
+    return " | ".join(f.message for f in findings if f.source == source and f.level == level)
+
+
+def test_an_hour_without_machine_samples_is_reported_as_a_gap():
+    w = _world()
+    hole = (w.end_ms - 6 * 3_600_000, w.end_ms - 5 * 3_600_000)
+
+    class Holed(WorldPods):
+        def usage(self, start_ms, end_ms, step_s):  # noqa: ANN001, ANN201
+            return [
+                s
+                for s in super().usage(start_ms, end_ms, step_s)
+                if not hole[0] <= s.t_ms < hole[1]
+            ]
+
+    findings = _findings(CapacitySources(resource_metrics=Holed(w)), w)
+
+    assert "gap" in _said(findings, "resource_metrics", "warning")
+
+
+def test_card_and_llm_rows_off_the_slot_are_errors():
+    from workspace_app.capacity.sources import LlmLatencyRow, LlmRequestSource, LlmUsageRow
+
+    w = _world()
+
+    class OffGpu(GpuMetricsSource):
+        def usage(self, start_ms, end_ms, step_s):  # noqa: ANN001, ANN201
+            return [GpuSample(start_ms + 1234, "gpu0", "m", 0.5, 1.0)]
+
+        def cards(self):  # noqa: ANN201
+            return []
+
+    class OffLlm(LlmRequestSource):
+        def usage(self, start_ms, end_ms, step_s):  # noqa: ANN001, ANN201
+            return [LlmUsageRow(start_ms + 1234, "m", ("ws", "ws.user:u"), 1, 1, 1, 1.0)]
+
+        def latency(self, start_ms, end_ms, step_s):  # noqa: ANN001, ANN201
+            return [LlmLatencyRow(start_ms + 1234, "m", 1, 0.1, 0.2, 30.0)]
+
+    findings = _findings(CapacitySources(gpu_metrics=OffGpu(), llm_requests=OffLlm()), w)
+
+    assert "not aligned" in _said(findings, "gpu_metrics", "error")
+    assert "not aligned" in _said(findings, "llm_requests", "error")
+
+
+def test_platform_tags_that_do_not_parse_are_reported():
+    from workspace_app.capacity.sources import LlmRequestSource, LlmUsageRow
+
+    w = _world()
+
+    class Garbled(LlmRequestSource):
+        def usage(self, start_ms, end_ms, step_s):  # noqa: ANN001, ANN201
+            return [LlmUsageRow(start_ms, "m", ("ws", "ws.user", "ws.colour:red"), 1, 1, 1, 1.0)]
+
+        def latency(self, start_ms, end_ms, step_s):  # noqa: ANN001, ANN201
+            return []
+
+    findings = _findings(CapacitySources(llm_requests=Garbled()), w)
+
+    assert "malformed" in _said(findings, "llm_requests", "warning")
+
+
+def test_sandbox_rows_are_counted_and_a_window_that_cannot_fit_the_slot_is_an_error():
+    """sandbox-host's window is its own setting: one that neither divides the
+    slot nor is a whole number of slots cannot be placed in the analysis."""
+    from workspace_app.capacity.sources import aggregate_documents
+    from workspace_app.capacity.usage_wire import document
+
+    w = _world()
+    rows = [
+        document(
+            "sandbox",
+            w.end_ms - k * 420_000,
+            pod="sbh",
+            component="sandbox-host",
+            fields={"user": "u", "app": "", "cpu_s": 1.0, "window_s": 420},
+        )
+        for k in range(1, 4)
+    ]
+
+    class Odd(WorldRecords):
+        def aggregate(self, q):  # noqa: ANN001, ANN201
+            return aggregate_documents(rows, q) if q.kind == "sandbox" else super().aggregate(q)
+
+    findings = _findings(CapacitySources(Odd(w)), w)
+
+    assert "420" in _said(findings, "usage_records", "error")
+    assert "3 sandbox rows" in _said(findings, "usage_records", "info")
+
+
+def test_a_kernel_without_pressure_is_reported():
+    w = World(days=2, users=6, psi=False)
+
+    findings = _findings(CapacitySources(WorldRecords(w)), w)
+
+    assert "PSI" in _said(findings, "usage_records", "warning")
+
+
+def test_the_gap_count_is_every_gap_not_the_ones_listed():
+    """Only the five longest gaps are listed; "5 gap(s)" for seven said two
+    of them were not there."""
+    w = _world()
+    holes = [
+        (w.end_ms - (2 * k + 1) * 3_600_000, w.end_ms - 2 * k * 3_600_000 - 1_800_000)
+        for k in range(1, 8)
+    ]
+
+    class Holed(WorldPods):
+        def usage(self, start_ms, end_ms, step_s):  # noqa: ANN001, ANN201
+            return [
+                s
+                for s in super().usage(start_ms, end_ms, step_s)
+                if not any(a <= s.t_ms < b for a, b in holes)
+            ]
+
+    findings = _findings(CapacitySources(resource_metrics=Holed(w)), w)
+
+    assert "7 gap(s)" in _said(findings, "resource_metrics", "warning")
+
+
+def test_turn_models_litellm_never_logged_are_named():
+    """The per-model first-output pair (b) matches a turn's model to the
+    names LiteLLM logs; a deployment whose names never meet has no such pair
+    and nothing said why."""
+    w = _world()
+
+    class Renamed(WorldRecords):
+        def records(self, kind, start_ms, end_ms):  # noqa: ANN001, ANN201
+            rows = super().records(kind, start_ms, end_ms)
+            return [{**r, "model": "gpt-local"} for r in rows] if kind == "turn" else rows
+
+    findings = _findings(CapacitySources(Renamed(w), llm_requests=WorldLlm(w)), w)
+
+    assert "gpt-local" in _said(findings, "llm_requests", "warning")
+
+
+def test_capacity_named_per_job_type_is_capacity_for_the_workers():
+    """② may name the workers' capacity per job type (`worker:index`); the
+    check called that "no capacity for worker"."""
+    w = _world()
+
+    class PerJob(WorldPods):
+        def capacity(self):  # noqa: ANN202
+            whole = [c for c in super().capacity() if c.component != "worker"]
+            return [*whole, CapacityEntry("worker:index", 4.0, 8e9, None, 1, "pod 4 cores")]
+
+    findings = _findings(CapacitySources(resource_metrics=PerJob(w)), w)
+
+    assert "no capacity for worker" not in _said(findings, "resource_metrics", "warning")
+
+
+def test_a_capacity_entry_for_no_component_is_an_error():
+    w = _world()
+
+    class Typo(WorldPods):
+        def capacity(self):  # noqa: ANN202
+            return [*super().capacity(), CapacityEntry("wroker:index", 4.0, 8e9, None, 1, "pod")]
+
+    findings = _findings(CapacitySources(resource_metrics=Typo(w)), w)
+
+    assert "wroker:index" in _said(findings, "resource_metrics", "error")
