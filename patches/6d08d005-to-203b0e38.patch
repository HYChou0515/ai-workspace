+"""`capacity:` (docs/plan-capacity-usage.md §12): whitelisted AND built, so a
+key the operator writes reaches `Settings` (a key that parses and goes nowhere
+is the dead-knob class), and a value that cannot work refuses to boot with the
+key named."""
+
+from __future__ import annotations
+
+import re
+from pathlib import Path
+
+import pytest
+
+from workspace_app.config.loader import load
+
+
+def _load(tmp_path: Path, body: str):
+    cfg = tmp_path / "config.yaml"
+    cfg.write_text(body, encoding="utf-8")
+    return load(config_path=cfg, env={})
+
+
+def test_defaults_record_and_read_nothing_until_a_source_is_named(tmp_path: Path):
+    c = load(config_path=tmp_path / "missing.yaml", env={}).capacity
+
+    assert c.record is True
+    assert c.sink == ""
+    assert c.window_s == 300
+    assert c.step_s == 300
+    assert c.llm_tags is True
+    assert (c.usage_records, c.resource_metrics, c.gpu_metrics, c.llm_requests) == ("", "", "", "")
+
+
+def test_every_key_the_operator_writes_reaches_settings(tmp_path: Path):
+    c = _load(
+        tmp_path,
+        "capacity:\n"
+        "  record: false\n"
+        "  sink: my.mod.Sink\n"
+        "  window_s: 60\n"
+        "  queue_max: 50\n"
+        "  llm_tags: false\n"
+        "  usage_records: my.mod.Records\n"
+        "  resource_metrics: my.mod.Pods\n"
+        "  gpu_metrics: my.mod.Gpus\n"
+        "  llm_requests: my.mod.Llm\n"
+        "  step_s: 120\n"
+        "  lag_s: 30\n"
+        "  timezone: Asia/Taipei\n"
+        "  max_rows: 10\n",
+    ).capacity
+
+    assert c.record is False
+    assert c.sink == "my.mod.Sink"
+    assert c.window_s == 60
+    assert c.queue_max == 50
+    assert c.llm_tags is False
+    assert (c.usage_records, c.resource_metrics, c.gpu_metrics, c.llm_requests) == (
+        "my.mod.Records",
+        "my.mod.Pods",
+        "my.mod.Gpus",
+        "my.mod.Llm",
+    )
+    assert c.step_s == 120
+    assert c.lag_s == 30
+    assert c.timezone == "Asia/Taipei"
+    assert c.max_rows == 10
+
+
+def test_an_unknown_key_refuses_to_boot(tmp_path: Path):
+    with pytest.raises(ValueError, match="capacity"):
+        _load(tmp_path, "capacity:\n  windw_s: 60\n")
+
+
+@pytest.mark.parametrize(
+    ("body", "sentence"),
+    [
+        ("window_s: 7", "capacity.window_s must divide 3600"),
+        ("window_s: 0", "capacity.window_s must divide 3600"),
+        ("step_s: 450", "capacity.step_s must be a multiple of capacity.window_s"),
+        ("window_s: 60\n  step_s: 420", "capacity.step_s must divide a day"),
+        ("timezone: Mars/Olympus", "capacity.timezone"),
+        ("queue_max: 0", "capacity.queue_max must be a positive integer"),
+        ("max_rows: -1", "capacity.max_rows must be a positive integer"),
+        ("lag_s: -5", "capacity.lag_s must be 0 or more"),
+    ],
+)
+def test_a_value_that_cannot_work_refuses_to_boot(tmp_path: Path, body: str, sentence: str):
+    with pytest.raises(ValueError, match=re.escape(sentence)):
+        _load(tmp_path, f"capacity:\n  {body}\n")
+
+
+def test_every_capacity_key_is_named_in_the_manual():
+    """A knob nothing documents is never set (the sibling of
+    tests/config/test_server_settings_are_documented.py)."""
+    import dataclasses
+
+    from workspace_app.config.schema import CapacitySettings
+
+    manual = (Path(__file__).resolve().parents[2] / "docs" / "configuration.md").read_text("utf-8")
+
+    missing = [
+        f.name for f in dataclasses.fields(CapacitySettings) if f"capacity.{f.name}" not in manual
+    ]
+    assert missing == []
+
+
+def test_the_recorder_is_built_from_every_writing_key(tmp_path: Path):
+    from workspace_app.factories import build_usage_recorder
+
+    c = _load(tmp_path, "capacity:\n  window_s: 60\n  queue_max: 7\n  llm_tags: false\n").capacity
+    rec = build_usage_recorder(c, component="api")
+    try:
+        assert rec is not None
+        assert (rec.window_s, rec.llm_tags, rec.component) == (60, False, "api")
+        assert rec._writer._queue.maxsize == 7  # noqa: SLF001
+    finally:
+        assert rec is not None
+        rec.close()
diff --git a/tests/capacity/test_sink.py b/tests/capacity/test_sink.py
new file mode 100644
index 00000000..530c4dea
--- /dev/null
+++ b/tests/capacity/test_sink.py
@@ -0,0 +1,121 @@
+"""Where usage records go (plan §5, §6.7): a sink the deploy may replace, fed
+by a writer thread through a bounded queue, so a slow stdout never stalls a
+request and a full queue loses rows visibly instead of growing memory."""
+
+import io
+import json
+import threading
+import time
+
+from workspace_app.capacity.sink import StdoutSink, UsageSink, UsageWriter
+from workspace_app.capacity.usage_wire import document
+
+
+class _ListSink(UsageSink):
+    def __init__(self) -> None:
+        self.docs: list[dict] = []
+
+    def write(self, documents):
+        self.docs.extend(documents)
+
+
+def _doc(n: int) -> dict:
+    return document("work", 0, pod="p", component="api", fields={"count": n})
+
+
+def test_the_default_sink_writes_one_json_line_per_record():
+    out = io.StringIO()
+
+    StdoutSink(stream=out).write([_doc(1), _doc(2)])
+
+    lines = out.getvalue().splitlines()
+    assert [json.loads(x)["usage"]["count"] for x in lines] == [1, 2]
+
+
+def test_the_default_sink_needs_no_arguments_so_config_can_name_it():
+    """`capacity.sink` is loaded by dotted path with a zero-argument constructor."""
+    assert isinstance(StdoutSink(), UsageSink)
+
+
+def test_records_reach_the_sink_and_close_delivers_what_was_queued():
+    sink = _ListSink()
+    writer = UsageWriter(sink, queue_max=100)
+
+    for n in range(5):
+        assert writer.put(_doc(n))
+    writer.close(timeout_s=5)
+
+    assert [d["usage"]["count"] for d in sink.docs] == [0, 1, 2, 3, 4]
+
+
+def test_a_full_queue_drops_and_counts_and_never_waits():
+    release = threading.Event()
+
+    class _Stuck(UsageSink):
+        def write(self, documents):
+            release.wait(5)
+
+    writer = UsageWriter(_Stuck(), queue_max=3)
+    started = time.monotonic()
+    accepted = [writer.put(_doc(n)) for n in range(50)]
+    elapsed = time.monotonic() - started
+
+    # The writer thread may have taken one off the queue before sticking.
+    assert accepted.count(True) in (3, 4)
+    assert writer.take_dropped() == accepted.count(False)
+    assert writer.take_dropped() == 0, "taking the count resets it"
+    assert elapsed < 2, "put must not wait on a stuck sink (a hang guard, not a speed claim)"
+    release.set()
+    writer.close(timeout_s=5)
+
+
+def test_a_sink_that_raises_loses_that_batch_and_keeps_writing():
+    class _Flaky(UsageSink):
+        def __init__(self) -> None:
+            self.calls = 0
+            self.docs: list[dict] = []
+
+        def write(self, documents):
+            self.calls += 1
+            if self.calls == 1:
+                raise OSError("pipe closed")
+            self.docs.extend(documents)
+
+    sink = _Flaky()
+    writer = UsageWriter(sink, queue_max=10)
+    writer.put(_doc(1))
+    deadline = time.monotonic() + 5
+    while sink.calls == 0 and time.monotonic() < deadline:
+        time.sleep(0.01)
+    writer.put(_doc(2))
+    writer.close(timeout_s=5)
+
+    assert [d["usage"]["count"] for d in sink.docs] == [2]
+
+
+def test_closing_takes_no_longer_than_its_bound_even_when_room_comes_late():
+    """The bound is the whole close: room in the queue arriving just before it
+    ends must not buy the join a second bound (shutdown counts on it)."""
+    first, stuck = threading.Event(), threading.Event()
+    calls: list[int] = []
+
+    class _Slow(UsageSink):
+        def write(self, documents):
+            calls.append(len(documents))
+            (first if len(calls) == 1 else stuck).wait(10)
+
+    writer = UsageWriter(_Slow(), queue_max=1)
+    writer.put(_doc(1))
+    deadline = time.monotonic() + 2
+    while not calls and time.monotonic() < deadline:  # the thread holds the first record
+        time.sleep(0.01)
+    writer.put(_doc(2))  # the queue is full now
+    threading.Timer(0.45, first.set).start()  # room comes just before the bound
+    try:
+        started = time.monotonic()
+        writer.close(timeout_s=0.6)
+        elapsed = time.monotonic() - started
+    finally:
+        stuck.set()
+
+    assert elapsed < 0.85
diff --git a/tests/capacity/test_sources.py b/tests/capacity/test_sources.py
new file mode 100644
index 00000000..46a9942b
--- /dev/null
+++ b/tests/capacity/test_sources.py
@@ -0,0 +1,140 @@
+"""The four sources (docs/plan-capacity-usage.md §8): the reference meaning of ①
+`aggregate` over records as the sink writes them, and each source loaded by the
+dotted path `capacity:` names — refused at boot when it is not one."""
+
+from __future__ import annotations
+
+import pytest
+
+from workspace_app.capacity.sources import (
+    AggregateQuery,
+    CapacitySources,
+    GpuMetricsSource,
+    LlmRequestSource,
+    ResourceMetricsSource,
+    UsageRecordSource,
+    aggregate_documents,
+)
+from workspace_app.capacity.usage_wire import document
+from workspace_app.config.schema import CapacitySettings
+from workspace_app.factories import get_capacity_sources
+
+T0 = 1_760_501_100_000
+
+
+def _work(at_ms: int, user: str, work: str, count: int, seconds: float, **more) -> dict:
+    fields = {"user": user, "app": "pm", "work": work, "count": count, "seconds": seconds}
+    return document("work", at_ms, pod="api-1", component="api", fields=fields | more)
+
+
+DOCS = [
+    _work(T0, "alice", "req:GET /a", 2, 0.5, h1=2),
+    _work(T0, "alice", "req:GET /a", 1, 0.25),  # another pod's window, same bucket
+    _work(T0 + 60_000, "bob", "req:GET /a", 4, 1.0, h1=3, h9=1),
+    _work(T0 + 300_000, "alice", "turn:chat", 1, 120.0),
+    document("turn", T0, pod="api-1", component="api", fields={"user": "alice"}),
+]
+
+
+def test_sums_are_grouped_by_the_named_fields_and_by_bucket():
+    q = AggregateQuery(
+        kind="work",
+        start_ms=T0,
+        end_ms=T0 + 600_000,
+        step_s=300,
+        group_by=("user", "work"),
+        sums=("count", "seconds", "h1"),
+    )
+
+    rows = {
+        (r.t_ms, r.keys["user"], r.keys["work"]): r.values for r in aggregate_documents(DOCS, q)
+    }
+
+    assert rows[(T0, "alice", "req:GET /a")] == {"count": 3.0, "seconds": 0.75, "h1": 2.0}
+    assert rows[(T0, "bob", "req:GET /a")] == {"count": 4.0, "seconds": 1.0, "h1": 3.0}
+    assert rows[(T0 + 300_000, "alice", "turn:chat")]["seconds"] == 120.0
+    assert len(rows) == 3, "the turn record is another kind"
+
+
+def test_a_filter_and_one_bucket_for_the_whole_range():
+    q = AggregateQuery(
+        kind="work",
+        start_ms=T0,
+        end_ms=T0 + 300_000,
+        step_s=None,
+        group_by=("work",),
+        sums=("count",),
+        maxes=("seconds",),
+        where={"user": "alice"},
+    )
+
+    (row,) = aggregate_documents(DOCS, q)
+
+    assert row.t_ms is None
+    assert row.values == {"count": 3.0, "seconds": 0.5}, "the larger of 0.5 and 0.25"
+
+
+def test_the_range_is_half_open():
+    q = AggregateQuery(
+        kind="work", start_ms=T0 + 60_000, end_ms=T0 + 300_000, step_s=60, group_by=("user",)
+    )
+
+    assert [r.keys["user"] for r in aggregate_documents(DOCS, q)] == ["bob"]
+
+
+class Records(UsageRecordSource):
+    def aggregate(self, q):
+        return []
+
+    def records(self, kind, start_ms, end_ms):
+        return []
+
+
+class Pods(ResourceMetricsSource):
+    def usage(self, start_ms, end_ms, step_s):
+        return []
+
+    def capacity(self):
+        return []
+
+
+class Gpus(GpuMetricsSource):
+    def usage(self, start_ms, end_ms, step_s):
+        return []
+
+    def cards(self):
+        return []
+
+
+class Llm(LlmRequestSource):
+    def usage(self, start_ms, end_ms, step_s):
+        return []
+
+    def latency(self, start_ms, end_ms, step_s):
+        return []
+
+
+def test_nothing_named_nothing_connected():
+    assert get_capacity_sources(CapacitySettings()) == CapacitySources()
+
+
+def test_each_named_source_is_built():
+    here = "tests.capacity.test_sources"
+    sources = get_capacity_sources(
+        CapacitySettings(
+            usage_records=f"{here}.Records",
+            resource_metrics=f"{here}.Pods",
+            gpu_metrics=f"{here}.Gpus",
+            llm_requests=f"{here}.Llm",
+        )
+    )
+
+    assert isinstance(sources.usage_records, Records)
+    assert isinstance(sources.resource_metrics, Pods)
+    assert isinstance(sources.gpu_metrics, Gpus)
+    assert isinstance(sources.llm_requests, Llm)
+
+
+def test_a_source_of_the_wrong_kind_refuses_to_boot_naming_its_key():
+    with pytest.raises(TypeError, match="capacity.gpu_metrics"):
+        get_capacity_sources(CapacitySettings(gpu_metrics="tests.capacity.test_sources.Pods"))
diff --git a/tests/capacity/test_turn_surfaces.py b/tests/capacity/test_turn_surfaces.py
new file mode 100644
index 00000000..cdee409a
--- /dev/null
+++ b/tests/capacity/test_turn_surfaces.py
@@ -0,0 +1,134 @@
+"""Each surface tells the turn engine what it is and when its message was
+accepted (docs/plan-capacity-usage.md §6.3), through its real route: an app
+chat send, a KB chat send. `accepted_ms` is the persisted question's own
+timestamp — the acceptance — not the moment the turn was queued."""
+
+from __future__ import annotations
+
+import asyncio
+import time
+
+from httpx import ASGITransport
+
+from workspace_app.api import MessageDelta, RunDone, ScriptedAgentRunner, create_app
+from workspace_app.capacity.recorder import UsageRecorder
+from workspace_app.capacity.sink import UsageSink
+from workspace_app.filestore.memory import MemoryFileStore
+from workspace_app.kb.chunker import FixedTokenChunker
+from workspace_app.kb.embedder import HashEmbedder
+from workspace_app.resources import make_spec
+from workspace_app.resources.kb import EMBED_DIM
+from workspace_app.sandbox.mock import MockSandbox
+
+from ..api._client import AsyncClient
+from ..api.conftest import register_rca_item
+
+
+class _ListSink(UsageSink):
+    def __init__(self) -> None:
+        self.docs: list[dict] = []
+
+    def write(self, documents):
+        self.docs.extend(documents)
+
+
+def _setup():
+    sink = _ListSink()
+    recorder = UsageRecorder(sink, component="api", pod="api-1", window_s=300, queue_max=1000)
+    spec = make_spec(default_user="alice")
+    app = create_app(
+        spec=spec,
+        sandbox=MockSandbox(),
+        filestore=MemoryFileStore(),
+        runner=ScriptedAgentRunner([MessageDelta(text="hi"), RunDone()]),
+        get_user_id=lambda: "alice",
+        kb_embedder=HashEmbedder(dim=EMBED_DIM),
+        kb_chunker=FixedTokenChunker(max_tokens=3, overlap_tokens=1),
+        usage_recorder=recorder,
+    )
+    return app, spec, sink, recorder
+
+
+async def _turn(sink: _ListSink, recorder: UsageRecorder) -> dict:
+    deadline = time.monotonic() + 10
+    while time.monotonic() < deadline:
+        recorder.flush()
+        turns = [d["usage"] for d in sink.docs if d["usage"]["kind"] == "turn"]
+        if turns:
+            return turns[0]
+        await asyncio.sleep(0.05)
+    raise AssertionError("no turn was recorded")
+
+
+async def test_an_app_chat_turn_is_recorded_as_chat_from_its_persisted_question():
+    app, spec, sink, recorder = _setup()
+    iid = register_rca_item(spec)
+    async with AsyncClient(transport=ASGITransport(app=app), base_url="http://t") as c:
+        chat = (await c.post(f"/a/rca/items/{iid}/chats", json={"title": "c"})).json()["chat_id"]
+        r = await c.post(f"/a/rca/items/{iid}/chats/{chat}/messages", json={"content": "go"})
+        assert r.status_code in (200, 202), r.text
+        turn = await _turn(sink, recorder)
+    _rid, conv = app.state.chat_send._locator.require_chat("rca", iid, chat)  # noqa: SLF001
+
+    question = next(m for m in conv.messages if m.role == "user")
+    assert (turn["surface"], turn["user"], turn["app"], turn["item"]) == (
+        "chat",
+        "alice",
+        "rca",
+        iid,
+    )
+    assert turn["accepted_ms"] == question.created_at
+    assert turn["outcome"] == "done"
+
+
+async def test_a_kb_chat_turn_is_recorded_as_kb_from_its_persisted_question():
+    app, _spec, sink, recorder = _setup()
+    async with AsyncClient(transport=ASGITransport(app=app), base_url="http://t") as c:
+        cid = (await c.post("/kb/chats", json={"title": "t", "collection_ids": []})).json()[
+            "resource_id"
+        ]
+        r = await c.post(f"/kb/chats/{cid}/messages", json={"content": "why?"})
+        assert r.status_code in (200, 202), r.text
+        turn = await _turn(sink, recorder)
+        msgs = (await c.get(f"/kb/chats/{cid}")).json()["messages"]
+
+    question = next(m for m in msgs if m["role"] == "user")
+    assert turn["surface"] == "kb"
+    assert turn["accepted_ms"] == question["created_at"]
+
+
+async def test_a_workflow_step_turn_is_recorded_as_workflow(monkeypatch):
+    """Through `WorkflowExecutor.drive_turn`, the door every workflow step's turn
+    takes (captured from `create_app` as `test_cov_fill_r2_workflow_exec` does)."""
+    import workspace_app.api.app as app_mod
+    from workspace_app.apps.playground.model import PlaygroundItem
+    from workspace_app.filestore.specstar_impl import SpecstarFileStore
+
+    sink = _ListSink()
+    recorder = UsageRecorder(sink, component="api", pod="api-1", window_s=300, queue_max=1000)
+    spec = make_spec()
+    captured: dict[str, object] = {}
+    real = app_mod.WorkflowExecutor
+
+    def _capture(**kw):
+        captured["ex"] = ex = real(**kw)
+        return ex
+
+    monkeypatch.setattr(app_mod, "WorkflowExecutor", _capture)
+    create_app(
+        spec=spec,
+        sandbox=MockSandbox(),
+        filestore=SpecstarFileStore(spec),
+        runner=ScriptedAgentRunner([MessageDelta(text="ok"), RunDone()]),
+        usage_recorder=recorder,
+    )
+    item_id = (
+        spec.get_resource_manager(PlaygroundItem)
+        .create(PlaygroundItem(title="t", owner="u", profile="echo"))
+        .resource_id
+    )
+
+    await captured["ex"].drive_turn(item_id, "no-such-chat", "u", "hello", None)  # ty: ignore[unresolved-attribute]
+    turn = await _turn(sink, recorder)
+
+    assert (turn["surface"], turn["item"]) == ("workflow", item_id)
diff --git a/tests/capacity/test_turns.py b/tests/capacity/test_turns.py
new file mode 100644
index 00000000..45160987
--- /dev/null
+++ b/tests/capacity/test_turns.py
@@ -0,0 +1,190 @@
+"""Turns on the usage record (docs/plan-capacity-usage.md §5.2 `turn`, §6.3):
+when a message was accepted, when its turn started, when the first event and
+the first output went out, and how it ended — through the engine's own
+`enqueue`, the one door every surface uses."""
+
+from __future__ import annotations
+
+import asyncio
+import time
+
+import pytest
+
+from workspace_app.agent import AgentToolContext
+from workspace_app.api import MessageDelta, RunDone
+from workspace_app.api.events import AgentMetrics, ToolStart
+from workspace_app.api.turns import ChatTurnEngine
+from workspace_app.capacity.recorder import UsageRecorder
+from workspace_app.capacity.scope import UsageScope, current
+from workspace_app.capacity.sink import UsageSink
+
+
+class _ListSink(UsageSink):
+    def __init__(self) -> None:
+        self.docs: list[dict] = []
+
+    def write(self, documents):
+        self.docs.extend(documents)
+
+
+def _recorder(sink: _ListSink) -> UsageRecorder:
+    return UsageRecorder(sink, component="api", pod="api-1", window_s=300, queue_max=1000)
+
+
+class _Runner:
+    """A metrics event first (what the real runner emits before the model
+    answers), a pause, then output — so first event and first output differ."""
+
+    def __init__(self, *, fail: bool = False, block: asyncio.Event | None = None) -> None:
+        self.fail = fail
+        self.block = block
+        self.scopes: list[UsageScope | None] = []
+
+    async def run(self, content, ctx):  # noqa: ANN001, ANN201
+        self.scopes.append(current())
+        yield AgentMetrics(phase="up")
+        await asyncio.sleep(0.1)
+        if self.block is not None:
+            await self.block.wait()
+        if self.fail:
+            raise RuntimeError("model gateway down")
+        yield ToolStart(call_id="c1", name="read_file", args={})
+        yield MessageDelta(text="hello")
+        yield AgentMetrics(
+            phase="final",
+            model="qwen3",
+            measured_prompt_tokens=120,
+            measured_completion_tokens=7,
+        )
+        yield RunDone()
+
+
+def _ctx() -> AgentToolContext:
+    return AgentToolContext(investigation_id="item-1", app_slug="pm", acting_user="alice")
+
+
+def _usage(sink: _ListSink, kind: str) -> list[dict]:
+    return [d["usage"] for d in sink.docs if d["usage"]["kind"] == kind]
+
+
+async def _one_turn(runner: _Runner, **enqueue_kw) -> tuple[_ListSink, ChatTurnEngine]:
+    sink = _ListSink()
+    rec = _recorder(sink)
+    engine = ChatTurnEngine(runner, usage_recorder=rec)  # ty: ignore[invalid-argument-type]
+    fut = engine.enqueue("item-1", "hi", _ctx(), on_complete=lambda _m: None, **enqueue_kw)
+    await asyncio.wait_for(fut, 5)
+    await engine.forget("item-1")
+    rec.close()
+    return sink, engine
+
+
+async def test_a_turn_is_recorded_with_its_moments_in_order():
+    accepted = int(time.time() * 1000) - 2000
+    sink, _ = await _one_turn(_Runner(), surface="chat", accepted_ms=accepted)
+
+    (turn,) = _usage(sink, "turn")
+    assert (turn["user"], turn["app"], turn["item"], turn["surface"], turn["outcome"]) == (
+        "alice",
+        "pm",
+        "item-1",
+        "chat",
+        "done",
+    )
+    assert turn["accepted_ms"] == accepted
+    assert accepted < turn["started_ms"] <= turn["first_event_ms"]
+    assert turn["first_output_ms"] - turn["first_event_ms"] >= 100, "output came after the pause"
+    assert turn["first_output_ms"] <= turn["ended_ms"]
+    assert (turn["model"], turn["prompt_tokens"], turn["completion_tokens"]) == ("qwen3", 120, 7)
+
+
+async def test_the_turn_runs_in_its_own_usage_scope():
+    runner = _Runner()
+
+    await _one_turn(runner, surface="kb")
+
+    assert runner.scopes == [UsageScope(user="alice", app="pm", item="item-1", purpose="kb")]
+
+
+async def test_a_turn_counts_as_work_while_it_runs_and_its_events_are_counted():
+    sink, _ = await _one_turn(_Runner(), surface="workflow")
+
+    work = {r["work"]: r for r in _usage(sink, "work")}
+    assert work["turn:workflow"]["count"] == 1
+    assert work["turn:workflow"]["seconds"] >= 0.1
+    # agent_metrics, tool_start, message_delta, agent_metrics, run_done
+    assert work["turn-events:workflow"]["count"] == 5
+    assert {r["user"] for r in work.values()} == {"alice"}
+
+
+async def test_a_failed_turn_is_recorded_as_an_error_without_output():
+    sink, _ = await _one_turn(_Runner(fail=True))
+
+    (turn,) = _usage(sink, "turn")
+    assert turn["outcome"] == "error"
+    assert turn["surface"] == "chat", "chat is the surface when none is named"
+    assert "first_output_ms" not in turn
+    assert turn["first_event_ms"] <= turn["ended_ms"]
+
+
+async def test_a_stopped_turn_is_recorded_as_cancelled():
+    sink = _ListSink()
+    rec = _recorder(sink)
+    block = asyncio.Event()
+    engine = ChatTurnEngine(_Runner(block=block), usage_recorder=rec)  # ty: ignore[invalid-argument-type]
+    fut = engine.enqueue("item-1", "hi", _ctx(), on_complete=lambda _m: None)
+    await asyncio.sleep(0.3)
+    await engine.cancel_current("item-1")
+    await asyncio.wait_for(fut, 5)
+    await engine.forget("item-1")
+    rec.close()
+
+    (turn,) = _usage(sink, "turn")
+    assert turn["outcome"] == "cancelled"
+
+
+async def test_a_stopped_turn_ends_on_the_record_even_when_the_cancel_comes_twice():
+    """Stop bumps the epoch and cancels the turn; the turn's own epoch watcher,
+    still alive while the turn runs its `finally`, sees the bump and cancels it
+    again — inside the turn-end flush. The turn must still end on the record:
+    left running, it is charged to that person in every window until restart."""
+    sink = _ListSink()
+    rec = _recorder(sink)
+    block = asyncio.Event()
+    engine = ChatTurnEngine(_Runner(block=block), usage_recorder=rec, poll_interval=0.05)  # ty: ignore[invalid-argument-type]
+
+    async def slow_flush() -> None:  # the turn-end durable flush (#492)
+        await asyncio.sleep(0.5)
+
+    fut = engine.enqueue(
+        "item-1", "hi", _ctx(), on_complete=lambda _m: None, on_turn_end=slow_flush
+    )
+    await asyncio.sleep(0.3)
+    await engine.cancel_current("item-1")
+    await asyncio.wait_for(fut, 5)
+    still_running = len(rec._running)  # noqa: SLF001
+    await engine.forget("item-1")
+    rec.close()
+
+    assert still_running == 0
+    (turn,) = _usage(sink, "turn")
+    assert turn["outcome"] == "cancelled"
+
+
+@pytest.mark.parametrize(
+    ("ctx", "user"),
+    [
+        (AgentToolContext(acting_user="alice", usage_user="schedule-binder"), "schedule-binder"),
+        (AgentToolContext(acting_user="alice"), "alice"),
+    ],
+)
+async def test_the_person_is_the_one_tool_usage_counts_for(ctx, user):
+    """The same rule the tool-usage statistics use (`agent.tool_usage.who`): two
+    pages must not disagree about whose turn it was."""
+    sink = _ListSink()
+    rec = _recorder(sink)
+    engine = ChatTurnEngine(_Runner(), usage_recorder=rec)  # ty: ignore[invalid-argument-type]
+    await asyncio.wait_for(engine.enqueue("k", "hi", ctx, on_complete=lambda _m: None), 5)
+    await engine.forget("k")
+    rec.close()
+
+    assert [t["user"] for t in _usage(sink, "turn")] == [user]
diff --git a/tests/capacity/test_usage_wire.py b/tests/capacity/test_usage_wire.py
new file mode 100644
index 00000000..dae775a2
--- /dev/null
+++ b/tests/capacity/test_usage_wire.py
@@ -0,0 +1,66 @@
+"""The usage record's wire format (docs/plan-capacity-usage.md §5.1): one JSON
+object per line, the envelope a collector routes on, and the interval the
+numbers describe in `@timestamp`."""
+
+import json
+
+from workspace_app.capacity.usage_wire import document, line, window_start
+
+
+def test_a_record_is_one_line_of_json_with_the_envelope_the_collector_routes_on():
+    doc = document(
+        "work",
+        1_760_501_100_000,
+        pod="api-7f9c",
+        component="api",
+        fields={"user": "alice", "work": "req:GET /api/x", "count": 3},
+    )
+
+    text = line(doc)
+
+    assert "\n" not in text
+    assert json.loads(text) == {
+        "@timestamp": "2025-10-15T04:05:00.000Z",
+        "event": {"dataset": "workspace.usage"},
+        "usage": {
+            "v": 1,
+            "kind": "work",
+            "pod": "api-7f9c",
+            "component": "api",
+            "user": "alice",
+            "work": "req:GET /api/x",
+            "count": 3,
+        },
+    }
+
+
+def test_milliseconds_survive_into_the_timestamp():
+    doc = document("turn", 1_760_501_100_042, pod="p", component="api", fields={})
+
+    assert doc["@timestamp"] == "2025-10-15T04:05:00.042Z"
+
+
+def test_a_field_the_source_could_not_read_is_left_out_not_written_as_null():
+    """A kernel without PSI has no pressure files: the row must not claim 0
+    (no pressure) or carry a null an ES mapping would have to accept."""
+    doc = document(
+        "sandbox", 0, pod="p", component="sandbox-host", fields={"cpu_s": 1.5, "cpu_psi_s": None}
+    )
+
+    assert doc["usage"]["cpu_s"] == 1.5
+    assert "cpu_psi_s" not in doc["usage"]
+
+
+def test_a_name_outside_ascii_cannot_be_split_by_a_pipeline_encoding():
+    text = line(document("work", 0, pod="p", component="api", fields={"user": "周宏毅"}))
+
+    assert text.isascii()
+    assert json.loads(text)["usage"]["user"] == "周宏毅"
+
+
+def test_windows_are_aligned_to_the_epoch_so_every_window_lands_in_one_bucket():
+    """A 5-minute date histogram puts a window in exactly one bucket only when
+    windows start on multiples of their length since the epoch."""
+    assert window_start(1_760_501_100_000 + 299_999, 300) == 1_760_501_100_000
+    assert window_start(1_760_501_100_000 + 300_000, 300) == 1_760_501_400_000
+    assert window_start(1_760_501_100_000 + 59_000, 60) == 1_760_501_100_000
diff --git a/tests/capacity/test_whatif.py b/tests/capacity/test_whatif.py
new file mode 100644
index 00000000..b00f439a
--- /dev/null
+++ b/tests/capacity/test_whatif.py
@@ -0,0 +1,189 @@
+"""What N people would need (docs/plan-capacity-usage.md §9.6, E10): on people
+whose days are known, the bootstrap's day peaks scale as they must, never
+shrink as N grows, and the headroom is where the limit is crossed."""
+
+from __future__ import annotations
+
+from zoneinfo import ZoneInfo
+
+import numpy as np
+import pytest
+
+from workspace_app.capacity.analysis.lines import Line
+from workspace_app.capacity.analysis.people import People
+from workspace_app.capacity.analysis.period import Period
+from workspace_app.capacity.analysis.whatif import Simulator, headroom
+
+UTC = ZoneInfo("UTC")
+T0 = 1_760_400_000_000 - 1_760_400_000_000 % 86_400_000  # a UTC midnight
+STEP = 3600  # hourly slots keep the arrays small
+
+
+def _period(days: int = 3) -> Period:
+    return Period(T0, T0 + days * 86_400_000, STEP, UTC)
+
+
+def _line(per_user: np.ndarray, fixed: float = 0.0, line_id: str = "api.cpu") -> Line:
+    n = per_user.shape[1]
+    total = per_user.sum(axis=0) + fixed
+    return Line(
+        id=line_id,
+        component="api",
+        resource="cpu",
+        unit="cores",
+        method="direct",
+        total=total,
+        fixed=np.full(n, fixed),
+        users=[f"u{i}" for i in range(per_user.shape[0])],
+        rows=np.arange(per_user.shape[0]),
+        per_user=per_user.astype(np.float32),
+    )
+
+
+def _people(users: int, days: int, absent: int = 0) -> People:
+    everyone = np.arange(users)
+    return People(
+        users=[f"u{i}" for i in range(users)],
+        active_30d=np.full(days, users + absent),
+        active_today=np.full(days, users),
+        pool=[everyone for _ in range(days)],
+        absent=np.full(days, absent),
+    )
+
+
+def _noon_bump(users: int, days: int, height: float = 1.0) -> np.ndarray:
+    """Every person uses `height` cores from 11:00 to 14:00, every day."""
+    hours = np.tile(np.arange(24), days)
+    one = np.where((hours >= 11) & (hours < 14), height, 0.0)
+    return np.tile(one, (users, 1))
+
+
+def test_identical_people_peak_at_n_times_one():
+    period = _period()
+    sim = Simulator([_line(_noon_bump(10, 3), fixed=0.5)], _people(10, 3), period, days=[0, 1, 2])
+
+    peaks = sim.run(25)["api.cpu"]
+
+    assert np.allclose(peaks, 25 * 1.0 + 0.5)
+
+
+def test_a_larger_n_never_needs_less():
+    rng = np.random.default_rng(0)
+    period = _period()
+    per_user = _noon_bump(12, 3) * rng.lognormal(0, 1, (12, 1))
+    sim = Simulator([_line(per_user)], _people(12, 3, absent=4), period, days=[0, 1, 2])
+
+    p95 = [float(np.quantile(sim.run(n)["api.cpu"], 0.95)) for n in range(0, 80, 3)]
+
+    assert all(b >= a for a, b in zip(p95, p95[1:], strict=False))
+
+
+def test_a_simulator_of_small_days_can_still_be_asked_for_a_large_n():
+    """The backtest asks the days before a day for that day's N. When a team
+    joins at once, that N is far beyond the earlier days': the draw stretches
+    rather than failing the page — and still never needs less for more."""
+    period = _period()
+    sim = Simulator([_line(_noon_bump(2, 3))], _people(2, 3), period, days=[0, 1, 2])
+
+    small = sim.run(30)["api.cpu"]
+    large = sim.run(300)["api.cpu"]
+
+    assert np.allclose(large, 300 * 1.0)
+    assert (large >= small).all()
+
+
+def test_a_stretched_draw_does_not_depend_on_what_was_asked_before():
+    rng = np.random.default_rng(1)
+    per_user = _noon_bump(3, 3) * rng.lognormal(0, 1, (3, 1))
+    a = Simulator([_line(per_user)], _people(3, 3, absent=2), _period(), days=[0, 1, 2])
+    b = Simulator([_line(per_user)], _people(3, 3, absent=2), _period(), days=[0, 1, 2])
+
+    a.run(200)
+    first = a.run(500)["api.cpu"]
+    second = b.run(500)["api.cpu"]
+
+    assert np.array_equal(first, second)
+
+
+def test_people_who_did_nothing_that_day_are_drawn_as_nothing():
+    """N counts everyone active in 30 days; a day's absent ones draw as zero, so
+    doubling N with half of it absent needs less than doubling the present."""
+    period = _period()
+    present_only = Simulator([_line(_noon_bump(10, 3))], _people(10, 3), period, days=[0, 1, 2])
+    half_absent = Simulator(
+        [_line(_noon_bump(10, 3))], _people(10, 3, absent=10), period, days=[0, 1, 2]
+    )
+
+    assert np.median(half_absent.run(40)["api.cpu"]) < np.median(present_only.run(40)["api.cpu"])
+
+
+def test_the_heaviest_pool_needs_at_least_what_everyone_does():
+    period = _period()
+    per_user = _noon_bump(10, 3) * np.linspace(0.1, 2.0, 10)[:, None]
+    people = _people(10, 3)
+    heavy = np.array([9])
+    everyone = Simulator([_line(per_user)], people, period, days=[0, 1, 2])
+    heaviest = Simulator(
+        [_line(per_user)], people, period, days=[0, 1, 2], pool=lambda present: heavy
+    )
+
+    assert np.median(heaviest.run(30)["api.cpu"]) >= np.median(everyone.run(30)["api.cpu"])
+
+
+def test_the_headroom_is_where_the_limit_is_crossed():
+    period = _period()
+    sim = Simulator([_line(_noon_bump(10, 3), fixed=0.5)], _people(10, 3), period, days=[0, 1, 2])
+
+    room = headroom(sim, {"api.cpu": 20.0})
+
+    assert room.max_n == 19  # 19 × 1.0 + 0.5 fits under 20; 20 does not
+    assert room.binding == "api.cpu"
+    assert room.n_now == 10
+
+
+def test_the_headroom_is_the_limit_even_just_below_the_furthest_it_looks():
+    """Doubling from today's 10 passes 160 and would step past 200 (20× today),
+    the furthest it looks. The limit is at 180: the answer is 180, not "200 or
+    more" — that claim is only made when 200 itself fits."""
+    period = _period()
+    sim = Simulator([_line(_noon_bump(10, 3))], _people(10, 3), period, days=[0, 1, 2])
+
+    room = headroom(sim, {"api.cpu": 180.5})
+
+    assert room.by_line["api.cpu"] == 180
+    assert headroom(sim, {"api.cpu": 1e9}).by_line["api.cpu"] == 200
+
+
+def test_no_limit_no_headroom():
+    period = _period()
+    sim = Simulator([_line(_noon_bump(4, 3))], _people(4, 3), period, days=[0, 1, 2])
+
+    assert headroom(sim, {}).max_n is None
+
+
+@pytest.mark.parametrize("n", [0, 3])
+def test_fewer_than_todays_n_draws_from_todays_people(n):
+    period = _period()
+    sim = Simulator([_line(_noon_bump(10, 3))], _people(10, 3), period, days=[0, 1, 2])
+
+    assert np.allclose(sim.run(n)["api.cpu"], n * 1.0)
+
+
+def test_a_run_reads_each_day_not_the_whole_period():
+    """A run takes the day's demand of the day's people. Indexing the people
+    first copied their whole period — every run, day and line — only to keep
+    one day of it: the headroom's fifty-odd runs paid it over and over."""
+    import tracemalloc
+
+    days = 14
+    rng = np.random.default_rng(3)
+    per_user = _noon_bump(200, days) * rng.lognormal(0, 1, (200, 1))
+    line = _line(per_user)
+    sim = Simulator([line], _people(200, days), _period(days), days=list(range(days)), draws=20)
+    sim.run(250)  # anything made once, made before counting
+    tracemalloc.start()
+    sim.run(250)
+    peak = tracemalloc.get_traced_memory()[1]
+    tracemalloc.stop()
+
+    assert peak < 0.5 * line.per_user.nbytes, f"{peak} bytes at the peak of one run"
