+class _Inner:
+    def __init__(self) -> None:
+        self.settings: list[ModelSettings] = []
+
+    async def get_response(self, *args, **kwargs):
+        self.settings.append(kwargs["model_settings"])
+
+    async def stream_response(self, *args, **kwargs):
+        self.settings.append(args[2])
+        yield "chunk"
+
+
+@pytest.mark.parametrize("path", ["get_response", "stream_response"])
+async def test_the_agent_model_tags_every_call_the_sdk_makes(path):
+    """The SDK passes `model_settings` by keyword to `get_response` and as the
+    third positional argument to `stream_response` — both must carry the tags,
+    and the turn's own headers must survive."""
+    inner = _Inner()
+    model = TaggedModel(inner)  # ty: ignore[invalid-argument-type]
+    settings = ModelSettings(extra_headers={"x-lane": "interactive"})
+
+    with scoped(ALICE):
+        if path == "get_response":
+            await model.get_response("sys", "hi", model_settings=settings)
+        else:
+            async for _ in model.stream_response("sys", "hi", settings):
+                pass
+
+    headers = inner.settings[0].extra_headers or {}
+    assert headers["x-lane"] == "interactive"
+    assert "ws.call:agent" in str(headers[TAG_HEADER])
+    assert settings.extra_headers == {"x-lane": "interactive"}, (
+        "the turn's settings are not mutated"
+    )
+
+
+# ── capacity.llm_tags: false reaches every scope a recorder opens ─────────
+
+
+def _quiet_recorder():
+    from workspace_app.capacity.recorder import UsageRecorder
+    from workspace_app.capacity.sink import UsageSink
+
+    class _Null(UsageSink):
+        def write(self, documents):
+            pass
+
+    return UsageRecorder(_Null(), component="api", pod="p", queue_max=100, llm_tags=False)
+
+
+async def test_a_turn_of_a_recorder_with_tags_off_opens_an_untagged_scope():
+    from workspace_app.agent import AgentToolContext
+    from workspace_app.api import RunDone
+    from workspace_app.api.turns import ChatTurnEngine
+    from workspace_app.capacity.scope import current
+
+    seen = []
+
+    class _Runner:
+        async def run(self, content, ctx):  # noqa: ANN001, ANN201
+            seen.append(current())
+            yield RunDone()
+
+    rec = _quiet_recorder()
+    engine = ChatTurnEngine(_Runner(), usage_recorder=rec)  # ty: ignore[invalid-argument-type]
+    ctx = AgentToolContext(investigation_id="i", acting_user="alice")
+    await asyncio.wait_for(engine.enqueue("i", "hi", ctx, on_complete=lambda _m: None), 5)
+    await engine.forget("i")
+    rec.close()
+
+    assert [s.tags for s in seen if s is not None] == [False]
+
+
+def test_a_job_of_a_recorder_with_tags_off_opens_an_untagged_scope():
+    import datetime as dt
+
+    from workspace_app.capacity.jobs import recorded_job
+    from workspace_app.capacity.scope import current
+
+    seen = []
+    rec = _quiet_recorder()
+    job = SimpleNamespace(
+        info=SimpleNamespace(created_by="alice", created_time=dt.datetime.now(dt.UTC)),
+        data=SimpleNamespace(retries=0),
+    )
+    recorded_job("index", lambda _job: seen.append(current()), rec)(job)
+    rec.close()
+
+    assert [s.tags for s in seen if s is not None] == [False]
+
+
+def test_a_request_of_a_recorder_with_tags_off_opens_an_untagged_scope():
+    from fastapi import FastAPI
+    from fastapi.testclient import TestClient
+
+    from workspace_app.capacity.middleware import UsageMiddleware
+    from workspace_app.capacity.scope import current
+
+    seen = []
+    app = FastAPI()
+
+    @app.get("/api/x")
+    def x():
+        seen.append(current())
+        return {}
+
+    rec = _quiet_recorder()
+    app.add_middleware(UsageMiddleware, recorder=rec, get_user_id=lambda: "alice")
+    TestClient(app).get("/api/x")
+    rec.close()
+
+    assert [s.tags for s in seen if s is not None] == [False]
+
+
+def test_the_composition_root_hands_the_setting_to_the_recorder(tmp_path, monkeypatch):
+    from .test_wiring import _build
+
+    app = _build(tmp_path, monkeypatch, "capacity:\n  llm_tags: false\n")
+
+    assert app.state.usage_recorder.llm_tags is False
diff --git a/tests/capacity/test_local_sandbox_usage.py b/tests/capacity/test_local_sandbox_usage.py
new file mode 100644
index 00000000..6e717082
--- /dev/null
+++ b/tests/capacity/test_local_sandbox_usage.py
@@ -0,0 +1,106 @@
+"""`kind: local` with isolation measures its own sandboxes (docs/plan-capacity-usage.md
+§6.5): each sandbox this process created is a usage target, labelled at create,
+and the sampler that reads them writes through the process's own recorder."""
+
+from __future__ import annotations
+
+import os
+
+from workspace_app.capacity.cgroup_usage import Target
+from workspace_app.capacity.local_usage import local_sandbox_sampler
+from workspace_app.capacity.recorder import UsageRecorder
+from workspace_app.capacity.sink import UsageSink
+from workspace_app.sandbox.isolated_process import IsolatedProcessSandbox
+from workspace_app.sandbox.mock import MockSandbox
+from workspace_app.sandbox.protocol import SandboxSpec
+
+
+def _isolated(tmp_path) -> IsolatedProcessSandbox:
+    return IsolatedProcessSandbox(
+        root_dir=tmp_path / "sb",
+        cgroup_root=tmp_path / "cg",
+        uid_base=os.getuid(),
+        uid_range=1,  # hash % 1 == 0 ⇒ uid == getuid, so chown is a no-op
+        acl_runner=lambda argv: None,
+        chown_runner=lambda p, u: None,
+    )
+
+
+async def test_a_sandbox_this_process_made_is_a_target_until_it_is_killed(tmp_path):
+    sb = _isolated(tmp_path)
+
+    h = await sb.create(SandboxSpec(labels={"user": "alice", "app": "pm"}), sandbox_id="i-1")
+    assert sb.usage_targets() == [Target(sandbox="i-1", item="i-1", user="alice", app="pm")]
+
+    await sb.kill(h)
+    assert sb.usage_targets() == []
+
+
+async def test_listing_targets_survives_a_sandbox_made_while_it_runs(tmp_path):
+    """The sampler lists the targets in a thread while the event loop creates
+    and kills sandboxes; a create landing mid-list must not end the sample."""
+    sb = _isolated(tmp_path)
+    await sb.create(SandboxSpec(labels={"user": "alice"}), sandbox_id="i-1")
+    await sb.create(SandboxSpec(labels={"user": "bob"}), sandbox_id="i-2")
+
+    class _CreatesOnLookup(dict):
+        def get(self, key, default=None):  # a create arrives while the list is walked
+            sb._usage_labels[f"new-{len(sb._usage_labels)}"] = {}  # noqa: SLF001
+            return super().get(key, default)
+
+    sb._usage_labels = {k: _CreatesOnLookup(v) for k, v in sb._usage_labels.items()}  # noqa: SLF001
+
+    assert len(sb.usage_targets()) == 2
+
+
+class _ListSink(UsageSink):
+    def __init__(self) -> None:
+        self.docs: list[dict] = []
+
+    def write(self, documents):
+        self.docs.extend(documents)
+
+
+async def test_the_sampler_reads_the_sandboxes_cgroups_and_writes_through_the_recorder(tmp_path):
+    sb = _isolated(tmp_path)
+    await sb.create(SandboxSpec(labels={"user": "alice", "app": "pm"}), sandbox_id="i-1")
+    sink = _ListSink()
+    recorder = UsageRecorder(sink, component="api", pod="api-1", window_s=300, queue_max=100)
+    clock = {"t": 1_760_501_100.0 + 60}
+    sampler = local_sandbox_sampler(sb, recorder, clock=lambda: clock["t"])
+    assert sampler is not None
+    cg = tmp_path / "cg" / "i-1"
+    (cg / "cpu.stat").write_text("usage_usec 0\n")
+    (cg / "memory.current").write_text("0\n")
+    sampler.sample()
+    (cg / "cpu.stat").write_text("usage_usec 4000000\n")
+    clock["t"] += 60
+    sampler.sample()
+    sampler.close()
+    recorder.close()
+
+    rows = [d["usage"] for d in sink.docs if d["usage"]["kind"] == "sandbox"]
+    assert [(r["user"], r["item"], r["cpu_s"], r["component"]) for r in rows] == [
+        ("alice", "i-1", 4.0, "api")
+    ]
+
+
+def test_a_sandbox_without_cgroups_has_no_sampler():
+    sink = _ListSink()
+    recorder = UsageRecorder(sink, component="api", pod="p", window_s=300, queue_max=10)
+    try:
+        assert local_sandbox_sampler(MockSandbox(), recorder) is None
+    finally:
+        recorder.close()
+
+
+def test_whether_sandbox_use_is_measured_comes_from_the_backend(tmp_path):
+    """§6.5: a backend with no cgroup per sandbox measures nothing, and the
+    page says so; sandbox-host decides for its own (None: not this process's
+    to say)."""
+    from workspace_app.capacity.local_usage import sandbox_measured
+    from workspace_app.sandbox.http_client import HttpSandbox
+
+    assert sandbox_measured(_isolated(tmp_path)) is True
+    assert sandbox_measured(MockSandbox()) is False
+    assert sandbox_measured(HttpSandbox("http://host:1")) is None
diff --git a/tests/capacity/test_math.py b/tests/capacity/test_math.py
new file mode 100644
index 00000000..0e1ee416
--- /dev/null
+++ b/tests/capacity/test_math.py
@@ -0,0 +1,111 @@
+"""The two estimators the analysis rests on (docs/plan-capacity-usage.md §9.3,
+§9.8): non-negative least squares for per-kind costs, and a one-break hinge for
+the load at which things slow down — each against data whose answer is known."""
+
+from __future__ import annotations
+
+import numpy as np
+import pytest
+
+from workspace_app.capacity.analysis.knee import fit_knee
+from workspace_app.capacity.analysis.nnls import nnls
+
+
+def test_nnls_recovers_known_costs_from_counts():
+    rng = np.random.default_rng(1)
+    x = rng.poisson(20, (500, 3)).astype(float)
+    truth = np.array([0.5, 2.0, 0.1])
+    y = x @ truth + rng.normal(0, 0.5, 500)
+
+    coef = nnls(x, y)
+
+    assert np.allclose(coef, truth, rtol=0.05)
+
+
+def test_nnls_never_returns_a_negative_cost():
+    """Ordinary least squares would give the unused column a negative cost to
+    soak up noise; a request cannot give CPU back."""
+    rng = np.random.default_rng(2)
+    x = rng.poisson(10, (300, 2)).astype(float)
+    y = 3.0 * x[:, 0] - 0.0 * x[:, 1] + rng.normal(0, 2.0, 300)
+
+    coef = nnls(x, y)
+
+    assert (coef >= 0).all()
+    assert coef[0] == pytest.approx(3.0, rel=0.05)
+
+
+def test_nnls_handles_a_column_that_never_moves():
+    x = np.column_stack([np.arange(50, dtype=float), np.zeros(50)])
+    y = 2.0 * x[:, 0]
+
+    coef = nnls(x, y)
+
+    assert coef[0] == pytest.approx(2.0)
+    assert coef[1] == 0.0
+
+
+@pytest.mark.parametrize("seed", range(20))
+def test_nnls_agrees_with_scipys(seed: int):
+    """The solver works on XᵀX and Xᵀy (the regression never lays all its rows
+    out); scipy's works on X itself — the oracle, on problems with costs at
+    zero, collinear columns and columns that never move."""
+    optimize = pytest.importorskip("scipy.optimize")
+    rng = np.random.default_rng(seed)
+    rows, cols = int(rng.integers(40, 400)), int(rng.integers(2, 12))
+    x = rng.poisson(rng.uniform(0.5, 50, cols), (rows, cols)).astype(float)
+    if cols > 3:
+        x[:, 1] = 260 * x[:, 0] + rng.poisson(5, rows)  # moves with column 0
+        x[:, 2] = 0.0
+    truth = np.where(rng.random(cols) < 0.3, 0.0, rng.uniform(0, 3, cols))
+    y = x @ truth + rng.normal(0, rng.uniform(0.1, 5), rows)
+
+    ours = nnls(x, y)
+    theirs, _ = optimize.nnls(x, y)
+
+    assert (ours >= 0).all()
+    assert np.linalg.norm(x @ ours - y) == pytest.approx(np.linalg.norm(x @ theirs - y), rel=1e-6)
+
+
+def test_a_hinge_is_found_where_it_was_put():
+    rng = np.random.default_rng(3)
+    x = rng.uniform(0, 1, 2000)
+    y = 100 + 20 * x + 900 * np.maximum(0, x - 0.6) + rng.normal(0, 10, 2000)
+
+    knee = fit_knee(x, y)
+
+    assert knee is not None
+    assert knee.at == pytest.approx(0.6, abs=0.03)
+    assert knee.slope_after > knee.slope_before
+
+
+def test_a_break_between_two_clouds_of_load_is_found_where_the_lines_meet():
+    """A working day and another system's weekend batch leave no slot between
+    them. The break is where the flat line and the rising one meet, not at the
+    top of the lower cloud — that would put a shared GPU's capacity at the load
+    the platform reaches on its own, and size the card purchase from it."""
+    rng = np.random.default_rng(6)
+    x = np.concatenate([rng.uniform(0.1, 1.0, 2000), rng.uniform(2.2, 3.0, 200)])
+    y = 0.8 + 0.6 * np.maximum(0, x - 1.75) + rng.normal(0, 0.01, len(x))
+
+    knee = fit_knee(x, y)
+
+    assert knee is not None
+    assert knee.at == pytest.approx(1.75, abs=0.03)
+
+
+def test_a_straight_line_has_no_knee():
+    rng = np.random.default_rng(4)
+    x = rng.uniform(0, 1, 2000)
+    y = 100 + 50 * x + rng.normal(0, 10, 2000)
+
+    assert fit_knee(x, y) is None
+
+
+def test_too_few_points_beyond_the_break_is_no_knee():
+    """A break with a handful of points past it is a guess, not a measurement."""
+    rng = np.random.default_rng(5)
+    x = np.concatenate([rng.uniform(0, 0.5, 2000), rng.uniform(0.9, 1.0, 10)])
+    y = 100 + 900 * np.maximum(0, x - 0.8)
+
+    assert fit_knee(x, y) is None
diff --git a/tests/capacity/test_middleware.py b/tests/capacity/test_middleware.py
new file mode 100644
index 00000000..127ec23f
--- /dev/null
+++ b/tests/capacity/test_middleware.py
@@ -0,0 +1,262 @@
+"""The request counter (docs/plan-capacity-usage.md §6.1, §6.2): every request
+under its route template, its App, and the person its route asked about — the
+deploy's reader asked once at most — and an event stream as a stream."""
+
+from __future__ import annotations
+
+import asyncio
+
+from fastapi import APIRouter, FastAPI, HTTPException
+from fastapi.responses import StreamingResponse
+from fastapi.testclient import TestClient
+
+from workspace_app.capacity.middleware import UsageMiddleware
+from workspace_app.capacity.recorder import UsageRecorder
+from workspace_app.capacity.scope import current, recording_reader
+from workspace_app.capacity.sink import UsageSink
+
+
+class _ListSink(UsageSink):
+    def __init__(self) -> None:
+        self.docs: list[dict] = []
+
+    def write(self, documents):
+        self.docs.extend(documents)
+
+
+class _Reader:
+    def __init__(self, user: str = "alice", fail: bool = False) -> None:
+        self.user = user
+        self.fail = fail
+        self.calls = 0
+
+    def __call__(self) -> str:
+        self.calls += 1
+        if self.fail:
+            raise RuntimeError("no session cookie")
+        return self.user
+
+
+def _app(recorder: UsageRecorder, reader: _Reader) -> tuple[FastAPI, list]:
+    """A small app shaped like the real one: routes under `/api`, asking the
+    request's person through the same wrapped reader `create_app` hands them."""
+    ask = recording_reader(reader)
+    seen_scopes: list = []
+    api = APIRouter(prefix="/api")
+
+    @api.get("/a/{slug}/items/{item_id}/files")
+    def files(slug: str, item_id: str):
+        ask()
+        seen_scopes.append(current())
+        return {"ok": True}
+
+    @api.get("/public")
+    def public():
+        return {"ok": True}
+
+    @api.get("/a/{slug}/gone")
+    def gone(slug: str):
+        ask()
+        raise HTTPException(status_code=404, detail="no such App")
+
+    @api.get("/a/{slug}/crash")
+    def crash(slug: str):
+        ask()
+        raise RuntimeError("unhandled")
+
+    @api.get("/a/{slug}/full")
+    def full(slug: str):
+        ask()
+        raise HTTPException(status_code=507, detail="workspace full")
+
+    @api.get("/a/{slug}/broken")
+    def broken(slug: str):
+        ask()
+        raise HTTPException(status_code=500, detail="broken")
+
+    @api.get("/apps/{slug}/icon")
+    def icon(slug: str):
+        ask()
+        return {"ok": True}
+
+    @api.get("/boom")
+    def boom():
+        ask()
+        raise HTTPException(status_code=500, detail="boom")
+
+    @api.get("/a/{slug}/items/{item_id}/stream")
+    async def stream(slug: str, item_id: str):
+        ask()
+
+        async def gen():
+            for _ in range(3):
+                yield "data: x\n\n"
+                await asyncio.sleep(0.05)
+
+        return StreamingResponse(gen(), media_type="text/event-stream")
+
+    app = FastAPI()
+    app.include_router(api)
+    app.add_middleware(UsageMiddleware, recorder=recorder, get_user_id=reader)
+    return app, seen_scopes
+
+
+def _run(reader: _Reader, *paths: str) -> tuple[list[dict], list]:
+    sink = _ListSink()
+    recorder = UsageRecorder(sink, component="api", pod="p", window_s=300, queue_max=1000)
+    app, scopes = _app(recorder, reader)
+    with TestClient(app, raise_server_exceptions=False) as client:
+        for path in paths:
+            client.get(path)
+    recorder.close()
+    return [d["usage"] for d in sink.docs if d["usage"]["kind"] == "work"], scopes
+
+
+def test_a_request_is_counted_under_its_template_app_and_person_asking_once():
+    reader = _Reader("alice")
+
+    rows, scopes = _run(reader, "/api/a/pm/items/i1/files", "/api/a/pm/items/i2/files")
+
+    (row,) = rows
+    assert (row["work"], row["app"], row["user"], row["count"]) == (
+        "req:GET /api/a/{slug}/items/{item_id}/files",
+        "pm",
+        "alice",
+        2,
+    )
+    assert sum(row.get(f"h{i}", 0) for i in range(10)) == 2
+    assert reader.calls == 2, "once per request: the route's own call, nothing extra"
+    assert [s.user for s in scopes] == ["alice", "alice"]
+
+
+def test_a_route_that_never_asks_gets_one_question_from_the_counter():
+    reader = _Reader("bob")
+
+    rows, _ = _run(reader, "/api/public")
+
+    assert [(r["work"], r["user"]) for r in rows] == [("req:GET /api/public", "bob")]
+    assert reader.calls == 1
+
+
+def test_a_reader_that_cannot_answer_counts_the_request_as_unknown():
+    rows, _ = _run(_Reader(fail=True), "/api/public")
+
+    assert [r["user"] for r in rows] == ["unknown"]
+
+
+def test_a_failing_request_is_still_counted():
+    rows, _ = _run(_Reader("carol"), "/api/boom")
+
+    assert [(r["work"], r["user"], r["count"]) for r in rows] == [("req:GET /api/boom", "carol", 1)]
+
+
+def test_requests_no_route_matched_are_static_outside_the_api_and_unmatched_inside():
+    rows, _ = _run(_Reader("dave"), "/assets/app.js", "/api/nope")
+
+    assert sorted(r["work"] for r in rows) == ["req:GET (static)", "req:GET (unmatched)"]
+
+
+def test_an_event_stream_is_counted_as_a_stream_with_its_connection_time():
+    rows, _ = _run(_Reader("erin"), "/api/a/pm/items/i1/stream")
+
+    (row,) = rows
+    assert row["work"] == "stream:/api/a/{slug}/items/{item_id}/stream"
+    assert (row["user"], row["app"], row["count"]) == ("erin", "pm", 1)
+    assert row["seconds"] >= 0.1
+    assert not [k for k in row if k.startswith("h")], "a stream has no latency"
+
+
+def test_a_url_no_route_answered_names_no_app_and_asks_nobody_who():
+    """Anyone, signed in or not, can send /api/a/<anything>/…: a slug read off
+    the raw path minted an App per URL — a row per window each, and a series
+    in the analysis. And a request no route answered (a static file, a URL
+    nothing serves) is nobody's to ask the deploy's reader about."""
+    reader = _Reader("dave")
+
+    rows, _ = _run(reader, *(f"/api/a/x{i}/nope" for i in range(5)), "/assets/app.js")
+
+    assert {r["app"] for r in rows} == {""}
+    assert {r["user"] for r in rows} == {"unknown"}
+    assert reader.calls == 0
+
+
+def test_an_app_route_that_refuses_its_slug_names_no_app():
+    """A route matched, but its slug is no App: the slug is the caller's word."""
+    rows, _ = _run(_Reader("erin"), "/api/a/zz1/gone", "/api/a/zz2/gone")
+
+    assert {r["app"] for r in rows} == {""}
+    assert {r["user"] for r in rows} == {"erin"}
+
+
+def test_app_work_that_failed_is_still_that_apps():
+    """Only a refusal (4xx) says the slug was not an App the caller may use.
+    A workspace that is full, a route that broke, one that crashed before it
+    answered (the 500 comes from outside the counter) all did that App's
+    work — booked to no App, the App's share of a failing week shrinks."""
+    rows, _ = _run(_Reader("erin"), "/api/a/pm/full", "/api/a/pm/broken", "/api/a/pm/crash")
+
+    assert sorted((r["work"], r["app"]) for r in rows) == [
+        ("req:GET /api/a/{slug}/broken", "pm"),
+        ("req:GET /api/a/{slug}/crash", "pm"),
+        ("req:GET /api/a/{slug}/full", "pm"),
+    ]
+
+
+def test_only_a_route_inside_an_app_names_the_app():
+    """The launcher loads every App's icon from /api/apps/{slug}/icon: opening
+    the home page is not using every App that ships an icon file."""
+    rows, _ = _run(_Reader("erin"), "/api/apps/pm/icon")
+
+    assert [(r["work"], r["app"]) for r in rows] == [("req:GET /api/apps/{slug}/icon", "")]
+
+
+def test_a_kubernetes_probe_is_system_work_and_asks_nobody_who():
+    """The readiness probe hits every API pod every few seconds: counted as
+    an unidentified person it was most of the "unknown" share on a quiet
+    deployment. It is work no person asked for."""
+    sink = _ListSink()
+    recorder = UsageRecorder(sink, component="api", pod="p", window_s=300, queue_max=1000)
+    reader = _Reader("dave")
+    app, _ = _app(recorder, reader)
+    with TestClient(app, raise_server_exceptions=False) as client:
+        client.get("/api/public", headers={"user-agent": "kube-probe/1.29"})
+    recorder.close()
+
+    rows = [d["usage"] for d in sink.docs if d["usage"]["kind"] == "work"]
+    assert [r["user"] for r in rows] == ["system"]
+    assert reader.calls == 0
+
+
+def test_a_probe_is_counted_as_a_probe_not_a_request():
+    """A probe comes the same number of times every window on every pod: as a
+    request column it moved exactly with each pod's idle cost, and the
+    regression could hand the whole idle CPU to "system" — and its fast
+    answers pulled the requests' p95 down."""
+    sink = _ListSink()
+    recorder = UsageRecorder(sink, component="api", pod="p", window_s=300, queue_max=1000)
+    app, _ = _app(recorder, _Reader("dave"))
+    with TestClient(app, raise_server_exceptions=False) as client:
+        client.get("/api/public", headers={"user-agent": "kube-probe/1.29"})
+    recorder.close()
+
+    (row,) = [d["usage"] for d in sink.docs if d["usage"]["kind"] == "work"]
+    assert row["work"] == "probe:GET /api/public"
+    assert not [k for k in row if k.startswith("h")], "a probe has no place in the latency"
+
+
+def test_a_request_saying_it_is_a_probe_on_a_route_that_knows_who_is_that_person():
+    """Anyone can send `User-Agent: kube-probe/…`. A route that asked who the
+    request is knows: it is that person's request, not a probe's."""
+    sink = _ListSink()
+    recorder = UsageRecorder(sink, component="api", pod="p", window_s=300, queue_max=1000)
+    app, _ = _app(recorder, _Reader("erin"))
+    with TestClient(app, raise_server_exceptions=False) as client:
+        client.get("/api/a/pm/items/i1/files", headers={"user-agent": "kube-probe/1.29"})
+    recorder.close()
+
+    (row,) = [d["usage"] for d in sink.docs if d["usage"]["kind"] == "work"]
+    assert (row["work"], row["user"], row["app"]) == (
+        "req:GET /api/a/{slug}/items/{item_id}/files",
+        "erin",
+        "pm",
+    )
