index 00000000..c888e76a
--- /dev/null
+++ b/src/workspace_app/capacity/analysis/people.py
@@ -0,0 +1,78 @@
+"""Who counts as one of the N (docs/plan-capacity-usage.md §9.5, D12).
+
+A person is one of the N on a day when they did anything in the 30 days up to
+and including it — the records' activity is loaded from 30 days before the
+period, so the first day's N is as complete as the last's. Until the records
+themselves are 30 days old it is not: N then counts only the people seen so
+far and rises with no one new, which `complete` marks. `unknown` and `system`
+are not people: their use is kept, as a baseline nobody's N grows.
+"""
+
+from __future__ import annotations
+
+import datetime as dt
+from dataclasses import dataclass
+
+import numpy as np
+
+from .observe import LOOKBACK_DAYS, Observations
+
+NOT_PEOPLE = frozenset({"", "unknown", "system"})
+
+
+@dataclass
+class People:
+    users: list[str]
+    #: [day] how many people were active in the 30 days up to it.
+    active_30d: np.ndarray
+    #: [day] how many did anything that day.
+    active_today: np.ndarray
+    #: [day] the people of that day's N who appear in the period (indices into
+    #: `users`), and how many more are in it with no use in the period at all.
+    pool: list[np.ndarray]
+    absent: np.ndarray
+    #: [day] whether the 30 days up to it are all recorded; None: every day's are.
+    complete: np.ndarray | None = None
+
+
+def _day_bounds_ms(day: dt.date, tz: dt.tzinfo) -> tuple[int, int]:
+    start = dt.datetime.combine(day, dt.time(0), tzinfo=tz)
+    end = start + dt.timedelta(days=1)
+    return int(start.timestamp() * 1000), int(end.timestamp() * 1000)
+
+
+def count_people(obs: Observations, users: list[str]) -> People:
+    p = obs.period
+    row = {u: i for i, u in enumerate(users)}
+    n_days = len(p.days)
+    active_30d = np.zeros(n_days, dtype=np.int64)
+    active_today = np.zeros(n_days, dtype=np.int64)
+    pool: list[np.ndarray] = []
+    absent = np.zeros(n_days, dtype=np.int64)
+    complete = np.ones(n_days, dtype=bool)
+    used = np.zeros((len(users), p.n), dtype=bool)
+    for (user, _app, _comp, _work), series in obs.work_user.items():
+        if user in row:
+            used[row[user], series.slots()] = True
+    for (user, _app), m in obs.sandbox_user.items():
+        if user in row:
+            used[row[user], m.slots("cpu_s")] = True
+    for d, day in enumerate(p.days):
+        start, end = _day_bounds_ms(day, p.tz)
+        since = end - LOOKBACK_DAYS * 86_400_000
+        complete[d] = obs.recorded_since_ms is None or since >= obs.recorded_since_ms
+        members = {
+            u
+            for u, days in obs.activity.items()
+            if u not in NOT_PEOPLE and any(since <= t < end for t in days)
+        }
+        today = used[:, p.day_of == d].any(axis=1)
+        members |= {users[i] for i in np.flatnonzero(today) if users[i] not in NOT_PEOPLE}
+        active_30d[d] = len(members)
+        active_today[d] = sum(1 for i in np.flatnonzero(today) if users[i] not in NOT_PEOPLE)
+        present = np.array(sorted(row[u] for u in members if u in row), dtype=np.int64)
+        pool.append(present)
+        absent[d] = len(members) - len(present)
+    return People(
+        users, active_30d, active_today, pool, absent, None if complete.all() else complete
+    )
diff --git a/src/workspace_app/capacity/analysis/period.py b/src/workspace_app/capacity/analysis/period.py
new file mode 100644
index 00000000..4ec9e493
--- /dev/null
+++ b/src/workspace_app/capacity/analysis/period.py
@@ -0,0 +1,102 @@
+"""The period an analysis covers, cut into slots (docs/plan-capacity-usage.md §9.2).
+
+`days` whole local days before today, plus today so far, in slots of `step_s`
+(E7): a view that needs N days of data can be ready in an N-day period. `end`
+is now minus the ingest lag, floored to a slot. Every slot also knows its local
+day and its place within that day (in `capacity.timezone`), which is what a
+person's day is made of.
+"""
+
+from __future__ import annotations
+
+import datetime as dt
+from dataclasses import dataclass
+from functools import cached_property
+from zoneinfo import ZoneInfo
+
+import numpy as np
+
+#: A run of this many slots with nothing from a source is a gap (15 minutes at
+#: 5-minute slots); one slot missing is a missed sample.
+GAP_SLOTS = 3
+
+
+@dataclass(frozen=True)
+class Period:
+    start_ms: int
+    end_ms: int
+    step_s: int
+    tz: ZoneInfo
+
+    @classmethod
+    def ending(cls, now_ms: int, *, days: int, step_s: int, lag_s: int, tz: ZoneInfo) -> Period:
+        """From local midnight `days` days before today to now − `lag_s`. It
+        starts on the slot that holds that midnight: in a +05:30 zone with
+        hourly slots, half an hour before it."""
+        step_ms = step_s * 1000
+        end = (now_ms - lag_s * 1000) // step_ms * step_ms
+        today = dt.datetime.fromtimestamp(end / 1000, tz).date()
+        first = dt.datetime.combine(today - dt.timedelta(days=days), dt.time(0), tzinfo=tz)
+        start = int(first.timestamp() * 1000) // step_ms * step_ms
+        return cls(start_ms=start, end_ms=end, step_s=step_s, tz=tz)
+
+    @property
+    def step_ms(self) -> int:
+        return self.step_s * 1000
+
+    @property
+    def n(self) -> int:
+        return (self.end_ms - self.start_ms) // self.step_ms
+
+    @property
+    def slots_per_day(self) -> int:
+        return 86_400 // self.step_s
+
+    def index(self, t_ms: int) -> int | None:
+        """The slot `t_ms` falls in, or None outside the period."""
+        if not self.start_ms <= t_ms < self.end_ms:
+            return None
+        return (t_ms - self.start_ms) // self.step_ms
+
+    @cached_property
+    def _local(self) -> list[dt.datetime]:
+        return [
+            dt.datetime.fromtimestamp((self.start_ms + i * self.step_ms) / 1000, self.tz)
+            for i in range(self.n)
+        ]
+
+    @cached_property
+    def days(self) -> list[dt.date]:
+        """The local days the period touches, in order."""
+        return sorted({d.date() for d in self._local})
+
+    @cached_property
+    def day_of(self) -> np.ndarray:
+        """[slot] → index into `days`."""
+        where = {d: i for i, d in enumerate(self.days)}
+        return np.array([where[d.date()] for d in self._local], dtype=np.int64)
+
+    @cached_property
+    def tod(self) -> np.ndarray:
+        """[slot] → its place within its local day (0 .. slots_per_day − 1)."""
+        return np.array(
+            [(d.hour * 3600 + d.minute * 60 + d.second) // self.step_s for d in self._local],
+            dtype=np.int64,
+        )
+
+    @cached_property
+    def full_days(self) -> list[int]:
+        """Indices of the days the period holds whole, from the slot holding
+        their local midnight to the next midnight — 23 or 25 hours on a day
+        the clocks change. A partial day's peak is not a day's peak."""
+        out = []
+        for i, day in enumerate(self.days):
+            start = _midnight_ms(day, self.tz)
+            end = _midnight_ms(day + dt.timedelta(days=1), self.tz)
+            if self.start_ms <= start // self.step_ms * self.step_ms and end <= self.end_ms:
+                out.append(i)
+        return out
+
+
+def _midnight_ms(day: dt.date, tz: ZoneInfo) -> int:
+    return int(dt.datetime.combine(day, dt.time(0), tzinfo=tz).timestamp() * 1000)
diff --git a/src/workspace_app/capacity/analysis/runway.py b/src/workspace_app/capacity/analysis/runway.py
new file mode 100644
index 00000000..08b1c807
--- /dev/null
+++ b/src/workspace_app/capacity/analysis/runway.py
@@ -0,0 +1,133 @@
+"""When the people trend reaches a limit (docs/plan-capacity-usage.md §9.7).
+
+A straight line through the days' N (least squares), and an 80% prediction
+band around it: t · s · √(1 + 1/n + (x − x̄)² / Sxx) either side — the interval
+for one future day's N, which widens the further x lies from the days the line
+was fitted on (the prediction interval of a new observation, e.g. Montgomery,
+Peck & Vining, *Introduction to Linear Regression Analysis*). A fixed ± around
+the line said next year is as certain as next week.
+
+The days the line, and each edge of the band, reach the limit are worked out
+here once; the page only formats them.
+"""
+
+from __future__ import annotations
+
+import math
+from dataclasses import asdict, dataclass
+from typing import Any
+
+import numpy as np
+
+#: The standard normal quantile with 90% below it: an 80% band's edge.
+_Z90 = 1.2815515655446004
+
+
+def t90(dof: int) -> float:
+    """Student's t quantile with 90% below it, for `dof` degrees of freedom —
+    the Cornish–Fisher expansion in the normal quantile (Abramowitz & Stegun,
+    *Handbook of Mathematical Functions*, 26.7.5); scipy is not in the API
+    image. Within 1e-4 of the exact value from 5 degrees of freedom on."""
+    z, v = _Z90, float(dof)
+    g1 = (z**3 + z) / 4
+    g2 = (5 * z**5 + 16 * z**3 + 3 * z) / 96
+    g3 = (3 * z**7 + 19 * z**5 + 17 * z**3 - 15 * z) / 384
+    g4 = (79 * z**9 + 776 * z**7 + 1482 * z**5 - 1920 * z**3 - 945 * z) / 92160
+    return z + g1 / v + g2 / v**2 + g3 / v**3 + g4 / v**4
+
+
+@dataclass(frozen=True)
+class Trend:
+    intercept: float
+    slope: float
+    #: the residual standard error (n − 2 degrees of freedom)
+    residual_sd: float
+    n: int
+    x_mean: float
+    #: Σ (x − x̄)²
+    sxx: float
+    #: the t quantile of the 80% band
+    t: float
+
+    def half(self, x: np.ndarray) -> np.ndarray:
+        """The 80% band's half-width at day `x`."""
+        spread = 1.0 + 1.0 / self.n + (np.asarray(x, dtype=float) - self.x_mean) ** 2 / self.sxx
+        return self.t * self.residual_sd * np.sqrt(spread)
+
+    def json(self) -> dict[str, Any]:
+        return asdict(self)
+
+
+def fit_trend(x: np.ndarray, y: np.ndarray) -> Trend | None:
+    """Least squares y = a + b·x. A slope within rounding of zero is zero: a
+    count that never moved fits ±1e-15, which is not growth."""
+    x = np.asarray(x, dtype=float)
+    y = np.asarray(y, dtype=float)
+    n = len(x)
+    if n < 2 or np.ptp(x) == 0:
+        return None
+    x_mean, y_mean = float(x.mean()), float(y.mean())
+    sxx = float(((x - x_mean) ** 2).sum())
+    slope = float(((x - x_mean) * (y - y_mean)).sum() / sxx)
+    if abs(slope) * float(np.ptp(x)) <= 1e-9 * max(1.0, float(np.abs(y).max())):
+        slope = 0.0
+    intercept = y_mean - slope * x_mean
+    resid = y - (intercept + slope * x)
+    sd = float(np.sqrt((resid**2).sum() / (n - 2))) if n > 2 else 0.0
+    return Trend(intercept, slope, sd, n, x_mean, sxx, t90(n - 2) if n > 2 else 0.0)
+
+
+def _first(trend: Trend, today: float, target: float, side: int) -> float | None:
+    """The first day from `today` on when the line (`side` 0) or the band's
+    upper (+1) or lower (−1) edge reaches `target`; None when it never does."""
+
+    def edge(x: float) -> float:
+        return trend.intercept + trend.slope * x + side * float(trend.half(np.array([x]))[0])
+
+    if edge(today) >= target:
+        return today
+    b = trend.slope
+    r0 = target - trend.intercept
+    if side == 0:
+        return r0 / b
+    # (r0 − b·x)² = k²·(1 + 1/n + (x − x̄)²/Sxx): the edge's equation squared
+    k2 = (trend.t * trend.residual_sd) ** 2
+    c = 1.0 + 1.0 / trend.n
+    xm, sxx = trend.x_mean, trend.sxx
+    qa = b * b - k2 / sxx
+    qb = -2 * r0 * b + 2 * k2 * xm / sxx
+    qc = r0 * r0 - k2 * c - k2 * xm * xm / sxx
+    if abs(qa) < 1e-15:
+        roots = [-qc / qb] if qb else []
+    else:
+        disc = qb * qb - 4 * qa * qc
+        if disc < 0:
+            # a band of no width has the line's one root twice, which rounding
+            # can put a hair below zero
+            if disc < -1e-9 * qb * qb:
+                return None
+            disc = 0.0
+        root = math.sqrt(disc)
+        roots = [(-qb - root) / (2 * qa), (-qb + root) / (2 * qa)]
+    valid = [
+        x
+        for x in roots
+        if x >= today
+        # squaring admits the other edge's crossings: keep this edge's own
+        and math.isclose(edge(x), target, rel_tol=1e-6, abs_tol=1e-6)
+    ]
+    return min(valid) if valid else None
+
+
+def reach(trend: Trend, today: float, target: float) -> dict[str, float | None]:
+    """Days from `today` until the band's upper edge ("early"), the line
+    ("at") and its lower edge ("late") reach `target`: 0 for one already
+    there, None for one that never does — and all None when the people are
+    not growing."""
+    if trend.slope <= 0:
+        return {"early": None, "at": None, "late": None}
+    out: dict[str, float | None] = {}
+    for key, side in (("early", 1), ("at", 0), ("late", -1)):
+        x = _first(trend, today, target, side)
+        out[key] = None if x is None else x - today
+    return out
diff --git a/src/workspace_app/capacity/analysis/thresholds.py b/src/workspace_app/capacity/analysis/thresholds.py
