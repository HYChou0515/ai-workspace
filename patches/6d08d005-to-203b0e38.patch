+/**
+ * View 1 — 總覽 (docs/plan-capacity-usage.md §10): how much is used, how far
+ * from the limit, which resource runs out first, and in one sentence how many
+ * people today's habits would hold.
+ */
+import { useMemo } from "react";
+
+import type { CapacitySummary, Line } from "../api";
+import { Chart } from "../Chart";
+import type { ChartOption } from "../echarts";
+import { formatValue, lineLabel, lineLabelById, pct, type T } from "../format";
+import { NotReady, readinessText, sourceName } from "../Readiness";
+
+export function headline(t: T, s: CapacitySummary): string {
+  const room = s.headroom;
+  if (!s.readiness.whatif.ready) return readinessText(t, s.readiness.whatif);
+  if (room === null || room.max_n === null) return t("capacity.headline.noLimit");
+  const line = lineLabelById(t, s.lines, room.binding);
+  if (room.ceiling) return t("capacity.headline.ceiling", { n: room.max_n, now: room.n_now });
+  if (room.max_n < room.n_now) {
+    return t("capacity.headline.over", { n: room.max_n, now: room.n_now, line });
+  }
+  return t("capacity.headline.room", { n: room.max_n, now: room.n_now, line });
+}
+
+/** The lines worth a row: anything measured with a peak. */
+export function overviewLines(s: CapacitySummary): Line[] {
+  return s.lines.filter((l) => l.peak !== null);
+}
+
+/** How many days the records cover, while that is under 30 (N reads low). */
+export function recordedDays(s: CapacitySummary): number | null {
+  if (s.people.complete || s.people.recorded_since_ms === null) return null;
+  return Math.max(0, Math.floor((s.period.end_ms - s.people.recorded_since_ms) / 86_400_000));
+}
+
+/** A caveat under a figure built on N while N is still filling up. */
+export function PeopleCaveat({ summary, t }: { summary: CapacitySummary; t: T }) {
+  const days = recordedDays(summary);
+  if (days === null) return null;
+  return (
+    <p className="capacity-note" data-testid="capacity-people-incomplete">
+      {t("capacity.people.incomplete", { days })}
+    </p>
+  );
+}
+
+export function Overview({ summary, t }: { summary: CapacitySummary; t: T }) {
+  const lines = overviewLines(summary);
+  const room = summary.headroom;
+  const option = useMemo<ChartOption>(() => utilisationChart(t, lines), [t, lines]);
+  // a default threshold is "not seen to slow yet" only where something watches it slow
+  // ... and only where that pair can show slowing at all (no PSI: it cannot), and
+  // has not: before view 8 is ready a knee is not used, but it was seen
+  const kneed = new Set(summary.thresholds.filter((p) => p.knee).map((p) => p.sets));
+  const watched = new Set(
+    summary.thresholds.filter((p) => p.note !== "no_psi" && !kneed.has(p.sets)).map((p) => p.sets),
+  );
+  return (
+    <section className="capacity-view" data-testid="capacity-overview">
+      <p className="capacity-headline" data-testid="capacity-headline">
+        {headline(t, summary)}
+      </p>
+      {summary.readiness.whatif.ready && room !== null && room.max_n !== null && (
+        <p className="capacity-note">
+          {t("capacity.headline.basis", { days: room.days, minutes: summary.period.step_s / 60 })}
+        </p>
+      )}
+      <PeopleCaveat summary={summary} t={t} />
+      {summary.sandbox_measured === false && (
+        <p className="capacity-note" data-testid="capacity-sandbox-unmeasured">
+          {t("capacity.sandbox.unmeasured")}
+        </p>
+      )}
+      <NotReady readiness={summary.readiness.overview} t={t} />
+      {lines.length > 0 && (
+        <>
+          <Chart option={option} label={t("capacity.col.utilization")} height={Math.max(160, 28 * lines.length + 60)} testId="capacity-overview-chart" />
+          <div className="capacity-scroll">
+            <table className="capacity-table">
+              <thead>
+                <tr>
+                  <th scope="col">{t("capacity.col.line")}</th>
+                  <th scope="col">{t("capacity.col.peak")}</th>
+                  <th scope="col">{t("capacity.col.capacity")}</th>
+                  <th scope="col">{t("capacity.col.threshold")}</th>
+                  <th scope="col">{t("capacity.col.utilization")}</th>
+                  <th scope="col">{t("capacity.col.people")}</th>
+                </tr>
+              </thead>
+              <tbody>
+                {lines.map((line) => {
+                  const binding = room?.binding === line.id;
+                  const holds = room?.by_line[line.id];
+                  return (
+                    <tr key={line.id} data-binding={binding || undefined} data-testid={`capacity-row-${line.id}`}>
+                      <th scope="row">
+                        {lineLabel(t, line)}
+                        {binding && <span className="capacity-badge">{t("capacity.binding")}</span>}
+                      </th>
+                      <td>{formatValue(t, line.peak, line.unit)}</td>
+                      <td>
+                        {line.capacity === null ? t("capacity.unknown") : formatValue(t, line.capacity, line.unit)}
+                        {(line.unit === "inflight" || line.machine_label) && (
+                          <span className="capacity-sub">
+                            {line.unit === "inflight" ? t("capacity.machine.card") : line.machine_label}
+                          </span>
+                        )}
+                      </td>
+                      <td>
+                        {line.threshold === null ? "—" : line.unit === "inflight" ? "—" : pct(line.threshold)}
+                        {line.threshold_source && (
+                          <span className="capacity-sub">
+                            {t(
+                              line.threshold_source === "knee"
+                                ? "capacity.threshold.knee"
+                                : watched.has(line.id)
+                                  ? "capacity.threshold.defaultUnseen"
+                                  : "capacity.threshold.default",
+                            )}
+                          </span>
+                        )}
+                      </td>
+                      <td>{pct(line.utilization_peak)}</td>
+                      <td>
+                        {holds === undefined
+                          ? "—"
+                          : room && holds >= room.ceiling_n
+                            ? t("capacity.headroom.atLeast", { n: holds })
+                            : holds}
+                      </td>
+                    </tr>
+                  );
+                })}
+              </tbody>
+            </table>
+          </div>
+        </>
+      )}
+      <h3 className="capacity-h3">{t("capacity.sources.title")}</h3>
+      <ul className="capacity-sources" data-testid="capacity-sources">
+        {Object.entries(summary.sources).map(([name, s]) => (
+          <li key={name} data-state={s.error ? "error" : s.connected ? "ok" : "off"}>
+            <span>{sourceName(t, name)}</span>
+            <span className="capacity-sub">
+              {s.error
+                ? t("capacity.sources.error", { error: s.error })
+                : s.connected
+                  ? t("capacity.sources.connected", { rows: s.rows.toLocaleString() })
+                  : t("capacity.sources.notConnected")}
+            </span>
+          </li>
+        ))}
+      </ul>
+    </section>
+  );
+}
+
+function utilisationChart(t: T, lines: Line[]): ChartOption {
+  const shown = lines.filter((l) => l.utilization_peak !== null);
+  const names = shown.map((l) => lineLabel(t, l));
+  return {
+    animation: false,
+    grid: { left: 8, right: 24, top: 8, bottom: 24, containLabel: true },
+    tooltip: { trigger: "axis", valueFormatter: (v: unknown) => pct(Number(v) / 100) },
+    xAxis: { type: "value", axisLabel: { formatter: "{value}%" }, max: (v: { max: number }) => Math.max(100, Math.ceil(v.max / 10) * 10) },
+    yAxis: { type: "category", data: names, inverse: true },
+    series: [
+      {
+        type: "bar",
+        name: t("capacity.col.utilization"),
+        data: shown.map((l) => Math.round((l.utilization_peak ?? 0) * 1000) / 10),
+        barMaxWidth: 16,
+      },
+      {
+        type: "scatter",
+        name: t("capacity.col.threshold"),
+        symbol: "rect",
+        symbolSize: [3, 18],
+        data: shown.map((l) => (l.threshold !== null && l.unit !== "inflight" ? l.threshold * 100 : null)),
+      },
+    ],
+  };
+}
diff --git a/web/src/capacity/views/Thresholds.tsx b/web/src/capacity/views/Thresholds.tsx
new file mode 100644
index 00000000..b933cd3c
--- /dev/null
+++ b/web/src/capacity/views/Thresholds.tsx
@@ -0,0 +1,226 @@
+/**
+ * Views 8–9 — 門檻與可信度 (docs/plan-capacity-usage.md §10): at what load it
+ * gets slow (the felt-most slowness first, D13), and whether these numbers can
+ * be trusted — backtest, fit, coverage, attribution gaps, assumptions.
+ */
+import { useMemo } from "react";
+
+import type { CapacitySummary, Pair } from "../api";
+import { Chart } from "../Chart";
+import type { ChartOption } from "../echarts";
+import { isMsgKey } from "../../lib/i18n";
+import { formatValue, lineLabelById, pct, purposeLabel, type T } from "../format";
+import { NotReady, sourceName } from "../Readiness";
+
+/** D13: (a), (b), (d), (e) are felt most and come first; (c) after. */
+const ORDER: Pair["id"][] = ["a", "b", "d", "e", "gpu", "c"];
+const FELT = new Set<Pair["id"]>(["a", "b", "d", "e"]);
+
+function isShare(x: string): boolean {
+  return x.endsWith(".util");
+}
+
+export function kneeText(t: T, summary: CapacitySummary, pair: Pair): string {
+  if (pair.note === "no_psi") return t("capacity.pair.noPsi");
+  const fmt = (v: number) =>
+    isShare(pair.x)
+      ? pct(v)
+      : pair.x === "gpu.inflight"
+        ? formatValue(t, v, "inflight")
+        : String(Math.round(v * 100) / 100);
+  if (pair.knee) {
+    if (pair.sets) {
+      const line = summary.lines.find((l) => l.id === pair.sets);
+      const label = lineLabelById(t, summary.lines, pair.sets);
+      // a line takes the lowest knee among its pairs: a higher one sets nothing
+      const used = line?.unit === "inflight" ? line.capacity : line?.threshold_source === "knee" ? line.threshold : null;
+      if (used != null && Math.abs(used - pair.knee.at) > 1e-9) {
+        return t("capacity.knee.atNotUsed", { at: fmt(pair.knee.at), line: label });
+      }
+      // a model's knee is its capacity (E5), any other line's its safe threshold
+      const key = line?.unit === "inflight" ? "capacity.knee.atCapacity" : "capacity.knee.at";
+      return t(key, { at: fmt(pair.knee.at), line: label });
+    }
+    return t("capacity.knee.atShown", { at: fmt(pair.knee.at) });
+  }
+  if (isShare(pair.x) && pair.span < 0.2) return t("capacity.knee.narrow", { span: pct(pair.span) });
+  return t("capacity.knee.none", { max: pair.x_max === null ? "—" : fmt(pair.x_max) });
+}
+
+/** A pair's name: (b) also per model, (e) per job type. */
+export function pairTitle(t: T, pair: Pair): string {
+  if (pair.id === "b" && pair.model) return t("capacity.pair.bModel", { model: pair.model });
+  if (pair.id === "e" && pair.job) return t("capacity.pair.eJob", { job: purposeLabel(t, pair.job) });
+  return t(`capacity.pair.${pair.id}`, { model: pair.model });
+}
+
+/** One card per pair: the same id comes once per model and per job type. */
+export function pairKey(pair: Pair): string {
+  return [pair.id, pair.model, pair.job].filter(Boolean).join("-");
+}
+
+function scatter(t: T, pair: Pair, title: string): ChartOption {
+  const share = isShare(pair.x);
+  const x = (v: number) => (share ? Math.round(v * 1000) / 10 : v);
+  const kneeLine = pair.knee
+    ? { symbol: "none", data: [{ xAxis: x(pair.knee.at) }], label: { formatter: "{c}" } }
+    : undefined;
+  const held = pair.throttled ?? [];
+  return {
+    animation: false,
+    grid: { left: 8, right: 24, top: held.length ? 28 : 8, bottom: 24, containLabel: true },
+    legend: held.length ? { top: 0 } : undefined,
+    tooltip: { trigger: "item" },
+    xAxis: { type: "value", axisLabel: share ? { formatter: "{value}%" } : {} },
+    yAxis: { type: "value", name: title.length > 40 ? undefined : title },
+    series: [
+      {
+        type: "scatter",
+        name: pair.id === "d" ? t("capacity.pair.d.waited") : title,
+        symbolSize: 4,
+        data: pair.points.map(([px, py]) => [x(px), py]),
+        markLine: kneeLine,
+      },
+      ...(held.length
+        ? [
+            {
+              type: "scatter" as const,
+              name: t("capacity.pair.d.held"),
+              symbol: "diamond",
+              symbolSize: 4,
+              data: held.map(([px, py]) => [x(px), py]),
+            },
+          ]
+        : []),
+    ],
+  };
+}
+
+export function Thresholds({ summary, t }: { summary: CapacitySummary; t: T }) {
+  const pairs = [...summary.thresholds].sort((a, b) => ORDER.indexOf(a.id) - ORDER.indexOf(b.id));
+  return (
+    <section className="capacity-view" data-testid="capacity-thresholds">
+      <NotReady readiness={summary.readiness.thresholds} t={t} />
+      {summary.readiness.thresholds.ready &&
+        pairs.map((pair) => <PairCard key={pairKey(pair)} pair={pair} summary={summary} t={t} />)}
+      <Confidence summary={summary} t={t} />
+    </section>
+  );
+}
+
+function PairCard({ pair, summary, t }: { pair: Pair; summary: CapacitySummary; t: T }) {
+  const title = pairTitle(t, pair);
+  const option = useMemo(() => scatter(t, pair, title), [t, pair, title]);
+  return (
+    <article className="capacity-card" data-testid={`capacity-pair-${pairKey(pair)}`}>
+      <header>
+        <h3 className="capacity-h3">{title}</h3>
+        {FELT.has(pair.id) && <span className="capacity-badge">{t("capacity.pair.felt")}</span>}
+      </header>
+      <p className="capacity-note" data-testid={`capacity-knee-${pair.id}`}>
+        {kneeText(t, summary, pair)}
+      </p>
+      {(pair.points.length > 0 || (pair.throttled?.length ?? 0) > 0) && (
+        <Chart option={option} label={title} height={220} />
+      )}
+    </article>
+  );
+}
+
+/** A regression column in words: "req:GET /api/a/{slug}/items" → a request. */
+export function columnLabel(t: T, column: string): string {
+  const other = /^req:\(other ([A-Z]+)\)$/.exec(column);
+  if (other) return t("capacity.column.otherRequests", { method: other[1] });
+  if (column.startsWith("req:")) {
+    const [method, path = ""] = column.slice(4).split(" ", 2);
+    return t("capacity.column.request", { method, path: path.split("/").filter(Boolean).slice(-2).join("/") });
+  }
+  if (column === "stream") return purposeLabel(t, "streams");
+  const [kind, name = ""] = column.split(":", 2);
+  if (kind === "turn-events") return t("capacity.column.turnEvents", { surface: purposeLabel(t, name) });
+  if (kind === "turn") return t("capacity.column.turns", { surface: purposeLabel(t, name) });
+  if (kind === "job") return t("capacity.column.jobs", { job: purposeLabel(t, name) });
+  return column;
+}
+
+/** What a source's coverage counts: slots with a sample, or — for the records
+ * and LiteLLM, which have rows only when something happened — with activity. */
+function coverageText(t: T, source: string, share: number | null): string {
+  const key = `capacity.conf.coverage.${source}`;
+  return isMsgKey(key)
+    ? t(key, { pct: pct(share) })
+    : t("capacity.conf.coverage", { source: sourceName(t, source), pct: pct(share) });
+}
+
+function when(ms: number): string {
+  return new Date(ms).toLocaleString(undefined, { month: "numeric", day: "numeric", hour: "2-digit", minute: "2-digit" });
+}
+
+/** View 9 — can these numbers be trusted. */
+function Confidence({ summary, t }: { summary: CapacitySummary; t: T }) {
+  const c = summary.confidence;
+  return (
+    <section className="capacity-sub-view" data-testid="capacity-confidence">
+      <h3 className="capacity-h3">{t("capacity.conf.title")}</h3>
+      <NotReady readiness={summary.readiness.confidence} t={t} />
+      <ul className="capacity-notes">
+        {c.backtest ? (
+          <li data-testid="capacity-backtest">
+            {t("capacity.conf.backtest", { days: c.backtest.days.length, mape: pct(c.backtest.mape, 1) })}{" "}
+            {c.backtest.mape <= c.mape_ok
+              ? t("capacity.conf.backtestOk", { ok: pct(c.mape_ok) })
+              : t("capacity.conf.backtestBad", { ok: pct(c.mape_ok) })}
+          </li>
+        ) : (
+          summary.readiness.confidence.ready && <li>{t("capacity.conf.noBacktest")}</li>
+        )}
+        {c.regressions.map((r) => (
+          <li key={r.line}>
+            {r.holdout_days > 0 && r.holdout_mape !== null
+              ? t("capacity.conf.fit", {
+                  line: lineLabelById(t, summary.lines, r.line),
+                  r2: pct(r.r2),
+                  days: r.holdout_days,
+                  mape: pct(r.holdout_mape, 1),
+                })
+              : t("capacity.conf.fitNoHoldout", { line: lineLabelById(t, summary.lines, r.line), r2: pct(r.r2) })}
+            {r.collinear.map(([a, b]) => (
+              <span key={`${a}|${b}`} className="capacity-sub">
+                {t("capacity.conf.collinear", { a: columnLabel(t, a), b: columnLabel(t, b) })}
+              </span>
+            ))}
+          </li>
+        ))}
+        {Object.entries(c.coverage)
+          .filter(([, v]) => v !== null)
+          .map(([source, v]) => (
+            <li key={source}>{coverageText(t, source, v)}</li>
+          ))}
+        {Object.entries(c.gaps).flatMap(([source, gaps]) =>
+          gaps.map(([start, end]) => (
+            <li key={`${source}-${start}`} data-testid="capacity-gap">
+              {t("capacity.conf.gap", { source: sourceName(t, source), start: when(start), end: when(end) })}
+            </li>
+          )),
+        )}
+        {c.unknown_share !== null && c.unknown_share > 0 && (
+          <li>{t("capacity.conf.unknown", { pct: pct(c.unknown_share, 1) })}</li>
+        )}
+        {c.system_share !== null && c.system_share > 0 && (
+          <li>{t("capacity.conf.system", { pct: pct(c.system_share, 1) })}</li>
+        )}
+        {Object.entries(c.untagged_gpu_share).map(([model, share]) => (
+          <li key={model}>{t("capacity.conf.untagged", { model, pct: pct(share) })}</li>
+        ))}
+        {c.dropped > 0 && <li>{t("capacity.conf.dropped", { n: c.dropped.toLocaleString() })}</li>}
+      </ul>
+      <h4 className="capacity-h4">{t("capacity.conf.assumptions")}</h4>
+      <ul className="capacity-notes">
+        <li>{t("capacity.conf.assume.regression")}</li>
+        <li>{t("capacity.conf.assume.fixed")}</li>
+        <li>{t("capacity.conf.assume.bootstrap")}</li>
+        <li>{t("capacity.conf.assume.gpu")}</li>
+      </ul>
+    </section>
+  );
+}
