+def test_one_sample_missed_in_the_last_slot_moves_no_capacity():
+    """Counted only in the last slot any worker pod reported, a pod whose one
+    scrape there failed was no pod: its job type lost its whole share to the
+    others — and, with no capacity, dropped out of the headroom."""
+    alive = {"w1": ("index", 24), "w2": ("wiki", 24), "w3": ("wiki", 24)}
+
+    got = _workers(alive, missing=frozenset({("w1", 23)}))
