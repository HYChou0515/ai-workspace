new file mode 100644
index 00000000..4a3f74ab
--- /dev/null
+++ b/src/workspace_app/capacity/cgroup_usage.py
@@ -0,0 +1,329 @@
+"""A sandbox's measured use, from its cgroup (docs/plan-capacity-usage.md §6.5).
+
+`read_cgroup` reads what the kernel keeps for one cgroup v2 directory.
+`UsageSampler` reads every live sandbox on a timer and integrates successive
+readings into `sandbox` rows — CPU seconds, memory × seconds, throttling,
+pressure, OOM kills — splitting each interval across the windows it spans, so
+a window's row describes that window and no other. One `sandbox_host` row per
+window carries the host's own pressure and the sandbox-seconds alive in it
+(how many sandboxes, times how long).
+
+Throttling and pressure answer different questions (E15): throttled time is a
+sandbox held at its OWN `cpu.max`; pressure is time it waited for a CPU the
+machine did not have. Only the second says "buy machines".
+
+ONE implementation, kept byte for byte identical with sandbox-host's copy
+(`sandbox-host/src/sandbox_host/cgroup_usage.py`; `tests/capacity/test_copies.py`
+compares the bytes): sandbox-host samples its own sandboxes, and the app
+samples its own under `kind: local` with isolation. Standard library only.
+"""
+
+from __future__ import annotations
+
+import contextlib
+from collections.abc import Callable, Iterable, Iterator
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any
+
+from .usage_wire import document, window_start
+
+#: Where the kernel publishes the whole machine's pressure.
+HOST_PRESSURE = Path("/proc/pressure")
+
+
+@dataclass(frozen=True)
+class Reading:
+    """One cgroup at one moment. A field the kernel did not offer is None."""
+
+    at_s: float
+    cpu_us: int | None
+    periods: int | None
+    throttled_n: int | None
+    throttled_us: int | None
+    mem_bytes: int | None
+    oom_kills: int | None
+    cpu_psi_us: int | None
+    mem_psi_us: int | None
+    cpu_limit: float | None
+    mem_limit: int | None
+
+
+@dataclass(frozen=True)
+class Target:
+    """A live sandbox: its cgroup's name, and whose it is."""
+
+    sandbox: str
+    item: str
+    user: str
+    app: str
+
+
+def _keyed(path: Path) -> dict[str, int]:
+    out: dict[str, int] = {}
+    with contextlib.suppress(OSError):
+        for line in path.read_text().splitlines():
+            parts = line.split()
+            if len(parts) == 2 and parts[1].lstrip("-").isdigit():
+                out[parts[0]] = int(parts[1])
+    return out
+
+
+def _single(path: Path) -> str | None:
+    try:
+        return path.read_text().strip()
+    except OSError:
+        return None
+
+
+def read_pressure(path: Path) -> int | None:
+    """The `some` line's `total=` (microseconds stalled), or None without PSI."""
+    text = _single(path)
+    if text is None:
+        return None
+    for line in text.splitlines():
+        if line.startswith("some "):
+            for part in line.split():
+                if part.startswith("total="):
+                    return int(part[len("total=") :])
+    return None
+
+
+def _cpu_limit(text: str | None) -> float | None:
+    if not text:
+        return None
+    quota, _, period = text.partition(" ")
+    if quota == "max" or not period:
+        return None
+    return int(quota) / int(period)
+
+
+def _mem_limit(text: str | None) -> int | None:
+    if not text or text == "max":
+        return None
+    return int(text)
+
+
+def read_cgroup(path: Path, at_s: float) -> Reading | None:
+    """One cgroup's counters at `at_s`; None when the cgroup is gone."""
+    if not path.is_dir():
+        return None
+    stat = _keyed(path / "cpu.stat")
+    events = _keyed(path / "memory.events")
+    mem = _single(path / "memory.current")
+    return Reading(
+        at_s=at_s,
+        cpu_us=stat.get("usage_usec"),
+        periods=stat.get("nr_periods"),
+        throttled_n=stat.get("nr_throttled"),
+        throttled_us=stat.get("throttled_usec"),
+        mem_bytes=int(mem) if mem and mem.isdigit() else None,
+        oom_kills=events.get("oom_kill"),
+        cpu_psi_us=read_pressure(path / "cpu.pressure"),
+        mem_psi_us=read_pressure(path / "memory.pressure"),
+        cpu_limit=_cpu_limit(_single(path / "cpu.max")),
+        mem_limit=_mem_limit(_single(path / "memory.max")),
+    )
+
+
+def _zero(at_s: float, like: Reading) -> Reading:
+    """A cgroup the moment it was made: every counter at zero."""
+    return Reading(at_s, 0, 0, 0, 0, 0, 0, 0, 0, like.cpu_limit, like.mem_limit)
+
+
+def _delta(before: int | None, after: int | None) -> int | None:
+    """How far a counter moved; a counter that went backwards is a new cgroup
+    counting from zero."""
+    if before is None or after is None:
+        return None
+    return after if after < before else after - before
+
+
+@dataclass
+class _Acc:
+    target: Target
+    cpu_s: float = 0.0
+    mem_bs: float = 0.0
+    mem_max: float = 0.0
+    thr_s: float = 0.0
+    thr_n: float = 0.0
+    periods: float = 0.0
+    cpu_psi_s: float | None = None
+    mem_psi_s: float | None = None
+    oom: float = 0.0
+    live_s: float = 0.0
+    cpu_limit: float | None = None
+    mem_limit: int | None = None
+
+
+@dataclass
+class _HostAcc:
+    live_s: float = 0.0
+    cpu_psi_s: float | None = None
+    mem_psi_s: float | None = None
+
+
+def _plus(total: float | None, more: float | None) -> float | None:
+    if more is None:
+        return total
+    return more if total is None else total + more
+
+
+@dataclass
+class UsageSampler:
+    """Samples every live sandbox's cgroup; writes a window's rows once it closes.
+
+    The first pass only takes a baseline: a sandbox already running when the
+    sampler starts holds counters from before, which belong to no window this
+    sampler saw. A sandbox first seen on a later pass was born since the last
+    one, so its counters are counted from zero."""
+
+    cgroup_root: Path
+    window_s: int
+    pod: str
+    component: str
+    targets: Callable[[], Iterable[Target]]
+    write: Callable[[list[dict[str, Any]]], None]
+    clock: Callable[[], float]
+    host_pressure: Path = HOST_PRESSURE
+    _prev: dict[str, Reading] = field(default_factory=dict)
+    _windows: dict[int, dict[str, _Acc]] = field(default_factory=dict)
+    _hosts: dict[int, _HostAcc] = field(default_factory=dict)
+    _host_prev: tuple[float, int | None, int | None] | None = None
+    _last_at: float | None = None
+
+    def sample(self) -> None:
+        now = self.clock()
+        first_pass = self._last_at is None
+        seen: set[str] = set()
+        for target in self.targets():
+            reading = read_cgroup(self.cgroup_root / target.sandbox, now)
+            if reading is None:
+                continue
+            seen.add(target.sandbox)
+            prev = self._prev.get(target.sandbox)
+            if prev is None and not first_pass and self._last_at is not None:
+                prev = _zero(self._last_at, reading)
+            if prev is not None:
+                self._charge(target, prev, reading)
+            self._prev[target.sandbox] = reading
+        for gone in set(self._prev) - seen:
+            del self._prev[gone]
+        self._sample_host(now)
+        self._last_at = now
+        self._emit(lambda start: start + self.window_s * 1000 <= now * 1000)
+
+    def close(self) -> None:
+        """Write every window that has anything in it, the open one included."""
+        self._emit(lambda _start: True)
+
+    # ── internals ─────────────────────────────────────────────────────────
+    def _spans(self, t0: float, t1: float) -> Iterator[tuple[int, float, float]]:
+        start = t0
+        while start < t1:
+            window = window_start(int(start * 1000), self.window_s)
+            end = min(t1, window / 1000 + self.window_s)
+            yield window, start, end
+            start = end
+
+    def _charge(self, target: Target, prev: Reading, cur: Reading) -> None:
+        dt = cur.at_s - prev.at_s
+        if dt <= 0:
+            return
+        cpu = _delta(prev.cpu_us, cur.cpu_us)
+        thr = _delta(prev.throttled_us, cur.throttled_us)
+        thr_n = _delta(prev.throttled_n, cur.throttled_n)
+        periods = _delta(prev.periods, cur.periods)
+        cpu_psi = _delta(prev.cpu_psi_us, cur.cpu_psi_us)
+        mem_psi = _delta(prev.mem_psi_us, cur.mem_psi_us)
+        oom = _delta(prev.oom_kills, cur.oom_kills)
+        for window, w0, w1 in self._spans(prev.at_s, cur.at_s):
+            share = (w1 - w0) / dt
+            acc = self._windows.setdefault(window, {}).get(target.sandbox)
+            if acc is None:
+                acc = self._windows[window][target.sandbox] = _Acc(target)
+            acc.cpu_s += (cpu or 0) * share / 1e6
+            acc.thr_s += (thr or 0) * share / 1e6
+            acc.thr_n += (thr_n or 0) * share
+            acc.periods += (periods or 0) * share
+            acc.oom += (oom or 0) * share
+            acc.cpu_psi_s = _plus(acc.cpu_psi_s, None if cpu_psi is None else cpu_psi * share / 1e6)
+            acc.mem_psi_s = _plus(acc.mem_psi_s, None if mem_psi is None else mem_psi * share / 1e6)
+            if prev.mem_bytes is not None and cur.mem_bytes is not None:
+                slope = (cur.mem_bytes - prev.mem_bytes) / dt
+                m0 = prev.mem_bytes + slope * (w0 - prev.at_s)
+                m1 = prev.mem_bytes + slope * (w1 - prev.at_s)
+                acc.mem_bs += (m0 + m1) / 2 * (w1 - w0)
+                acc.mem_max = max(acc.mem_max, m0, m1)
+            acc.live_s += w1 - w0
+            acc.cpu_limit, acc.mem_limit = cur.cpu_limit, cur.mem_limit
+
+    def _sample_host(self, now: float) -> None:
+        cpu = read_pressure(self.host_pressure / "cpu")
+        mem = read_pressure(self.host_pressure / "memory")
+        prev, self._host_prev = self._host_prev, (now, cpu, mem)
+        if prev is None or now <= prev[0]:
+            return
+        dt = now - prev[0]
+        d_cpu, d_mem = _delta(prev[1], cpu), _delta(prev[2], mem)
+        for window, w0, w1 in self._spans(prev[0], now):
+            share = (w1 - w0) / dt
+            host = self._hosts.setdefault(window, _HostAcc())
+            host.cpu_psi_s = _plus(host.cpu_psi_s, None if d_cpu is None else d_cpu * share / 1e6)
+            host.mem_psi_s = _plus(host.mem_psi_s, None if d_mem is None else d_mem * share / 1e6)
+
+    def _emit(self, due: Callable[[int], bool]) -> None:
+        docs: list[dict[str, Any]] = []
+        for window in sorted(set(self._windows) | set(self._hosts)):
+            if not due(window):
+                continue
+            accs = self._windows.pop(window, {})
+            host = self._hosts.pop(window, _HostAcc())
+            for sandbox, acc in accs.items():
+                docs.append(
+                    self._doc("sandbox", window, _sandbox_fields(sandbox, acc, self.window_s))
+                )
+            live = sum(acc.live_s for acc in accs.values())
+            docs.append(
+                self._doc(
+                    "sandbox_host",
+                    window,
+                    {
+                        "live_s": round(live, 6),
+                        "cpu_psi_s": _round(host.cpu_psi_s),
+                        "mem_psi_s": _round(host.mem_psi_s),
+                        "window_s": self.window_s,
+                    },
+                )
+            )
+        if docs:
+            self.write(docs)
+
+    def _doc(self, kind: str, window: int, fields: dict[str, Any]) -> dict[str, Any]:
+        return document(kind, window, pod=self.pod, component=self.component, fields=fields)
+
+
+def _round(value: float | None) -> float | None:
+    return None if value is None else round(value, 6)
+
+
+def _sandbox_fields(sandbox: str, acc: _Acc, window_s: int) -> dict[str, Any]:
+    t = acc.target
+    return {
+        "item": t.item,
+        "user": t.user or "unknown",
+        "app": t.app,
+        "sandbox": sandbox,
+        "cpu_s": round(acc.cpu_s, 6),
+        "mem_bs": round(acc.mem_bs, 3),
+        "mem_max": int(acc.mem_max),
+        "thr_s": round(acc.thr_s, 6),
+        "thr_n": round(acc.thr_n, 3),
+        "periods": round(acc.periods, 3),
+        "cpu_psi_s": _round(acc.cpu_psi_s),
+        "mem_psi_s": _round(acc.mem_psi_s),
+        "oom": round(acc.oom, 3),
+        "cpu_limit": acc.cpu_limit,
+        "mem_limit": acc.mem_limit,
+        "window_s": window_s,
+    }
diff --git a/src/workspace_app/capacity/check.py b/src/workspace_app/capacity/check.py
new file mode 100644
index 00000000..a767b57f
--- /dev/null
+++ b/src/workspace_app/capacity/check.py
@@ -0,0 +1,334 @@
+"""Check the operator's four sources against their contract (docs/plan-capacity-usage.md §8).
+
+    uv run python -m workspace_app.capacity check [--hours 24] [--config config.yaml]
+
+Calls every method of every configured source over the last N hours and
+reports what the dashboard would otherwise draw wrong without a word:
+buckets not aligned to the slot (every source), components the platform does
+not know, negative or impossible values, sandbox rows whose window cannot be
+placed in the slots, a kernel without CPU pressure (PSI), LiteLLM rows
+without this platform's tags or with tags that do not parse, and gaps in the
+sources sampled every slot. Exit 1 when anything is an error.
+"""
+
+from __future__ import annotations
+
+import argparse
+import time
+from collections.abc import Callable, Sequence
+from dataclasses import dataclass
+from pathlib import Path
+from zoneinfo import ZoneInfo
+
+import numpy as np
+
+from .analysis.model import find_gaps, gap_runs
+from .analysis.observe import parse_tags
+from .analysis.period import Period
+from .analysis.thresholds import same_model
+from .service import long_step
+from .sources import COMPONENTS, AggregateQuery, CapacitySources
+
+#: The keys a platform tag (`ws.<key>:<value>`) may carry (§7).
+TAG_KEYS = ("user", "app", "purpose", "call")
+
+WORK_KINDS = ("req:", "probe:", "stream:", "turn:", "turn-events:", "job:")
+
+
+@dataclass(frozen=True)
+class Finding:
+    source: str
+    level: str  # error | warning | info
+    message: str
+
+
+def _aligned(t_ms: int, step_ms: int) -> bool:
+    return t_ms % step_ms == 0
+
+
+def _check(name: str, findings: list[Finding], run: Callable[[], None]) -> None:
+    try:
+        run()
+    except Exception as exc:  # noqa: BLE001 — the report is the point
+        findings.append(Finding(name, "error", f"raised {type(exc).__name__}: {exc}"))
+
+
+def check_sources(
+    sources: CapacitySources, *, now_ms: int, hours: float, step_s: int
+) -> list[Finding]:
+    step_ms = step_s * 1000
+    end = now_ms // step_ms * step_ms
+    start = end - int(hours * 3_600_000) // step_ms * step_ms
+    out: list[Finding] = []
+
+    def say(source: str, level: str, message: str) -> None:
+        out.append(Finding(source, level, message))
+
+    def unaligned(source: str, stamps: list[int]) -> None:
+        for t in stamps:
+            if not _aligned(t, step_ms):
+                say(source, "error", f"bucket {t} not aligned to {step_s}s")
+                return
+
+    def gaps(source: str, stamps: list[int]) -> None:
+        period = Period(start, end, step_s, ZoneInfo("UTC"))
+        present = np.zeros(period.n, dtype=bool)
+        for t in stamps:
+            i = period.index(t)
+            if i is not None:
+                present[i] = True
+        runs = gap_runs(present)
+        if runs:
+            hours = sum(b - a for a, b in runs) * step_s / 3600
+            longest = find_gaps(period, present)
+            say(
+                source,
+                "warning",
+                f"{len(runs)} gap(s), {hours:.1f} h with no sample; "
+                f"the {len(longest)} longest: {longest}",
+            )
+
+    def records() -> None:
+        src = sources.usage_records
+        assert src is not None
+        rows = list(
+            src.aggregate(
+                AggregateQuery("work", start, end, step_s, ("user", "work"), ("count", "seconds"))
+            )
+        )
+        users = {r.keys.get("user", "") for r in rows}
+        say("usage_records", "info", f"{len(rows)} work rows, {len(users)} people")
+        if not rows:
+            say("usage_records", "warning", "no work rows: are the records reaching ES?")
+        for r in rows:
+            if r.t_ms is None or not _aligned(r.t_ms, step_ms):
+                say("usage_records", "error", f"bucket {r.t_ms} not aligned to {step_s}s")
+                break
+        for r in rows:
+            if any(v < 0 for v in r.values.values()):
+                say("usage_records", "error", f"negative sum in {dict(r.keys)}: {dict(r.values)}")
+                break
+        odd = sorted(
+            {
+                r.keys.get("work", "")
+                for r in rows
+                if not r.keys.get("work", "").startswith(WORK_KINDS)
+            }
+        )
+        if odd:
+            say("usage_records", "warning", f"unknown kinds of work: {odd[:5]}")
+        sandbox = list(
+            src.aggregate(AggregateQuery("sandbox", start, end, step_s, ("user",), ("cpu_s",)))
+        )
+        say("usage_records", "info", f"{len(sandbox)} sandbox rows")
+        if not sandbox:
+            say(
+                "usage_records",
+                "warning",
+                "no sandbox rows: is sandbox-host sampling (SANDBOX_HOST_USAGE_SAMPLE_S)?",
+            )
+        else:
+            windows = list(
+                src.aggregate(
+                    AggregateQuery("sandbox", start, end, None, ("window_s",), ("cpu_s",))
+                )
+            )
+            for slot in (step_s, long_step(step_s)):
+                for row in windows:
+                    window = int(float(row.keys.get("window_s") or 0))
+                    if window and slot % window and window % slot:
+                        say(
+                            "usage_records",
+                            "error",
+                            f"sandbox rows of a {window}s window cannot be placed in {slot}s "
+                            "slots: set SANDBOX_HOST_USAGE_WINDOW_S to a divisor of "
+                            f"{step_s}",
+                        )
+                        break
+            pressure = src.aggregate(
+                AggregateQuery("sandbox", start, end, None, (), maxes=("cpu_psi_s",))
+            )
+            if not any("cpu_psi_s" in r.values for r in pressure):
+                say(
+                    "usage_records",
+                    "warning",
+                    "sandbox rows carry no CPU pressure: this kernel has no PSI, and view 8 "
+                    "(d) cannot show sandboxes waiting for the machine",
+                )
+        for kind, fields in (
+            ("turn", ("accepted_ms", "started_ms", "ended_ms")),
+            ("job", ("enqueued_ms", "started_ms", "ended_ms")),
+        ):
+            found = list(src.records(kind, start, end))
+            say("usage_records", "info", f"{len(found)} {kind} records")
+            broken = [f for f in found if any(not isinstance(f.get(k), int) for k in fields)]
+            if broken:
+                say("usage_records", "error", f"{len(broken)} {kind} records miss {fields}")
+
+    def metrics() -> None:
+        src = sources.resource_metrics
+        assert src is not None
+        samples = list(src.usage(start, end, step_s))
+        capacity = {c.component: c for c in src.capacity()}
+        say("resource_metrics", "info", f"{len(samples)} samples, capacity for {sorted(capacity)}")
+        seen = set()
+        unaligned("resource_metrics", [s.t_ms for s in samples])
+        gaps("resource_metrics", [s.t_ms for s in samples])
+        for s in samples:
+            if s.component not in COMPONENTS:
+                say(
+                    "resource_metrics",
+                    "error",
+                    f"component {s.component!r} is not one of {COMPONENTS}",
+                )
+                break
+        for s in samples:
+            seen.add(s.component)
+            whole = capacity.get(s.component)
+            if (
+                whole is not None
+                and whole.cpu_cores is not None
+                and s.cpu_cores is not None
+                and s.cpu_cores > whole.cpu_cores
+            ):
+                say(
+                    "resource_metrics",
+                    "error",
+                    f"{s.pod} uses {s.cpu_cores:g} cores, more CPU than {s.component} has "
+                    f"({whole.cpu_cores:g})",
+                )
+                break
+        for s in samples:
+            if any(v is not None and v < 0 for v in (s.cpu_cores, s.memory_bytes, s.disk_bytes)):
+                say("resource_metrics", "error", f"negative value from {s.pod}")
+                break
+        # `worker:<job>` is capacity for the workers too, one job type's
+        covered = {name.partition(":")[0] for name in capacity}
+        for component in sorted(seen - covered):
+            say("resource_metrics", "warning", f"no capacity for {component}: its limit is unknown")
+        for c in capacity.values():
+            base, colon, job = c.component.partition(":")
+            if base not in COMPONENTS or (colon and (base != "worker" or not job)):
+                say(
+                    "resource_metrics",
+                    "error",
+                    f"capacity entry {c.component!r} names no component: one of {COMPONENTS}, "
+                    "or worker:<job type>",
+                )
+            if c.machines < 1:
+                say("resource_metrics", "error", f"{c.component}: machines must be at least 1")
+
+    def gpus() -> None:
+        src = sources.gpu_metrics
+        assert src is not None
+        samples = list(src.usage(start, end, step_s))
+        cards = list(src.cards())
+        say("gpu_metrics", "info", f"{len(samples)} samples, {len(cards)} cards")
+        unaligned("gpu_metrics", [s.t_ms for s in samples])
+        gaps("gpu_metrics", [s.t_ms for s in samples])
+        for s in samples:
+            if not 0.0 <= s.util <= 1.0:
+                say("gpu_metrics", "error", f"util {s.util} on {s.card} is not between 0 and 1")
+                break
+        models = {c.model for c in cards}
+        stray = sorted({s.model for s in samples} - models)
+        if stray:
+            say("gpu_metrics", "warning", f"samples for models no card serves: {stray[:5]}")
+
+    def llm() -> None:
+        src = sources.llm_requests
+        assert src is not None
+        rows = list(src.usage(start, end, step_s))
+        unaligned("llm_requests", [r.t_ms for r in rows])
+        ours = [r for r in rows if "ws" in parse_tags(r.tags)]
+        garbled = [
+            r
+            for r in ours
+            if any(
+                t.startswith("ws.") and (":" not in t or t[3:].partition(":")[0] not in TAG_KEYS)
+                for t in r.tags
+            )
+        ]
+        if garbled:
+            bad = sorted({t for r in garbled for t in r.tags if t.startswith("ws.")})[:5]
+            say(
+                "llm_requests",
+                "warning",
+                f"{len(garbled)} rows carry malformed ws.* tags (e.g. {bad})",
+            )
+        busy = sum(r.busy_seconds for r in rows)
+        share = sum(r.busy_seconds for r in ours) / busy if busy else 0.0
+        say(
+            "llm_requests",
+            "info",
+            f"{len(rows)} rows; this platform's share of busy time {share:.0%}",
+        )
+        if rows and not ours:
+            say(
+                "llm_requests", "warning", "no row carries this platform's ws tags: is llm_tags on?"
+            )
+        nameless = [r for r in ours if "user" not in parse_tags(r.tags)]
+        if nameless:
+            say(
+                "llm_requests", "warning", f"{len(nameless)} of this platform's rows name no person"
+            )
+        latency = list(src.latency(start, end, step_s))
+        say("llm_requests", "info", f"{len(latency)} latency rows")
+        unaligned("llm_requests", [r.t_ms for r in latency])
+
+    def models() -> None:
+        """A turn's model as the platform asked for it against the names
+        LiteLLM logs: view 8's per-model first-output pair (b) needs them to
+        meet (`same_model`)."""
+        turns, logs = sources.usage_records, sources.llm_requests
+        assert turns is not None and logs is not None
+        asked = {str(t.get("model") or "") for t in turns.records("turn", start, end)} - {""}
+        logged = {r.model for r in logs.usage(start, end, step_s)}
+        lost = sorted(m for m in asked if not any(same_model(m, name) for name in logged))
+        if lost:
+            say(
+                "llm_requests",
+                "warning",
+                f"turns name models LiteLLM never logged: {lost[:5]} — view 8's per-model "
+                "first-output pair needs LiteLLM to log the name the platform asks for "
+                "(its model_group)",
+            )
+
+    for name, run in (
+        ("usage_records", records),
+        ("resource_metrics", metrics),
+        ("gpu_metrics", gpus),
+        ("llm_requests", llm),
+    ):
+        if getattr(sources, name) is None:
+            say(name, "info", "not connected")
+        else:
+            _check(name, out, run)
+    if sources.usage_records is not None and sources.llm_requests is not None:
+        _check("llm_requests", out, models)
+    return out
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    from ..config.loader import load
+    from ..factories import get_capacity_sources
+
+    parser = argparse.ArgumentParser(prog="python -m workspace_app.capacity")
+    sub = parser.add_subparsers(dest="command", required=True)
+    check = sub.add_parser("check", help="check the configured sources against their contract")
+    check.add_argument("--hours", type=float, default=24.0)
+    check.add_argument("--config", type=Path, default=None)
+    args = parser.parse_args(argv)
+    settings = load(config_path=args.config, env=__import__("os").environ).capacity
+    findings = check_sources(
+        get_capacity_sources(settings),
+        now_ms=int(time.time() * 1000),
+        hours=args.hours,
+        step_s=settings.step_s,
+    )
+    marks = {"error": "✗", "warning": "!", "info": "·"}
+    for f in findings:
+        print(f"{marks[f.level]} {f.source}: {f.message}")
+    errors = sum(1 for f in findings if f.level == "error")
+    print(f"{errors} error(s)")
+    return 1 if errors else 0
