@@ -0,0 +1,51 @@
+"""`kind: local` with isolation measures its own sandboxes
+(docs/plan-capacity-usage.md §6.5).
+
+The sandboxes run in this process's pod, in cgroups this process made, so the
+pod-local loop (`api/lifecycle.py`) samples them with the same `UsageSampler`
+sandbox-host runs, writing through this process's own recorder. sandbox-host
+samples its own. Every other backend has no per-sandbox cgroup to read: no
+sampler, and `sandbox_measured` tells the dashboard, which says so.
+"""
+
+from __future__ import annotations
+
+import time
+from collections.abc import Callable
+from typing import Any
+
+from ..sandbox.isolated_process import IsolatedProcessSandbox
+from .cgroup_usage import UsageSampler
+from .recorder import UsageRecorder
+
+#: How often each sandbox's cgroup is read — sandbox-host's default too.
+SAMPLE_S = 60.0
+
+
+def sandbox_measured(sandbox: Any) -> bool | None:
+    """Whether `sandbox`'s sandboxes can be measured one by one: this process
+    measures its own isolated ones (while it records — with `capacity.record`
+    off nothing is written at all); sandbox-host decides for its own (None —
+    not this process's to say); anything else, nothing can."""
+    from ..sandbox.http_client import HttpSandbox
+
+    if isinstance(sandbox, IsolatedProcessSandbox):
+        return True
+    return None if isinstance(sandbox, HttpSandbox) else False
+
+
+def local_sandbox_sampler(
+    sandbox: Any, recorder: UsageRecorder, *, clock: Callable[[], float] = time.time
+) -> UsageSampler | None:
+    """A sampler over `sandbox`'s own cgroups, or None when it has none."""
+    if not isinstance(sandbox, IsolatedProcessSandbox):
+        return None
+    return UsageSampler(
+        sandbox.cgroup_root,
+        window_s=recorder.window_s,
+        pod=recorder.pod,
+        component=recorder.component,
+        targets=sandbox.usage_targets,
+        write=recorder.write_documents,
+        clock=clock,
+    )
diff --git a/src/workspace_app/capacity/middleware.py b/src/workspace_app/capacity/middleware.py
new file mode 100644
index 00000000..d211f666
--- /dev/null
+++ b/src/workspace_app/capacity/middleware.py
@@ -0,0 +1,180 @@
+"""The request counter (docs/plan-capacity-usage.md §6.1, §6.2).
+
+A pure ASGI middleware — not `BaseHTTPMiddleware`, which wraps response bodies
+and this app streams SSE. For each HTTP request it records one `work` count:
+
+- **What**: the route template FastAPI matched (`req:<METHOD> <template>`),
+  read in the `send` wrapper because the router sets `scope["route"]` while
+  routing, after this middleware was entered. No route: `(static)` outside
+  `/api`, `(unmatched)` inside it.
+- **A stream or a request**: a response whose content type is
+  `text/event-stream` is a stream, in flight from its first header to its
+  end — no list of long-lived routes to keep current.
+- **Which App**: the `slug` of the route that matched, when that route is
+  inside an App (`/api/a/{slug}/…` — `/api/apps/{slug}`, its icon and assets
+  are not using the App; the launcher loads every App's icon), the slug is
+  an App the platform has, and its response did not refuse it (4xx). Read
+  off the raw path, any URL — `/api/a/<anything>/…`, signed in or not —
+  minted an App: a row per window each, and a series in the analysis. Work
+  that failed (5xx, or a crash before any response) is still that App's.
+- **Who**: the request carries a `RequestIdentity`; the `get_user_id` its
+  routes call is `recording_reader`-wrapped, so the first answer a route gets
+  is the request's person at no extra cost. An API request whose route never
+  asked (auto-CRUD routes) gets one call of the deploy's reader after its
+  response; an exception there is `unknown`. A request no route answered
+  (a static file, a URL nothing serves) is `unknown` without asking. A
+  Kubernetes probe (`User-Agent: kube-probe/…`) on a route that never asked
+  who is `system` work of its own kind, `probe:<METHOD> <template>`: it hits
+  every pod every few seconds, and nobody asked for it. (Anyone can send
+  that header; a route that asked knows who the request is.)
+"""
+
+from __future__ import annotations
+
+import logging
+import time
+from collections.abc import Callable
+from typing import Any
+
+from .recorder import Running, UsageRecorder
+from .scope import SYSTEM, UNKNOWN, RequestIdentity, request_identity
+
+logger = logging.getLogger(__name__)
+
+Scope = dict[str, Any]
+Message = dict[str, Any]
+Receive = Callable[[], Any]
+Send = Callable[[Message], Any]
+
+_EVENT_STREAM = b"text/event-stream"
+_KUBE_PROBE = b"kube-probe/"
+
+
+_APP_ROUTE = "/api/a/{slug}"
+
+
+def _slug(scope: Scope, is_app: Callable[[str], bool] | None) -> str:
+    """The App the matched route was called with — never read off the raw path
+    (`path_params` exist only once something matched), only from a route
+    inside an App, and only an App the platform has (`is_app`): a route that
+    answers for any slug, or a 5xx while the database is down, would name
+    whatever the URL said."""
+    template = getattr(scope.get("route"), "path", None)
+    if not isinstance(template, str):
+        return ""
+    if template != _APP_ROUTE and not template.startswith(_APP_ROUTE + "/"):
+        return ""
+    slug = scope.get("path_params", {}).get("slug", "")
+    if not isinstance(slug, str) or (is_app is not None and not is_app(slug)):
+        return ""
+    return slug
+
+
+def _work(scope: Scope) -> str:
+    method = scope.get("method", "GET")
+    route = scope.get("route")
+    template = getattr(route, "path", None)
+    if isinstance(template, str) and template:
+        return f"{method} {template}"
+    path = scope.get("path", "")
+    under_api = path == "/api" or path.startswith("/api/")
+    return f"{method} (unmatched)" if under_api else f"{method} (static)"
+
+
+def _is_probe(scope: Scope) -> bool:
+    for name, value in scope.get("headers", ()):
+        if name.lower() == b"user-agent":
+            return value.lower().startswith(_KUBE_PROBE)
+    return False
+
+
+def _is_stream(message: Message) -> bool:
+    for name, value in message.get("headers", ()):
+        if name.lower() == b"content-type":
+            return value.split(b";", 1)[0].strip().lower() == _EVENT_STREAM
+    return False
+
+
+class UsageMiddleware:
+    def __init__(
+        self,
+        app: Any,
+        *,
+        recorder: UsageRecorder,
+        get_user_id: Callable[[], str],
+        is_app: Callable[[str], bool] | None = None,
+    ) -> None:
+        self.app = app
+        self._recorder = recorder
+        self._get_user_id = get_user_id
+        self._is_app = is_app
+
+    def _who(self, holder: RequestIdentity, scope: Scope) -> str:
+        if holder.user is not None:
+            return holder.user
+        if _is_probe(scope):
+            return SYSTEM
+        if scope.get("route") is None:
+            return UNKNOWN
+        try:
+            holder.user = self._get_user_id()
+        except Exception:
+            holder.user = UNKNOWN
+        return holder.user
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+        started = time.monotonic()
+        holder = RequestIdentity(
+            tags=self._recorder.llm_tags, app_of=lambda: _slug(scope, self._is_app)
+        )
+        stream: Running | None = None
+        status = 0
+
+        def app() -> str:
+            return "" if 400 <= status < 500 else holder.app
+
+        async def counted_send(message: Message) -> None:
+            nonlocal stream, status
+            starting = message["type"] == "http.response.start"
+            if starting:
+                status = int(message.get("status", 0))
+            if starting and stream is None and _is_stream(message):
+                work = "stream:" + _template(scope)
+                stream = self._recorder.begin(self._who(holder, scope), app(), work)
+            await send(message)
+
+        try:
+            with request_identity(holder):
+                await self.app(scope, receive, counted_send)
+        finally:
+            try:
+                if stream is not None:
+                    stream.end()
+                elif holder.user is None and _is_probe(scope):
+                    # The same count every window on every pod: as a request
+                    # column it moves exactly with each pod's idle cost, which
+                    # is where its CPU belongs; nor is it a request's latency.
+                    # (Anyone can say kube-probe: a route that asked who the
+                    # request is knows better.)
+                    elapsed = time.monotonic() - started
+                    self._recorder.add(SYSTEM, "", "probe:" + _work(scope), seconds=elapsed)
+                else:
+                    elapsed = time.monotonic() - started
+                    self._recorder.add(
+                        self._who(holder, scope),
+                        app(),
+                        "req:" + _work(scope),
+                        seconds=elapsed,
+                        latency_ms=elapsed * 1000,
+                    )
+            except Exception:  # counting must never fail a request
+                logger.warning("usage: could not count a request", exc_info=True)
+            holder.close()
+
+
+def _template(scope: Scope) -> str:
+    """The stream's route template (a stream always has one: something answered it)."""
+    return _work(scope).split(" ", 1)[1]
diff --git a/src/workspace_app/capacity/recorder.py b/src/workspace_app/capacity/recorder.py
new file mode 100644
index 00000000..853cad71
--- /dev/null
+++ b/src/workspace_app/capacity/recorder.py
@@ -0,0 +1,222 @@
+"""One process's usage counters (docs/plan-capacity-usage.md §5.2, §6.7).
+
+`add` counts finished work (a request); `begin` … `end` brackets work that
+runs for a while (a stream, a turn, a job). Both land in the window they
+happen in. Running work is charged to EVERY window it runs through — at each
+flush the time since its last charge goes to the windows it spans — so a
+two-hour stream is not one spike in the window it ends in.
+
+A window is written once it has closed (`flush`, driven by `run`), and the
+window in progress is written by `close` at shutdown. Event records (`turn`,
+`job`, `disk`) are written as they come (`emit`). Everything goes through one
+`UsageWriter`; what its full queue dropped is reported in a `meta` row.
+
+Pod-local by construction (the #804 convention): it touches only this
+process's own counts.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import threading
+import time
+from collections.abc import Callable
+from dataclasses import dataclass, field
+from typing import Any
+
+from .records import BUCKETS, MetaRow, UsageRecord, WorkRow, latency_bucket, to_document
+from .sink import UsageSink, UsageWriter
+from .usage_wire import pod_name, window_start
+
+#: How long after a window closes its flush runs — late enough that work
+#: finishing on the boundary has been counted.
+_FLUSH_GRACE_S = 0.1
+
+_Key = tuple[str, str, str]
+
+
+@dataclass
+class _Cell:
+    count: int = 0
+    seconds: float = 0.0
+    hist: list[int] = field(default_factory=list)
+
+
+class Running:
+    """Work in flight. `end()` it exactly once; a second call does nothing."""
+
+    def __init__(self, recorder: UsageRecorder, key: _Key, started_s: float) -> None:
+        self._recorder = recorder
+        self.key = key
+        self.charged_to_s = started_s
+        self.done = False
+
+    def end(self) -> None:
+        self._recorder._end(self)
+
+
+class UsageRecorder:
+    def __init__(
+        self,
+        sink: UsageSink,
+        *,
+        component: str,
+        pod: str | None = None,
+        window_s: int = 300,
+        queue_max: int = 10000,
+        clock: Callable[[], float] = time.time,
+        llm_tags: bool = True,
+    ) -> None:
+        self.component = component
+        #: `capacity.llm_tags`: whether the scopes this process's work opens
+        #: tag their LLM calls (docs/plan-capacity-usage.md §7).
+        self.llm_tags = llm_tags
+        self.pod = pod or pod_name()
+        self.window_s = window_s
+        self._clock = clock
+        self._writer = UsageWriter(sink, queue_max=queue_max)
+        self._lock = threading.Lock()
+        #: one flush at a time, start to end (see `flush`)
+        self._flushing = threading.Lock()
+        self._windows: dict[int, dict[_Key, _Cell]] = {}
+        self._running: set[Running] = set()
+
+    # ── counting ──────────────────────────────────────────────────────────
+    def add(
+        self,
+        user: str,
+        app: str,
+        work: str,
+        *,
+        count: int = 1,
+        seconds: float = 0.0,
+        latency_ms: float | None = None,
+    ) -> None:
+        """Count finished work. `latency_ms` (requests) adds it to the histogram."""
+        now = self._clock()
+        with self._lock:
+            cell = self._cell(self._window_of(now), (user, app, work))
+            cell.count += count
+            cell.seconds += seconds
+            if latency_ms is not None:
+                if not cell.hist:
+                    cell.hist = [0] * BUCKETS
+                cell.hist[latency_bucket(latency_ms)] += 1
+
+    def begin(self, user: str, app: str, work: str, *, count: int = 1) -> Running:
+        """Start running work: counted now, its seconds charged as it runs."""
+        now = self._clock()
+        key = (user, app, work)
+        running = Running(self, key, now)
+        with self._lock:
+            self._cell(self._window_of(now), key).count += count
+            self._running.add(running)
+        return running
+
+    def _end(self, running: Running) -> None:
+        now = self._clock()
+        with self._lock:
+            if running.done:
+                return
+            running.done = True
+            self._running.discard(running)
+            self._charge(running.key, running.charged_to_s, now)
+            running.charged_to_s = now
+
+    # ── writing ───────────────────────────────────────────────────────────
+    def write_documents(self, documents: list[dict[str, Any]]) -> None:
+        """Write records another component already built (a cgroup sampler)."""
+        for doc in documents:
+            self._writer.put(doc)
+
+    def emit(self, record: UsageRecord, *, at_ms: int) -> None:
+        """Write an event record now (`at_ms`: when the event began)."""
+        self._writer.put(to_document(record, at_ms, pod=self.pod, component=self.component))
+
+    def flush(self, *, final: bool = False) -> None:
+        """Write every closed window — and, `final`, the one in progress.
+
+        One flush at a time, from taking the windows to putting the last row:
+        shutdown cancels the flush loop but not the thread its flush runs in,
+        and `close` must not stop the writer while that flush is still putting
+        rows — every row put after the stop is lost, and counted nowhere."""
+        with self._flushing:
+            self._flush(final=final)
+
+    def _flush(self, *, final: bool) -> None:
+        now = self._clock()
+        current = self._window_of(now)
+        until_s = now if final else current / 1000
+        with self._lock:
+            for running in self._running:
+                if running.charged_to_s < until_s:
+                    self._charge(running.key, running.charged_to_s, until_s)
+                    running.charged_to_s = until_s
+            due = sorted(w for w in self._windows if final or w < current)
+            batches = [(w, self._windows.pop(w)) for w in due]
+        for start, cells in batches:
+            for (user, app, work), cell in cells.items():
+                row = WorkRow(
+                    user=user,
+                    app=app,
+                    work=work,
+                    count=cell.count,
+                    seconds=round(cell.seconds, 6),
+                    window_s=self.window_s,
+                    hist=tuple(cell.hist),
+                )
+                self._writer.put(to_document(row, start, pod=self.pod, component=self.component))
+        dropped = self._writer.take_dropped()
+        if dropped:
+            meta = MetaRow(dropped=dropped, window_s=self.window_s)
+            doc = to_document(meta, current, pod=self.pod, component=self.component)
+            if not self._writer.put(doc):
+                self._writer.return_dropped(dropped)
+
+    async def run(self) -> None:
+        """Flush each window as it closes, until cancelled. A window is one
+        document per (person, App, work) cell — thousands on a busy pod, tens
+        of milliseconds to build — so they are built in a thread, not on the
+        loop the pod serves from; the counting lock is held only to take the
+        closed windows."""
+        while True:
+            now = self._clock()
+            next_close = self._window_of(now) / 1000 + self.window_s
+            await asyncio.sleep(max(0.0, next_close - now) + _FLUSH_GRACE_S)
+            await asyncio.to_thread(self.flush)
+
+    def run_until(self, stop: threading.Event) -> None:
+        """`run` for a thread (the worker process): flush each window as it
+        closes until `stop` is set, then write everything and stop (`close`)."""
+        while not stop.is_set():
+            now = self._clock()
+            next_close = self._window_of(now) / 1000 + self.window_s
+            if stop.wait(max(0.0, next_close - now) + _FLUSH_GRACE_S):
+                break
+            self.flush()
+        self.close()
+
+    def close(self, *, timeout_s: float = 5.0) -> None:
+        """Write everything counted so far and stop the writer (shutdown)."""
+        self.flush(final=True)
+        self._writer.close(timeout_s=timeout_s)
+
+    # ── internals (under the lock) ────────────────────────────────────────
+    def _window_of(self, at_s: float) -> int:
+        return window_start(int(at_s * 1000), self.window_s)
+
+    def _cell(self, window: int, key: _Key) -> _Cell:
+        cells = self._windows.setdefault(window, {})
+        cell = cells.get(key)
+        if cell is None:
+            cell = cells[key] = _Cell()
+        return cell
+
+    def _charge(self, key: _Key, from_s: float, to_s: float) -> None:
+        """Add the seconds of [from_s, to_s) to each window they fall in."""
+        start = from_s
+        while start < to_s:
+            window = self._window_of(start)
+            end = min(to_s, window / 1000 + self.window_s)
+            self._cell(window, key).seconds += end - start
+            start = end
diff --git a/src/workspace_app/capacity/records.py b/src/workspace_app/capacity/records.py
new file mode 100644
index 00000000..d46b16eb
--- /dev/null
+++ b/src/workspace_app/capacity/records.py
@@ -0,0 +1,107 @@
+"""The record kinds (docs/plan-capacity-usage.md §5.2).
+
+Every measured number in a windowed kind (`work`, `sandbox`, `sandbox_host`)
+is additive — counts, seconds, byte-seconds — so the one aggregation ES has to
+do is a sum. The exceptions describe rather than measure: `mem_max` (taken
+with max), and `cpu_limit`, `mem_limit` and `window_s` (settings, never
+summed). Event kinds (`turn`, `job`) are one record per occurrence; `disk` is
+a snapshot.
+"""
+
+from __future__ import annotations
+
+from bisect import bisect_left
+from dataclasses import dataclass, fields
+from typing import Any, ClassVar
+
+from .usage_wire import document
+
+#: Upper bounds (ms) of request-latency buckets h0..h8; h9 holds everything slower.
+LATENCY_BOUNDS_MS: tuple[int, ...] = (50, 100, 250, 500, 1000, 2500, 5000, 10000, 30000)
+BUCKETS = len(LATENCY_BOUNDS_MS) + 1
+
+
+def latency_bucket(ms: float) -> int:
+    """The bucket a request of `ms` falls in: the first whose bound it does not exceed."""
+    return bisect_left(LATENCY_BOUNDS_MS, ms)
+
+
+@dataclass(frozen=True)
+class WorkRow:
+    """What one process did for one person, App and kind of work in one window."""
+
+    kind: ClassVar[str] = "work"
+    user: str
+    app: str
+    work: str
+    count: int
+    seconds: float
+    window_s: int
+    #: Requests only: how many fell in each latency bucket (`BUCKETS` long).
+    hist: tuple[int, ...] = ()
+
+
+@dataclass(frozen=True)
+class TurnRecord:
+    kind: ClassVar[str] = "turn"
+    user: str
+    app: str
+    item: str
+    surface: str
+    outcome: str
+    accepted_ms: int
+    started_ms: int
+    first_event_ms: int | None
+    first_output_ms: int | None
+    ended_ms: int
+    #: The model that wrote the reply, and the provider's own token counts —
+    #: absent when it gave none (a cross-check on ④, not a replacement).
+    model: str = ""
+    prompt_tokens: int | None = None
+    completion_tokens: int | None = None
+
+
+@dataclass(frozen=True)
+class JobRecord:
+    kind: ClassVar[str] = "job"
+    user: str
+    jobtype: str
+    enqueued_ms: int
+    started_ms: int
+    ended_ms: int
+    outcome: str
+    attempt: int
+
+
+@dataclass(frozen=True)
+class DiskRow:
+    kind: ClassVar[str] = "disk"
+    scope: str
+    user: str
+    app: str
+    bytes: int
+    item: str = ""
+    collection: str = ""
+
+
+@dataclass(frozen=True)
+class MetaRow:
+    """A window in which records were lost (the writer's queue was full)."""
+
+    kind: ClassVar[str] = "meta"
+    dropped: int
+    window_s: int
+
+
+UsageRecord = WorkRow | TurnRecord | JobRecord | DiskRow | MetaRow
+
+
+def to_document(record: UsageRecord, at_ms: int, *, pod: str, component: str) -> dict[str, Any]:
+    out: dict[str, Any] = {}
+    for f in fields(record):
+        value = getattr(record, f.name)
+        if f.name == "hist":
+            out.update((f"h{i}", n) for i, n in enumerate(value) if n)
+        elif value != "" or f.name in ("user", "app"):
+            out[f.name] = value
+    return document(record.kind, at_ms, pod=pod, component=component, fields=out)
