+    assert declared_lookup(reply) is None
+
+
+@pytest.mark.parametrize(
+    "query",
+    [
+        "pandas 2.0 breaking changes groupby apply behaviour deprecation warning fix",
+        "台積電 2025 年報 營收 毛利率",
