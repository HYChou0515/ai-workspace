+    text,
+    edit,
+    baseline,
+    parsed,
+    settled,
+    checkedText,
+    dirty,
+    checking,
+    check,
+    checkFailed,
+    problems,
+    refused,
+    notice,
+    saveError,
+    applyError,
+    save,
+    apply,
+    changes,
+    pendingKeys,
+    nothingToApply,
+    blocked,
+    askToApply,
+    clearNotice,
+    discard,
+    restored,
+  };
+}
