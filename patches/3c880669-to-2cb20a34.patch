+    result = _initialize("2025-06-18")
+
+    assert result["protocolVersion"] == "2025-06-18"
+    assert result["serverInfo"] == {
+        "name": "wafer-history",
+        "version": "1.4.2",
+        "title": "晶圓歷史查詢",
+    }
+    assert result["instructions"] == "晶圓路徑與良率歷史查詢。"
