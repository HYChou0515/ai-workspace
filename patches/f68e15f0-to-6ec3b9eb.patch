@@ -0,0 +1,127 @@
+/**
+ * The people picker's "picked often" memory (docs/plan-people-picker-ranking.md
+ * D2): per signed-in person, in this browser, how often and how recently each
+ * person was picked.
+ */
+import { describe, expect, it } from "vitest";
+
+import { readFrecency, recordPick, removePick } from "./peopleFrecency";
+
+const DAY = 24 * 60 * 60 * 1000;
+const NOW = Date.UTC(2026, 10, 7);
+
+/** An in-memory `localStorage` stand-in, so each test starts empty. */
+function memory(): Storage {
+  const m = new Map<string, string>();
+  return {
+    getItem: (k: string) => m.get(k) ?? null,
+    setItem: (k: string, v: string) => void m.set(k, v),
+    removeItem: (k: string) => void m.delete(k),
+    clear: () => m.clear(),
+    key: (i: number) => [...m.keys()][i] ?? null,
+    get length() {
+      return m.size;
+    },
+  };
+}
+
+describe("peopleFrecency", () => {
+  it("knows no one at first", () => {
+    expect(readFrecency("me", NOW, memory()).size).toBe(0);
+  });
+
+  it("scores a pick by how long ago it was", () => {
+    const s = memory();
+    recordPick("me", "a", NOW - 1 * DAY, s);
+    recordPick("me", "b", NOW - 10 * DAY, s);
+    recordPick("me", "c", NOW - 20 * DAY, s);
+    recordPick("me", "d", NOW - 60 * DAY, s);
+    recordPick("me", "e", NOW - 200 * DAY, s);
+    expect(Object.fromEntries(readFrecency("me", NOW, s))).toEqual({ a: 100, b: 70, c: 50, d: 30, e: 10 });
+  });
+
+  it("adds up the picks of one person, so often beats once", () => {
+    const s = memory();
+    recordPick("me", "often", NOW - 40 * DAY, s);
+    recordPick("me", "often", NOW - 35 * DAY, s);
+    recordPick("me", "often", NOW - 32 * DAY, s);
+    recordPick("me", "once", NOW - 20 * DAY, s);
+    const f = readFrecency("me", NOW, s);
+    expect(f.get("often")).toBe(90);
+    expect(f.get("once")).toBe(50);
+  });
+
+  it("keeps a person's last 10 picks", () => {
+    const s = memory();
+    for (let i = 0; i < 15; i++) recordPick("me", "a", NOW, s);
+    expect(readFrecency("me", NOW, s).get("a")).toBe(1000);
+  });
+
+  it("remembers at most 20 people, forgetting the one scored lowest", () => {
+    const s = memory();
+    recordPick("me", "old", NOW - 300 * DAY, s);
+    for (let i = 0; i < 19; i++) recordPick("me", `p${i}`, NOW, s);
+    recordPick("me", "new", NOW, s);
+    const f = readFrecency("me", NOW, s);
+    expect(f.size).toBe(20);
+    expect(f.has("old")).toBe(false);
+    expect(f.has("new")).toBe(true);
+  });
+
+  it("keeps each signed-in person's own list", () => {
+    const s = memory();
+    recordPick("me", "a", NOW, s);
+    expect(readFrecency("someone-else", NOW, s).size).toBe(0);
+  });
+
+  it("forgets a person on request", () => {
+    const s = memory();
+    recordPick("me", "a", NOW, s);
+    recordPick("me", "b", NOW, s);
+    removePick("me", "a", s);
+    expect([...readFrecency("me", NOW, s).keys()]).toEqual(["b"]);
+  });
+
+  it("treats unreadable storage as no memory, and a failed write as nothing", () => {
+    const broken = {
+      ...memory(),
+      getItem: () => {
+        throw new Error("denied");
+      },
+      setItem: () => {
+        throw new Error("quota");
+      },
+    } as Storage;
+    expect(readFrecency("me", NOW, broken).size).toBe(0);
+    expect(() => recordPick("me", "a", NOW, broken)).not.toThrow();
+    expect(() => removePick("me", "a", broken)).not.toThrow();
+  });
+
+  it("treats a corrupt record as no memory", () => {
+    const s = memory();
+    s.setItem("peoplePicker.frecency.me", "{not json");
+    expect(readFrecency("me", NOW, s).size).toBe(0);
+    s.setItem("peoplePicker.frecency.me", JSON.stringify({ a: "nope", b: [NOW] }));
+    expect(Object.fromEntries(readFrecency("me", NOW, s))).toEqual({ b: 100 });
+  });
+
+  it("survives a browser where even reaching localStorage throws", () => {
+    // Blocked site data makes the `localStorage` property itself throw, so the
+    // default storage must be reached inside the guard, not as a default value.
+    const real = Object.getOwnPropertyDescriptor(globalThis, "localStorage");
+    Object.defineProperty(globalThis, "localStorage", {
+      configurable: true,
+      get() {
+        throw new DOMException("denied", "SecurityError");
+      },
+    });
+    try {
+      expect(readFrecency("me", NOW).size).toBe(0);
+      expect(() => recordPick("me", "a", NOW)).not.toThrow();
+      expect(() => removePick("me", "a")).not.toThrow();
+    } finally {
+      if (real) Object.defineProperty(globalThis, "localStorage", real);
+    }
+  });
+});
+
diff --git a/web/src/lib/peopleFrecency.ts b/web/src/lib/peopleFrecency.ts
new file mode 100644
index 000000000..49ae3f027
--- /dev/null
+++ b/web/src/lib/peopleFrecency.ts
@@ -0,0 +1,104 @@
+/**
+ * Who the signed-in person picks often, in this browser
+ * (docs/plan-people-picker-ranking.md D2).
+ *
+ * "Often" is frecency, the way Firefox's address bar ranks: each of a person's
+ * last 10 picks scores by how long ago it was — within 4 days 100, 14 days 70,
+ * 31 days 50, 90 days 30, older 10 — and the scores add up. Someone picked every
+ * week stays near the top through a quiet month; someone picked once yesterday
+ * still shows up.
+ *
+ * Kept in `localStorage`, one key per signed-in person, at most 20 people. The
+ * user chose the browser over the server knowing it does not follow them to
+ * another machine. Every read and write tolerates a storage that throws (a
+ * private window, blocked site data) or holds garbage: the picker then simply
+ * has no "often" to rank by.
+ */
+
+const DAY = 24 * 60 * 60 * 1000;
+const PICKS_PER_PERSON = 10;
+const PEOPLE = 20;
+/** [max age in days, score]; anything older scores the last value. */
+const BANDS: readonly [number, number][] = [
+  [4, 100],
+  [14, 70],
+  [31, 50],
+  [90, 30],
+];
+const OLDEST = 10;
+
+type Picks = Record<string, number[]>;
+
+const keyOf = (userId: string) => `peoplePicker.frecency.${userId}`;
+
+function scoreOf(times: readonly number[], now: number): number {
+  let total = 0;
+  for (const t of times) {
+    const age = (now - t) / DAY;
+    total += BANDS.find(([days]) => age <= days)?.[1] ?? OLDEST;
+  }
+  return total;
+}
+
+function load(userId: string, storage?: Storage): Picks {
+  try {
+    // Reached HERE, inside the guard: with site data blocked, merely reading
+    // the `localStorage` property throws.
+    const raw = (storage ?? localStorage).getItem(keyOf(userId));
+    if (!raw) return {};
+    const parsed: unknown = JSON.parse(raw);
+    if (!parsed || typeof parsed !== "object") return {};
+    const out: Picks = {};
+    for (const [id, times] of Object.entries(parsed as Record<string, unknown>)) {
+      if (Array.isArray(times) && times.every((t) => typeof t === "number")) out[id] = times;
+    }
+    return out;
+  } catch {
+    return {};
+  }
+}
+
+function save(userId: string, picks: Picks, storage?: Storage): void {
+  try {
+    (storage ?? localStorage).setItem(keyOf(userId), JSON.stringify(picks));
+  } catch {
+    // A full or blocked storage loses the memory, never the pick itself.
+  }
+}
+
+/** id → frecency score at `now`, for everyone remembered. */
+export function readFrecency(
+  userId: string,
+  now: number = Date.now(),
+  storage?: Storage,
+): Map<string, number> {
+  const picks = load(userId, storage);
+  return new Map(Object.entries(picks).map(([id, times]) => [id, scoreOf(times, now)]));
+}
+
+/** Remember that `personId` was just picked. */
+export function recordPick(
+  userId: string,
+  personId: string,
+  now: number = Date.now(),
+  storage?: Storage,
+): void {
+  const picks = load(userId, storage);
+  picks[personId] = [now, ...(picks[personId] ?? [])].slice(0, PICKS_PER_PERSON);
+  const ids = Object.keys(picks);
+  if (ids.length > PEOPLE) {
+    // Forget whoever scores lowest now — never the person just picked.
+    const ranked = ids
+      .filter((id) => id !== personId)
+      .sort((a, b) => scoreOf(picks[a], now) - scoreOf(picks[b], now));
+    for (const id of ranked.slice(0, ids.length - PEOPLE)) delete picks[id];
+  }
+  save(userId, picks, storage);
+}
+
+/** Forget `personId` (the × beside a frequent person, D6). */
+export function removePick(userId: string, personId: string, storage?: Storage): void {
+  const picks = load(userId, storage);
+  delete picks[personId];
+  save(userId, picks, storage);
+}
