+    client, spec, _store = _app(holder)
+    iid = _item(spec, by="bob")
+
+    assert client.delete(_wp(iid, "/publish"), params={"path": PAGE}).status_code == 204
+
+
+def test_release_notes_accumulate_across_republishes():
