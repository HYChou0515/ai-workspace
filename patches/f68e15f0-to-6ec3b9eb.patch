+  it("pre-fills nothing that is malformed", () => {
+    expect(
+      choicesFromSpec({
+        sharing: "everybody",
+        reach: 3,
+        subjects: ["amy", "user:", 7, "group:ops"],
+        role: "owner",
+        cpu_cores: 0,
+        memory_gb: "4",
+      }),
+    ).toEqual({ subjects: ["group:ops"] });
+  });
