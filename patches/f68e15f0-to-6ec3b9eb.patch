+describe("choicesFromSpec", () => {
+  it("reads every key the skill writes, memory in GB", () => {
+    expect(
+      choicesFromSpec({
+        sharing: "shared",
+        reach: "subjects",
+        subjects: ["user:amy", "group:ops"],
+        role: "reader",
+        cpu_cores: 2,
+        memory_gb: 1.5,
+      }),
+    ).toEqual({
+      sharing: "shared",
+      reach: "subjects",
+      subjects: ["user:amy", "group:ops"],
+      role: "reader",
+      cpu_cores: 2,
+      memory_bytes: Math.round(1.5 * 1024 ** 3),
