+// @vitest-environment happy-dom
+import "@testing-library/jest-dom/vitest";
+import { cleanup, fireEvent, render, screen, waitFor, within } from "@testing-library/react";
+import { MemoryRouter, Route, Routes, useLocation } from "react-router-dom";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+vi.mock("../api", () => ({
+  api: {
+    listApps: vi.fn(async () => [{ slug: "rca", title: "根因分析", description: "", icon: "flame", color: "#F0502E" }]),
+    getUsers: vi.fn(async () => [{ id: "bob", name: "Bob Lin", section: "", email: "", photo_url: null }]),
+    deleteAppItem: vi.fn(async () => {}),
+  },
+}));
+vi.mock("../hooks/useCurrentUser", () => ({
+  useCurrentUser: () => "amy",
+  useCurrentUserState: () => ({ id: "amy", ready: true }),
+}));
+
+import type { AgentCard, AgentPageData } from "../api/agentHub";
+import { HttpError } from "../api/http";
+import { QueryWrap } from "../test/queryWrapper";
+import { AgentHubAgentPage } from "./AgentHubAgentPage";
+import { AgentHubPage } from "./AgentHubPage";
+
+const card = (over: Partial<AgentCard> = {}): AgentCard => ({
+  id: "rca-investigation%3Asrc∕agents∕sales∕agent.ai.yaml",
+  slug: "rca",
+  item_id: "rca-investigation:src",
+  path: "/agents/sales/agent.ai.yaml",
+  title: "Sales helper",
+  description: "Order questions.",
+  icon: "",
+  color: "",
+  published_by: "bob",
+  published_at: Date.now() - 3_600_000,
+  opens: 7,
+  people: 3,
+  can_remove: false,
+  ...over,
+});
+
+function Where() {
+  const loc = useLocation();
+  return <div data-testid="landed">{loc.pathname}</div>;
+}
+
+function renderHub(cards: AgentCard[]) {
+  const client = { list: vi.fn(async () => cards) };
+  render(
+    <MemoryRouter>
+      <QueryWrap>
+        <AgentHubPage client={client} />
+      </QueryWrap>
+    </MemoryRouter>,
+  );
+  return client;
+}
+
+afterEach(() => cleanup());
+beforeEach(() => localStorage.clear());
+
+describe("AgentHubPage", () => {
+  it("lists each agent as a card that goes straight into a conversation, with usage and no names", async () => {
+    renderHub([card(), card({ id: "b", title: "Quality helper", opens: 0, people: 0 })]);
+
+    const link = await screen.findByRole("link", { name: "Sales helper" });
+    // Straight into a conversation (the user's decision, 2026-11-05) — and
+    // the agent's introduction and history, one page, a link of its own.
+    expect(link).toHaveAttribute("href", `/agents/${encodeURIComponent(card().id)}/go`);
+    expect(screen.getAllByRole("link", { name: "介紹與歷史" })[0]).toHaveAttribute(
+      "href",
+      `/agents/${encodeURIComponent(card().id)}`,
+    );
+    expect(screen.getAllByTestId("agent-usage")[0]).toHaveTextContent("7 次打開 · 3 人");
+    expect(screen.getByRole("heading", { level: 1 })).toHaveTextContent("Agent Hub");
+  });
+
+  it("the introduction-and-history link stays on one line in a narrow card", async () => {
+    // A 4-character label broke into 介紹 / 與歷 / 史 beside the usage line
+    // (seen in the demo, 2026-11-05).
+    renderHub([card()]);
+
+    for (const l of await screen.findAllByRole("link", { name: "介紹與歷史" })) {
+      expect(l).toHaveStyle({ whiteSpace: "nowrap" });
+    }
+  });
+
+  it("a starred agent is also listed under favourites, and the star is the viewer's", async () => {
+    renderHub([card()]);
+    fireEvent.click(await screen.findByRole("button", { name: /把「Sales helper」加入我的最愛/ }));
+
+    const fav = await screen.findByRole("region", { name: "我的最愛" });
+    expect(within(fav).getByRole("link", { name: "Sales helper" })).toBeInTheDocument();
+    // Agent Hub's stars are its own, not the WUI overview's.
+    expect(localStorage.getItem("rca.agentHubFavourites")).toContain(card().item_id);
+    expect(localStorage.getItem("rca.wuiFavourites")).toBeNull();
+
+    // Read back from its own store on the next visit.
+    cleanup();
+    renderHub([card()]);
+    expect(await screen.findByRole("region", { name: "我的最愛" })).toBeInTheDocument();
+  });
+
+  it("switches to the list and remembers it apart from the WUI overview", async () => {
+    renderHub([card()]);
+    fireEvent.click(await screen.findByRole("switch"));
+
+    await waitFor(() => expect(document.querySelector(".wui-list")).not.toBeNull());
+    expect(localStorage.getItem("rca.agentHubView")).toBe("table");
+    expect(localStorage.getItem("rca.wuiView")).toBeNull();
+  });
+
+  it("searches titles and descriptions", async () => {
+    renderHub([card(), card({ id: "b", title: "Quality helper", description: "Defects." })]);
+    await screen.findByRole("link", { name: "Sales helper" });
+
+    fireEvent.change(screen.getByRole("searchbox"), { target: { value: "defect" } });
+
+    expect(screen.queryByRole("link", { name: "Sales helper" })).toBeNull();
+    expect(screen.getByRole("link", { name: "Quality helper" })).toBeInTheDocument();
+  });
+
+  it("says what an agent is when none is published to the viewer", async () => {
+    renderHub([]);
+
+    expect(await screen.findByText("還沒有發布給你的 agent。")).toBeInTheDocument();
+    expect(screen.queryByRole("switch")).toBeNull();
+  });
+});
+
+const PAGE: AgentPageData = {
+  agent: card(),
+  notes: [{ at: Date.now() - 1000, by: "bob", text: "Shorter answers." }],
+  mine: [
+    { slug: "rca", item_id: "rca-investigation:c2", hint: "Which orders shipped late?", created_at: Date.now() - 1000, bytes: 2048 },
+    { slug: "rca", item_id: "rca-investigation:c1", hint: "", created_at: Date.now() - 9000, bytes: 0 },
+  ],
+};
+
+function renderAgent(page: () => Promise<AgentPageData>) {
+  const client = { page: vi.fn(page) };
+  const removeItem = vi.fn(async () => {});
+  render(
+    <MemoryRouter initialEntries={[`/agents/${encodeURIComponent(card().id)}`]}>
+      <QueryWrap>
+        <Routes>
+          <Route path="/agents/:agentId" element={<AgentHubAgentPage client={client} removeItem={removeItem} />} />
+          <Route path="*" element={<Where />} />
+        </Routes>
+      </QueryWrap>
+    </MemoryRouter>,
+  );
+  return { client, removeItem };
+}
+
+describe("AgentHubAgentPage", () => {
+  it("shows what it is, its notes and the viewer's conversations with their size", async () => {
+    const { client } = renderAgent(async () => PAGE);
+
+    expect(await screen.findByRole("heading", { level: 1 })).toHaveTextContent("Sales helper");
+    expect(client.page).toHaveBeenCalledWith(card().id);
+    expect(screen.getByText("Shorter answers.")).toBeInTheDocument();
+    // A9: date, publisher, text.
+    const notes = screen.getByRole("region", { name: "更新說明" });
+    await waitFor(() => expect(notes).toHaveTextContent("Bob Lin"));
+    const mine = screen.getByRole("region", { name: "我和它的對話" });
+    expect(within(mine).getByRole("link", { name: "Which orders shipped late?" })).toHaveAttribute(
+      "href",
+      "/a/rca/rca-investigation%3Ac2",
+    );
+    expect(within(mine).getByRole("link", { name: "（還沒問任何事）" })).toBeInTheDocument();
+    expect(mine).toHaveTextContent("2.0 KB");
+  });
+
+  it("starts a new conversation through the preparing page", async () => {
+    renderAgent(async () => PAGE);
+
+    fireEvent.click(await screen.findByRole("button", { name: "開始新對話" }));
+
+    expect(await screen.findByTestId("landed")).toHaveTextContent("/open/rca/rca-investigation%3Asrc/agents/sales/agent.ai.yaml");
+  });
+
+  it("deletes only the picked conversations, after asking", async () => {
+    const { removeItem } = renderAgent(async () => PAGE);
+    const mine = await screen.findByRole("region", { name: "我和它的對話" });
+    const del = within(mine).getByRole("button", { name: "刪除選取的對話" });
+    expect(del).toBeDisabled();
+
+    fireEvent.click(within(mine).getByRole("checkbox", { name: "選取「（還沒問任何事）」" }));
+    fireEvent.click(del);
+    const ask = await screen.findByRole("dialog");
+    expect(ask).toHaveTextContent("刪除 1 個對話？");
+    expect(removeItem).not.toHaveBeenCalled();
+    fireEvent.click(within(ask).getByRole("button", { name: "刪除選取的對話" }));
+
+    await waitFor(() => expect(removeItem).toHaveBeenCalledWith("rca", "rca-investigation:c1"));
+    expect(removeItem).toHaveBeenCalledTimes(1);
+  });
+
+  it("says plainly when the agent is not there for the viewer", async () => {
+    renderAgent(async () => {
+      throw new HttpError(404, "no such agent");
+    });
+
+    expect(await screen.findByRole("alert")).toHaveTextContent("找不到這個 agent，或它沒有發布給你。");
+    expect(screen.getByRole("link", { name: "回到 Agent Hub" })).toHaveAttribute("href", "/agents");
+  });
+});
diff --git a/web/src/pages/AgentHubPage.tsx b/web/src/pages/AgentHubPage.tsx
new file mode 100644
index 000000000..fa4987103
--- /dev/null
+++ b/web/src/pages/AgentHubPage.tsx
@@ -0,0 +1,291 @@
+/**
+ * Agent Hub (`docs/plan-wui-publish-and-agent-hub.md` A1/A7) — its own place in
+ * the platform menu, beside WUI.
+ *
+ * Every published agent the viewer may use, laid out like the `/wui` overview
+ * (cards with an icon, a list mode, favourites — the same sheet, `.page
+ * .wui-cards`) because people already know how to read that page (NN/g,
+ * *Consistency and standards*), under its own name and in its own place,
+ * because an agent is a different thing to them than a page (A1). A card
+ * opens the agent's page, where a conversation is started (A8); usage is
+ * shown to everyone without names, like skill hub's.
+ */
+
+import { useQuery } from "@tanstack/react-query";
+import { useState } from "react";
+import { Link } from "react-router-dom";
+
+import { type AgentCard, agentHubApi, type AgentHubApi } from "../api/agentHub";
+import { qk } from "../api/queryKeys";
+import { encodePath } from "../api/refPath";
+import { exactTime, relativeTime } from "../api/types";
+import { AppTag } from "../components/AppTag";
+import { Icon } from "../components/Icon";
+import { PageMark } from "../components/PageMark";
+import { UserChip } from "../components/UserChip";
+import { useBreadcrumbs } from "../hooks/breadcrumbs";
+import { useCurrentUserState } from "../hooks/useCurrentUser";
+import { useApps } from "../hooks/useResources";
+import { appTagPalette, pageColour } from "../lib/appColor";
+import { useT } from "../lib/i18n";
+import { AGENT_HUB_FAVOURITES, favouriteKey, useWuiFavourites } from "../lib/wuiFavourites";
+import { AGENT_HUB_VIEW, useWuiView } from "../lib/wuiView";
+import { ViewSwitch } from "./WuiOverviewPage";
+
+export const AGENT_HUB = "Agent Hub";
+
+/** An agent's page in Agent Hub — its introduction and the person's history
+ * with it, one page (A8, as the user amended it 2026-11-05). */
+export function agentPageHref(id: string): string {
+  return `/agents/${encodeURIComponent(id)}`;
+}
+
+/** Into a conversation with the agent (`AgentLaunchPage`): the person's
+ * latest, or a first one; ``fresh`` — a new one, whatever came before. */
+export function agentConversationHref(id: string, fresh = false): string {
+  return `/agents/${encodeURIComponent(id)}/go${fresh ? "?new=1" : ""}`;
+}
+
+/** The preparing page that makes a new conversation copy of ``agent`` (C12). */
+export function agentOpenRoute(agent: { slug: string; item_id: string; path: string }): string {
+  return `/open/${encodeURIComponent(agent.slug)}/${encodeURIComponent(agent.item_id)}/${encodePath(agent.path)}`;
+}
+
+export function AgentHubPage({ client = agentHubApi }: { client?: Pick<AgentHubApi, "list"> }) {
+  const t = useT();
+  // "Agent Hub" is the proper noun the menu uses — always in full (A1).
+  useBreadcrumbs([{ label: t("nav.home"), to: "/" }, { label: AGENT_HUB }]);
+  const me = useCurrentUserState();
+  const favourites = useWuiFavourites(me.id, AGENT_HUB_FAVOURITES);
+  const [view, setView] = useWuiView(AGENT_HUB_VIEW);
+  const [query, setQuery] = useState("");
+  const [sort, setSort] = useState<"newest" | "title">("newest");
+  const { data, isPending, isError, refetch } = useQuery({ queryKey: qk.agentHub, queryFn: () => client.list() });
+
+  if (isError) {
+    return (
+      <div className="page">
+        <h1>{AGENT_HUB}</h1>
+        <p className="error" role="alert">
+          {t("agentHub.error")}{" "}
+          <button type="button" className="btn" data-variant="secondary" data-size="sm" onClick={() => void refetch()}>
+            {t("wui.retry")}
+          </button>
+        </p>
+      </div>
+    );
+  }
+  if (isPending) return <p>{t("agentHub.loading")}</p>;
+
+  const needle = query.trim().toLocaleLowerCase();
+  const shown = data
+    .filter(
+      (a) =>
+        !needle ||
+        a.title.toLocaleLowerCase().includes(needle) ||
+        a.description.toLocaleLowerCase().includes(needle),
+    )
+    .sort((a, b) => (sort === "title" ? a.title.localeCompare(b.title, "zh-TW") : 0));
+  const starred = shown.filter((a) => favourites.has(favouriteKey(a)));
+  const listOf = (agents: AgentCard[], showApp: boolean) => {
+    const props = (a: AgentCard) => ({
+      agent: a,
+      starred: favourites.has(favouriteKey(a)),
+      starReady: me.ready,
+      onStar: () => favourites.toggle(favouriteKey(a)),
+      showApp,
+    });
+    return view === "cards" ? (
+      <ul className="wui-cards">
+        {agents.map((a) => (
+          <AgentCardItem key={a.id} {...props(a)} />
+        ))}
+      </ul>
+    ) : (
+      <ul className="wui-list">
+        {agents.map((a) => (
+          <AgentRow key={a.id} {...props(a)} />
+        ))}
+      </ul>
+    );
+  };
+  const nothing = data.length === 0;
+
+  return (
+    <div className={view === "cards" && !nothing ? "page page--wide" : "page"}>
+      <div className="page-head">
+        <h1>{AGENT_HUB}</h1>
+        {nothing ? null : <ViewSwitch view={view} onChange={setView} />}
+      </div>
+      {nothing ? (
+        <>
+          <p className="empty">{t("agentHub.empty")}</p>
+          <p className="hint">{t("agentHub.empty.what")}</p>
+        </>
+      ) : (
+        <>
+          <div className="page-tools">
+            <input
+              autoComplete="off"
+              className="input"
+              type="search"
+              value={query}
+              onChange={(e) => setQuery(e.target.value)}
+              placeholder={t("agentHub.search")}
+              aria-label={t("agentHub.search")}
+            />
+            <label>
+              {t("wui.sort")}
+              <select
+                className="input"
+                value={sort}
+                onChange={(e) => setSort(e.target.value === "title" ? "title" : "newest")}
+                aria-label={t("wui.sort")}
+              >
+                <option value="newest">{t("agentHub.sort.newest")}</option>
+                <option value="title">{t("wui.sort.title")}</option>
+              </select>
+            </label>
+          </div>
+          {shown.length === 0 ? <p className="empty">{t("agentHub.nomatch")}</p> : null}
+          {starred.length > 0 ? (
+            <section aria-labelledby="agent-hub-favourites">
+              <h2 id="agent-hub-favourites">{t("wui.favourites")}</h2>
+              {listOf(starred, true)}
+            </section>
+          ) : null}
+          {shown.length > 0 ? (
+            <section aria-labelledby="agent-hub-all">
+              <h2 id="agent-hub-all">{t("agentHub.all")}</h2>
+              {listOf(shown, true)}
+            </section>
+          ) : null}
+        </>
+      )}
+    </div>
+  );
+}
+
+type ItemProps = {
+  agent: AgentCard;
+  starred: boolean;
+  starReady: boolean;
+  onStar: () => void;
+  showApp: boolean;
+};
+
+function Star({ agent, starred, starReady, onStar, className = "btn" }: ItemProps & { className?: string }) {
+  const t = useT();
+  return (
+    <button
+      type="button"
+      className={className}
+      data-variant="ghost"
+      data-size="sm"
+      aria-pressed={starred}
+      aria-label={starred ? t("wui.unstar", { title: agent.title }) : t("wui.star", { title: agent.title })}
+      disabled={!starReady}
+      onClick={onStar}
+    >
+      <Icon name="star" size={16} />
+    </button>
+  );
+}
+
+/** The agent's introduction and the person's history with it — one page,
+ * reached the same way from here and from inside a conversation. */
+function IntroLink({ agent }: { agent: AgentCard }) {
+  const t = useT();
+  // One line: beside the usage in a narrow card it otherwise breaks mid-word.
+  return (
+    <Link to={agentPageHref(agent.id)} style={{ whiteSpace: "nowrap" }}>
+      {t("agentHub.intro")}
+    </Link>
+  );
+}
+
+function Usage({ agent }: { agent: AgentCard }) {
+  const t = useT();
+  const iso = new Date(agent.published_at).toISOString();
+  return (
+    <span className="detail" title={exactTime(iso)} data-testid="agent-usage">
+      {t("publish.usage", { opens: agent.opens, people: agent.people })} · {relativeTime(iso)}
+    </span>
+  );
+}
+
+function AgentRow(props: ItemProps) {
+  const { agent, showApp } = props;
+  return (
+    <li>
+      <PageMark
+        slug={agent.slug}
+        itemId={agent.item_id}
+        path={agent.path}
+        icon={agent.icon}
+        color={agent.color}
+        title={agent.title}
+      />
+      <Link to={agentConversationHref(agent.id)} title={agent.title}>
+        {agent.title}
+      </Link>
+      <span className="detail">
+        {showApp ? <AppTag slug={agent.slug} /> : null} {agent.description}
+      </span>
+      <Usage agent={agent} />
+      <IntroLink agent={agent} />
+      <Star {...props} />
+    </li>
+  );
+}
+
+function AgentCardItem(props: ItemProps) {
+  const { agent, showApp } = props;
+  const app = useApps().find((a) => a.slug === agent.slug);
+  const colour = pageColour(agent.color, app?.color);
+  const palette = appTagPalette(colour);
+  return (
+    <li
+      className="wui-card"
+      style={
+        {
+          ...(colour ? { "--app-color": colour } : {}),
+          ...(palette ? { "--app-tint": palette.tint } : {}),
+        } as React.CSSProperties
+      }
+    >
+      <span className="stripe" aria-hidden="true" />
+      <div className="wui-card-body">
+        <PageMark
+          slug={agent.slug}
+          itemId={agent.item_id}
+          path={agent.path}
+          icon={agent.icon}
+          color={agent.color}
+          title={agent.title}
+          size={54}
+        />
+        <div className="wui-card-text">
+          {/* Stretched over the card by the sheet, like a page card's link —
+              straight into a conversation with the agent (the user's
+              decision, 2026-11-05): its latest, or a first one. */}
+          <Link to={agentConversationHref(agent.id)} title={agent.title}>
+            {agent.title}
+          </Link>
+          <span className="detail" title={agent.description}>
+            {agent.description}
+          </span>
+        </div>
+      </div>
+      <Star {...props} className="btn star" />
+      <div className="wui-card-foot">
+        <span className="wui-card-who">
+          {showApp ? <AppTag slug={agent.slug} /> : null}
+          <UserChip userId={agent.published_by} size={18} />
+        </span>
+        <Usage agent={agent} />
+        <IntroLink agent={agent} />
+      </div>
+    </li>
+  );
+}
