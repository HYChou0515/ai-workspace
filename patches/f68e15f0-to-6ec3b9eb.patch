diff --git a/web/src/lib/llmBudget.test.ts b/web/src/lib/llmBudget.test.ts
new file mode 100644
index 000000000..479bfdef2
--- /dev/null
+++ b/web/src/lib/llmBudget.test.ts
@@ -0,0 +1,105 @@
+import { QueryClient, QueryObserver } from "@tanstack/react-query";
+import { describe, expect, it, vi } from "vitest";
+
+import { qk } from "../api/queryKeys";
+import type { LlmBudget } from "../api/types";
+import { refreshBudgetAfterTurn } from "./llmBudget";
+
+// docs/plan-llm-budget.md D6 + review round 1 (#1015): a turn that ends inside
+// the server's 30 s window is answered from its cache — the figure from BEFORE
+// the turn. The page asks now, and once more when the server says its window
+// ends (`stale_in_s`), so the post-turn figure shows without any polling.
+function shownBudget(staleIn: number, fromCache = true) {
+  const qc = new QueryClient({ defaultOptions: { queries: { retry: false, staleTime: 30_000 } } });
+  const queryFn = vi.fn(
+    async (): Promise<LlmBudget> => ({ status: "ok", budget: null, stale_in_s: staleIn, from_cache: fromCache }),
+  );
+  new QueryObserver(qc, { queryKey: qk.llmBudget, queryFn }).subscribe(() => {});
+  return { qc, queryFn };
+}
+
+/** A timer the test fires by hand, recording each delay asked for. */
+function manualTimer() {
+  const armed: { fn: () => void; ms: number; live: boolean }[] = [];
+  return {
+    armed,
+    set: (fn: () => void, ms: number) => {
+      const t = { fn, ms, live: true };
+      armed.push(t);
+      return t;
+    },
+    clear: (handle: unknown) => {
+      (handle as { live: boolean }).live = false;
+    },
+    fire: () => armed.filter((t) => t.live).forEach((t) => ((t.live = false), t.fn())),
+  };
+}
+
+describe("refreshBudgetAfterTurn", () => {
+  it("asks now, then once more when the server's window ends — no further", async () => {
+    const { qc, queryFn } = shownBudget(18);
+    await vi.waitFor(() => expect(qc.getQueryData(qk.llmBudget)).toBeDefined());
+    const timer = manualTimer();
+    await refreshBudgetAfterTurn(qc, timer);
+    expect(queryFn).toHaveBeenCalledTimes(2);
+    expect(timer.armed.map((t) => t.ms)).toEqual([18_000]);
+    timer.fire();
+    await vi.waitFor(() => expect(queryFn).toHaveBeenCalledTimes(3));
+    // The follow-up ask is not itself followed: no polling.
+    expect(timer.armed).toHaveLength(1);
+  });
+
+  it("a second turn replaces the pending ask rather than adding one", async () => {
+    const { qc } = shownBudget(18);
+    await vi.waitFor(() => expect(qc.getQueryData(qk.llmBudget)).toBeDefined());
+    const timer = manualTimer();
+    await refreshBudgetAfterTurn(qc, timer);
+    await refreshBudgetAfterTurn(qc, timer);
+    expect(timer.armed.filter((t) => t.live)).toHaveLength(1);
+  });
+
+  it("schedules nothing when the server will not ask again, or nothing is shown", async () => {
+    const off = shownBudget(0);
+    await vi.waitFor(() => expect(off.qc.getQueryData(qk.llmBudget)).toBeDefined());
+    const timer = manualTimer();
+    await refreshBudgetAfterTurn(off.qc, timer);
+    expect(timer.armed).toHaveLength(0);
+
+    await refreshBudgetAfterTurn(new QueryClient(), timer); // no budget on screen
+    expect(timer.armed).toHaveLength(0);
+  });
+
+  // Review round 2 (#1015).
+  it("asks no second time when the answer was fresh — it is already the post-turn figure", async () => {
+    const { qc, queryFn } = shownBudget(30, false);
+    await vi.waitFor(() => expect(qc.getQueryData(qk.llmBudget)).toBeDefined());
+    const timer = manualTimer();
+    await refreshBudgetAfterTurn(qc, timer);
+    expect(queryFn).toHaveBeenCalledTimes(2);
+    expect(timer.armed).toHaveLength(0);
+  });
+
+  it("a fresh answer after a later turn withdraws the ask an earlier turn left pending", async () => {
+    const qc = new QueryClient({ defaultOptions: { queries: { retry: false, staleTime: 30_000 } } });
+    let fromCache = true;
+    const queryFn = vi.fn(
+      async (): Promise<LlmBudget> => ({ status: "ok", budget: null, stale_in_s: 18, from_cache: fromCache }),
+    );
+    new QueryObserver(qc, { queryKey: qk.llmBudget, queryFn }).subscribe(() => {});
+    await vi.waitFor(() => expect(qc.getQueryData(qk.llmBudget)).toBeDefined());
+    const timer = manualTimer();
+    await refreshBudgetAfterTurn(qc, timer);
+    expect(timer.armed.filter((t) => t.live)).toHaveLength(1);
+    fromCache = false;
+    await refreshBudgetAfterTurn(qc, timer);
+    expect(timer.armed.filter((t) => t.live)).toHaveLength(0);
+  });
+
+  it("two turns ending at once leave one pending ask, not two", async () => {
+    const { qc } = shownBudget(18);
+    await vi.waitFor(() => expect(qc.getQueryData(qk.llmBudget)).toBeDefined());
+    const timer = manualTimer();
+    await Promise.all([refreshBudgetAfterTurn(qc, timer), refreshBudgetAfterTurn(qc, timer)]);
+    expect(timer.armed.filter((t) => t.live)).toHaveLength(1);
+  });
+});
diff --git a/web/src/lib/llmBudget.ts b/web/src/lib/llmBudget.ts
new file mode 100644
index 000000000..ff4be22d6
--- /dev/null
+++ b/web/src/lib/llmBudget.ts
@@ -0,0 +1,53 @@
+/**
+ * Ask for the LLM budget again because a turn just ended — money was just spent
+ * (docs/plan-llm-budget.md D6). Called by every chat's turn end: the item chat
+ * (`useChatSession`) and the knowledge-base chat (`useKbChat`).
+ *
+ * The server keeps one answer per person for a window (30 s, per pod), so a turn
+ * that ends inside it is answered with the figure from BEFORE the turn. The
+ * answer says whether it came from that window (`from_cache`) and how long
+ * until the server asks the deploy's class again (`stale_in_s`); only a cached
+ * answer is asked for once more, then — a fresh one is already the post-turn
+ * figure. Both values come from the server that holds the window, not from a
+ * second copy of it here. One pending ask per client: a later turn end
+ * replaces it, even one that finishes at the same moment. No polling beyond
+ * that one ask.
+ */
+import type { QueryClient } from "@tanstack/react-query";
+
+import { qk } from "../api/queryKeys";
+import type { LlmBudget } from "../api/types";
+
+type Timer = { set: (fn: () => void, ms: number) => unknown; clear: (handle: unknown) => void };
+const realTimer: Timer = {
+  set: (fn, ms) => setTimeout(fn, ms),
+  clear: (handle) => clearTimeout(handle as ReturnType<typeof setTimeout>),
+};
+
+const pending = new WeakMap<QueryClient, unknown>();
+
+function cancelPending(qc: QueryClient, timer: Timer): void {
+  const before = pending.get(qc);
+  if (before !== undefined) {
+    timer.clear(before);
+    pending.delete(qc);
+  }
+}
+
+export async function refreshBudgetAfterTurn(qc: QueryClient, timer: Timer = realTimer): Promise<void> {
+  cancelPending(qc, timer);
+  await qc.invalidateQueries({ queryKey: qk.llmBudget });
+  const shown = qc.getQueryData<LlmBudget>(qk.llmBudget);
+  const staleIn = shown?.stale_in_s ?? 0;
+  if (shown?.from_cache && staleIn > 0) {
+    // Again, after the await: another turn end may have armed one meanwhile.
+    cancelPending(qc, timer);
+    pending.set(
+      qc,
+      timer.set(() => {
+        pending.delete(qc);
+        void qc.invalidateQueries({ queryKey: qk.llmBudget });
+      }, staleIn * 1000),
+    );
+  }
+}
