+
+def test_the_command_refuses_what_query_refuses(workspace, capsys):
+    assert (
+        main(
+            [
+                "partials",
+                json.dumps({"spec": SPEC.replace("field: value", "field: z"), "by": ["group"]}),
+            ]
+        )
+        == 2
