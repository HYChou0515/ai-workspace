+vi.mock("../hooks/useInvestigation", () => ({ useFiles: (id: string) => useFiles(id) }));
+
+const layout: LayoutNode = {
+  type: "split",
+  dir: "row",
+  ratio: 0.5,
+  a: { type: "leaf", path: "/v/a.ai.yaml" },
+  b: {
+    type: "split",
+    dir: "col",
+    ratio: 0.5,
+    a: { type: "leaf", path: "/v/b.ai.yaml" },
+    b: { type: "leaf", path: "/v/c.csv" },
+  },
+};
+
+function visit(href: string) {
