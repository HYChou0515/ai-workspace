+
+
+# Review #865 round 1 (defect B): the guard judged the path as written, so a
+# spelling the filesystem normalises -- `/./`, `//`, `x/..` -- wrote into the copy.
+@pytest.mark.parametrize(
+    "path",
+    [
+        "/./.skill/ref/docs/a.md",
+        "/.skill//ref/docs/a.md",
+        "/.skill/./ref/docs/a.md",
