+def test_diff_subtracts_the_same_aggregate_over_two_groups(dies):
+    out = apply_transforms(
+        dies,
+        [
+            {
+                "diff": {"by": "phase", "of": "after", "minus": "before"},
+                "aggregate": [{"op": "mean", "field": "t", "as": "delta"}],
+                "groupby": ["lot"],
