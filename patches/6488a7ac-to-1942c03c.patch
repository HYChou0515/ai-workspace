+    rows = dict(zip(out["lot"], out["delta"], strict=True))
+    # A: after mean(2,4)=3, before 1 → 2.   B: after 5, before mean(3,7)=5 → 0.
+    assert rows == {"A": 2.0, "B": 0.0}
