+def _ms(y: int, m: int, d: int) -> float:
+    return (dt.datetime(y, m, d, tzinfo=dt.UTC) - dt.datetime(1970, 1, 1, tzinfo=dt.UTC)) / (
+        dt.timedelta(milliseconds=1)
+    )
