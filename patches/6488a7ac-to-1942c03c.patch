+      source: "data/a.csv",
+      keys: ["lot"],
+      mark: "heatmap",
+      encoding: {
+        x: { field: "x", type: "nominal" },
+        y: { field: "y", type: "nominal" },
+        color: { field: "v", type: "quantitative" },
+      },
+    };
+    const a = answer(
+      layer("heatmap", 4, {
+        x: cat(["a", "b", "a", "b"]),
+        y: cat(["p", "p", "q", "q"]),
+        v: f64([1, 2, 3, 4]),
+        lot: cat(["L1", "L2", "L3", "L4"]),
+      }),
