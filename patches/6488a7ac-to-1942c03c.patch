+"""Review round 1 findings on the sandbox half, each with the input that
+reproduced it."""
+
+from __future__ import annotations
+
+import json
+import math
+from pathlib import Path
+
+import numpy as np
+import pandas as pd
+import pytest
+
+from chart_view.cli import main
+from chart_view.query import build
