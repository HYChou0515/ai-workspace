+
+
+def test_partials_answers_every_layer(rows):
+    spec = {
+        "view": "chart",
+        "source": "a.csv",
+        "keys": ["group", "item"],
+        "layer": [
+            {
+                "mark": "bar",
+                "encoding": {
+                    "x": GROUP,
+                    "y": {"field": "value", "type": "quantitative", "aggregate": "sum"},
+                },
