diff --git a/src/workspace_app/tooling/tool_env.py b/src/workspace_app/tooling/tool_env.py
new file mode 100644
index 000000000..401a2a08d
--- /dev/null
+++ b/src/workspace_app/tooling/tool_env.py
@@ -0,0 +1,95 @@
+"""What a caller may put in a third-party tool's environment
+(docs/plan-tool-identity-secrets.md).
+
+The caller's variables are the item's user-set ones — values a user, or an
+agent reaching this host's API directly, chooses. Most are what the tool is for
+(a token, a base URL). Some decide where the process loads CODE from, or where
+its traffic goes and whom it trusts; passing those is a way to run someone
+else's code inside the tool, beside its credentials, or to read them off the
+wire. So for an `as_tool` command they are dropped HERE, on the host — not in
+the app: this host's API can be called without the app, and a rule the caller
+applies is a rule the caller can skip.
+
+A denylist, by necessity: the names a tool legitimately reads are its author's
+choice and cannot be listed. It is drawn from sudo's `env_delete` defaults and
+widened to the interpreters, TLS stacks, proxies and package tools a bundle
+or what it shells out to will honour. Matched case-insensitively, because
+`https_proxy` is honoured as readily as `HTTPS_PROXY`.
+
+The tool's own credentials are not caller variables and are added after this.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+
+#: Built by the app: which of the caller's names are the user's own, so the
+#: launcher can restore them last. Rewritten, never dropped — a name left on it
+#: after its value is gone would be restored as EMPTY over the launcher's own.
+USER_KEYS = "SANDBOX_USER_ENV_KEYS"
+
+_EXACT = frozenset(
+    {
+        "HOME",
+        "PATH",
+        "TMPDIR",
+        "IFS",
+        "CDPATH",
+        "ENV",
+        "BASH_ENV",
+        "SHELLOPTS",
+        "BASHOPTS",
+        "PS4",
+        "GCONV_PATH",
+        "LOCPATH",
+        "NLSPATH",
+        "HOSTALIASES",
+        "RESOLV_HOST_CONF",
+        "REQUESTS_CA_BUNDLE",
+        "CURL_CA_BUNDLE",
+        "PERLLIB",
+        "PERL5LIB",
+        "PERL5OPT",
+        "RUBYLIB",
+        "RUBYOPT",
+        "JAVA_TOOL_OPTIONS",
+        "_JAVA_OPTIONS",
+        "VIRTUAL_ENV",
+        "CONDA_PREFIX",
+    }
+)
+_PREFIXES = (
+    "PYTHON",
+    "LD_",
+    "DYLD_",
+    "GLIBC_",
+    "MALLOC_",
+    "BASH_FUNC_",
+    "OPENSSL_",
+    "SSL_",
+    "NODE_",
+    "GIT_",
+    "PIP_",
+    "UV_",
+    "SANDBOX_",
+)
+
+
+def is_loader_name(name: str) -> bool:
+    upper = name.upper()
+    return (
+        upper in _EXACT
+        or upper.startswith(_PREFIXES)
+        or upper.endswith("_PROXY")
+        or upper == USER_KEYS
+    )
+
+
+def scrub_tool_env(env: Mapping[str, str]) -> dict[str, str]:
+    """`env` without the loader names, its user-key list rewritten to match."""
+    kept = {name: value for name, value in env.items() if not is_loader_name(name)}
+    if USER_KEYS in env:
+        names = [n for n in env[USER_KEYS].split() if n in kept]
+        if names:
+            kept[USER_KEYS] = " ".join(names)
+    return kept
diff --git a/src/workspace_app/tooling/tool_secrets.py b/src/workspace_app/tooling/tool_secrets.py
new file mode 100644
index 000000000..625911f57
--- /dev/null
+++ b/src/workspace_app/tooling/tool_secrets.py
@@ -0,0 +1,135 @@
+"""Credentials a third-party tool's author keeps out of its source
+(docs/plan-tool-identity-secrets.md P4).
+
+The author sets each value in the tool's GitLab CI/CD Variables and marks its
+name `"secret": true` in `env.json`. The builder SEALS the values to every
+public key in `TOOL_SECRET_RECIPIENTS` (one per deployment: staging,
+production…) and puts the result in the bundle as `SECRETS_FILE`. The sandbox
+host OPENS the entry for its own key and hands the values to that tool's
+process only — never to the agent or the user. (Every third-party tool in one
+item runs as the same tool identity, so this does not defend one tool's
+credentials against ANOTHER tool's author; malicious authors are out of scope.)
+
+HPKE (RFC 9180), base mode, X25519 + HKDF-SHA256 + ChaCha20-Poly1305, from
+`cryptography` — a published construction, not one of ours. Each ciphertext is
+bound to its variable's name through HPKE's `info`, so a value cannot be
+relabelled as another name.
+
+This file is copied byte-for-byte between `workspace_app.tooling` (the builder
+seals) and `sandbox_host` (the host opens); a test fails when they differ. So:
+no imports beyond the stdlib and `cryptography`, which both sides carry.
+"""
+
+from __future__ import annotations
+
+import base64
+import binascii
+import hashlib
+import json
+from collections.abc import Iterable, Mapping
+
+from cryptography.exceptions import InvalidTag
+from cryptography.hazmat.primitives import hpke, serialization
+from cryptography.hazmat.primitives.asymmetric.x25519 import X25519PrivateKey, X25519PublicKey
+
+#: Where the sealed values live inside a bundle, beside `launch`.
+SECRETS_FILE = ".tool-secrets.json"
+#: The CI variable listing the public keys to seal to — base64 of each raw
+#: 32-byte X25519 key, separated by whitespace. Set once, on the GitLab group,
+#: by whoever runs the platform; not a secret.
+RECIPIENTS_ENV = "TOOL_SECRET_RECIPIENTS"
+
+_FORMAT = 1
+_SUITE = hpke.Suite(hpke.KEM.X25519, hpke.KDF.HKDF_SHA256, hpke.AEAD.CHACHA20_POLY1305)
+_INFO = b"ai-workspace tool secret v1\x00"
+
+
+class SecretsError(Exception):
+    """A value cannot be sealed or opened — the message says which and why."""
+
+
+def _raw(public: X25519PublicKey) -> bytes:
+    return public.public_bytes(serialization.Encoding.Raw, serialization.PublicFormat.Raw)
+
+
+def key_id(public: X25519PublicKey) -> str:
+    """A short, stable name for a public key: what a sealed file is indexed by,
+    and what an error tells an operator to look for."""
+    return hashlib.sha256(_raw(public)).hexdigest()[:16]
+
+
+def public_key_text(public: X25519PublicKey) -> str:
+    """The form `TOOL_SECRET_RECIPIENTS` takes one of."""
+    return base64.b64encode(_raw(public)).decode()
+
+
+def parse_recipients(text: str) -> list[X25519PublicKey]:
+    keys: list[X25519PublicKey] = []
+    for word in text.split():
+        try:
+            keys.append(X25519PublicKey.from_public_bytes(base64.b64decode(word, validate=True)))
+        except (binascii.Error, ValueError) as exc:
+            raise SecretsError(
+                f"{RECIPIENTS_ENV} holds {word!r}, which is not a base64 X25519 public key "
+                f"({exc}) — ask the platform team for the current value"
+            ) from exc
+    return keys
+
+
+def private_key_from_text(text: str) -> X25519PrivateKey:
+    """The host's key file: base64 of the raw 32-byte X25519 private key."""
+    try:
+        return X25519PrivateKey.from_private_bytes(base64.b64decode(text.strip(), validate=True))
+    except (binascii.Error, ValueError) as exc:
+        raise SecretsError(
+            f"the tool secret key is not a base64 X25519 private key ({exc})"
+        ) from exc
+
+
+def _info(name: str) -> bytes:
+    return _INFO + name.encode()
+
+
+def seal(values: Mapping[str, str], recipients: Iterable[X25519PublicKey]) -> bytes:
+    """`{name: value}` sealed to every recipient, as the bytes of `SECRETS_FILE`."""
+    keys = list(recipients)
+    if not keys:
+        raise SecretsError(
+            f"env.json marks a variable secret, but {RECIPIENTS_ENV} names no public key "
+            "to seal it to — ask the platform team to set it on the GitLab group"
+        )
+    sealed = {
+        key_id(key): {
+            name: base64.b64encode(_SUITE.encrypt(value.encode(), key, info=_info(name))).decode()
+            for name, value in sorted(values.items())
+        }
+        for key in keys
+    }
+    doc = {"format": _FORMAT, "recipients": sealed}
+    return (json.dumps(doc, indent=2, sort_keys=True) + "\n").encode()
+
+
+def open_sealed(data: bytes, private: X25519PrivateKey) -> dict[str, str]:
+    """The values sealed for `private`'s public key."""
+    try:
+        doc = json.loads(data)
+        recipients = doc["recipients"]
+    except (ValueError, KeyError, TypeError) as exc:
+        raise SecretsError(f"{SECRETS_FILE} is not a sealed-secrets file ({exc})") from exc
+    if doc.get("format") != _FORMAT:
+        raise SecretsError(f"{SECRETS_FILE} has format {doc.get('format')!r}, not {_FORMAT}")
+    kid = key_id(private.public_key())
+    entry = recipients.get(kid) if isinstance(recipients, dict) else None
+    if not isinstance(entry, dict):
+        raise SecretsError(
+            f"this tool's credentials were not sealed for this deployment (key {kid}); "
+            f"add its public key to {RECIPIENTS_ENV} and rebuild the tool"
+        )
+    values: dict[str, str] = {}
+    for name, sealed in entry.items():
+        try:
+            plain = _SUITE.decrypt(base64.b64decode(sealed), private, info=_info(name))
+        except (InvalidTag, binascii.Error, ValueError, TypeError) as exc:
+            raise SecretsError(f"the sealed value of {name} does not open ({exc!r})") from exc
+        values[name] = plain.decode()
+    return values
diff --git a/tests/agent/test_exec_third_party_note.py b/tests/agent/test_exec_third_party_note.py
new file mode 100644
index 000000000..c9b3aabb7
--- /dev/null
+++ b/tests/agent/test_exec_third_party_note.py
@@ -0,0 +1,128 @@
+"""The agent's own `exec` cannot reach a third-party tool, and is told why
+(docs/plan-tool-identity-secrets.md P2).
+
+The host makes those bundles readable by the tool group only, so a shell command
+that names one fails with the kernel's "Permission denied" — accurate, and no
+help: it reads like a broken install, and the natural next move is to retry or
+to chmod. The result says instead that the tool is used through its tool call.
+"""
+
+from __future__ import annotations
+
+from agents import RunContextWrapper
+
+from workspace_app.agent import AgentToolContext, exec_impl
+from workspace_app.files import WorkspaceFiles
+from workspace_app.filestore.memory import MemoryFileStore
+from workspace_app.sandbox.mock import MockSandbox
+from workspace_app.sandbox.protocol import ExecResult, SandboxSpec
+from workspace_app.tooling.registry import CommandInfo, PackageInfo
+
+_ERP = PackageInfo(
+    name="erp",
+    install_dir="../.tools/erp",
+    commands=(CommandInfo(name="lot-status", description="d", params_json_schema={}),),
+    third_party=True,
+)
+_PLOT = PackageInfo(
+    name="sci-plot",
+    install_dir="../.tools/sci-plot",
+    commands=(CommandInfo(name="chart", description="d", params_json_schema={}),),
+)
+
+
+class _Denying(MockSandbox):
+    def __init__(self, result: ExecResult) -> None:
+        super().__init__()
+        self.result = result
+
+    async def exec(self, handle, cmd, on_output=None, env=None, exec_timeout=None, as_tool=None):
+        return self.result
+
+
+def _ctx(result: ExecResult) -> RunContextWrapper[AgentToolContext]:
+    return RunContextWrapper(
+        AgentToolContext(
+            investigation_id="inv-1",
+            sandbox=_Denying(result),
+            filestore=MemoryFileStore(),
+            files=WorkspaceFiles(MemoryFileStore()),
+            packages=[_ERP, _PLOT],
+        )
+    )
+
+
+_DENIED = ExecResult(
+    exit_code=1, stdout=b"", stderr=b"cat: ../.tools/erp/creds.py: Permission denied\n"
+)
+
+
+async def test_reading_a_third_party_tool_says_to_use_its_tool_call():
+    text = await exec_impl(_ctx(_DENIED), ["cat", "../.tools/erp/creds.py"])
+    assert "only through its tool call" in text
+    assert "`erp__lot-status`" in text
+    # The kernel's own words stay: the note explains them, it does not replace them.
+    assert "Permission denied" in text
+
+
+async def test_running_one_says_the_same():
+    result = ExecResult(
+        exit_code=126, stdout=b"", stderr=b"sh: 1: ../.tools/erp/launch: Permission denied\n"
+    )
+    text = await exec_impl(_ctx(result), ["sh", "-c", "../.tools/erp/launch lot-status {}"])
+    assert "only through its tool call" in text
+
+
+async def test_a_first_party_tool_gets_no_such_note():
+    result = ExecResult(
+        exit_code=1, stdout=b"", stderr=b"cat: ../.tools/sci-plot/x: Permission denied\n"
+    )
+    text = await exec_impl(_ctx(result), ["cat", "../.tools/sci-plot/x"])
+    assert "only through its tool call" not in text
+
+
+async def test_an_unrelated_failure_gets_no_such_note():
+    result = ExecResult(exit_code=1, stdout=b"", stderr=b"cat: notes.md: No such file\n")
+    text = await exec_impl(_ctx(result), ["cat", "notes.md"])
+    assert "only through its tool call" not in text
+
+
+async def test_a_success_that_mentions_the_path_gets_no_such_note():
+    result = ExecResult(exit_code=0, stdout=b"../.tools/erp\n", stderr=b"")
+    text = await exec_impl(_ctx(result), ["ls", "-d", "../.tools/erp"])
+    assert "only through its tool call" not in text
+
+
+async def test_an_artifact_view_plugin_gets_the_note_too():
+    """Review round 1 (F2): an `{artifact: url}` view plugin is mounted from the
+    third-party store and hidden the same way, but is not in `packages`."""
+    actx = AgentToolContext(
+        investigation_id="inv-1",
+        sandbox=_Denying(
+            ExecResult(
+                exit_code=1, stdout=b"", stderr=b"cat: ../.tools/wafermap/x: Permission denied\n"
+            )
+        ),
+        filestore=MemoryFileStore(),
+        files=WorkspaceFiles(MemoryFileStore()),
+        sandbox_spec=SandboxSpec(tools={"wafermap": "a" * 64}),
+    )
+    text = await exec_impl(RunContextWrapper(actx), ["cat", "../.tools/wafermap/x"])
+    assert "only through its tool call" in text
+
+
+async def test_a_tool_whose_name_merely_starts_the_same_gets_no_note():
+    """Review round 1: `.tools/erpnext` is not `erp`."""
+    result = ExecResult(
+        exit_code=1, stdout=b"", stderr=b"cat: ../.tools/erpnext/x: Permission denied\n"
+    )
+    text = await exec_impl(_ctx(result), ["cat", "../.tools/erpnext/x"])
+    assert "only through its tool call" not in text
+
+
+async def test_a_failure_that_was_not_refused_gets_no_such_note():
+    """The tool's path in a failure that is NOT "Permission denied" — a typo'd
+    command name, say — is not the platform hiding anything."""
+    result = ExecResult(exit_code=1, stdout=b"", stderr=b"cat: ../.tools/erp/nope: No such file\n")
+    text = await exec_impl(_ctx(result), ["cat", "../.tools/erp/nope"])
+    assert "only through its tool call" not in text
