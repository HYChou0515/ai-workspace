diff --git a/sandbox-host/tests/test_secret_flag_reaches_the_app.py b/sandbox-host/tests/test_secret_flag_reaches_the_app.py
new file mode 100644
index 000000000..127a1f840
--- /dev/null
+++ b/sandbox-host/tests/test_secret_flag_reaches_the_app.py
@@ -0,0 +1,61 @@
+"""Which names are secret travels every hop to the app
+(docs/plan-tool-identity-secrets.md P4).
+
+The app never reads a manifest: it learns a tool's `env` from `/tools/resolve`,
+which is built from a `ResolvedTool`, which an outage rebuilds from the host's
+remembered note. A hop that dropped `secret` would hand the app the machine
+password's NAME as an ordinary variable — and the environment panel would offer
+the user a field to type it into.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+from sandbox_host.artifact import CommandSpec, EnvSpec
+from sandbox_host.tool_resolve import ResolvedTool
+
+from .test_tool_resolve import _MANIFEST_URL, _bundle, _manifest, _resolver, _Wire
+from .test_tools_endpoint import _client, _Resolver
+
+_ENV = [
+    {"name": "MACHINE_PASSWORD", "description": "", "required": None, "secret": True},
+    {"name": "ERP_BASE", "description": "site", "required": False},
+]
+
+
+async def test_the_resolve_reply_says_which_names_are_secret() -> None:
+    resolver = _Resolver(
+        erp=ResolvedTool(
+            name="erp",
+            sha="a" * 64,
+            version="1.0",
+            commands=(CommandSpec("q", "q", {"type": "object"}),),
+            stale=False,
+            env=(EnvSpec("MACHINE_PASSWORD", secret=True), EnvSpec("ERP_BASE", "site", False)),
+        )
+    )
+    async with _client(resolver) as c:
+        r = await c.post("/tools/resolve", json={"tools": {"erp": "https://g/m"}})
+    assert r.json()["tools"]["erp"]["env"] == _ENV
+
+
+def test_a_resolve_carries_the_flag_from_the_manifest(tmp_path: Path) -> None:
+    data = _bundle()
+    wire = _Wire(manifest=_manifest(data, env=_ENV), bundle=data)
+    resolved = _resolver(tmp_path, wire).resolve("wafer-history", _MANIFEST_URL)
+    assert resolved.env is not None
+    assert [e.secret for e in resolved.env] == [True, False]
+
+
+def test_the_remembered_copy_keeps_the_flag(tmp_path: Path) -> None:
+    """An outage serves the remembered note; losing the flag there would show
+    the field exactly when nothing else can be checked."""
+    data = _bundle()
+    _resolver(tmp_path, _Wire(manifest=_manifest(data, env=_ENV), bundle=data)).resolve(
+        "wafer-history", _MANIFEST_URL
+    )
+    fallen_back = _resolver(tmp_path, _Wire()).resolve("wafer-history", _MANIFEST_URL)
+    assert fallen_back.stale is True
+    assert fallen_back.env is not None
+    assert [e.secret for e in fallen_back.env] == [True, False]
diff --git a/sandbox-host/tests/test_tool_group.py b/sandbox-host/tests/test_tool_group.py
new file mode 100644
index 000000000..978ff0d2f
--- /dev/null
+++ b/sandbox-host/tests/test_tool_group.py
@@ -0,0 +1,137 @@
+"""Third-party bundles are readable by the tool group only
+(docs/plan-tool-identity-secrets.md P2).
+
+Before: `root:root`, group/other may read — so the agent, running as the
+sandbox uid, could `cat` a tool's source and any credential written into it.
+After: `root:<tool group>`, and the group gets exactly the read/traverse bits
+"other" used to have — so the tool's uid reaches precisely what a sandbox could
+reach before, and "other" (the agent) reaches nothing.
+
+First-party tools (`builtin/`) and the engineer's MCP runner are untouched.
+"""
+
+from __future__ import annotations
+
+import io
+import os
+import tarfile
+from pathlib import Path
+
+from sandbox_host.config import SandboxHostSettings
+from sandbox_host.service import build_sandbox, build_tool_resolver
+from sandbox_host.tool_cache import EXT_DIR, ToolCache, _GroupHardener
+
+GROUP = 4242
+
+
+def _tar(files: dict[str, bytes]) -> bytes:
+    buf = io.BytesIO()
+    with tarfile.open(fileobj=buf, mode="w:gz") as tar:
+        for name, body in files.items():
+            info = tarfile.TarInfo(name)
+            info.size = len(body)
+            info.mode = 0o755 if name == "launch" else 0o644
+            tar.addfile(info, io.BytesIO(body))
+    return buf.getvalue()
+
+
+def _record(monkeypatch) -> tuple[list[tuple[Path, int, int]], dict[Path, int]]:
+    owned: list[tuple[Path, int, int]] = []
+    modes: dict[Path, int] = {}
+    monkeypatch.setattr(os, "lchown", lambda p, u, g: owned.append((Path(p), u, g)))
+    monkeypatch.setattr(os, "chmod", lambda p, m: modes.__setitem__(Path(p), m))
+    return owned, modes
+
+
+def test_the_group_gets_what_other_had_and_other_gets_nothing(tmp_path, monkeypatch):
+    tree = tmp_path / "staging"
+    (tree / "lib").mkdir(parents=True)
+    (tree / "launch").write_text("#!/bin/sh\n")
+    (tree / "launch").chmod(0o755)
+    (tree / "lib" / "creds.py").write_text("PASSWORD = 'x'\n")
+    (tree / "lib" / "creds.py").chmod(0o644)
+    (tree / "lib" / "private").write_text("")
+    (tree / "lib" / "private").chmod(0o600)
+    tree.chmod(0o755)
+    (tree / "lib").chmod(0o755)
+    owned, modes = _record(monkeypatch)
+
+    _GroupHardener(GROUP)(tree)
+
+    assert {p for p, _, _ in owned} == {
+        tree,
+        tree / "lib",
+        tree / "launch",
+        tree / "lib" / "creds.py",
+        tree / "lib" / "private",
+    }
+    assert all(uid == 0 and gid == GROUP for _, uid, gid in owned)
+    assert modes[tree] == 0o750
+    assert modes[tree / "lib"] == 0o750
+    assert modes[tree / "launch"] == 0o750
+    assert modes[tree / "lib" / "creds.py"] == 0o640
+    # Nobody but root could read it before; the group gains nothing either.
+    assert modes[tree / "lib" / "private"] == 0o600
+
+
+def test_group_hardening_never_follows_a_link(tmp_path, monkeypatch):
+    """Same rule as `_harden`: `lchown`, and no `chmod` through a symlink — a
+    dangling relative one is something the safe tar filter lets through."""
+    tree = tmp_path / "staging"
+    tree.mkdir()
+    (tree / "dangling").symlink_to("nowhere")
+    owned, modes = _record(monkeypatch)
+
+    _GroupHardener(GROUP)(tree)
+
+    assert (tree / "dangling", 0, GROUP) in owned
+    assert tree / "dangling" not in modes
+
+
+def test_bundles_already_on_the_host_are_hardened_again(tmp_path):
+    """A host that unpacked bundles before this change keeps them on disk, and
+    `ensure` returns early for a sha it already has — so without this, every
+    tool installed before the upgrade would stay readable by the agent."""
+    sha_a, sha_b = "a" * 64, "b" * 64
+    plain = ToolCache(tmp_path, harden=lambda _p: None)
+    plain.ensure(sha_a, _tar({"launch": b"#!/bin/sh\n"}))
+    plain.ensure(sha_b, _tar({"launch": b"#!/bin/sh\n"}))
+    (tmp_path / f".{sha_a}.half").mkdir()  # an interrupted unpack: not a bundle
+
+    hardened: list[Path] = []
+    ToolCache(tmp_path, harden=hardened.append).reharden_installed()
+
+    assert sorted(hardened) == [tmp_path / sha_a, tmp_path / sha_b]
+
+
+def test_the_production_cache_hardens_for_the_group_the_tools_run_with(tmp_path, monkeypatch):
+    """One number, two consumers: the bundles' group and the group a tool
+    command holds. Derived in one place, or a host could unpack bundles for a
+    group no tool ever joins — and then no third-party tool runs at all."""
+    monkeypatch.setenv("TOOL_BUILDER_ID", "tool-builder:2026.07")
+    settings = SandboxHostSettings(
+        uid_min=300000,
+        uid_max=300009,
+        tools_dir=str(tmp_path / "tools"),
+        cgroup_root=str(tmp_path / "cg"),
+        root=str(tmp_path / "sb"),
+    )
+    resolver = build_tool_resolver(settings)
+    assert resolver is not None
+    hardener = resolver._cache._harden
+    assert isinstance(hardener, _GroupHardener)
+    assert hardener.group == build_sandbox(settings)._tool_gid == 300000
+
+
+def test_the_production_cache_rehardens_what_it_finds_at_startup(tmp_path, monkeypatch):
+    monkeypatch.setenv("TOOL_BUILDER_ID", "tool-builder:2026.07")
+    ext = tmp_path / "tools" / EXT_DIR
+    ToolCache(ext, harden=lambda _p: None).ensure("c" * 64, _tar({"launch": b"x"}))
+    settings = SandboxHostSettings(
+        uid_min=300000, uid_max=300009, tools_dir=str(tmp_path / "tools")
+    )
+    owned, _modes = _record(monkeypatch)
+
+    build_tool_resolver(settings)
+
+    assert (ext / ("c" * 64), 0, 300000) in owned
diff --git a/sandbox-host/tests/test_tool_identity.py b/sandbox-host/tests/test_tool_identity.py
new file mode 100644
index 000000000..060f0fdd7
--- /dev/null
+++ b/sandbox-host/tests/test_tool_identity.py
@@ -0,0 +1,387 @@
+"""A third-party tool runs as the item's TOOL identity, not the sandbox's
+(docs/plan-tool-identity-secrets.md P1).
+
+The agent's own commands run as the sandbox uid; a third-party tool's command
+runs as a second pooled uid that shares the sandbox's cgroup and workspace (by
+ACL) but nothing else — its own HOME, and a group the sandbox uid never holds.
+Being a different uid is what keeps the agent from reading the running tool's
+environment (`/proc/<pid>/environ` is readable by the same uid only).
+
+L2 unit tests: the uid pool is pure and the privileged steps are seamed, so
+nothing here needs root. Real enforcement is in the root-gated integration file.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import logging
+import os
+from pathlib import Path
+
+import pytest
+
+from sandbox_host.isolated_process import IsolatedProcessSandbox, _acl_argv
+from sandbox_host.protocol import SandboxSpec
+
+TOOL_GID = 4242
+
+
+@pytest.fixture
+def tooled(tmp_path):
+    """Room in the pool for exactly one sandbox's TWO uids: the sandbox takes the
+    caller's own uid (the pool hands out from the top) so `_provision`'s raw
+    `chown` of the workspace works non-root; the tool takes the one below, whose
+    ownership handovers are recorded through `_own_privately` instead."""
+    acl: list[list[str]] = []
+    owned: list[tuple[Path, int]] = []
+    sb = IsolatedProcessSandbox(
+        root_dir=tmp_path / "sb",
+        cgroup_root=tmp_path / "cg",
+        uid_min=os.getuid() - 1,
+        uid_max=os.getuid(),
+        tool_gid=TOOL_GID,
+        acl_runner=acl.append,
+        chown_runner=lambda p, u: None,
+    )
+    sb._own_privately = lambda path, uid: owned.append((path, uid))  # ty: ignore[invalid-assignment]
+    return sb, acl, owned
+
+
+async def test_a_sandbox_gets_a_second_pooled_uid_for_its_tools(tooled):
+    sb, _acl, _owned = tooled
+    h = await sb.create(SandboxSpec())
+    ident = sb._identities[h.id]
+    assert ident.uid == os.getuid()
+    assert ident.tool_uid == os.getuid() - 1
+
+
+async def test_the_workspace_acl_grants_both_identities(tooled):
+    sb, acl, _owned = tooled
+    h = await sb.create(SandboxSpec())
+    ident = sb._identities[h.id]
+    assert ident.tool_uid is not None
+    ws = sb._workspace(h)
+    assert acl == [_acl_argv(ws, ident.uid, ident.tool_uid)]
+
+
+def test_one_acl_call_names_every_identity_and_its_default():
+    spec = "u:7:rwx,u:8:rwx"
+    assert _acl_argv(Path("/w"), 7, 8) == ["setfacl", "-R", "-m", spec, "-d", "-m", spec, "/w"]
+
+
+async def test_the_tool_identity_has_its_own_home(tooled):
+    sb, _acl, owned = tooled
+    h = await sb.create(SandboxSpec())
+    ident = sb._identities[h.id]
+    tool_home = sb._require(h) / ".tool-home"
+    assert tool_home.is_dir()
+    assert (tool_home, ident.tool_uid) in owned
+    # Never the sandbox's own HOME: that one the agent writes.
+    assert (sb._require(h) / ".home", ident.tool_uid) not in owned
+
+
+async def test_a_tool_command_runs_as_the_tool_identity_in_the_same_cgroup(tooled):
+    sb, _acl, _owned = tooled
+    h = await sb.create(SandboxSpec())
+    ident = sb._identities[h.id]
+    plain, _, _ = sb._exec_argv(h, ["true"])
+    argv, cwd, env = sb._exec_argv(h, ["../.tools/erp/launch", "q", "{}"], as_tool="erp")
+
+    assert argv[:3] == plain[:3], "joins the SAME cgroup — limits and billing unchanged"
+    assert f"--reuid={ident.tool_uid}" in argv
+    assert f"--regid={ident.tool_uid}" in argv
+    assert f"--groups={TOOL_GID}" in argv
+    assert "--clear-groups" not in argv
+    assert argv[-3:] == ["../.tools/erp/launch", "q", "{}"]
+    assert cwd == sb._workspace(h)
+    tool_home = str(sb._require(h) / ".tool-home")
+    assert env["HOME"] == tool_home
+    assert env["SANDBOX_HOME"] == tool_home
+    assert env["PYTHONNOUSERSITE"] == "1"
+    assert env["PYTHONSAFEPATH"] == "1"
+
+
+async def test_a_tool_commands_temp_files_are_its_own(tooled):
+    """Review round 3 (reproduced as root): with TMPDIR = the workspace, a tool's
+    private temp file — a credential written out for a subprocess, say — sat in
+    a directory the agent writes, so the agent could move it aside mid-run and
+    read it once the call was over. A tool's TMPDIR is under its own HOME, which
+    the agent cannot enter."""
+    sb, _acl, owned = tooled
+    h = await sb.create(SandboxSpec())
+    ident = sb._identities[h.id]
+    _argv, _cwd, env = sb._exec_argv(h, ["true"], as_tool="erp")
+    tmp = sb._require(h) / ".tool-home" / "tmp"
+    assert env["TMPDIR"] == str(tmp)
+    assert tmp.is_dir()
+    assert (tmp, ident.tool_uid) in owned
+    # The agent's own commands keep the workspace, as before.
+    _argv, cwd, env = sb._exec_argv(h, ["true"])
+    assert env["TMPDIR"] == str(cwd)
+
+
+async def test_an_ordinary_command_keeps_the_sandbox_identity(tooled):
+    sb, _acl, _owned = tooled
+    h = await sb.create(SandboxSpec())
+    ident = sb._identities[h.id]
+    argv, _cwd, env = sb._exec_argv(h, ["true"])
+    assert f"--reuid={ident.uid}" in argv
+    assert "--clear-groups" in argv
+    assert not any(a.startswith("--groups") for a in argv)
+    assert env["HOME"] == str(sb._require(h) / ".home")
+    assert "PYTHONNOUSERSITE" not in env
+
+
+async def test_the_tool_identity_owns_its_home_on_every_tool_exec(tooled):
+    """Same shape as `.home`: re-established per exec, so a home the exec path
+    had to recreate is never handed to the tool owned by this service."""
+    sb, _acl, owned = tooled
+    h = await sb.create(SandboxSpec())
+    ident = sb._identities[h.id]
+    owned.clear()
+    sb._exec_argv(h, ["true"], as_tool="erp")
+    assert (sb._require(h) / ".tool-home", ident.tool_uid) in owned
+
+
+async def test_kill_returns_both_uids_to_the_pool(tooled, monkeypatch):
+    sb, _acl, _owned = tooled
+    # Freed uids come back in a different order, so the second sandbox may get
+    # the uid that is not the caller's — `_provision`'s raw chown would then need
+    # root. Ownership is not what this test is about.
+    monkeypatch.setattr(os, "chown", lambda *a, **k: None)
+    h = await sb.create(SandboxSpec())
+    await sb.kill(h)
+    # A pool of exactly two: a leaked tool uid makes this create raise.
+    h2 = await sb.create(SandboxSpec())
+    ident = sb._identities[h2.id]
+    assert {ident.uid, ident.tool_uid} == {os.getuid(), os.getuid() - 1}
+
+
+async def test_the_callers_env_cannot_move_a_tools_home(tooled, monkeypatch):
+    """The caller's variables win over the exec path's own — except the names
+    that define the tool identity's environment. A `HOME` the agent can write is
+    a user site the tool would import from."""
+    sb, _acl, _owned = tooled
+    h = await sb.create(SandboxSpec())
+    seen: dict[str, str] = {}
+
+    async def fake_spawn(*_argv, env, **_kw):
+        seen.update(env)
+        raise FileNotFoundError
+
+    monkeypatch.setattr(asyncio, "create_subprocess_exec", fake_spawn)
+    # No tool is mounted in this fixture; what an as_tool exec may be is pinned
+    # in test_as_tool_is_enforced_here.py. This test is about HOME only.
+    monkeypatch.setattr(sb, "_refuse_tool_exec", lambda *_a: None)
+    await sb.exec(
+        h,
+        ["../.tools/erp/launch", "q", "{}"],
+        env={"HOME": "/root/evil", "SANDBOX_HOME": "/root/evil", "PYTHONNOUSERSITE": "0"},
+        as_tool="erp",
+    )
+    tool_home = str(sb._require(h) / ".tool-home")
+    assert seen["HOME"] == tool_home
+    assert seen["SANDBOX_HOME"] == tool_home
+    assert seen["PYTHONNOUSERSITE"] == "1"
+
+
+async def test_an_ordinary_commands_env_still_wins(tooled, monkeypatch):
+    """The pin is for tool commands only: the agent's own `exec` keeps the
+    precedence it always had."""
+    sb, _acl, _owned = tooled
+    h = await sb.create(SandboxSpec())
+    seen: dict[str, str] = {}
+
+    async def fake_spawn(*_argv, env, **_kw):
+        seen.update(env)
+        raise FileNotFoundError
+
+    monkeypatch.setattr(asyncio, "create_subprocess_exec", fake_spawn)
+    await sb.exec(h, ["true"], env={"HOME": "/elsewhere"})
+    assert seen["HOME"] == "/elsewhere"
+
+
+async def test_without_a_tool_group_a_tool_command_runs_as_the_sandbox(tmp_path, caplog):
+    """A host built without a tool group cannot separate the two; it says so once,
+    at construction, rather than pretending."""
+    with caplog.at_level(logging.WARNING):
+        sb = IsolatedProcessSandbox(
+            root_dir=tmp_path / "sb",
+            cgroup_root=tmp_path / "cg",
+            uid_min=os.getuid(),
+            uid_max=os.getuid(),
+            acl_runner=lambda argv: None,
+            chown_runner=lambda p, u: None,
+        )
+    assert "third-party tools run as the sandbox's own uid" in caplog.text
+    h = await sb.create(SandboxSpec())
+    assert sb._identities[h.id].tool_uid is None
+    argv, _cwd, _env = sb._exec_argv(h, ["true"], as_tool="erp")
+    assert f"--reuid={os.getuid()}" in argv
+    assert "--clear-groups" in argv
+
+
+async def test_a_failed_create_gives_back_every_uid_and_leaves_no_dir(tmp_path, monkeypatch):
+    """Review round 1: a pool with room for the sandbox uid but not the tool's
+    raised after taking the first one, which was then never freed."""
+    sb = IsolatedProcessSandbox(
+        root_dir=tmp_path / "sb",
+        cgroup_root=tmp_path / "cg",
+        uid_min=os.getuid(),
+        uid_max=os.getuid(),
+        tool_gid=TOOL_GID,
+        acl_runner=lambda argv: None,
+        chown_runner=lambda p, u: None,
+    )
+    with pytest.raises(RuntimeError, match="exhausted"):
+        await sb.create(SandboxSpec())
+    assert sb._pool._used == set()
+    assert list((tmp_path / "sb").iterdir()) == []
+
+
+async def test_a_create_that_fails_later_gives_its_uids_back_too(tooled, monkeypatch):
+    sb, _acl, _owned = tooled
+
+    def boom(*_a, **_k):
+        raise OSError("setfacl failed")
+
+    monkeypatch.setattr(sb, "_provision", boom)
+    with pytest.raises(OSError):
+        await sb.create(SandboxSpec())
+    assert sb._pool._used == set()
+
+
+def _record_around(sb, monkeypatch):
+    """Record, in order, the per-call widenings, any root walk, and the spawn."""
+    order: list[str] = []
+    monkeypatch.setattr(
+        sb, "_run_as", lambda uid, argv: order.append(f"as {uid}: {' '.join(argv[:3])}")
+    )
+    monkeypatch.setattr(sb, "_acl_runner", lambda argv: order.append("ROOT setfacl"))
+    monkeypatch.setattr(sb, "_chown_runner", lambda path, uid: order.append("ROOT chown"))
+
+    async def fake_spawn(*_argv, **_kw):
+        order.append("run")
+        raise FileNotFoundError
+
+    monkeypatch.setattr(asyncio, "create_subprocess_exec", fake_spawn)
+    return order
+
+
+async def test_around_a_tool_call_each_identity_opens_its_own_files_to_the_other(
+    tooled, monkeypatch
+):
+    """Review round 1 (regression, reproduced as root): a mode set after creation
+    shrinks a file's ACL mask, so the tool could not write where the agent had
+    unpacked an archive, and the agent could not read the tool's 0600 file.
+
+    Review round 2 (reproduced as root): fixing that with a ROOT `setfacl -R` or
+    `chown` walk over the workspace lets a process the agent left running swap a
+    file for a symlink mid-walk and have root grant it any file on the host. So
+    each identity widens ITS OWN files' group class (`chmod g+rwX` sets the mask
+    on a file that has an ACL), as itself: the sandbox uid before the call, the
+    tool uid after. A race can then only make a uid change what it already owns."""
+    sb, _acl, _owned = tooled
+    h = await sb.create(SandboxSpec())
+    ident = sb._identities[h.id]
+    order = _record_around(sb, monkeypatch)
+    monkeypatch.setattr(sb, "_refuse_tool_exec", lambda *_a: None)
+
+    await sb.exec(h, ["../.tools/erp/launch", "q", "{}"], as_tool="erp")
+
+    assert order == [
+        f"as {ident.uid}: find {sb._workspace(h)} (",
+        "run",
+        f"as {ident.tool_uid}: find {sb._workspace(h)} -user",
+    ]
+
+
+async def test_no_root_walk_happens_around_a_tool_call(tooled, monkeypatch):
+    sb, _acl, _owned = tooled
+    h = await sb.create(SandboxSpec())
+    order = _record_around(sb, monkeypatch)
+    monkeypatch.setattr(sb, "_refuse_tool_exec", lambda *_a: None)
+    await sb.exec(h, ["../.tools/erp/launch", "q", "{}"], as_tool="erp")
+    assert not [o for o in order if o.startswith("ROOT")]
+
+
+async def test_the_widening_runs_on_the_workspace_and_nowhere_else(tooled, monkeypatch):
+    sb, _acl, _owned = tooled
+    h = await sb.create(SandboxSpec())
+    seen: list[list[str]] = []
+    monkeypatch.setattr(sb, "_run_as", lambda uid, argv: seen.append(argv))
+    monkeypatch.setattr(sb, "_refuse_tool_exec", lambda *_a: None)
+
+    async def fake_spawn(*_argv, **_kw):
+        raise FileNotFoundError
+
+    monkeypatch.setattr(asyncio, "create_subprocess_exec", fake_spawn)
+    await sb.exec(h, ["../.tools/erp/launch", "q", "{}"], as_tool="erp")
+    ws = str(sb._workspace(h))
+    ident = sb._identities[h.id]
+    # Before: the agent's directories, and the files its group can already read
+    # (644 -> 664) — so the tool can create where the agent unpacked and edit
+    # what it could edit before; a file the agent made 600 (an SSH key) stays
+    # 600, as it chose (review round 2, M1). After: the tool's OWN files only.
+    assert seen == [
+        [
+            "find",
+            ws,
+            "(",
+            "-type",
+            "d",
+            "-o",
+            "-perm",
+            "-g+r",
+            ")",
+            "-exec",
+            "chmod",
+            "g+rwX",
+            "{}",
+            "+",
+        ],
+        ["find", ws, "-user", str(ident.tool_uid), "-exec", "chmod", "g+rwX", "{}", "+"],
+    ]
+
+
+async def test_a_refused_tool_call_touches_nothing(tooled, monkeypatch):
+    """Not a walk of the workspace for every request the agent sends itself."""
+    sb, _acl, _owned = tooled
+    h = await sb.create(SandboxSpec())
+    order = _record_around(sb, monkeypatch)
+    result = await sb.exec(h, ["sh", "-c", "id"], as_tool="erp")
+    assert result.exit_code == 126
+    assert order == []
+
+
+async def test_the_agents_own_command_walks_nothing(tooled, monkeypatch):
+    sb, _acl, _owned = tooled
+    h = await sb.create(SandboxSpec())
+    order = _record_around(sb, monkeypatch)
+    await sb.exec(h, ["true"])
+    assert order == ["run"]
+
+
+async def test_reown_after_a_restore_is_chown_only_as_it_was(tooled, monkeypatch):
+    """Round 2 removed the ACL re-apply round 1 added to `reown`: a restore keeps
+    the archived 770/660 modes (verified as root in round 1), so it bought
+    nothing — and it was one more root `setfacl -R` over an agent's tree."""
+    sb, acl, _owned = tooled
+    h = await sb.create(SandboxSpec())
+    acl.clear()
+    await sb.reown(h)
+    assert acl == []
+
+
+async def test_a_tool_command_points_at_nothing_the_agent_fills(tooled):
+    """Review rounds 1 and 3: the sandbox's PATH starts with a `python` shim that
+    can route to the project venv the agent fills, and these names point a
+    program at that venv, uv's cache or the shim's dir."""
+    from sandbox_host.local_process import _TOOL_PATH
+
+    sb, _acl, _owned = tooled
+    h = await sb.create(SandboxSpec())
+    _argv, _cwd, env = sb._exec_argv(h, ["true"], as_tool="erp")
+    assert env["PATH"] == _TOOL_PATH
+    for name in ("VIRTUAL_ENV", "UV_PROJECT_ENVIRONMENT", "UV_CACHE_DIR", "SANDBOX_JAILBIN"):
+        assert name not in env, name
