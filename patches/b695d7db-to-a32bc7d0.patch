index 00000000..d3fc8ae2
--- /dev/null
+++ b/web/src/components/schedules/RunsAs.test.tsx
@@ -0,0 +1,149 @@
+// @vitest-environment happy-dom
+/**
+ * Who a schedule runs as, and why (`docs/plan-schedule-run-as.md` G8) — ONE
+ * control, drawn the same way on the schedules overview, in the item's
+ * Workflows panel and in a page's own schedules list (G9, NN/g consistency).
+ */
+import "@testing-library/jest-dom/vitest";
+import { cleanup, fireEvent, screen, waitFor, within } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+
+vi.mock("../../api", () => ({
+  api: {
+    getUsers: vi.fn(async () => [
+      { id: "carol", name: "Carol", section: "QA", email: "carol@x" },
+      { id: "dave", name: "Dave", section: "QA", email: "dave@x" },
+    ]),
+  },
+}));
+
+import type { ScheduleBindingsClient } from "../../api/scheduleBindings";
+import type { RunsAsReason } from "../../api/schedules";
+import { translate } from "../../lib/i18n";
+import { renderWithQuery } from "../../test/queryWrapper";
+import { RunsAs } from "./RunsAs";
+
+afterEach(cleanup);
+
+const word = (key: Parameters<typeof translate>[1], vars?: Record<string, string | number>) =>
+  translate("zh-TW", key, vars);
+
+function bindings(): ScheduleBindingsClient {
+  return {
+    list: vi.fn(async () => []),
+    bind: vi.fn(async () => {}),
+    unbind: vi.fn(async () => {}),
+    assign: vi.fn(async () => {}),
+  };
+}
+
+function draw({
+  who = "",
+  reason = "" as RunsAsReason,
+  by = "",
+  mine = false,
+  canRun = true,
+  canAssign = false,
+  client = bindings(),
+} = {}) {
+  const onChanged = vi.fn();
+  renderWithQuery(
+    <RunsAs
+      slug="rca"
+      itemId="i-1"
+      path="/.workflows/schedules.json"
+      triggerId="k-1"
+      runsAs={{ who, reason, by, mine }}
+      canRun={canRun}
+      canAssign={canAssign}
+      client={client}
+      onChanged={onChanged}
+    />,
+  );
+  return { client, onChanged };
+}
+
+describe("what it says", () => {
+  it("names the author as the reason it runs as them", () => {
+    draw({ who: "bob", reason: "author" });
+    expect(screen.getByTestId("runs-as")).toHaveTextContent(
+      word("sched.runsAsWhy", { main: word("sched.runsAs", { who: "bob" }), why: word("sched.why.author") }),
+    );
+  });
+
+  it("says it is you, and that you chose it", () => {
+    draw({ who: "me", reason: "self", mine: true });
+    expect(screen.getByTestId("runs-as")).toHaveTextContent(
+      word("sched.runsAsWhy", { main: word("sched.runsAsYou"), why: word("sched.why.selfYou") }),
+    );
+  });
+
+  it("says it is you when you wrote it", () => {
+    draw({ who: "me", reason: "author", mine: true });
+    expect(screen.getByTestId("runs-as")).toHaveTextContent(word("sched.why.authorYou"));
+  });
+
+  it("names the administrator who chose the person", () => {
+    draw({ who: "carol", reason: "admin", by: "root" });
+    expect(screen.getByTestId("runs-as")).toHaveTextContent(word("sched.why.admin", { by: "root" }));
+  });
+
+  it("says plainly that nobody's own values are used", () => {
+    draw();
+    expect(screen.getByTestId("runs-as")).toHaveTextContent(word("sched.runsAsNobody"));
+  });
+});
+
+describe("what it lets you do", () => {
+  it("runs a schedule nobody holds as you, at once", async () => {
+    const { client, onChanged } = draw();
+    fireEvent.click(screen.getByRole("button", { name: word("sched.bindMe") }));
+    await waitFor(() =>
+      expect(client.bind).toHaveBeenCalledWith("rca", "i-1", "/.workflows/schedules.json", "k-1"),
+    );
+    await waitFor(() => expect(onChanged).toHaveBeenCalled());
+  });
+
+  it("asks before taking a schedule over from someone", async () => {
+    const { client } = draw({ who: "bob", reason: "author" });
+    fireEvent.click(screen.getByRole("button", { name: word("sched.replaceMe") }));
+    const dialog = await screen.findByRole("dialog");
+    expect(client.bind).not.toHaveBeenCalled();
+    fireEvent.click(within(dialog).getByRole("button", { name: word("sched.replaceMe") }));
+    await waitFor(() => expect(client.bind).toHaveBeenCalled());
+  });
+
+  it("lets the person it runs as stop it", async () => {
+    const { client } = draw({ who: "me", reason: "admin", by: "root", mine: true });
+    fireEvent.click(screen.getByRole("button", { name: word("sched.unbind") }));
+    await waitFor(() => expect(client.unbind).toHaveBeenCalled());
+  });
+
+  it("offers nothing to someone who may not run work in the item", () => {
+    draw({ who: "bob", reason: "author", canRun: false });
+    expect(screen.queryByRole("button")).toBeNull();
+  });
+
+  it("lets an administrator choose someone else", async () => {
+    const { client } = draw({ who: "bob", reason: "author", canAssign: true });
+    fireEvent.click(screen.getByRole("button", { name: word("sched.assign") }));
+    const dialog = await screen.findByRole("dialog");
+    fireEvent.click(await within(dialog).findByText("Carol"));
+    await waitFor(() =>
+      expect(client.assign).toHaveBeenCalledWith("rca", "i-1", "/.workflows/schedules.json", "k-1", "carol"),
+    );
+  });
+
+  it("says why a change was refused", async () => {
+    const client = bindings();
+    client.bind = vi.fn(async () => {
+      throw Object.assign(new Error("x"), { detail: "nope" });
+    });
+    const { onChanged } = draw({ client });
+    fireEvent.click(screen.getByRole("button", { name: word("sched.bindMe") }));
+    expect(await screen.findByRole("alert")).toHaveTextContent("nope");
+    // Refused because the row changed meanwhile: the list is refetched, so it
+    // shows what IS there (review round 1).
+    await waitFor(() => expect(onChanged).toHaveBeenCalled());
+  });
+});
diff --git a/web/src/components/schedules/RunsAs.tsx b/web/src/components/schedules/RunsAs.tsx
new file mode 100644
index 00000000..64efc41a
--- /dev/null
+++ b/web/src/components/schedules/RunsAs.tsx
@@ -0,0 +1,194 @@
+/**
+ * Who a schedule runs as, and why (`docs/plan-schedule-run-as.md` G8).
+ *
+ * ONE control for every place a schedule is listed — the schedules overview,
+ * the item's Workflows panel, a page's own schedules list — so the same fact is
+ * said in the same words with the same buttons wherever a person meets it
+ * (G9; NN/g, *Consistency and Standards*: "use the same patterns everywhere").
+ *
+ * Running as someone uses their own sign-ins and values, an act with
+ * consequences for them, so it is always said, never implied (NN/g, *Visibility
+ * of System Status*): who, and why it is them — they chose it, they wrote the
+ * row, or an administrator named them.
+ */
+import { useMutation } from "@tanstack/react-query";
+import { useState } from "react";
+
+import { type ScheduleBindingsClient, scheduleBindingsApi } from "../../api/scheduleBindings";
+import type { RunsAsReason } from "../../api/schedules";
+import { useT } from "../../lib/i18n";
+import { pxToRem } from "../../lib/pxToRem";
+import { useDialog } from "../Dialog";
+import { ModalShell } from "../ModalShell";
+import { UserPicker } from "../UserPicker";
+
+export type RunsAsFacts = {
+  /** Who it runs as; `""` = nobody. */
+  who: string;
+  reason: RunsAsReason;
+  /** The administrator who named them, for `admin`. */
+  by: string;
+  /** Whether that is the viewer. */
+  mine: boolean;
+};
+
+/** The sentence: "runs as X (why)", or "nobody's own values". */
+export function runsAsText(r: RunsAsFacts, t: ReturnType<typeof useT>): string {
+  if (!r.who) return t("sched.runsAsNobody");
+  const main = r.mine ? t("sched.runsAsYou") : t("sched.runsAs", { who: r.who });
+  const why =
+    r.reason === "admin"
+      ? t("sched.why.admin", { by: r.by })
+      : r.reason === "author"
+        ? t(r.mine ? "sched.why.authorYou" : "sched.why.author")
+        : t(r.mine ? "sched.why.selfYou" : "sched.why.self");
+  return t("sched.runsAsWhy", { main, why });
+}
+
+export function RunsAs({
+  slug,
+  itemId,
+  path,
+  triggerId,
+  runsAs,
+  canRun,
+  canAssign,
+  client = scheduleBindingsApi,
+  onChanged,
+}: {
+  slug: string;
+  itemId: string;
+  /** The schedules file the row lives in. */
+  path: string;
+  triggerId: string;
+  runsAs: RunsAsFacts;
+  /** May the viewer run work in the item (`execute`) — "Run as me". */
+  canRun: boolean;
+  /** Is the viewer an administrator — "Choose…" someone else. */
+  canAssign: boolean;
+  client?: ScheduleBindingsClient;
+  /** After a change landed — the caller refetches its rows. */
+  onChanged?: () => void;
+}) {
+  const t = useT();
+  const dialog = useDialog();
+  const [problem, setProblem] = useState<string | null>(null);
+  const [choosing, setChoosing] = useState(false);
+  const change = useMutation({
+    mutationFn: (act: { kind: "bind" } | { kind: "unbind" } | { kind: "assign"; user: string }) =>
+      act.kind === "assign"
+        ? client.assign(slug, itemId, path, triggerId, act.user)
+        : act.kind === "bind"
+          ? client.bind(slug, itemId, path, triggerId)
+          : client.unbind(slug, itemId, path, triggerId),
+    onMutate: () => setProblem(null),
+    // Refused or not, the list is read again: a refusal is usually "this row
+    // changed meanwhile", and the list should then show what IS there.
+    onSettled: () => onChanged?.(),
+    onError: (err) => {
+      const why = (err as { detail?: unknown })?.detail;
+      setProblem(t("sched.failed", { why: typeof why === "string" ? why : String((err as Error).message) }));
+    },
+  });
+
+  const runAsMe = async () => {
+    if (runsAs.who) {
+      // Taking it over from someone: they lose it, and are told — so ask.
+      const choice = await dialog.confirm({
+        title: t("sched.replaceTitle"),
+        body: t("sched.replaceBody", { who: runsAs.who }),
+        actions: [
+          { id: "cancel", label: t("env.cancel") },
+          { id: "replace", label: t("sched.replaceMe"), variant: "primary" },
+        ],
+      });
+      if (choice !== "replace") return;
+    }
+    change.mutate({ kind: "bind" });
+  };
+
+  return (
+    <div style={{ display: "grid", gap: 4 }}>
+      <span data-testid="runs-as" style={{ fontSize: pxToRem(12) }}>
+        {runsAsText(runsAs, t)}
+      </span>
+      <span style={{ display: "flex", flexWrap: "wrap", gap: 6 }}>
+        {runsAs.mine ? (
+          <button
+            type="button"
+            className="btn"
+            data-variant="secondary"
+            data-size="sm"
+            disabled={change.isPending}
+            onClick={() => change.mutate({ kind: "unbind" })}
+          >
+            {t("sched.unbind")}
+          </button>
+        ) : canRun ? (
+          <button
+            type="button"
+            className="btn"
+            data-variant="secondary"
+            data-size="sm"
+            disabled={change.isPending}
+            onClick={() => void runAsMe()}
+          >
+            {runsAs.who ? t("sched.replaceMe") : t("sched.bindMe")}
+          </button>
+        ) : null}
+        {canAssign ? (
+          <button
+            type="button"
+            className="btn"
+            data-variant="secondary"
+            data-size="sm"
+            disabled={change.isPending}
+            onClick={() => setChoosing(true)}
+          >
+            {t("sched.assign")}
+          </button>
+        ) : null}
+      </span>
+      {problem ? (
+        <span role="alert" style={{ fontSize: pxToRem(11), color: "var(--err)" }}>
+          {problem}
+        </span>
+      ) : null}
+      {choosing ? (
+        // Nothing typed to lose: picking a person IS the act, so a stray click
+        // beside the panel may close it (#779 — a picker that applies live).
+        <ModalShell
+          onClose={() => setChoosing(false)}
+          ariaLabel={t("sched.assignTitle")}
+          width={360}
+          maxWidth="92vw"
+          closeOnBackdrop
+          panelStyle={{ padding: 16, display: "grid", gap: 8 }}
+        >
+          <strong>{t("sched.assignTitle")}</strong>
+          <p style={{ margin: 0, fontSize: pxToRem(12), color: "var(--text-paper-d)" }}>
+            {t("sched.assignBody")}
+          </p>
+          <UserPicker
+            selected={runsAs.who ? [runsAs.who] : []}
+            onToggle={(user) => {
+              setChoosing(false);
+              change.mutate({ kind: "assign", user });
+            }}
+            placeholder={t("sched.assignSearch")}
+          />
+          <button
+            type="button"
+            className="btn"
+            data-variant="secondary"
+            data-size="sm"
+            style={{ justifySelf: "end" }}
+            onClick={() => setChoosing(false)}
+          >
+            {t("env.cancel")}
+          </button>
+        </ModalShell>
+      ) : null}
+    </div>
+  );
+}
diff --git a/web/src/components/schedules/ScheduleRowParts.tsx b/web/src/components/schedules/ScheduleRowParts.tsx
new file mode 100644
index 00000000..96ebfe82
--- /dev/null
+++ b/web/src/components/schedules/ScheduleRowParts.tsx
@@ -0,0 +1,294 @@
+/**
+ * One schedule row's parts — where it lives, when it runs next, how it last
+ * went, who it runs as, and the acts on it — shared by the schedules overview
+ * (a table) and the item's Workflows panel (a list).
+ *
+ * The two screens list the SAME rows (`GET /schedules`, and its narrowing to
+ * one item), so they must say each thing in the same words with the same
+ * buttons (`docs/plan-schedule-run-as.md` G9; NN/g, *Consistency and
+ * Standards*). They differ only in arrangement: a wide table there, a stacked
+ * card here. Anything a row SAYS lives in this file, never in either screen.
+ */
+import { useMutation, useQueryClient } from "@tanstack/react-query";
+import { useState } from "react";
+import { Link } from "react-router-dom";
+
+import { qk } from "../../api/queryKeys";
+import {
+  type OverviewRow,
+  type RowRef,
+  ScheduleActionError,
+  type SchedulesApi,
+  mayRunNow,
+} from "../../api/schedules";
+import { wuiAddress } from "../../api/wui";
+import { describeSchedule } from "../../lib/describeSchedule";
+import { executionPath, OPEN_PARAM } from "../../lib/executionTab";
+import { type MsgKey, useT } from "../../lib/i18n";
+import { fullTime, whenText } from "../../lib/scheduleTime";
+import type { ViewerClock } from "../../lib/viewerClock";
+import { useDialog } from "../Dialog";
+import { ScheduleTimeModal } from "../ScheduleTimeModal";
+import { RunsAs } from "./RunsAs";
+
+export const ITEM_SCHEDULES = "/.workflows/schedules.json";
+
+/** The folder a page's schedules file sits in; "" for the item's own. */
+export const folderOf = (row: Pick<OverviewRow, "path">) =>
+  row.path === ITEM_SCHEDULES ? "" : row.path.slice(0, row.path.lastIndexOf("/"));
+
+/** Where a schedule lives, in words: the item, and the page when it is a
+ * page's — by the page's title, its folder only when it has none. */
+export function placeOf(row: OverviewRow, t: ReturnType<typeof useT>): string {
+  const item = row.item_title || row.item_id;
+  const folder = folderOf(row);
+  if (!folder) return item;
+  return `${item} · ${t("scheduleOverview.page", { page: row.page_title || folder })}`;
+}
+
+/** The workflow a row runs, by the name people gave it. */
+export const workflowName = (row: Pick<OverviewRow, "run" | "run_title">) => row.run_title || row.run || "—";
+
+/** A row's React key: its identity, not its position — keyed by position, a
+ * row's own state (Run now's "started", an open editor) moved to whichever
+ * row slid into its place when one above it went (review round 1). A row the
+ * sweep refuses has no identity; its position is all there is. */
+export const rowKey = (row: Pick<OverviewRow, "item_id" | "path" | "trigger_id" | "index">) =>
+  `${row.item_id}${row.path}#${row.trigger_id || `@${row.index}`}`;
+
+const itemHrefOf = (row: OverviewRow) =>
+  `/a/${encodeURIComponent(row.slug)}/${encodeURIComponent(row.item_id)}`;
+
+/** An execution opens as a tab in its item (plan-workflow-out-of-chat P11). */
+const runHrefOf = (row: OverviewRow, runId: string) =>
+  runId ? `${itemHrefOf(row)}?${OPEN_PARAM}=${encodeURIComponent(executionPath(runId))}` : itemHrefOf(row);
+
+/** Every cache that lists this row: the overview, the item's panel, the file
+ * tree (the file was just rewritten), the item's chats (Run now may have made
+ * the schedule's own), its executions. */
+export function useRefreshSchedules(row: Pick<OverviewRow, "slug" | "item_id">) {
+  const qc = useQueryClient();
+  return () =>
+    Promise.all([
+      qc.invalidateQueries({ queryKey: qk.schedulesOverview }),
+      qc.invalidateQueries({ queryKey: qk.itemSchedules(row.slug, row.item_id) }),
+      qc.invalidateQueries({ queryKey: qk.files(row.item_id) }),
+      qc.invalidateQueries({ queryKey: qk.itemChats(row.slug, row.item_id) }),
+      qc.invalidateQueries({ queryKey: qk.workflowRuns(row.slug, row.item_id) }),
+    ]);
+}
+
+/** Where it lives. ``withItem``: name the item too (the overview spans items;
+ * the item's own panel does not need to say which item it is). */
+export function ScheduleWhere({ row, withItem }: { row: OverviewRow; withItem: boolean }) {
+  const t = useT();
+  const folder = folderOf(row);
+  const label = folder ? t("scheduleOverview.page", { page: row.page_title || folder }) : t("scheduleOverview.itemOwn");
+  return (
+    <>
+      {withItem ? <Link to={itemHrefOf(row)}>{row.item_title || row.item_id}</Link> : null}
+      <div className="detail">
+        {folder && row.page_path ? (
+          <a href={wuiAddress(row.slug, row.item_id, row.page_path)} target="_blank" rel="noreferrer">
+            {label}
+          </a>
+        ) : (
+          label
+        )}
+      </div>
+    </>
+  );
+}
+
+/** When it runs next, or why it will not. */
+export function ScheduleNext({ row, clock }: { row: OverviewRow; clock: ViewerClock }) {
+  const t = useT();
+  if (row.problems.length > 0) return <>{`${t("schedules.invalidRow")} ${row.problems.join(" ")}`}</>;
+  if (!row.known) return <>{t("schedules.unknownWorkflow")}</>;
+  if (row.run_problem) return <>{`${t("schedules.brokenWorkflow")} ${row.run_problem}`}</>;
+  if (!row.runnable || row.next_ms === null) return <>—</>;
+  if (row.due_now) return <>{t("scheduleOverview.nextSweep")}</>;
+  return (
+    <span title={fullTime(row.next_ms, clock.viewer, t)}>
+      {whenText(row.next_ms, clock.now, clock.viewer, t, "future")}
+    </span>
+  );
+}
+
+/** How it last went — a link to that execution — or that it never ran. */
+export function ScheduleLast({ row, clock }: { row: OverviewRow; clock: ViewerClock }) {
+  const t = useT();
+  const last = row.last_run;
+  if (!last) return <>{t("scheduleOverview.never")}</>;
+  const lastAt = last.ended ?? last.started;
+  return (
+    <Link to={runHrefOf(row, last.run_id)} title={lastAt ? fullTime(lastAt, clock.viewer, t) : undefined}>
+      <span className="schedule-status" data-status={last.status}>
+        {t(`scheduleOverview.status.${last.status}` as MsgKey)}
+      </span>
+      {last.by_hand ? <span className="schedule-tag">{t("scheduleOverview.byHand")}</span> : null}{" "}
+      {lastAt ? whenText(lastAt, clock.now, clock.viewer, t, "past") : null}
+    </Link>
+  );
+}
+
+/** Who it runs as, and why — with "Run as me" / "Choose…". A row the sweep
+ * refuses has no identity, so nobody can be bound to it. */
+export function ScheduleRunsAs({ row, canAssign }: { row: OverviewRow; canAssign: boolean }) {
+  const refresh = useRefreshSchedules(row);
+  if (!row.trigger_id) return <>—</>;
+  return (
+    <RunsAs
+      slug={row.slug}
+      itemId={row.item_id}
+      path={row.path}
+      triggerId={row.trigger_id}
+      runsAs={{ who: row.runs_as, reason: row.runs_as_reason, by: row.runs_as_by, mine: row.runs_as_mine }}
+      canRun={row.can_run}
+      canAssign={canAssign}
+      onChanged={() => void refresh()}
+    />
+  );
+}
+
+/** The acts on a row — Run now, change its time, remove it — with what came
+ * of the last one. Per row, so one row's pending press does not hold every
+ * other row's buttons. */
+export function ScheduleActions({
+  row,
+  client,
+  clock,
+}: {
+  row: OverviewRow;
+  client: SchedulesApi;
+  clock: ViewerClock;
+}) {
+  const t = useT();
+  const dialog = useDialog();
+  const refresh = useRefreshSchedules(row);
+  const [editing, setEditing] = useState(false);
+  const [failed, setFailed] = useState<string | null>(null);
+  // After Run now: the run the row showed as its last when it was pressed.
+  // The note stays until the row shows any other run — that one is the press's
+  // (or a fire that overtook it), and the last-run cell then says everything
+  // the note would. Not "until it shows the run id the press got back": a
+  // reply without one, or an overtaking fire, left the note up for good.
+  const [started, setStarted] = useState<{ before: string | null; runId: string } | null>(null);
+  // A row the sweep refuses has no identity; Remove finds it by its value.
+  const ref: RowRef = {
+    path: row.path,
+    trigger_id: row.trigger_id,
+    raw: row.trigger_id ? undefined : row.raw,
+    index: row.trigger_id ? undefined : row.index,
+  };
+  const fail = (e: unknown) => setFailed(e instanceof ScheduleActionError ? e.message : String(e));
+  const runNow = useMutation({
+    mutationFn: (_before: string | null) => client.runNow(row.slug, row.item_id, ref),
+    onSuccess: (runId, before) => {
+      setStarted({ before, runId });
+      return refresh();
+    },
+    onError: fail,
+  });
+  const remove = useMutation({
+    mutationFn: () => client.remove(row.slug, row.item_id, ref),
+    onError: fail,
+    // Refused ("this schedule has changed") or not, show what the file holds now.
+    onSettled: refresh,
+  });
+  const period = describeSchedule(row, clock, t);
+  const workflow = workflowName(row);
+  const askRemove = async () => {
+    const choice = await dialog.confirm({
+      title: t("schedules.removeTitle"),
+      body: t("scheduleOverview.removeConfirm", { place: placeOf(row, t), period: period.text, workflow }),
+      // The safe answer first: the destructive one is never what a stray
+      // Enter or the first focus lands on.
+      actions: [
+        { id: "cancel", label: t("schedules.cancel") },
+        { id: "remove", label: t("schedules.remove"), variant: "danger" },
+      ],
+    });
+    if (choice === "remove") remove.mutate();
+  };
+  // A row the sweep refuses has no identity: it has no time to move and
+  // nothing that would run, so only Remove (by its value) applies.
+  const identified = row.trigger_id !== "";
+  const showStarted = started !== null && (row.last_run?.run_id ?? null) === started.before;
+
+  return (
+    <>
+      <div className="schedule-actions">
+        {mayRunNow(row, row.can_run) ? (
+          <button
+            type="button"
+            className="btn"
+            data-variant="secondary"
+            data-size="sm"
+            disabled={runNow.isPending}
+            onClick={() => {
+              setFailed(null);
+              runNow.mutate(row.last_run?.run_id ?? null);
+            }}
+          >
+            {t("schedules.runNow")}
+          </button>
+        ) : null}
+        {row.can_edit && identified ? (
+          <button
+            type="button"
+            className="btn"
+            data-variant="secondary"
+            data-size="sm"
+            onClick={() => {
+              setFailed(null);
+              setEditing(true);
+            }}
+          >
+            {t("schedules.editTime")}
+          </button>
+        ) : null}
+        {row.can_edit ? (
+          <button
+            type="button"
+            className="btn"
+            data-variant="danger"
+            data-size="sm"
+            disabled={remove.isPending}
+            aria-label={`${t("schedules.remove")} ${placeOf(row, t)} · ${period.text} → ${workflow}`}
+            onClick={() => {
+              setFailed(null);
+              void askRemove();
+            }}
+          >
+            {t("schedules.remove")}
+          </button>
+        ) : null}
+      </div>
+      {showStarted ? (
+        <div className="detail" role="status">
+          {t("schedules.started")} · <Link to={runHrefOf(row, started?.runId ?? "")}>{t("scheduleOverview.seeRun")}</Link>
+        </div>
+      ) : null}
+      {failed ? (
+        <div className="detail schedule-problem" role="alert">
+          {failed}
+        </div>
+      ) : null}
+      {editing ? (
+        <ScheduleTimeModal
+          raw={row.raw}
+          nextMs={row.next_ms}
+          rowRef={ref}
+          runsAsEditor={row.can_run}
+          onSave={(r, time) => client.editTime(row.slug, row.item_id, r, time)}
+          onSaved={() => {
+            setEditing(false);
+            void refresh();
+          }}
+          onClose={() => setEditing(false)}
+        />
+      ) : null}
+    </>
+  );
+}
