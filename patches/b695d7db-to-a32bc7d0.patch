+    client, runner = _pod(spec, reply="from the peer")
+    histories: list[str] = []
+    original = runner.run
+
+    async def spying(prompt, ctx):  # noqa: ANN001, ANN202
+        histories.append(" | ".join(h["content"] for h in ctx.history))
+        async for ev in original(prompt, ctx):
