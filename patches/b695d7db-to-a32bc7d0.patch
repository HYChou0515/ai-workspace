diff --git a/web/tests/itemVerbParity.test.ts b/web/tests/itemVerbParity.test.ts
new file mode 100644
index 00000000..9d734b8f
--- /dev/null
+++ b/web/tests/itemVerbParity.test.ts
@@ -0,0 +1,26 @@
+/**
+ * The browser's copy of `perm.authorize` for an item (`hasItemVerb`) — used to
+ * decide which buttons to draw. Held to the table the backend generates and
+ * re-checks (`tests/fixtures/item_verb_cases.json`), so an implication added on
+ * one side (docs/plan-wui-user.md D9/D10: converse and execute imply use_wui;
+ * use_wui implies read_content) cannot be missing on the other.
+ *
+ * In `web/tests/`, not beside the module: the fixtures live outside `web/`.
+ */
+import { describe, expect, it } from "vitest";
+
+import table from "../../tests/fixtures/item_verb_cases.json";
+
+import { hasItemVerb, type ItemPermission, type ItemVerb } from "../src/lib/itemPermission";
+
+type Case = { granted: string[]; answers: Record<string, boolean> };
+
+describe("hasItemVerb", () => {
+  it.each(table.cases as Case[])("agrees with authorize: %j", (c) => {
+    const perm: ItemPermission = { visibility: "restricted" };
+    for (const verb of c.granted) (perm as Record<string, unknown>)[verb] = ["user:alice"];
+    for (const [verb, want] of Object.entries(c.answers)) {
+      expect([verb, hasItemVerb(perm, "alice", "bob", verb as ItemVerb, false)]).toEqual([verb, want]);
+    }
+  });
+});
diff --git a/web/tests/sizeSpellings.test.ts b/web/tests/sizeSpellings.test.ts
new file mode 100644
index 00000000..e059c2a3
--- /dev/null
+++ b/web/tests/sizeSpellings.test.ts
@@ -0,0 +1,23 @@
+/**
+ * The client reads each size spelling as the bytes the server reads it as.
+ *
+ * The sheet, `tests/fixtures/size_spellings.json`, is graded against the
+ * server's `parse_size` in `tests/quota/test_size_spellings.py`; this file asks
+ * only whether the client agrees. Outside `src/` for the reason
+ * `itemSizeParity.test.ts` gives: the web image does not carry `tests/fixtures/`.
+ */
+import { describe, expect, it } from "vitest";
+
+import sheet from "../../tests/fixtures/size_spellings.json";
+import { normaliseMemory, parseSize } from "../src/components/ItemEnvironmentSize";
+
+describe("the client reads sizes as the server does", () => {
+  it("every row of the sheet", () => {
+    for (const row of sheet.rows) {
+      // Not a size → nothing to send at all (review: a huge fraction became
+      // the literal "Infinity", which read back as null and slipped through).
+      expect(normaliseMemory(row.typed) === null, row.typed.slice(0, 40)).toBe(row.bytes === null);
+      expect(parseSize(normaliseMemory(row.typed)), row.typed.slice(0, 40)).toBe(row.bytes);
+    }
+  });
+});
