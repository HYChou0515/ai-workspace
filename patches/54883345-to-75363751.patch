+<!doctype html>
+<html lang="zh-Hant">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>抽取判準的調校紀錄</title>
+<style>
+:root {
+  --paper: #f6f8f7;  --card: #ffffff;  --ink: #16201f;  --muted: #667573;
+  --rule: #dae1df;   --hold: #0f6f6a;  --tune: #b4762a;  --alarm: #a8322a;
+  --best: #9aa8a5;
+  --serif: "Iowan Old Style", "Source Han Serif TC", "Noto Serif TC", "Songti TC", Georgia, serif;
