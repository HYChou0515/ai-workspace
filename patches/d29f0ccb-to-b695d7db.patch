+    vi.spyOn(workflowApi, "listProfiles").mockResolvedValue([]);
+    vi.spyOn(workspaceWorkflowsApi, "list").mockResolvedValue([
+      { id: "good", title: "Good one", phases: [{ id: "a", title: "A" }] },
