+def _two_step_run(calls: list, fail_second: int = 1):
+    async def run(wf, inputs):
+        await run_step(wf, name="first", phase="think", args={"a": 1}, execute=_rec(calls, "first"))
+        await run_step(
+            wf,
+            name="second",
+            phase="review",
+            args={"b": 1},
+            execute=_flaky(calls, "second", fail_second),
+        )
+        return {"ok": True}
+
+    return run
