+def _flaky(calls: list, name: str, fail_times: int):
+    """An execute that fails its first ``fail_times`` attempts, then passes."""
+
+    async def execute(_fb):
+        calls.append(name)
+        if calls.count(name) <= fail_times:
+            raise RuntimeError(f"{name} broke")
+        return {name: True}
+
+    return execute
+
