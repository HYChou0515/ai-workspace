+      </button>
+    );
+  if (viewHref)
+    return (
+      <a href={viewHref} target="_blank" rel="noreferrer" style={frame({})}>
+        {body}
+      </a>
+    );
+  return <div style={frame({})}>{body}</div>;
+}
