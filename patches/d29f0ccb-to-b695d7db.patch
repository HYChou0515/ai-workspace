+    msg({ content: "Read 12 wafers", run_id: "workflow-run:r1", step: "read", phase: "read" }),
+    msg({ role: "user", content: "Sort them by defect", run_id: "workflow-run:r1", step: "sort", phase: "sort", driven_by: "workflow" }),
