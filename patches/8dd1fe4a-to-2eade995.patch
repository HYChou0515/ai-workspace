+def test_a_backend_that_overruns_its_budget_is_abandoned_at_the_budget(workspace):
+    job = _sent(workspace)
+    Remote.machine.delay["cancel"] = 30
+
+    outcome = _ask("cancel", {"job_id": job})
+
+    assert outcome.exit_code == 2
+    assert "0.5s" in outcome.error
