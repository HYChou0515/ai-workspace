+            why.append(f"you are not holding {', '.join(unheld)} yourself")
+        return (
+            f"error: cannot grant {', '.join(outside)} to a sub-agent — {'; and '.join(why)}. "
+            f"Available: {', '.join(sorted(allowed)) or 'none'}"
+        )
