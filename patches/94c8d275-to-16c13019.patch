     assert "name" in read_skill_tool.params_json_schema["properties"]  # ty: ignore
     assert "read_skill" in {t.name for t in build_tools(app_slug="rca", profile="local-lab")}
     assert _IMPLS["read_skill"] is read_skill_impl
