diff --git a/tests/api/test_rabbitmq_event_bus.py b/tests/api/test_rabbitmq_event_bus.py
index 39f30ea7..2ad6cebe 100644
--- a/tests/api/test_rabbitmq_event_bus.py
+++ b/tests/api/test_rabbitmq_event_bus.py
@@ -124,3 +124,269 @@ def test_a_frame_from_a_pod_that_predates_event_ids_still_delivers():
