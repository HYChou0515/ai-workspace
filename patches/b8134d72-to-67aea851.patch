@@ -0,0 +1,419 @@
+/* docs/plan-tool-usage-stats.md — the administrator's tool-usage tab
+   (`pages/ToolUsagePanel.tsx`). Its own classes. */
+
+.tool-usage-controls {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: flex-end;
+  gap: var(--space-12);
+  margin-bottom: var(--space-12);
+}
+
+.tool-usage-controls label {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-4);
+  font-size: var(--text-small);
+  color: var(--text-paper-d);
+}
+
+/* Material 3 segmented buttons: one outlined row, the chosen segment filled. */
+.tool-usage-segmented {
+  display: inline-flex;
+  border: 1px solid var(--paper-3);
+  border-radius: var(--radius-btn);
+  overflow: hidden;
+}
+
+.tool-usage-segmented button {
+  padding: 6px 14px;
+  border: none;
+  border-left: 1px solid var(--paper-3);
+  background: transparent;
+  color: var(--text-paper);
+  font-size: var(--text-small);
+  cursor: pointer;
+}
+
+.tool-usage-segmented button:first-child {
+  border-left: none;
+}
+
+.tool-usage-segmented button[aria-pressed="true"] {
+  background: var(--accent-soft);
+  color: var(--accent-h);
+  font-weight: 600;
+}
+
+/* A wide table scrolls inside itself rather than widening the page. */
+.tool-usage-scroll {
+  overflow-x: auto;
+  max-width: 100%;
+}
+
+.tool-usage-table {
+  width: 100%;
+  border-collapse: collapse;
+  font-size: var(--text-small);
+}
+
+.tool-usage-table th {
+  font-weight: 600;
+  color: var(--text-paper-d);
+  white-space: nowrap;
+}
+
+.tool-usage-table tr[aria-selected="true"] td {
+  background: var(--accent-soft);
+}
+
+/* The tool name opens its breakdown: a link-styled button, not a filled one. */
+.tool-usage-tool {
+  border: none;
+  background: none;
+  padding: 0;
+  color: var(--accent-h);
+  font-family: var(--font-mono);
+  font-size: inherit;
+  text-align: left;
+  cursor: pointer;
+  overflow-wrap: anywhere;
+}
+
+.tool-usage-tool:hover {
+  text-decoration: underline;
+}
+
+.tool-usage-note {
+  color: var(--text-paper-d);
+}
+
+/* A row's details (§3.6): a nonmodal side panel beside the table (NN/g, Data
+   Tables) — fixed to the right below the top bar; the full width on a phone. */
+.tool-usage-sidepanel {
+  position: fixed;
+  top: var(--nav-height);
+  right: 0;
+  bottom: 0;
+  width: min(420px, 100vw);
+  overflow-y: auto;
+  padding: var(--space-16);
+  background: var(--paper);
+  border-left: 1px solid var(--paper-3);
+  box-shadow: -8px 0 24px rgb(0 0 0 / 0.08);
+  /* The rail's band: furniture beside the page, under menus and modals. */
+  z-index: var(--z-rail);
+}
+
+.tool-usage-sidepanel-head {
+  display: flex;
+  align-items: flex-start;
+  justify-content: space-between;
+  gap: var(--space-8);
+}
+
+/* The name can be one long unbroken identifier: it wraps, and never pushes ✕
+   out of the panel. */
+.tool-usage-detail-title {
+  margin: 0;
+  min-width: 0;
+  font-family: var(--font-mono);
+  font-size: var(--text-body-lg);
+  overflow-wrap: anywhere;
+}
+
+/* While a panel is open on a wide screen, the page makes room for it, so the
+   part's own controls (來源, the CSV link) and the table's right columns are
+   not under it. The page's box is inline-styled (DiagnosticsPage), hence the
+   `!important`; it widens by the panel's width and pads it back out, so the
+   content keeps its width and moves left. */
+@media (min-width: 1100px) {
+  [data-testid="page-diagnostics"] > div:has(.tool-usage-sidepanel) {
+    max-width: calc(760px + 420px) !important;
+    padding-right: calc(20px + 420px) !important;
+  }
+}
+
+.tool-usage-sidepanel-close {
+  border: none;
+  background: none;
+  cursor: pointer;
+  color: var(--text-paper-d);
+  font-size: var(--text-body);
+  padding: 2px 6px;
+}
+
+.tool-usage-detail-which {
+  display: block;
+  font-size: var(--text-small);
+  color: var(--text-paper-d);
+}
+
+.tool-usage-detail-what {
+  margin: 0;
+  font-size: var(--text-small);
+  color: var(--text-paper-d);
+}
+
+/* The totals, first and in words. */
+.tool-usage-detail-summary {
+  margin: var(--space-8) 0 0;
+  font-size: var(--text-body-lg);
+  font-weight: 600;
