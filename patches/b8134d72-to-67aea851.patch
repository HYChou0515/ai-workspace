+}
+
+.tool-usage-cellbar-num.is-inside {
+  color: var(--text-dark);
+}
+
+.tool-usage-detail-part {
+  margin: var(--space-16) 0 var(--space-4);
+  font-size: var(--text-small);
+  color: var(--text-paper-d);
+}
+
+/* §8.4: tools and skills, each a part of the page — its title and its own
+   source filter, its charts, its table. */
+.tool-usage-part {
+  margin-top: var(--space-24);
+}
+
+.tool-usage-part-head {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: flex-end;
+  justify-content: space-between;
+  gap: var(--space-12);
+  margin-bottom: var(--space-12);
+}
+
+.tool-usage-part-title {
+  margin: 0;
+  font-size: var(--text-body-lg);
+}
+
+/* The part's own controls together, on the right of its title. */
+.tool-usage-part-tools {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: flex-end;
+  gap: var(--space-12);
+}
+
+.tool-usage-part-head label {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-4);
+  font-size: var(--text-small);
+  color: var(--text-paper-d);
+}
+
+/* Charts side by side when there is room, stacked on a phone. */
+.tool-usage-charts {
