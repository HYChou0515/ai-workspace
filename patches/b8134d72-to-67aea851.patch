+  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
+  gap: var(--space-16);
+  margin-bottom: var(--space-16);
+}
+
+.tool-usage-bars {
+  margin: 0;
+  min-width: 0;
+}
+
+.tool-usage-bars-title {
+  margin-bottom: var(--space-8);
+  font-size: var(--text-small);
+  font-weight: 600;
