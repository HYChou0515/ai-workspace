+    width: 84px;
+    min-width: 84px;
+  }
+}
+
+.tool-usage-cellbar {
+  position: relative;
+  display: block;
+  height: 18px;
+}
+
+.tool-usage-cellbar [data-bar] {
+  position: absolute;
+  left: 0;
+  top: 0;
+  bottom: 0;
+  min-width: 2px;
+  border-radius: 0 2px 2px 0;
+  background: var(--accent-h);
+}
+
+.tool-usage-cellbar-num {
+  position: absolute;
+  top: 0;
+  line-height: 18px;
+  padding: 0 4px;
