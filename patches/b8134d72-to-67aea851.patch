diff --git a/tests/test_tool_usage_wiring.py b/tests/test_tool_usage_wiring.py
new file mode 100644
index 00000000..95ba55c7
--- /dev/null
+++ b/tests/test_tool_usage_wiring.py
@@ -0,0 +1,169 @@
+"""The composition roots hand the runner and the writer ONE recorder
+(docs/plan-tool-usage-stats.md §3.5) — two recorders would count every call
+into one and write the other, which is empty: a report that reads zero."""
+
+from __future__ import annotations
+
+from textwrap import dedent
+
+from workspace_app.config.loader import load
+
+
+def _settings(tmp_path):  # noqa: ANN001, ANN202
+    cfg = tmp_path / "config.yaml"
+    cfg.write_text(
+        dedent(f"""
+            server:
+              run_consumers: false
+            filestore:
+              kind: specstar
+            sandbox:
+              root: {tmp_path / "sandbox"}
+            skill_hub:
+              git_root: {tmp_path / "skill-hub-git"}
+            kb:
+              embedder:
+                model: ""
+        """),
+        encoding="utf-8",
+    )
+    return load(config_path=cfg, env={})
+
+
+def test_the_api_counts_into_the_recorder_it_writes(tmp_path, monkeypatch) -> None:  # noqa: ANN001
+    from workspace_app.__main__ import build_app
+
+    monkeypatch.setattr("workspace_app.__main__.PACKAGES", {})
+    app = build_app(_settings(tmp_path), config_dir=None)
+
+    store = app.state.tool_usage_store
+    runner = app.state.turn_engine._runner  # noqa: SLF001
+    assert store is not None
+    assert runner._tool_usage is store._recorder  # noqa: SLF001
+
+
+def test_a_worker_counts_into_the_recorder_it_writes(tmp_path) -> None:  # noqa: ANN001
+    from workspace_app.agent.tool_usage import ToolUsageRecorder
+    from workspace_app.factories import get_runner
+
+    rec = ToolUsageRecorder()
+
+    runner = get_runner(_settings(tmp_path), tool_usage=rec)
+
+    assert runner._tool_usage is rec  # ty: ignore[unresolved-attribute]  # noqa: SLF001
+
+
+def test_a_bundle_worker_writes_what_its_agents_count_through_the_spec_they_use(
+    tmp_path, monkeypatch
+) -> None:  # noqa: ANN001
+    """A wiki / card-gen worker: the recorder `build_bundle` hands its agents is
+    the one written, through the bundle's own spec — not a second backend
+    connection opened just to write the counts (review r1)."""
+    import workspace_app.worker.__main__ as wm
+
+    seen: dict = {}
+    real = wm.build_bundle
+
+    def spy(settings, spec, **kw):  # noqa: ANN001, ANN003, ANN202
+        seen["spec"], seen["rec"] = spec, kw["tool_usage"]
+        return real(settings, spec, **kw)
+
+    monkeypatch.setattr(wm, "build_bundle", spy)
+    monkeypatch.setattr("workspace_app.api.tool_usage_store.writer_name", lambda: "vm-4242")
+
+    worker = wm.build_worker(_settings(tmp_path), "wiki", config_dir=None)
+
+    store = worker.usage_store
+    assert store is not None
+    assert store._recorder is seen["rec"]  # noqa: SLF001
+    assert store._spec is seen["spec"]  # noqa: SLF001
+    assert store._pod == "vm-4242"  # this process's rows, never the API's (r2)  # noqa: SLF001
+
+
+def test_an_api_composed_worker_writes_the_apps_own_counts(tmp_path, monkeypatch) -> None:  # noqa: ANN001
+    """blob-gc / chat-video are composed by `build_app`, whose runner counts into
+    the APP's recorder — a separate recorder in the worker would be flushed
+    empty while the app's is never written (review r1)."""
+    import workspace_app.__main__ as main_mod
+    import workspace_app.worker.__main__ as wm
+
+    monkeypatch.setattr("workspace_app.__main__.PACKAGES", {})
+    built: list = []
+    real = main_mod.build_app
+
+    def spy(settings, **kw):  # noqa: ANN001, ANN003, ANN202
+        built.append(real(settings, **kw))
+        return built[-1]
+
+    monkeypatch.setattr(main_mod, "build_app", spy)
+
+    worker = wm.build_worker(_settings(tmp_path), "chat-video", config_dir=None)
+
+    assert worker.usage_store is built[0].state.tool_usage_store
+
+
+def test_a_worker_writes_what_its_jobs_count_while_draining() -> None:
+    """SIGTERM sets `stop`; the coordinator then drains, and a job finishing in
+    that drain counts tool calls. The last write must come AFTER the drain —
+    one triggered by the same `stop` runs before it and loses them (review r1)."""
+    import threading
+
+    from workspace_app.agent.tool_usage import ToolUsageRecorder
+    from workspace_app.worker.__main__ import serve
+
+    rec = ToolUsageRecorder()
+    written: list[int] = []
+
+    class _Store:
+        def flush(self) -> None:
+            written.append(len(rec.drain()))
+
+    class _Coordinator:
+        def start_consuming(self) -> None:
+            pass
+
+        async def aclose(self) -> None:
+            import asyncio
+
+            await asyncio.sleep(0.3)  # the drain: a job finishing late
+            rec.record(
+                "read_file",
+                "builtin",
+                surface="background",
+                user="",
+                app="",
+                item="",
+                ms=5,
+                failed=False,
+            )
+
+    stop = threading.Event()
+    stop.set()
+
+    serve(_Coordinator(), _Store(), stop, interval=3600)
+
+    assert sum(written) == 1
+
+
+def test_the_worker_process_serves_the_writer_it_built(tmp_path, monkeypatch) -> None:  # noqa: ANN001
+    import workspace_app.worker.__main__ as wm
+
+    settings = _settings(tmp_path)
+    monkeypatch.setattr(
+        "workspace_app.config.loader.load_with_provenance",
+        lambda **_kw: (settings, None),
+    )
+    monkeypatch.setattr("workspace_app.observability.setup.install_llm_logging", lambda _s: None)
+    store, coordinator = object(), object()
+    monkeypatch.setattr(wm, "build_worker", lambda *_a, **_kw: wm.Worker(coordinator, store))  # ty: ignore[invalid-argument-type]
+    served: list = []
+    monkeypatch.setattr(
+        wm, "serve", lambda c, s, stop, *, interval: served.append((c, s, interval))
+    )
+    monkeypatch.setattr(wm.signal, "signal", lambda *_a: None)
+
+    wm.main(["wiki"])
+
+    from workspace_app.api.tool_usage_store import FLUSH_INTERVAL_S
+
+    assert served == [(coordinator, store, FLUSH_INTERVAL_S)]
diff --git a/tests/workflow/test_page_jobs.py b/tests/workflow/test_page_jobs.py
new file mode 100644
index 00000000..753d93c7
--- /dev/null
+++ b/tests/workflow/test_page_jobs.py
@@ -0,0 +1,447 @@
+"""A page job is a run (`docs/plan-wui-call-agent.md` D5, D6).
+
+What a page starts with `startTool` / `startAgent` (and what `callAgent` waits
+on) is one `WorkflowRun`: the same record, stop and retention a workflow run
+has, carrying `page_job` instead of a manifest. The work itself is handed in by
+the API at start and runs on this pod; nothing re-drives it after a restart, so
+a job past its deadline is over whatever its row still says.
+"""
+
+import asyncio
+
+import pytest
+from specstar import SpecStar
+from specstar.types import ResourceIDNotFoundError
+
+from tests.workflow.test_orchestrator import _clock, _orch
+from workspace_app.workflow.orchestrator import TooManyPageJobs
+from workspace_app.workflow.run import PageJob, RunStatus, WorkflowRun
+from workspace_app.workflow.run_identity import RunIdentities, register_run_identity
+
+
+@pytest.fixture
+def spec_instance(spec_instance: SpecStar) -> SpecStar:
+    register_run_identity(spec_instance)  # registered post-`make_spec` in the app
+    return spec_instance
+
+
+async def _never(_wf):  # pragma: no cover - the test never lets it finish
+    raise AssertionError("must not be reached")
+
+
+def _job(name: str = "summarise", kind: str = "agent") -> PageJob:
+    return PageJob(kind=kind, name=name, input="hello")
+
+
+async def _start(orch, work, *, item="i1", job=None, chat="c1"):
+    return await orch.start_page_job(
+        item_id=item,
+        captured_user="owner",
+        env_user="clicker",
+        chat_id=chat,
+        job=job or _job(),
+        work=work,
+    )
+
+
+async def _settle(orch, run_id: str) -> None:
+    task = orch._tasks.get(run_id)
+    if task is not None:
+        await asyncio.wait({task})
+
+
+async def test_a_job_is_a_run_record_that_ends_with_the_works_answer(spec_instance: SpecStar):
+    seen = []
+
+    async def work(wf):
+        seen.append((wf.user, wf.run_id))
+        return {"output": "done!", "failed": False}
+
+    orch, _ = _orch(spec_instance, _never)
+    run_id = await _start(orch, work)
+    await _settle(orch, run_id)
+
+    row = spec_instance.get_resource_manager(WorkflowRun).get(run_id).data
+    assert isinstance(row, WorkflowRun)
+    assert row.status is RunStatus.DONE
+    assert row.page_job is not None
+    assert row.page_job == PageJob(
+        kind="agent", name="summarise", input="hello", deadline=row.page_job.deadline
+    )
+    assert row.chat_id == "c1" and row.captured_user == "owner"
+    assert seen == [("owner", run_id)], "billed to the owner, on its own run's handle"
+    state = await orch.page_job_state(run_id, "i1")
+    assert (state.state, state.output, state.error) == (
+        "done",
+        {"output": "done!", "failed": False},
+        None,
+    )
+
+
+async def test_the_clicker_is_who_its_private_values_come_from(spec_instance: SpecStar):
+    """D11: billed to the owner, the presser's own values — as `startRun`."""
+    orch, _ = _orch(spec_instance, _never)
+    run_id = await _start(orch, lambda _wf: asyncio.sleep(0, {"output": ""}))
+    ident = RunIdentities(spec_instance).get(run_id)
+    assert ident is not None and ident.env_user == "clicker" and ident.verb == "execute"
+
+
+async def test_a_running_job_reads_as_running(spec_instance: SpecStar):
+    gate = asyncio.Event()
+
+    async def work(_wf):
+        await gate.wait()
+        return {"output": "x"}
+
+    orch, _ = _orch(spec_instance, _never)
+    run_id = await _start(orch, work)
+    await asyncio.sleep(0)
+    assert (await orch.page_job_state(run_id, "i1")).state == "running"
+    gate.set()
+    await _settle(orch, run_id)
+
+
+async def test_a_job_whose_work_raises_reads_as_failed_with_the_reason(spec_instance: SpecStar):
+    async def work(_wf):
+        raise RuntimeError("sandbox went away")
+
+    orch, fakes = _orch(spec_instance, _never)
+    run_id = await _start(orch, work)
+    await _settle(orch, run_id)
+    state = await orch.page_job_state(run_id, "i1")
+    assert state.state == "failed" and "sandbox went away" in (state.error or "")
+    assert fakes.released == [], "a page job never tears down the item's sandbox"
+
+
+async def test_a_stopped_job_reads_as_stopped(spec_instance: SpecStar):
+    async def work(_wf):
+        await asyncio.Event().wait()
+
+    orch, _ = _orch(spec_instance, _never)
+    run_id = await _start(orch, work)
+    await asyncio.sleep(0)
+    assert await orch.cancel(run_id, "i1")
+    assert (await orch.page_job_state(run_id, "i1")).state == "stopped"
+
+
+async def test_a_job_has_a_total_time_cap(spec_instance: SpecStar):
+    async def work(_wf):
+        await asyncio.Event().wait()
+
+    orch, _ = _orch(spec_instance, _never, page_job_timeout_s=0.01)
+    run_id = await _start(orch, work)
+    await _settle(orch, run_id)
+    state = await orch.page_job_state(run_id, "i1")
+    assert state.state == "failed" and "0.01" in (state.error or "")
+
+
+async def test_at_most_four_jobs_run_at_once_on_one_item(spec_instance: SpecStar):
+    """D6 — the fifth is refused, a sibling item is not affected, and a
+    finished job frees its place."""
+    gates = [asyncio.Event() for _ in range(4)]
+
+    def waiting(gate):
+        async def work(_wf):
+            await gate.wait()
+            return {"output": ""}
+
+        return work
+
+    orch, _ = _orch(spec_instance, _never)
+    ids = [await _start(orch, waiting(g), chat=f"c{n}") for n, g in enumerate(gates)]
+    with pytest.raises(TooManyPageJobs):
+        await _start(orch, waiting(asyncio.Event()), chat="c9")
+    other = await _start(orch, waiting(gates[0]), item="i2", chat="c10")
+
+    gates[0].set()
+    await _settle(orch, ids[0])
+    await _settle(orch, other)
+    fifth = await _start(orch, lambda _wf: asyncio.sleep(0, {"output": ""}), chat="c11")
+    await _settle(orch, fifth)
+    for g in gates:
+        g.set()
+    for rid in ids:
+        await _settle(orch, rid)
+
+
+async def test_the_cap_is_a_setting(spec_instance: SpecStar):
+    orch, _ = _orch(spec_instance, _never, page_job_limit=1)
+    gate = asyncio.Event()
+
+    async def work(_wf):
+        await gate.wait()
+        return {"output": ""}
+
+    first = await _start(orch, work)
+    with pytest.raises(TooManyPageJobs):
+        await _start(orch, work, chat="c2")
+    gate.set()
+    await _settle(orch, first)
+
+
+async def test_a_workflow_run_does_not_take_a_page_jobs_place(spec_instance: SpecStar):
+    gate = asyncio.Event()
+
+    async def run(_wf, _inputs):
+        await gate.wait()
+        return {}
+
+    orch, _ = _orch(spec_instance, run, page_job_limit=1)
+    wf_run = await orch.start(slug="rca", item_id="i1", profile="p", captured_user="u", chat_id="w")
+    job = await _start(orch, lambda _wf: asyncio.sleep(0, {"output": ""}))
+    await _settle(orch, job)
+    gate.set()
+    await _settle(orch, wf_run)
+
+
+async def test_a_job_lost_with_its_pod_is_over_once_past_its_deadline(spec_instance: SpecStar):
+    """Nothing re-drives a page job (its work lived in the dead pod's memory),
+    so a row still RUNNING past its deadline is read as failed, settled as such,
+    and no longer holds one of the item's places."""
+    clock = [10_000]
+    orch, _ = _orch(spec_instance, _never, now=lambda: clock[0], page_job_limit=1)
+    rm = spec_instance.get_resource_manager(WorkflowRun)
+    lost = rm.create(
+        WorkflowRun(
