__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
dist/
build/

# Editor / IDE
.vscode/

# Local runtime state (specstar DB written when you run the server).
/data/

# Claude Code local-only settings
.claude/settings.local.json
.workspace-tools/
.workspace-tools-uvrun/
# the merged tools root plus its lock/stamp and any staging/retired tree
.workspace-tools*-with-view-plugins*
# #847/#848: installed runtime view plugins (`make view-plugins`) and each
# plugin package's own build deps.
.view-plugins/
view-plugins/*/web/node_modules/

# Per-deploy config (copy from config.example.yaml).  See factories.Settings.
/config.yaml

# Observability: startup resolved-config dump (real secrets, 0600) + the
# faithful LLM call log. Both are local runtime artifacts, never committed.
config.resolved.yaml
/logs/
# The LLM call log the app writes wherever it is started from — a run artifact,
# never source. `/logs/` only covers a backend started at the repo root; one
# started from `web/` (or any subdir) puts it there instead, and it reached a
# commit that way.
**/logs/llm/

# mkdocs build output
/site/

# docs/plan-ext-ai.md D7: the company's site file — packed into the helper with
# `--ext-ai-site`, never committed (its URL is the company's own)
ai-workspace-helper/src/ai_workspace_helper/ext_ai_site.py
