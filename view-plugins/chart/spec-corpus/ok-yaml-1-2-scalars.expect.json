{
  "view": "chart",
  "source": "data/flags.csv",
  "keys": [
    "answer",
    "code",
    "slot",
    "day"
  ],
  "mark": "bar",
  "encoding": {
    "x": {
      "field": "answer",
      "type": "nominal"
    },
    "y": {
