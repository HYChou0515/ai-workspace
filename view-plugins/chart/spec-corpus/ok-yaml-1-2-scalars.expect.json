        "yes",
        "on",
        "off",
        "y",
        "n",
        "NO"
      ],
      "code": [
        17,
        15,
        31,
        "1_000",
        1,
        0.5,
        1000,
        1
      ],
      "slot": [
        "12:30",
        "12:30:00"
      ],
      "day": [
        "2024-01-01",
        "2024-01-01T10:00:00Z",
        true,
        false
      ]
    }
  }
}
