    "stackColour": {
      "description": "A stack (a bar or an area with stack: true) is summed per slot and colour; a colour by value makes no segments.",
      "if": {
        "required": [
          "mark"
        ],
        "properties": {
          "mark": {
            "type": "object",
            "required": [
              "type",
              "stack"
            ],
            "properties": {
              "type": {
                "enum": [
                  "bar",
                  "area"
                ]
              },
              "stack": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "encoding": {
            "properties": {
              "color": {
                "not": {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "const": "quantitative"
                    }
                  }
                },
                "errorMessage": {
                  "not": "a stack cannot be coloured by value (quantitative): which rows form one segment of it is not defined \u2014 colour it by a category (nominal or ordinal), or drop stack"
                }
              }
            }
          }
        }
      }
    },
    "stackValue": {
      "description": "A stack sums its value channel: y, or x when y is a category (a horizontal bar).",
      "if": {
        "required": [
          "mark"
        ],
        "properties": {
          "mark": {
            "type": "object",
            "required": [
              "type",
              "stack"
            ],
            "properties": {
              "type": {
                "enum": [
                  "bar",
                  "area"
                ]
              },
              "stack": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "encoding": {
            "if": {
              "required": [
                "y"
              ],
              "properties": {
                "y": {
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "enum": [
                        "nominal",
                        "ordinal"
                      ]
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "x": {
                  "$ref": "#/$defs/stackValueChannel"
                }
              }
            },
            "else": {
              "properties": {
                "y": {
                  "$ref": "#/$defs/stackValueChannel"
                }
              }
            }
          }
        }
      }
    },
    "stackValueChannel": {
      "description": "A stack's value channel: a number to sum.",
      "not": {
        "type": "object",
