# Default RCA sandbox image — see plan-backend §7.5.
#
# Bundles ipykernel (so the kernel can spawn in the container) +
# jupyter_client (CLI side; included for parity with the BE) +
# a small data-science stack so the seeded drift / pareto notebooks
# work without an extra pip install.
#
# Build:  docker build -t workspace-app/sandbox:py312-ds \
#                      -f docker/Dockerfile.workspace .
FROM python:3.12-slim

# #775: a workspace may declare its own dependencies (`pyproject.toml` +
# `uv.lock`), and `ensure_project_env` runs `uv sync` at every cold start to
# make the sandbox match them. uv is baked in rather than shipped as a tool
# bundle: the bundle machinery (certificates, size ceilings, an ABI anchor)
# exists for THIRD-PARTY authors publishing their own things, and uv has to
# exist before provisioning can run at all.
#
# Pinned on purpose. The version here decides how a lock file is read, and
# that must not change behind a user's back — upgrading uv is a deliberate
# image rebuild.
COPY --from=ghcr.io/astral-sh/uv:0.7.5 /uv /uvx /usr/local/bin/

RUN pip install --no-cache-dir \
    ipykernel jupyter_client \
    numpy pandas matplotlib scipy

WORKDIR /workspace
